# OpenAI-compatible API endpoint configuration
# Supports OpenAI, DeepSeek, OpenRouter, Together, SiliconFlow, vLLM, etc.
BASE_URL=https://api.openai.com/v1
API_KEY=sk-your-api-key-here
MODEL_NAME=gpt-4o-mini

# Optional standard OpenAI SDK aliases (used as fallback if the above are unset)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# Optional concurrency & rate-limit defaults
CONCURRENCY=5
RPM=30
