---
import type { CompatStatus } from '../types/vram';

export interface Props {
  status: CompatStatus;
  id?: string;
  size?: 'sm' | 'md';
}

const { status, id, size = 'sm' } = Astro.props;

const paletteMap: Record<CompatStatus, string> = {
  Fits: 'badge-fits',
  'Tight Fit': 'badge-tight',
  'Partial Offload': 'badge-partial',
  OOM: 'badge-oom',
};

const sizeCls =
  size === 'md'
    ? 'px-3 py-1 text-xs font-semibold gap-2'
    : 'px-2.5 py-0.5 text-[11px] font-semibold gap-1.5';

const badgeTheme = paletteMap[status] ?? paletteMap.OOM;
const badgeClass = `inline-flex items-center rounded-full border tracking-wide whitespace-nowrap ${sizeCls} ${badgeTheme}`;
---

<span id={id} class={badgeClass}>
  <span class="status-dot h-1.5 w-1.5 rounded-full shrink-0" aria-hidden="true"></span>
  <span data-status-label data-i18n-status={status}>{status}</span>
</span>
