---
import type { CompatStatus } from '../types/vram';

export interface Props {
  status: CompatStatus;
  id?: string;
  size?: 'sm' | 'md';
}

const { status, id, size = 'sm' } = Astro.props;

const paletteMap: Record<CompatStatus, { badge: string; dot: string }> = {
  Fits: {
    badge: 'border-emerald-200 bg-emerald-50 text-emerald-800',
    dot: 'bg-emerald-600',
  },
  'Tight Fit': {
    badge: 'border-orange-200 bg-orange-50 text-orange-800',
    dot: 'bg-orange-500',
  },
  'Partial Offload': {
    badge: 'border-amber-200 bg-amber-50 text-amber-800',
    dot: 'bg-amber-500',
  },
  OOM: {
    badge: 'border-rose-200 bg-rose-50 text-rose-800',
    dot: 'bg-rose-500',
  },
};

const sizeCls =
  size === 'md'
    ? 'px-3 py-1 text-xs font-semibold gap-2'
    : 'px-2.5 py-0.5 text-[11px] font-semibold gap-1.5';

const style = paletteMap[status] ?? paletteMap.OOM;
const badgeClass = `inline-flex items-center rounded-full border tracking-wide whitespace-nowrap ${sizeCls} ${style.badge}`;
const dotClass = `h-1.5 w-1.5 rounded-full ${style.dot}`;
---

<span id={id} class={badgeClass}>
  <span class={dotClass} aria-hidden="true"></span>
  <span data-status-label data-i18n-status={status}>{status}</span>
</span>
