---
import type { PageEntry } from '../types/vram';
import StatusBadge from './StatusBadge.astro';
import { formatContextLabel, speedRating } from '../utils/physics';

interface Props {
  entry: PageEntry;
}

const { entry } = Astro.props;
const { model, hardware, default_result: res } = entry;

const usable = hardware.usable_vram_gb;
const maxScale = Math.max(usable, res.total_vram_gb, 1);
const weightsPct = Math.min(100, (res.weights_gb / maxScale) * 100);
const kvPct = Math.min(100 - weightsPct, (res.kv_cache_gb / maxScale) * 100);
const overheadPct = Math.min(100 - weightsPct - kvPct, (res.overhead_gb / maxScale) * 100);
const ceilingPct = Math.min(100, (usable / maxScale) * 100);
const utilPct = Math.round((res.total_vram_gb / usable) * 100);
const initialCtxLabel = formatContextLabel(entry.default_context);
const initialRating = speedRating(res.est_tps, res.status);
const initialTpsText = res.status === 'OOM' ? 'OOM' : `${res.est_tps.toFixed(1)} tok/s`;
const initialHeadroomText =
  res.total_vram_gb <= usable
    ? `${(usable - res.total_vram_gb).toFixed(2)} GB free headroom`
    : `${(res.total_vram_gb - usable).toFixed(2)} GB over ${hardware.backend} ceiling`;
const initialVerdictLine =
  res.status === 'Smooth'
    ? `100% resident in ${hardware.backend} memory — zero CPU spill.`
    : res.status === 'Partial Offload'
      ? `Partial offload: ${res.gpu_layers_fit}/${res.total_layers} layers fit in VRAM; remainder spills to system RAM.`
      : `Out of memory: ${res.total_vram_gb.toFixed(2)} GB required exceeds ${hardware.short_name}'s capacity.`;
const initialNgl = res.status === 'Smooth' ? 99 : Math.max(1, res.gpu_layers_fit);
const gpuCount = hardware.gpu_count ?? 1;
const splitModeSuffix = gpuCount > 1 ? ' --split-mode layer' : '';
const initialLiveCmd = `llama-cli -hf ${model.hf_repo}:Q4_K_M -ngl ${initialNgl} -c ${entry.default_context} -fa on${splitModeSuffix}`;
const weightsStyle = `width: ${weightsPct.toFixed(2)}%`;
const kvStyle = `width: ${kvPct.toFixed(2)}%`;
const overheadStyle = `width: ${overheadPct.toFixed(2)}%`;
const ceilingStyle = `left: ${ceilingPct.toFixed(2)}%`;

const calcPayload = JSON.stringify({
  model: {
    params_b: model.params_b,
    num_layers: model.num_layers,
    num_kv_heads: model.num_kv_heads,
    head_dim: model.head_dim,
    max_context: model.max_context,
    ollama_tag: model.ollama_tag,
    hf_repo: model.hf_repo,
  },
  hardware: {
    name: hardware.name,
    short_name: hardware.short_name,
    vendor: hardware.vendor,
    gpu_count: gpuCount,
    vram_gb: hardware.vram_gb,
    usable_vram_gb: hardware.usable_vram_gb,
    bandwidth_gbps: hardware.bandwidth_gbps,
    is_unified: hardware.is_unified,
    backend: hardware.backend,
  },
  default_quant: 'Q4_K_M',
  default_context: entry.default_context,
});

const contextTicks = [4096, 8192, 16384, 32768, 49152, 65536];
---

<section
  id="vram-calculator"
  aria-label="Interactive VRAM and Speed Calculator"
  class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs sm:p-7"
>
  <div class="flex flex-col gap-3 border-b border-slate-100 pb-5 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-lg font-bold tracking-tight text-slate-950">
        Interactive VRAM &amp; Speed Simulator
      </h2>
      <p class="mt-0.5 text-sm text-slate-600">
        Toggle quantization precision and drag context length to inspect real-time GPU residency on {hardware.short_name}.
      </p>
    </div>
    <div class="flex items-center gap-2.5 self-start sm:self-auto">
      <StatusBadge status={res.status} size="md" id="calc-status-badge" />
    </div>
  </div>

  <!-- Interactive Controls -->
  <div class="mt-6 grid gap-6 lg:grid-cols-12">
    <!-- Quant Selector -->
    <div class="lg:col-span-5">
      <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500">
        Quantization Format
      </label>
      <div
        role="radiogroup"
        aria-label="Quantization format"
        class="mt-2.5 grid grid-cols-3 gap-2 rounded-xl border border-slate-200 bg-slate-50 p-1.5"
      >
        {(['Q4_K_M', 'Q8_0', 'FP16'] as const).map((q) => {
          const isActive = q === 'Q4_K_M';
          const bpwLabel = q === 'Q4_K_M' ? '4.85 bpw' : q === 'Q8_0' ? '8.50 bpw' : '16.0 bpw';
          const btnClass = isActive
            ? 'flex flex-col items-center rounded-lg px-2.5 py-2 text-center transition-all cursor-pointer bg-blue-600 text-white shadow-xs'
            : 'flex flex-col items-center rounded-lg px-2.5 py-2 text-center transition-all cursor-pointer text-slate-700 hover:bg-white hover:text-slate-950';
          const subClass = isActive ? 'text-[11px] text-blue-100' : 'text-[11px] text-slate-500';
          return (
            <button
              type="button"
              role="radio"
              aria-checked={isActive ? 'true' : 'false'}
              data-quant-btn={q}
              class={btnClass}
            >
              <span class="font-mono text-sm font-bold">{q}</span>
              <span class={subClass}>
                {bpwLabel}
              </span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- Context Length Slider -->
    <div class="lg:col-span-7">
      <div class="flex items-center justify-between">
        <label for="calc-ctx-slider" class="text-xs font-semibold uppercase tracking-wider text-slate-500">
          Context Window (KV Cache)
        </label>
        <span
          id="calc-ctx-readout"
          class="rounded-md bg-blue-50 px-2.5 py-0.5 font-mono text-sm font-bold text-blue-700 tabular-nums"
        >
          {initialCtxLabel} ({entry.default_context.toLocaleString()} tokens)
        </span>
      </div>

      <div class="mt-3.5">
        <input
          id="calc-ctx-slider"
          type="range"
          min="4096"
          max="65536"
          step="4096"
          value={entry.default_context}
          class="vram-slider"
          aria-describedby="calc-ctx-readout"
        />
        <div class="mt-2.5 flex items-center justify-between gap-1">
          {contextTicks.map((tick) => {
            const label = formatContextLabel(tick);
            const isDefault = tick === entry.default_context;
            const presetClass = isDefault
              ? 'rounded-md px-2 py-1 font-mono text-xs transition-colors cursor-pointer bg-slate-900 font-semibold text-white'
              : 'rounded-md px-2 py-1 font-mono text-xs transition-colors cursor-pointer text-slate-500 hover:bg-slate-100 hover:text-slate-900';
            return (
              <button
                type="button"
                data-ctx-preset={tick}
                class={presetClass}
              >
                {label}
              </button>
            );
          })}
        </div>
      </div>
    </div>
  </div>

  <!-- Telemetry KPI Row -->
  <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
      <p class="text-xs font-medium text-slate-500">Estimated Total VRAM</p>
      <div class="mt-1 flex items-baseline gap-2">
        <span id="calc-total-vram" class="font-mono text-2xl font-bold text-slate-950 tabular-nums">
          {res.total_vram_gb.toFixed(2)} GB
        </span>
        <span id="calc-util-pct" class="font-mono text-xs font-semibold text-slate-600 tabular-nums">
          ({utilPct}% of {usable} GB)
        </span>
      </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
      <p class="text-xs font-medium text-slate-500">Est. Decode Speed</p>
      <div class="mt-1 flex items-baseline gap-2">
        <span id="calc-tps" class="font-mono text-2xl font-bold text-slate-950 tabular-nums">
          {initialTpsText}
        </span>
      </div>
      <p id="calc-tps-rating" class="mt-0.5 text-xs text-slate-600">{initialRating}</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
      <p class="text-xs font-medium text-slate-500">Weights + Buffer</p>
      <div class="mt-1 flex items-baseline gap-2">
        <span id="calc-weights-gb" class="font-mono text-xl font-bold text-slate-900 tabular-nums">
          {res.weights_gb.toFixed(2)} GB
        </span>
        <span id="calc-overhead-gb" class="font-mono text-xs text-slate-500 tabular-nums">
          + {res.overhead_gb.toFixed(2)} GB sys
        </span>
      </div>
      <p id="calc-kv-gb" class="mt-0.5 font-mono text-xs text-slate-600 tabular-nums">
        KV Cache: {res.kv_cache_gb.toFixed(2)} GB (FP16)
      </p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
      <p class="text-xs font-medium text-slate-500">{hardware.backend} Layer Residency</p>
      <div class="mt-1 flex items-baseline gap-2">
        <span id="calc-layers" class="font-mono text-xl font-bold text-slate-900 tabular-nums">
          {res.gpu_layers_fit} / {res.total_layers}
        </span>
        <span class="text-xs text-slate-500">layers on GPU</span>
      </div>
      <p id="calc-headroom" class="mt-0.5 text-xs text-slate-600 tabular-nums">
        {initialHeadroomText}
      </p>
    </div>
  </div>

  <!-- Stacked Memory Bar -->
  <div class="mt-6 rounded-xl border border-slate-200 bg-slate-50/50 p-4">
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
      <span class="font-semibold text-slate-700">Memory Allocation vs Usable Budget</span>
      <span class="font-mono text-slate-600 tabular-nums">
        Usable {hardware.backend} Ceiling: <strong class="text-slate-950">{usable} GB</strong> (of {hardware.vram_gb} GB physical)
      </span>
    </div>

    <div class="relative mt-3 h-5 w-full overflow-hidden rounded-lg bg-slate-200">
      <div class="flex h-full w-full">
        <div
          id="bar-weights"
          class="h-full bg-blue-600 transition-all duration-150"
          style={weightsStyle}
          title="Model Weights"
        ></div>
        <div
          id="bar-kv"
          class="h-full bg-cyan-500 transition-all duration-150"
          style={kvStyle}
          title="KV Cache"
        ></div>
        <div
          id="bar-overhead"
          class="h-full bg-slate-500 transition-all duration-150"
          style={overheadStyle}
          title="Runtime Buffer"
        ></div>
      </div>

      <!-- Usable Budget Marker -->
      <div
        id="bar-ceiling-marker"
        class="pointer-events-none absolute top-0 bottom-0 w-0.5 bg-slate-950"
        style={ceilingStyle}
        title={'Usable Limit: ' + usable + ' GB'}
      ></div>
    </div>

    <div class="mt-2.5 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-600">
      <div class="flex flex-wrap items-center gap-4">
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-xs bg-blue-600"></span>
          Weights
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-xs bg-cyan-500"></span>
          KV Cache
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-xs bg-slate-500"></span>
          Runtime Buffer
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="h-3 w-0.5 bg-slate-950"></span>
          Usable Ceiling ({usable} GB)
        </span>
      </div>
      <p id="calc-verdict-line" class="font-medium text-slate-800">
        {initialVerdictLine}
      </p>
    </div>
  </div>

  <!-- Live Synced CLI Preview -->
  <div class="mt-4 flex flex-col gap-2 rounded-xl bg-slate-950 px-4 py-3 text-slate-100 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">
        Live Flags for Selected Config
      </span>
      <pre id="calc-live-cmd" class="mt-0.5 overflow-x-auto font-mono text-xs text-emerald-300">{initialLiveCmd}</pre>
    </div>
    <button
      type="button"
      data-copy-target="calc-live-cmd"
      class="shrink-0 self-start rounded-lg border border-slate-700 bg-slate-800 px-3 py-1.5 text-xs font-medium text-slate-200 hover:bg-slate-700 transition-colors cursor-pointer sm:self-center"
    >
      Copy Command
    </button>
  </div>

  <script type="application/json" id="calc-config-json" set:html={calcPayload}></script>
</section>

<script is:inline>
  (function () {
    const configEl = document.getElementById('calc-config-json');
    if (!configEl) return;
    const cfg = JSON.parse(configEl.textContent || '{}');
    const model = cfg.model;
    const hardware = cfg.hardware;

    const QUANT_BPW = { Q4_K_M: 4.85, Q5_K_M: 5.7, Q6_K: 6.6, Q8_0: 8.5, FP16: 16.0 };
    const EFFICIENCY_CUDA = { Q4_K_M: 0.78, Q5_K_M: 0.79, Q6_K: 0.79, Q8_0: 0.8, FP16: 0.82 };
    const EFFICIENCY_METAL = { Q4_K_M: 0.74, Q5_K_M: 0.75, Q6_K: 0.75, Q8_0: 0.76, FP16: 0.78 };
    const EFFICIENCY_ROCM = { Q4_K_M: 0.7, Q5_K_M: 0.71, Q6_K: 0.71, Q8_0: 0.72, FP16: 0.74 };
    const EFFICIENCY_BY_BACKEND = { CUDA: EFFICIENCY_CUDA, Metal: EFFICIENCY_METAL, ROCm: EFFICIENCY_ROCM };
    const MULTI_GPU_EFFICIENCY = 0.92;
    const CPU_OFFLOAD_BW_GBPS = 35.0;

    let currentQuant = cfg.default_quant || 'Q4_K_M';
    let currentContext = Number(cfg.default_context || 8192);

    const slider = document.getElementById('calc-ctx-slider');
    const ctxReadout = document.getElementById('calc-ctx-readout');
    const quantBtns = Array.from(document.querySelectorAll('[data-quant-btn]'));
    const presetBtns = Array.from(document.querySelectorAll('[data-ctx-preset]'));

    const statusBadge = document.getElementById('calc-status-badge');
    const totalVramEl = document.getElementById('calc-total-vram');
    const utilPctEl = document.getElementById('calc-util-pct');
    const tpsEl = document.getElementById('calc-tps');
    const tpsRatingEl = document.getElementById('calc-tps-rating');
    const weightsEl = document.getElementById('calc-weights-gb');
    const overheadEl = document.getElementById('calc-overhead-gb');
    const kvEl = document.getElementById('calc-kv-gb');
    const layersEl = document.getElementById('calc-layers');
    const headroomEl = document.getElementById('calc-headroom');
    const barWeights = document.getElementById('bar-weights');
    const barKv = document.getElementById('bar-kv');
    const barOverhead = document.getElementById('bar-overhead');
    const barCeiling = document.getElementById('bar-ceiling-marker');
    const verdictLine = document.getElementById('calc-verdict-line');
    const liveCmdEl = document.getElementById('calc-live-cmd');

    const round2 = (n) => Math.round(n * 100) / 100;
    const round1 = (n) => Math.round(n * 10) / 10;

    function estimate(quant, contextTokens) {
      const bpw = QUANT_BPW[quant];
      const weightsGb = (model.params_b * bpw) / 8.0;
      const kvBytes = 2 * model.num_layers * model.num_kv_heads * model.head_dim * contextTokens * 2;
      const kvCacheGb = kvBytes / Math.pow(1024, 3);
      const overheadGb = Math.min(2.0, 0.5 + 0.015 * model.params_b);
      const totalVramGb = weightsGb + kvCacheGb + overheadGb;

      const usable = hardware.usable_vram_gb;
      const memForWeights = Math.max(0.0, usable - kvCacheGb - overheadGb);
      const gpuFraction = weightsGb > 0 ? Math.min(1.0, memForWeights / weightsGb) : 1.0;
      const gpuLayersFit =
        totalVramGb <= usable ? model.num_layers : Math.floor(model.num_layers * gpuFraction);

      let status;
      if (totalVramGb <= usable) {
        status = 'Smooth';
      } else if (hardware.is_unified) {
        status = totalVramGb <= hardware.vram_gb * 0.92 ? 'Partial Offload' : 'OOM';
      } else {
        status = totalVramGb <= usable * 2.0 && gpuFraction >= 0.35 ? 'Partial Offload' : 'OOM';
      }

      const effTable = EFFICIENCY_BY_BACKEND[hardware.backend] || EFFICIENCY_CUDA;
      const eff = effTable[quant];
      const multiGpuFactor = (hardware.gpu_count || 1) > 1 ? MULTI_GPU_EFFICIENCY : 1.0;
      const effectiveBw = hardware.bandwidth_gbps * eff * multiGpuFactor;
      const kvReadGb = kvCacheGb * 0.5;
      let estTps = 0.0;

      if (status === 'OOM') {
        estTps = 0.0;
      } else if (status === 'Smooth') {
        estTps = effectiveBw / (weightsGb + kvReadGb);
      } else if (hardware.is_unified) {
        estTps = (effectiveBw / (weightsGb + kvReadGb)) * 0.55;
      } else {
        const tGpu = (weightsGb * gpuFraction + kvReadGb) / effectiveBw;
        const tCpu = (weightsGb * (1.0 - gpuFraction)) / CPU_OFFLOAD_BW_GBPS;
        estTps = tGpu + tCpu > 0 ? 1.0 / (tGpu + tCpu) : 0.0;
      }

      return {
        weightsGb: round2(weightsGb),
        kvCacheGb: round2(kvCacheGb),
        overheadGb: round2(overheadGb),
        totalVramGb: round2(totalVramGb),
        status,
        estTps: round1(estTps),
        gpuLayersFit,
        totalLayers: model.num_layers,
      };
    }

    function updateBadge(status) {
      if (!statusBadge) return;
      const dot = statusBadge.querySelector('span:first-child');
      const label = statusBadge.querySelector('[data-status-label]');
      if (label) label.textContent = status;

      statusBadge.classList.remove(
        'border-emerald-200',
        'bg-emerald-50',
        'text-emerald-800',
        'border-amber-200',
        'bg-amber-50',
        'text-amber-800',
        'border-rose-200',
        'bg-rose-50',
        'text-rose-800'
      );
      if (dot) {
        dot.classList.remove('bg-emerald-600', 'bg-amber-500', 'bg-rose-600');
      }

      if (status === 'Smooth') {
        statusBadge.classList.add('border-emerald-200', 'bg-emerald-50', 'text-emerald-800');
        if (dot) dot.classList.add('bg-emerald-600');
      } else if (status === 'Partial Offload') {
        statusBadge.classList.add('border-amber-200', 'bg-amber-50', 'text-amber-800');
        if (dot) dot.classList.add('bg-amber-500');
      } else {
        statusBadge.classList.add('border-rose-200', 'bg-rose-50', 'text-rose-800');
        if (dot) dot.classList.add('bg-rose-600');
      }
    }

    function getSpeedRating(tps, status) {
      if (status === 'OOM' || tps <= 0) return 'Impractical (OOM)';
      if (tps >= 50) return 'Blazing (>50 tok/s)';
      if (tps >= 20) return 'Fast Interactive';
      if (tps >= 8) return 'Readable Speed';
      return 'Slow (PCIe / RAM Bound)';
    }

    function render() {
      const r = estimate(currentQuant, currentContext);
      const usable = hardware.usable_vram_gb;
      const ctxK = Math.round(currentContext / 1024) + 'K';

      if (ctxReadout) {
        ctxReadout.textContent = `${ctxK} (${currentContext.toLocaleString()} tokens)`;
      }

      updateBadge(r.status);

      const utilPct = Math.round((r.totalVramGb / usable) * 100);
      if (totalVramEl) totalVramEl.textContent = `${r.totalVramGb.toFixed(2)} GB`;
      if (utilPctEl) utilPctEl.textContent = `(${utilPct}% of ${usable} GB)`;

      if (tpsEl) {
        tpsEl.textContent = r.status === 'OOM' ? 'OOM' : `${r.estTps.toFixed(1)} tok/s`;
      }
      if (tpsRatingEl) tpsRatingEl.textContent = getSpeedRating(r.estTps, r.status);
      if (weightsEl) weightsEl.textContent = `${r.weightsGb.toFixed(2)} GB`;
      if (overheadEl) overheadEl.textContent = `+ ${r.overheadGb.toFixed(2)} GB sys`;
      if (kvEl) kvEl.textContent = `KV Cache: ${r.kvCacheGb.toFixed(2)} GB (FP16)`;
      if (layersEl) layersEl.textContent = `${r.gpuLayersFit} / ${r.totalLayers}`;

      if (headroomEl) {
        headroomEl.textContent =
          r.totalVramGb <= usable
            ? `${(usable - r.totalVramGb).toFixed(2)} GB free headroom`
            : `${(r.totalVramGb - usable).toFixed(2)} GB over ${hardware.backend} ceiling`;
      }

      const maxScale = Math.max(usable, r.totalVramGb, 1);
      const wPct = Math.min(100, (r.weightsGb / maxScale) * 100);
      const kPct = Math.min(100 - wPct, (r.kvCacheGb / maxScale) * 100);
      const oPct = Math.min(100 - wPct - kPct, (r.overheadGb / maxScale) * 100);
      const cPct = Math.min(100, (usable / maxScale) * 100);

      if (barWeights) barWeights.style.width = `${wPct.toFixed(2)}%`;
      if (barKv) barKv.style.width = `${kPct.toFixed(2)}%`;
      if (barOverhead) barOverhead.style.width = `${oPct.toFixed(2)}%`;
      if (barCeiling) barCeiling.style.left = `${cPct.toFixed(2)}%`;

      if (verdictLine) {
        if (r.status === 'Smooth') {
          verdictLine.textContent = `100% resident in ${hardware.backend} memory — zero CPU spill.`;
        } else if (r.status === 'Partial Offload') {
          verdictLine.textContent = `Partial offload: ${r.gpuLayersFit}/${r.totalLayers} layers fit in VRAM; remainder spills to system RAM.`;
        } else {
          verdictLine.textContent = `Out of memory: ${r.totalVramGb.toFixed(2)} GB required exceeds ${hardware.short_name}'s capacity.`;
        }
      }

      if (liveCmdEl) {
        const ngl = r.status === 'Smooth' ? 99 : Math.max(1, r.gpuLayersFit);
        const splitFlag = (hardware.gpu_count || 1) > 1 ? ' --split-mode layer' : '';
        liveCmdEl.textContent = `llama-cli -hf ${model.hf_repo}:${currentQuant} -ngl ${ngl} -c ${currentContext} -fa on${splitFlag}`;
      }

      quantBtns.forEach((btn) => {
        const active = btn.getAttribute('data-quant-btn') === currentQuant;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        const sub = btn.querySelector('span:last-child');
        if (active) {
          btn.classList.add('bg-blue-600', 'text-white', 'shadow-xs');
          btn.classList.remove('text-slate-700', 'hover:bg-white', 'hover:text-slate-950');
          if (sub) {
            sub.classList.add('text-blue-100');
            sub.classList.remove('text-slate-500');
          }
        } else {
          btn.classList.remove('bg-blue-600', 'text-white', 'shadow-xs');
          btn.classList.add('text-slate-700', 'hover:bg-white', 'hover:text-slate-950');
          if (sub) {
            sub.classList.remove('text-blue-100');
            sub.classList.add('text-slate-500');
          }
        }
      });

      presetBtns.forEach((btn) => {
        const val = Number(btn.getAttribute('data-ctx-preset'));
        const active = val === currentContext;
        if (active) {
          btn.classList.add('bg-slate-900', 'font-semibold', 'text-white');
          btn.classList.remove('text-slate-500', 'hover:bg-slate-100', 'hover:text-slate-900');
        } else {
          btn.classList.remove('bg-slate-900', 'font-semibold', 'text-white');
          btn.classList.add('text-slate-500', 'hover:bg-slate-100', 'hover:text-slate-900');
        }
      });
    }

    quantBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentQuant = btn.getAttribute('data-quant-btn') || 'Q4_K_M';
        render();
      });
    });

    if (slider) {
      slider.addEventListener('input', () => {
        currentContext = Number(slider.value);
        render();
      });
    }

    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentContext = Number(btn.getAttribute('data-ctx-preset') || 8192);
        if (slider) slider.value = String(currentContext);
        render();
      });
    });

    render();
  })();
</script>
