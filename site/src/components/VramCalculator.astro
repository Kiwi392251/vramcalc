---
import {
  classifySpeedTier,
  formatContextLabel,
  formatTpsRange,
  PCIE_LINKS,
  QUANT_BPW,
  THERMAL_FACTORS,
} from '../utils/physics';
import type { PcieLinkKey, ThermalProfile, VramPageEntry } from '../types/vram';

import CustomSelect from './CustomSelect.astro';
import StatusBadge from './StatusBadge.astro';
import SpeedBadge from './SpeedBadge.astro';

interface Props {
  entry: VramPageEntry;
}

const { entry } = Astro.props;
const { model, hardware, default_result: res } = entry;
const defaultSysRam = hardware.vram_gb >= 24 ? 64 : 32;
const calcRamOptions = [16, 32, 64, 128] as const;

const usable = res.effective_usable_vram_gb ?? hardware.usable_vram_gb;
const maxScale = Math.max(usable, res.total_vram_gb, 1);
const weightsPct = Math.min(100, (res.weights_gb / maxScale) * 100);
const kvPct = Math.min(100 - weightsPct, (res.kv_cache_gb / maxScale) * 100);
const overheadPct = Math.min(100 - weightsPct - kvPct, (res.overhead_gb / maxScale) * 100);
const ceilingPct = Math.min(100, (usable / maxScale) * 100);
const utilPct = Math.round((res.total_vram_gb / usable) * 100);
const initialCtxLabel = formatContextLabel(entry.default_context);
const initialTier = res.speed_tier ?? classifySpeedTier(res.est_tps, res.status);
const initialTpsText = formatTpsRange(
  res.est_tps_low,
  res.est_tps_high,
  res.est_tps,
  res.status,
);
const initialHeadroomText =
  res.total_vram_gb <= usable
    ? `${(usable - res.total_vram_gb).toFixed(2)} GB free headroom`
    : `${(res.total_vram_gb - usable).toFixed(2)} GB over ${hardware.backend} ceiling`;
const initialVerdictLine =
  res.status === 'Fits'
    ? `100% resident in ${hardware.backend} memory (${(usable - res.total_vram_gb).toFixed(2)} GB headroom).`
    : res.status === 'Tight Fit'
      ? `Tight margin: ${(usable - res.total_vram_gb).toFixed(2)} GB free (<5% buffer) — minimize desktop apps or cut KV to q8_0.`
      : res.status === 'Partial Offload'
        ? `Partial offload: ${res.gpu_layers_fit}/${res.total_layers} layers fit in VRAM; remainder spills to system RAM.`
        : `Out of memory: ${res.total_vram_gb.toFixed(2)} GB required exceeds ${hardware.short_name}'s capacity.`;

const initialNgl = res.status === 'Fits' || res.status === 'Tight Fit' ? 99 : Math.max(1, res.gpu_layers_fit);
const gpuCount = hardware.gpu_count ?? 1;
const initialLiveCmd = `llama-cli -hf ${model.hf_repo}:Q4_K_M -ngl ${initialNgl} -c ${entry.default_context} -fa on`;
const gpuHubHref = `/gpu/${hardware.id}/`;
const modelHubHref = `/model/${model.id}/`;
const simulatorHref = `/calculator/?model=${encodeURIComponent(model.id)}&hw=${encodeURIComponent(hardware.id)}&gpus=${gpuCount}`;

const weightsStyle = `width: ${weightsPct.toFixed(2)}%`;
const kvStyle = `width: ${kvPct.toFixed(2)}%`;
const overheadStyle = `width: ${overheadPct.toFixed(2)}%`;
const ceilingStyle = `left: ${ceilingPct.toFixed(2)}%`;
const ceilingTitle = `Usable Limit: ${usable} GB`;

const formatTabs = [
  { key: 'GGUF', label: 'GGUF', sub: 'llama.cpp', i18n: 'fmt.ggufShort' },
  { key: 'AWQ', label: 'AWQ / FP8', sub: 'vLLM', i18n: 'fmt.awqShort' },
  { key: 'MLX', label: 'MLX', sub: 'Apple Silicon', i18n: 'fmt.mlxShort' },
] as const;

const allQuantOptions = [
  { key: 'Q4_K_M', fmt: 'GGUF', bpw: `${QUANT_BPW.Q4_K_M} bpw` },
  { key: 'Q5_K_M', fmt: 'GGUF', bpw: `${QUANT_BPW.Q5_K_M} bpw` },
  { key: 'Q6_K', fmt: 'GGUF', bpw: `${QUANT_BPW.Q6_K} bpw` },
  { key: 'Q8_0', fmt: 'GGUF', bpw: `${QUANT_BPW.Q8_0} bpw` },
  { key: 'FP16', fmt: 'GGUF', bpw: '16.0 bpw' },
  { key: 'AWQ_4BIT', fmt: 'AWQ', bpw: '4.75 bpw' },
  { key: 'FP8', fmt: 'AWQ', bpw: '8.20 bpw' },
  { key: 'MLX_4BIT', fmt: 'MLX', bpw: '4.55 bpw' },
  { key: 'MLX_8BIT', fmt: 'MLX', bpw: '8.25 bpw' },
] as const;

const kvOptions = [
  { key: 'fp16', label: 'FP16 KV' },
  { key: 'q8_0', label: 'Q8_0 (-50%)' },
  { key: 'q4_0', label: 'Q4_0 (-75%)' },
] as const;

const cpuPresets = [
  { label: 'Default DDR4 (35 GB/s)', bw: 35 },
  { label: 'Intel / Ryzen DDR5-6000 (68 GB/s)', bw: 68 },
  { label: 'Threadripper 4-Ch DDR5 (145 GB/s)', bw: 145 },
  { label: 'EPYC 12-Ch Server (360 GB/s)', bw: 360 },
] as const;

const gpuCountOptions = [1, 2, 3, 4] as const;
const contextTicks = [4096, 8192, 16384, 32768, 49152, 65536];

const calcPayload = JSON.stringify({
  model,
  hardware,
  default_quant: 'Q4_K_M',
  default_format: 'GGUF',
  default_context: entry.default_context,
  default_kv_quant: 'fp16',
  default_gpu_count: gpuCount,
  default_sys_ram: defaultSysRam,
});

const splitWrapClass = gpuCount > 1 ? '' : 'hidden';
const tightWarnWrapClass = res.status === 'Tight Fit' ? 'mt-3' : 'mt-3 hidden';
const oomRescueWrapClass = res.status === 'OOM' ? 'mt-3' : 'mt-3 hidden';

const calcSubArgs = JSON.stringify({ hw: hardware.short_name });
const unifiedNoteArgs = JSON.stringify({
  usable: usable.toFixed(1),
  vram: hardware.vram_gb,
  bw: hardware.bandwidth_gbps,
});
const layerResidencyArgs = JSON.stringify({ backend: hardware.backend });
const oomAlertDescArgs = JSON.stringify({ hw: hardware.short_name });
const modelsFitBtnArgs = JSON.stringify({ hw: hardware.short_name });
const smoothGpusBtnArgs = JSON.stringify({ model: model.short_name });
const tightWarnDescArgs = JSON.stringify({ gb: Math.max(0, usable - res.total_vram_gb).toFixed(2) });
---

<section
  id="vram-calculator"
  aria-label="Interactive VRAM and Speed Calculator"
  class="surface-card p-5 sm:p-7"
>
  <div class="flex flex-col gap-3 border-b border-[var(--border-hairline)] pb-5 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-lg font-bold tracking-tight text-[var(--ink-primary)]" data-i18n="detail.calcTitle">
        Interactive VRAM, Format &amp; Speed Simulator
      </h2>
      <p class="mt-0.5 text-sm text-[var(--ink-secondary)]" data-i18n="detail.calcSub" data-i18n-args={calcSubArgs}>
        Switch GGUF, AWQ (vLLM), or MLX, adjust Daily Desktop vs Clean OS reserves, KV cache precision, context length, and Multi-GPU topology on {hardware.short_name}.
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2 self-start sm:self-auto">
      <a
        href={simulatorHref}
        data-i18n="detail.fullRigSim"
        class="btn-secondary text-xs text-[var(--accent-ink)]"
      >
        Full Rig Simulator -&gt;
      </a>
      <StatusBadge status={res.status} size="md" id="calc-status-badge" />
      <SpeedBadge tier={initialTier} id="calc-speed-badge" short={true} />
    </div>
  </div>

  <!-- Format + OS Reserve Controls -->
  <div class="mt-5 grid gap-4 border-b border-[var(--border-hairline)] pb-5 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <span class="block text-xs font-semibold uppercase tracking-wider text-[var(--ink-tertiary)]" data-i18n="fmt.title">
        Runtime Format
      </span>
      <div class="mt-2 seg-track" role="group" aria-label="Runtime format">
        {formatTabs.map((ft) => {
          const active = ft.key === 'GGUF';
          return (
            <button type="button" data-fmt-btn={ft.key} data-active={active ? 'true' : 'false'} class="seg-btn whitespace-nowrap py-1.5 px-3">
              <span data-i18n={ft.i18n}>{ft.label}</span>
            </button>
          );
        })}
      </div>
    </div>

    <div class="lg:col-span-7">
      <span class="block text-xs font-semibold uppercase tracking-wider text-[var(--ink-tertiary)]" data-i18n="reserve.title">
        OS Reserve Profile
      </span>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <div class="seg-track" role="group" aria-label="OS Reserve profile">
          <button
            type="button"
            data-reserve-btn="desktop"
            data-active="true"
            data-i18n="reserve.desktop"
            class="seg-btn whitespace-nowrap py-1.5 px-2.5"
          >
            Daily Desktop
          </button>
          <button
            type="button"
            data-reserve-btn="clean"
            data-active="false"
            data-i18n="reserve.clean"
            class="seg-btn whitespace-nowrap py-1.5 px-2.5"
          >
            Clean OS / Headless
          </button>
          <button
            type="button"
            data-reserve-btn="custom"
            data-active="false"
            data-i18n="reserve.custom"
            class="seg-btn whitespace-nowrap py-1.5 px-2.5"
          >
            Custom GB
          </button>
        </div>

        <div id="calc-custom-reserve-wrap" class="hidden">
          <label class="inline-flex items-center gap-1.5 text-xs text-[var(--ink-secondary)]">
            <span class="sr-only" data-i18n="reserve.customLabel">Usable ceiling (GB)</span>
            <input
              id="calc-custom-usable-input"
              type="number"
              min="1"
              max={hardware.vram_gb * 8}
              step="0.5"
              value={usable.toFixed(1)}
              class="field-input w-20 px-2.5 py-1 font-mono text-xs font-bold"
            />
            <span class="font-mono text-[var(--ink-tertiary)]">GB</span>
          </label>
        </div>
      </div>
    </div>
  </div>

  <!-- Quantization + Context Controls -->
  <div class="mt-5 grid gap-6 lg:grid-cols-12">
    <div class="lg:col-span-6">
      <label class="block text-xs font-semibold uppercase tracking-wider text-[var(--ink-tertiary)]" data-i18n="detail.quantFormat">
        Runtime Format &amp; Quantization
      </label>
      <div
        role="radiogroup"
        aria-label="Quantization format"
        class="surface-inset mt-2.5 flex flex-wrap gap-1.5 p-1.5"
      >
        {allQuantOptions.map((q) => {
          const isActive = q.key === 'Q4_K_M';
          const wrapVisible = q.fmt === 'GGUF' ? '' : 'hidden';
          return (
            <div data-quant-wrap={q.fmt} class={wrapVisible}>
              <button
                type="button"
                role="radio"
                aria-checked={isActive ? 'true' : 'false'}
                data-quant-btn={q.key}
                data-quant-fmt={q.fmt}
                data-active={isActive ? 'true' : 'false'}
                class="quant-btn min-w-[76px]"
              >
                <span class="font-mono text-xs font-bold">{q.key}</span>
                <span class="quant-sub text-[10px]">{q.bpw}</span>
              </button>
            </div>
          );
        })}
      </div>
    </div>

    <div class="lg:col-span-6">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <label for="calc-ctx-slider" class="text-xs font-semibold uppercase tracking-wider text-[var(--ink-tertiary)]" data-i18n="detail.ctxWindowKv">
          Context Window &amp; KV Cache
        </label>
        <div class="flex flex-wrap items-center gap-2">
          <div class="seg-track" role="group" aria-label="KV cache quantization">
            {kvOptions.map((kv) => {
              const isKvActive = kv.key === 'fp16';
              return (
                <button type="button" data-kv-btn={kv.key} data-active={isKvActive ? 'true' : 'false'} class="seg-btn font-mono text-[11px] px-2 py-0.5">
                  {kv.label}
                </button>
              );
            })}
          </div>
          <span
            id="calc-ctx-readout"
            class="badge-accent rounded-md px-2.5 py-0.5 font-mono text-sm font-bold tabular-nums"
          >
            {initialCtxLabel} ({entry.default_context.toLocaleString()} tokens)
          </span>
        </div>
      </div>

      <div class="mt-3.5">
        <input
          id="calc-ctx-slider"
          type="range"
          min="4096"
          max="65536"
          step="4096"
          value={entry.default_context}
          class="vram-slider"
          aria-describedby="calc-ctx-readout"
        />
        <div class="mt-2.5 flex items-center justify-between gap-1">
          {contextTicks.map((tick) => {
            const label = formatContextLabel(tick);
            const isDefault = tick === entry.default_context;
            return (
              <button type="button" data-ctx-preset={tick} data-active={isDefault ? 'true' : 'false'} class="seg-btn font-mono text-xs px-2 py-1">
                {label}
              </button>
            );
          })}
        </div>
      </div>
    </div>
  </div>

  <!-- Compact Multi-GPU, System RAM & Offload Bar -->
  {!hardware.is_unified ? (
    <div class="surface-inset mt-4 space-y-3 px-4 py-3 text-xs">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-1.5">
            <span class="font-semibold text-[var(--ink-secondary)]" data-i18n="detail.gpusLabel">GPUs:</span>
            <div class="seg-track" role="group" aria-label="GPU count">
              {gpuCountOptions.map((n) => {
                const active = n === gpuCount;
                return (
                  <button type="button" data-gpu-count-btn={n} data-active={active ? 'true' : 'false'} class="seg-btn font-mono text-xs px-2 py-0.5">
                    {n}x
                  </button>
                );
              })}
            </div>
          </div>

          <div id="calc-split-wrap" class={splitWrapClass}>
            <div class="flex items-center gap-1.5">
              <span class="font-semibold text-[var(--ink-secondary)]" data-i18n="detail.splitLabel">Split:</span>
              <div class="seg-track" role="group" aria-label="Multi-GPU split mode">
                <button
                  type="button"
                  data-split-btn="layer"
                  data-active="true"
                  data-i18n="detail.splitLayer"
                  class="seg-btn font-mono text-xs px-2 py-0.5"
                >
                  Layer
                </button>
                <button
                  type="button"
                  data-split-btn="tensor"
                  data-active="false"
                  data-i18n="detail.splitTensor"
                  class="seg-btn font-mono text-xs px-2 py-0.5"
                >
                  Tensor
                </button>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-1.5">
            <span class="font-semibold text-[var(--ink-secondary)]" data-i18n="detail.sysRamLabel">System RAM:</span>
            <div class="seg-track" role="group" aria-label="System RAM capacity">
              {calcRamOptions.map((rGb) => (
                <button
                  type="button"
                  data-calc-ram={rGb}
                  data-active={rGb === defaultSysRam ? 'true' : 'false'}
                  class="seg-btn font-mono text-xs px-2 py-0.5"
                >
                  {rGb}G
                </button>
              ))}
            </div>
          </div>

          <div class="flex items-center gap-2">
            <span class="font-semibold text-[var(--ink-secondary)]" data-i18n="detail.cpuOffloadLabel">Host Offload RAM:</span>
            <CustomSelect
              id="calc-cpu-select"
              compact={true}
              options={cpuPresets.map((c) => ({ value: String(c.bw), label: c.label }))}
              value="35"
              ariaLabel="Host Offload RAM"
              menuWidthClass="min-w-[230px]"
            />
          </div>
        </div>

        <span id="calc-rig-tag" class="font-mono text-[11px] font-medium text-[var(--ink-tertiary)]">
          {gpuCount}x {hardware.short_name} · {usable.toFixed(1)} GB usable VRAM
        </span>
      </div>

      <!-- Manual -ngl & Advanced Offload Strip (GGUF only) -->
      <div id="calc-offload-strip" class="border-t border-[var(--border-hairline)] pt-2.5 space-y-2">
        <div class="flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-1.5">
            <label for="calc-ngl-slider" class="font-semibold text-[var(--ink-secondary)]" data-i18n="sim.nglLabel">
              GPU Layers (-ngl)
            </label>
            <button
              id="calc-ngl-auto"
              type="button"
              data-active="true"
              data-i18n="sim.nglAuto"
              class="seg-btn font-mono text-[11px] px-2 py-0.5"
            >
              Auto
            </button>
          </div>
          <div class="min-w-[140px] flex-1">
            <input
              id="calc-ngl-slider"
              type="range"
              min="0"
              max={model.num_layers}
              step="1"
              value={res.gpu_layers_fit}
              class="vram-slider"
            />
          </div>
          <span id="calc-ngl-readout" class="badge-accent rounded-md px-2 py-0.5 font-mono text-[11px] font-bold tabular-nums">
            Auto ({res.gpu_layers_fit}/{res.total_layers})
          </span>
        </div>

        <details class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3 py-1.5">
          <summary class="cursor-pointer select-none text-[11px] font-semibold text-[var(--ink-secondary)] hover:text-[var(--ink-primary)]" data-i18n="sim.advancedOffload">
            Offload &amp; Advanced: PCIe · Thermal · -nkvo
          </summary>
          <div class="mt-2.5 flex flex-wrap items-center gap-3 pb-1">
            <div class="flex items-center gap-1.5">
              <label for="calc-pcie-select" class="text-[11px] font-semibold text-[var(--ink-tertiary)]" data-i18n="sim.pcieLabel">PCIe:</label>
              <select id="calc-pcie-select" class="field-input px-2 py-1 font-mono text-[11px]">
                {(Object.keys(PCIE_LINKS) as PcieLinkKey[]).map((key) => (
                  <option value={key} selected={key === 'pcie4_x16'}>{PCIE_LINKS[key].label}</option>
                ))}
              </select>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-[11px] font-semibold text-[var(--ink-tertiary)]" data-i18n="sim.thermalLabel">Thermal:</span>
              <div class="seg-track" role="group" aria-label="Thermal profile">
                {(['desktop', 'laptop_sustained', 'throttled'] as const).map((tp) => (
                  <button
                    type="button"
                    data-calc-thermal={tp}
                    data-active={tp === 'desktop' ? 'true' : 'false'}
                    data-i18n={tp === 'desktop' ? 'sim.thermalDesktop' : tp === 'laptop_sustained' ? 'sim.thermalLaptop' : 'sim.thermalThrottled'}
                    class="seg-btn font-mono text-[10px] px-2 py-0.5"
                  >
                    {THERMAL_FACTORS[tp].toFixed(2)}×
                  </button>
                ))}
              </div>
            </div>
            <label class="inline-flex items-center gap-1.5 text-[11px] font-medium text-[var(--ink-secondary)] cursor-pointer">
              <input id="calc-nkvo-check" type="checkbox" class="rounded border-[var(--border-strong)] accent-[var(--accent)]" />
              <span data-i18n="sim.nkvoLabel">Keep KV in System RAM (-nkvo)</span>
            </label>
          </div>
        </details>
      </div>
    </div>
  ) : (
    <div class="surface-inset mt-4 flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 text-xs text-[var(--ink-secondary)]">
      <span id="calc-unified-note" data-i18n="detail.unifiedNote" data-i18n-args={unifiedNoteArgs}>
        Unified Pool ({usable.toFixed(1)} GB usable in current reserve of {hardware.vram_gb} GB · {hardware.bandwidth_gbps} GB/s).
      </span>
      <a href={simulatorHref} class="font-semibold text-[var(--accent-ink)] hover:underline" data-i18n="detail.compareMultiGpu">
        Compare against 1x–8x GPUs or CPU-Only -&gt;
      </a>
    </div>
  )}

  <!-- Telemetry KPI Row -->
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="surface-inset p-4">
      <p class="text-xs font-medium text-[var(--ink-secondary)]" data-i18n="detail.estTotalVram">Estimated Total VRAM</p>
      <div class="mt-1 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
        <span id="calc-total-vram" class="whitespace-nowrap font-mono text-2xl font-bold text-[var(--ink-primary)] tabular-nums">
          {res.total_vram_gb.toFixed(2)} GB
        </span>
        <span id="calc-util-pct" class="whitespace-nowrap font-mono text-xs font-semibold text-[var(--ink-secondary)] tabular-nums">
          ({utilPct}% of {usable.toFixed(1)} GB)
        </span>
      </div>
    </div>

    <div class="surface-inset p-4">
      <p class="text-xs font-medium text-[var(--ink-secondary)]" data-i18n="detail.estDecodeSpeed">Formula Speed Range</p>
      <div class="mt-1 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
        <span id="calc-tps" class="whitespace-nowrap font-mono text-2xl font-bold text-[var(--ink-primary)] tabular-nums">
          {initialTpsText}
        </span>
      </div>
      <p id="calc-tps-rating" class="mt-1 text-xs text-[var(--ink-secondary)]">{initialTier} · Formula (±15–25%)</p>
    </div>

    <div class="surface-inset p-4">
      <p class="text-xs font-medium text-[var(--ink-secondary)]" data-i18n="detail.weightsBuffer">Weights + Buffer</p>
      <div class="mt-1 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
        <span id="calc-weights-gb" class="whitespace-nowrap font-mono text-2xl font-bold text-[var(--ink-primary)] tabular-nums">
          {res.weights_gb.toFixed(2)} GB
        </span>
        <span id="calc-overhead-gb" class="whitespace-nowrap font-mono text-xs text-[var(--ink-secondary)] tabular-nums">
          + {res.overhead_gb.toFixed(2)} GB sys
        </span>
      </div>
      <p id="calc-kv-gb" class="mt-1 font-mono text-xs text-[var(--ink-secondary)] tabular-nums">
        KV Cache: {res.kv_cache_gb.toFixed(2)} GB (FP16)
      </p>
    </div>

    <div class="surface-inset p-4">
      <p class="text-xs font-medium text-[var(--ink-secondary)]" data-i18n="detail.layerResidency" data-i18n-args={layerResidencyArgs}>{hardware.backend} Layer Residency</p>
      <div class="mt-1 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
        <span id="calc-layers" class="whitespace-nowrap font-mono text-2xl font-bold text-[var(--ink-primary)] tabular-nums">
          {res.gpu_layers_fit} / {res.total_layers}
        </span>
        <span class="whitespace-nowrap text-xs text-[var(--ink-secondary)]" data-i18n="detail.layersOnGpu">layers on GPU</span>
      </div>
      <p id="calc-headroom" class="mt-1 text-xs text-[var(--ink-secondary)] tabular-nums">
        {initialHeadroomText}
      </p>
    </div>
  </div>

  <!-- Tight Margin Warning -->
  <div id="calc-tight-warn" class={tightWarnWrapClass} role="note">
    <div class="rounded-xl border border-orange-500/30 bg-orange-500/10 px-4 py-3 text-xs text-orange-800 dark:text-orange-300">
      <strong class="font-bold" data-i18n="warn.tightFitTitle">Tight Margin Warning (&lt;5% / &lt;1 GB free):</strong>{' '}
      <span id="calc-tight-desc" data-i18n="warn.tightFitDesc" data-i18n-args={tightWarnDescArgs}>
        Only {Math.max(0, usable - res.total_vram_gb).toFixed(2)} GB free headroom remains. Display compositor memory, CUDA context growth, or longer context may spill weights to CPU/RAM.
      </span>
    </div>
  </div>

  <!-- PCIe All-Reduce Warning -->
  <div id="calc-pcie-warn" class="mt-3 hidden" role="note">
    <div class="rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-xs text-amber-800 dark:text-amber-300">
      <strong class="font-bold" data-i18n="warn.pcieTpTitle">PCIe All-Reduce Synchronization Overhead:</strong>{' '}
      <span id="calc-pcie-desc"></span>
    </div>
  </div>

  <!-- Stacked Memory Bar -->
  <div class="surface-inset mt-5 p-4">
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
      <span class="font-semibold text-[var(--ink-primary)]" data-i18n="detail.memAllocTitle">Memory Allocation vs Usable Budget</span>
      <span id="calc-ceiling-text" class="font-mono text-[var(--ink-secondary)] tabular-nums">
        Usable {hardware.backend} Ceiling: <strong class="text-[var(--ink-primary)]">{usable.toFixed(1)} GB</strong> (of {hardware.vram_gb} GB physical)
      </span>
    </div>

    <div class="relative mt-3 h-4 w-full overflow-hidden rounded-full bg-[var(--border-subtle)]">
      <div class="flex h-full w-full">
        <div id="bar-weights" class="h-full bg-[var(--accent)] transition-all duration-150" style={weightsStyle} title="Model Weights"></div>
        <div id="bar-kv" class="h-full bg-cyan-500 transition-all duration-150" style={kvStyle} title="KV Cache"></div>
        <div id="bar-overhead" class="h-full bg-[var(--ink-tertiary)] transition-all duration-150" style={overheadStyle} title="Runtime Buffer"></div>
      </div>

      <div
        id="bar-ceiling-marker"
        class="pointer-events-none absolute top-0 bottom-0 w-0.5 bg-[var(--ink-primary)]"
        style={ceilingStyle}
        title={ceilingTitle}
      ></div>
    </div>

    <div id="calc-ram-pool" class="hidden mt-3 border-t border-[var(--border-hairline)] pt-2.5">
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
        <span class="font-semibold text-[var(--ink-primary)]" data-i18n="sim.ramPoolTitle">System RAM Pool (Offloaded Weights + CPU KV + Buffer)</span>
        <span id="calc-ram-pool-text" class="font-mono text-[var(--ink-secondary)] tabular-nums">0.00 GB</span>
      </div>
      <div class="relative mt-2 h-3 w-full overflow-hidden rounded-full bg-[var(--border-subtle)]">
        <div class="flex h-full w-full">
          <div id="calc-ram-bar-weights" class="h-full bg-amber-500 transition-all duration-150" style="width: 0%"></div>
          <div id="calc-ram-bar-kv" class="h-full bg-teal-500 transition-all duration-150" style="width: 0%"></div>
          <div id="calc-ram-bar-overhead" class="h-full bg-[var(--ink-tertiary)] transition-all duration-150" style="width: 0%"></div>
        </div>
        <div id="calc-ram-ceiling-marker" class="pointer-events-none absolute top-0 bottom-0 w-0.5 bg-[var(--ink-primary)]" style="left: 100%"></div>
      </div>
    </div>

    <div id="calc-latency-box" class="mt-3 border-t border-[var(--border-hairline)] pt-2.5">
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
        <span class="font-semibold text-[var(--ink-primary)]" data-i18n="sim.latencyTitle">Per-Token Decode Latency Breakdown</span>
        <span id="calc-latency-total" class="font-mono text-[var(--ink-secondary)] tabular-nums">-- ms/tok</span>
      </div>
      <div class="mt-1.5 flex h-2 w-full overflow-hidden rounded-full bg-[var(--border-subtle)]">
        <div id="calc-lat-bar-gpu" class="h-full bg-[var(--accent)] transition-all duration-150" style="width: 70%"></div>
        <div id="calc-lat-bar-cpu" class="h-full bg-amber-500 transition-all duration-150" style="width: 0%"></div>
        <div id="calc-lat-bar-kv" class="h-full bg-cyan-500 transition-all duration-150" style="width: 20%"></div>
        <div id="calc-lat-bar-pcie" class="h-full bg-violet-500 transition-all duration-150" style="width: 0%"></div>
        <div id="calc-lat-bar-fixed" class="h-full bg-[var(--ink-tertiary)] transition-all duration-150" style="width: 10%"></div>
      </div>
      <div class="mt-1.5 grid grid-cols-2 gap-1.5 sm:grid-cols-5 font-mono text-[11px] text-[var(--ink-secondary)] tabular-nums">
        <div><span class="text-[var(--ink-tertiary)]" data-i18n="sim.latGpuW">GPU W:</span> <strong id="calc-lat-gpu" class="text-[var(--ink-primary)]">--</strong></div>
        <div><span class="text-[var(--ink-tertiary)]" data-i18n="sim.latCpuW">CPU W:</span> <strong id="calc-lat-cpu" class="text-[var(--ink-primary)]">--</strong></div>
        <div><span class="text-[var(--ink-tertiary)]" data-i18n="sim.latKv">KV:</span> <strong id="calc-lat-kv" class="text-[var(--ink-primary)]">--</strong></div>
        <div><span class="text-[var(--ink-tertiary)]" data-i18n="sim.latPcie">PCIe:</span> <strong id="calc-lat-pcie" class="text-[var(--ink-primary)]">--</strong></div>
        <div><span class="text-[var(--ink-tertiary)]" data-i18n="sim.latFixed">Overh.:</span> <strong id="calc-lat-fixed" class="text-[var(--ink-primary)]">--</strong></div>
      </div>
    </div>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-3 text-xs text-[var(--ink-secondary)]">
      <div class="flex flex-wrap items-center gap-4">
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-xs bg-[var(--accent)]"></span>
          <span data-i18n="sim.legendWeights">Weights</span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-xs bg-cyan-500"></span>
          <span data-i18n="sim.legendKv">KV Cache</span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-xs bg-[var(--ink-tertiary)]"></span>
          <span data-i18n="detail.runtimeBuffer">Runtime Buffer</span>
        </span>
        <span id="calc-legend-ceiling" class="inline-flex items-center gap-1.5">
          <span class="h-3 w-0.5 bg-[var(--ink-primary)]"></span>
          Usable Ceiling ({usable.toFixed(1)} GB)
        </span>
      </div>
      <p id="calc-verdict-line" class="font-medium text-[var(--ink-primary)]">
        {initialVerdictLine}
      </p>
    </div>
  </div>

  <!-- Live Synced CLI Preview -->
  <div class="code-card mt-4 flex min-w-0 max-w-full flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0 max-w-full">
      <span id="calc-live-cmd-label" class="text-[11px] font-semibold uppercase tracking-wider text-slate-400" data-i18n="detail.liveFlags">
        Live Flags for Selected Config
      </span>
      <pre id="calc-live-cmd" class="mt-0.5 w-full max-w-full overflow-x-auto rounded font-mono text-xs text-emerald-300 transition-shadow">{initialLiveCmd}</pre>
    </div>
    <button
      type="button"
      data-copy-target="calc-live-cmd"
      data-copy-label="Live runtime command"
      class="inline-flex shrink-0 self-start items-center gap-1.5 rounded-lg border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-semibold text-slate-200 hover:bg-white/20 transition-colors cursor-pointer sm:self-center"
    >
      <span data-copy-icon="copy" aria-hidden="true">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      </span>
      <span data-copy-icon="check" class="hidden" aria-hidden="true">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </span>
      <span data-copy-text data-i18n="detail.copyCommand">Copy Command</span>
    </button>
  </div>

  <!-- Live OOM Rescue Banner -->
  <div id="calc-oom-rescue" class={oomRescueWrapClass}>
    <div class="rounded-xl border border-rose-500/30 bg-rose-500/10 px-4 py-3.5" role="region" aria-label="Out of Memory Recovery Suggestions">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="text-xs leading-relaxed text-rose-800 dark:text-rose-300">
          <strong class="font-bold" data-i18n="detail.oomAlertTitle">Out of Memory Alert:</strong>{' '}
          <span data-i18n="detail.oomAlertDesc" data-i18n-args={oomAlertDescArgs}>
            This format and context exceed {hardware.short_name} usable capacity under the active reserve profile.
          </span>
        </div>
        <div class="flex flex-wrap items-center gap-2 shrink-0">
          <button
            id="calc-reset-btn"
            type="button"
            data-i18n="detail.resetQ48k"
            class="hidden rounded-lg bg-rose-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-rose-700 transition-colors cursor-pointer"
          >
            Reset to Q4_K_M @ 8K
          </button>
          <a
            href={gpuHubHref}
            data-i18n="detail.modelsFitBtn"
            data-i18n-args={modelsFitBtnArgs}
            class="btn-secondary text-xs"
          >
            Models That Fit {hardware.short_name} -&gt;
          </a>
          <a
            href={modelHubHref}
            data-i18n="detail.smoothGpusBtn"
            data-i18n-args={smoothGpusBtnArgs}
            class="btn-secondary text-xs"
          >
            GPUs That Fit {model.short_name} -&gt;
          </a>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" id="calc-config-json" set:html={calcPayload}></script>
</section>

<script>
  import { CustomSelect } from '../utils/customSelect';
  import { onLocaleChange, t, tSpeedTier, tStatus } from '../utils/i18n';
  import {
    buildRuntimeCommand,
    defaultQuantForFormat,
    estimateRigRun,
    formatTpsRange,
    PCIE_LINKS,
    THERMAL_FACTORS,
  } from '../utils/physics';
  import type {
    CpuSpec,
    HardwareSpec,
    KvQuantKey,
    ModelSpec,
    PcieLinkKey,
    QuantKey,
    ReserveProfile,
    RuntimeFormat,
    SpeedTier,
    SplitMode,
    ThermalProfile,
  } from '../types/vram';

  interface CalcPayload {
    model: ModelSpec;
    hardware: HardwareSpec;
    default_quant: QuantKey;
    default_format: RuntimeFormat;
    default_context: number;
    default_kv_quant: KvQuantKey;
    default_gpu_count: number;
    default_sys_ram: number;
  }

  function makeSyntheticCpu(bw: number): CpuSpec {
    return {
      id: 'custom-offload-cpu',
      name: `Host RAM (${bw} GB/s)`,
      short_name: `Host ${bw} GB/s`,
      vendor: 'Host',
      memory_type: 'DDR5/DDR4',
      channels: 2,
      effective_bw_gbps: bw,
      recommended_threads: 16,
      simd: 'AVX2',
      tier: 'Consumer DDR5',
    };
  }

  function initDetailCalculator() {
    const configEl = document.getElementById('calc-config-json');
    if (!configEl) return;
    const cfg = JSON.parse(configEl.textContent || '{}') as CalcPayload;
    const { model, hardware } = cfg;

    let currentFormat: RuntimeFormat = cfg.default_format || 'GGUF';
    let currentQuant: QuantKey = cfg.default_quant || 'Q4_K_M';
    let currentReserve: ReserveProfile = 'desktop';
    let currentCustomUsable: number | null = null;
    let currentContext: number = Number(cfg.default_context || 8192);
    let currentKvQuant: KvQuantKey = cfg.default_kv_quant || 'fp16';
    let currentGpuCount: number = Number(cfg.default_gpu_count || 1);
    let currentSplitMode: SplitMode = 'layer';
    let currentCpuBw = 35;
    let currentSysRam = Number(cfg.default_sys_ram || (hardware.vram_gb >= 24 ? 64 : 32));
    let currentNglOverride: number | null = null;
    let currentPcieLink: PcieLinkKey = 'pcie4_x16';
    let currentThermal: ThermalProfile = 'desktop';
    let currentNkvo = false;

    const slider = document.getElementById('calc-ctx-slider') as HTMLInputElement | null;
    const ctxReadout = document.getElementById('calc-ctx-readout');
    const fmtBtns = Array.from(document.querySelectorAll('[data-fmt-btn]'));
    const reserveBtns = Array.from(document.querySelectorAll('[data-reserve-btn]'));
    const customReserveWrap = document.getElementById('calc-custom-reserve-wrap');
    const customUsableInput = document.getElementById('calc-custom-usable-input') as HTMLInputElement | null;
    const quantWraps = Array.from(document.querySelectorAll('[data-quant-wrap]'));
    const quantBtns = Array.from(document.querySelectorAll('[data-quant-btn]'));
    const kvBtns = Array.from(document.querySelectorAll('[data-kv-btn]'));
    const presetBtns = Array.from(document.querySelectorAll('[data-ctx-preset]'));
    const gpuCountBtns = Array.from(document.querySelectorAll('[data-gpu-count-btn]'));
    const splitBtns = Array.from(document.querySelectorAll('[data-split-btn]'));
    const splitWrap = document.getElementById('calc-split-wrap');
    const ramBtns = Array.from(document.querySelectorAll('[data-calc-ram]'));
    const offloadStrip = document.getElementById('calc-offload-strip');
    const nglAutoBtn = document.getElementById('calc-ngl-auto');
    const nglSlider = document.getElementById('calc-ngl-slider') as HTMLInputElement | null;
    const nglReadout = document.getElementById('calc-ngl-readout');
    const pcieSelect = document.getElementById('calc-pcie-select') as HTMLSelectElement | null;
    const thermalBtns = Array.from(document.querySelectorAll('[data-calc-thermal]'));
    const nkvoCheck = document.getElementById('calc-nkvo-check') as HTMLInputElement | null;
    const cpuSelectRoot = document.getElementById('calc-cpu-select');
    const cpuSelect = cpuSelectRoot
      ? new CustomSelect({
          root: cpuSelectRoot,
          initialValue: '35',
          onChange: (v) => {
            currentCpuBw = Number(v || 35);
            render();
          },
        })
      : null;
    const rigTagEl = document.getElementById('calc-rig-tag');
    const unifiedNoteEl = document.getElementById('calc-unified-note');

    const statusBadge = document.getElementById('calc-status-badge');
    const speedBadge = document.getElementById('calc-speed-badge');
    const totalVramEl = document.getElementById('calc-total-vram');
    const utilPctEl = document.getElementById('calc-util-pct');
    const tpsEl = document.getElementById('calc-tps');
    const tpsRatingEl = document.getElementById('calc-tps-rating');
    const weightsEl = document.getElementById('calc-weights-gb');
    const overheadEl = document.getElementById('calc-overhead-gb');
    const kvEl = document.getElementById('calc-kv-gb');
    const layersEl = document.getElementById('calc-layers');
    const headroomEl = document.getElementById('calc-headroom');
    const ceilingTextEl = document.getElementById('calc-ceiling-text');
    const legendCeilingEl = document.getElementById('calc-legend-ceiling');
    const barWeights = document.getElementById('bar-weights');
    const barKv = document.getElementById('bar-kv');
    const barOverhead = document.getElementById('bar-overhead');
    const barCeiling = document.getElementById('bar-ceiling-marker');
    const ramPoolEl = document.getElementById('calc-ram-pool');
    const ramPoolTextEl = document.getElementById('calc-ram-pool-text');
    const ramBarWeights = document.getElementById('calc-ram-bar-weights');
    const ramBarKv = document.getElementById('calc-ram-bar-kv');
    const ramBarOverhead = document.getElementById('calc-ram-bar-overhead');
    const ramBarCeiling = document.getElementById('calc-ram-ceiling-marker');
    const latencyBox = document.getElementById('calc-latency-box');
    const latencyTotalEl = document.getElementById('calc-latency-total');
    const latBarGpu = document.getElementById('calc-lat-bar-gpu');
    const latBarCpu = document.getElementById('calc-lat-bar-cpu');
    const latBarKv = document.getElementById('calc-lat-bar-kv');
    const latBarPcie = document.getElementById('calc-lat-bar-pcie');
    const latBarFixed = document.getElementById('calc-lat-bar-fixed');
    const latGpuEl = document.getElementById('calc-lat-gpu');
    const latCpuEl = document.getElementById('calc-lat-cpu');
    const latKvEl = document.getElementById('calc-lat-kv');
    const latPcieEl = document.getElementById('calc-lat-pcie');
    const latFixedEl = document.getElementById('calc-lat-fixed');
    const verdictLine = document.getElementById('calc-verdict-line');
    const liveCmdEl = document.getElementById('calc-live-cmd');
    const oomRescueEl = document.getElementById('calc-oom-rescue');
    const resetBtnEl = document.getElementById('calc-reset-btn');
    const tightWarnEl = document.getElementById('calc-tight-warn');
    const tightDescEl = document.getElementById('calc-tight-desc');
    const pcieWarnEl = document.getElementById('calc-pcie-warn');
    const pcieDescEl = document.getElementById('calc-pcie-desc');

    function updateStatusBadge(status: string) {
      if (!statusBadge) return;
      const label = statusBadge.querySelector('[data-status-label]');
      if (label) {
        label.textContent = tStatus(status);
        label.setAttribute('data-i18n-status', status);
      }

      statusBadge.classList.remove('badge-fits', 'badge-tight', 'badge-partial', 'badge-oom');
      if (status === 'Fits') statusBadge.classList.add('badge-fits');
      else if (status === 'Tight Fit') statusBadge.classList.add('badge-tight');
      else if (status === 'Partial Offload') statusBadge.classList.add('badge-partial');
      else statusBadge.classList.add('badge-oom');
    }

    function updateSpeedBadge(tier: SpeedTier) {
      if (!speedBadge) return;
      const label = speedBadge.querySelector('[data-tier-label]');
      if (label) {
        label.textContent = tSpeedTier(tier, true);
        label.setAttribute('data-i18n-tier', tier);
      }
      speedBadge.setAttribute('data-tier', tier);
    }

    function render() {
      const supportsDiscreteOffload = !hardware.is_unified && currentFormat === 'GGUF';
      if (offloadStrip) offloadStrip.classList.toggle('hidden', !supportsDiscreteOffload);
      if (nglAutoBtn) nglAutoBtn.setAttribute('data-active', currentNglOverride === null ? 'true' : 'false');
      if (nglSlider) nglSlider.disabled = !supportsDiscreteOffload;
      if (nkvoCheck) {
        nkvoCheck.checked = currentNkvo;
        nkvoCheck.disabled = !supportsDiscreteOffload;
      }
      if (pcieSelect) pcieSelect.value = currentPcieLink;
      ramBtns.forEach((btn) => {
        btn.setAttribute('data-active', Number(btn.getAttribute('data-calc-ram') || 32) === currentSysRam ? 'true' : 'false');
      });
      thermalBtns.forEach((btn) => {
        btn.setAttribute('data-active', btn.getAttribute('data-calc-thermal') === currentThermal ? 'true' : 'false');
      });

      const r = estimateRigRun({
        model,
        hardware,
        gpuCount: hardware.is_unified ? 1 : currentGpuCount,
        cpu: makeSyntheticCpu(currentCpuBw),
        systemRamGb: hardware.is_unified ? hardware.vram_gb : currentSysRam,
        ramBwOverrideGbps: currentCpuBw,
        pcieLink: currentPcieLink,
        gpuLayersOverride: supportsDiscreteOffload ? currentNglOverride : null,
        kvOffloadToCpu: supportsDiscreteOffload ? currentNkvo : false,
        thermalProfile: currentThermal,
        quant: currentQuant,
        format: currentFormat,
        contextTokens: currentContext,
        kvQuant: currentKvQuant,
        splitMode: currentSplitMode,
        reserveProfile: currentReserve,
        customUsableGb: currentReserve === 'custom' ? currentCustomUsable : null,
      });

      if (nglSlider) nglSlider.value = String(r.gpu_layers_fit);
      if (nglReadout) {
        nglReadout.textContent =
          r.ngl_mode === 'manual'
            ? `${t('sim.nglManual')} (${r.gpu_layers_fit}/${r.total_layers})`
            : `${t('sim.nglAuto')} (${r.gpu_layers_fit}/${r.total_layers})`;
      }

      const usable = r.usable_vram_gb;
      const physTotal = r.raw_vram_gb;
      const ctxK = `${Math.round(currentContext / 1024)}K`;

      if (ctxReadout) {
        ctxReadout.textContent = `${ctxK} (${currentContext.toLocaleString()} tokens)`;
      }

      updateStatusBadge(r.status);
      updateSpeedBadge((r.speed_tier ?? 'Readable') as SpeedTier);

      const gpuUsed = supportsDiscreteOffload ? r.gpu_vram_used_gb : r.total_vram_gb;
      const utilPct = usable > 0 ? Math.round((gpuUsed / usable) * 100) : 0;
      if (totalVramEl) totalVramEl.textContent = `${gpuUsed.toFixed(2)} GB`;
      if (utilPctEl) utilPctEl.textContent = t('detail.utilPct', { pct: utilPct, usable: usable.toFixed(1) });

      if (tpsEl) {
        tpsEl.textContent = formatTpsRange(r.est_tps_low, r.est_tps_high, r.est_tps, r.status);
      }
      if (tpsRatingEl) {
        tpsRatingEl.textContent =
          r.status === 'OOM'
            ? t('speed.oom')
            : r.status === 'Partial Offload'
              ? `${tSpeedTier(r.speed_tier ?? 'Readable', false)} · ${t('speed.formulaOffloadDesc')}`
              : `${tSpeedTier(r.speed_tier ?? 'Readable', false)} · ${t('speed.formulaDesc')}`;
      }
      if (weightsEl) weightsEl.textContent = `${r.weights_gb.toFixed(2)} GB`;
      if (overheadEl) overheadEl.textContent = `+ ${r.overhead_gb.toFixed(2)} GB sys`;
      if (kvEl) kvEl.textContent = `KV Cache: ${r.kv_cache_gb.toFixed(2)} GB (${currentKvQuant.toUpperCase()}${r.kv_offload_to_cpu ? ' · CPU' : ''})`;
      if (layersEl) layersEl.textContent = `${r.gpu_layers_fit} / ${r.total_layers}`;

      if (headroomEl) {
        headroomEl.textContent =
          r.ram_used_gb > 0
            ? t('sim.headroomOffload', { layers: r.total_layers - r.gpu_layers_fit, bw: currentCpuBw })
            : gpuUsed <= usable
              ? t('sim.headroomFree', { gb: Math.max(0, usable - gpuUsed).toFixed(2) })
              : t('detail.overCeiling', {
                  gb: (gpuUsed - usable).toFixed(2),
                  backend: hardware.backend,
                });
      }

      if (ceilingTextEl) {
        ceilingTextEl.textContent = t('detail.usableCeiling', {
          backend: hardware.backend,
          usable: usable.toFixed(1),
          phys: physTotal.toFixed(1),
        });
      }
      if (legendCeilingEl) {
        legendCeilingEl.innerHTML = `<span class="h-3 w-0.5 bg-[var(--ink-primary)]"></span>${t('detail.usableLegend', { usable: usable.toFixed(1) })}`;
      }
      if (rigTagEl) {
        rigTagEl.textContent = `${r.gpu_count}x ${hardware.short_name} · ${usable.toFixed(1)} GB VRAM · ${currentSysRam} GB RAM`;
      }
      if (unifiedNoteEl) {
        unifiedNoteEl.textContent = t('detail.unifiedNote', {
          usable: usable.toFixed(1),
          vram: hardware.vram_gb,
          bw: hardware.bandwidth_gbps,
        });
      }

      const barW = supportsDiscreteOffload ? r.gpu_weights_gb : r.weights_gb;
      const barK = supportsDiscreteOffload ? r.gpu_kv_gb : r.kv_cache_gb;
      const barO = supportsDiscreteOffload && r.gpu_layers_fit === 0 ? 0 : r.overhead_gb;
      const maxScale = Math.max(usable, gpuUsed, 1);
      const wPct = Math.min(100, (barW / maxScale) * 100);
      const kPct = Math.min(100 - wPct, (barK / maxScale) * 100);
      const oPct = Math.min(100 - wPct - kPct, (barO / maxScale) * 100);
      const cPct = Math.min(100, (usable / maxScale) * 100);

      if (barWeights) barWeights.style.width = `${wPct.toFixed(2)}%`;
      if (barKv) barKv.style.width = `${kPct.toFixed(2)}%`;
      if (barOverhead) barOverhead.style.width = `${oPct.toFixed(2)}%`;
      if (barCeiling) barCeiling.style.left = `${cPct.toFixed(2)}%`;

      const showRamPool = !hardware.is_unified && (r.ram_used_gb > 0 || r.oom_reason === 'ram' || r.oom_reason === 'both');
      if (ramPoolEl) ramPoolEl.classList.toggle('hidden', !showRamPool);
      if (showRamPool) {
        const ramOom = r.ram_used_gb > r.available_ram_gb;
        if (ramPoolTextEl) {
          ramPoolTextEl.textContent = `${r.ram_used_gb.toFixed(2)} / ${r.available_ram_gb.toFixed(1)} GB (${currentSysRam} GB RAM · W ${r.cpu_weights_gb.toFixed(1)} + KV ${r.cpu_kv_gb.toFixed(1)} + Buf ${r.cpu_overhead_gb.toFixed(2)})`;
          ramPoolTextEl.classList.toggle('text-rose-600', ramOom);
          ramPoolTextEl.classList.toggle('dark:text-rose-400', ramOom);
        }
        const rMax = Math.max(r.available_ram_gb, r.ram_used_gb, 1);
        const rwPct = Math.min(100, (r.cpu_weights_gb / rMax) * 100);
        const rkPct = Math.min(100 - rwPct, (r.cpu_kv_gb / rMax) * 100);
        const roPct = Math.min(100 - rwPct - rkPct, (r.cpu_overhead_gb / rMax) * 100);
        const rcPct = Math.min(100, (r.available_ram_gb / rMax) * 100);
        if (ramBarWeights) {
          ramBarWeights.style.width = `${rwPct.toFixed(2)}%`;
          ramBarWeights.classList.toggle('bg-rose-500', ramOom);
          ramBarWeights.classList.toggle('bg-amber-500', !ramOom);
        }
        if (ramBarKv) ramBarKv.style.width = `${rkPct.toFixed(2)}%`;
        if (ramBarOverhead) ramBarOverhead.style.width = `${roPct.toFixed(2)}%`;
        if (ramBarCeiling) ramBarCeiling.style.left = `${rcPct.toFixed(2)}%`;
      }

      if (latencyBox && r.latency_ms) {
        const l = r.latency_ms;
        const tot = Math.max(0.01, l.total_ms);
        if (latencyTotalEl) latencyTotalEl.textContent = r.status === 'OOM' ? 'OOM' : `${l.total_ms.toFixed(1)} ms/tok`;
        if (latBarGpu) latBarGpu.style.width = `${Math.min(100, (l.gpu_weights_ms / tot) * 100).toFixed(1)}%`;
        if (latBarCpu) latBarCpu.style.width = `${Math.min(100, (l.cpu_weights_ms / tot) * 100).toFixed(1)}%`;
        if (latBarKv) latBarKv.style.width = `${Math.min(100, (l.kv_read_ms / tot) * 100).toFixed(1)}%`;
        if (latBarPcie) latBarPcie.style.width = `${Math.min(100, (l.pcie_transfer_ms / tot) * 100).toFixed(1)}%`;
        if (latBarFixed) latBarFixed.style.width = `${Math.min(100, (l.fixed_overhead_ms / tot) * 100).toFixed(1)}%`;
        if (latGpuEl) latGpuEl.textContent = `${l.gpu_weights_ms.toFixed(1)} ms`;
        if (latCpuEl) latCpuEl.textContent = `${l.cpu_weights_ms.toFixed(1)} ms`;
        if (latKvEl) latKvEl.textContent = `${l.kv_read_ms.toFixed(1)} ms`;
        if (latPcieEl) latPcieEl.textContent = `${l.pcie_transfer_ms.toFixed(1)} ms`;
        if (latFixedEl) latFixedEl.textContent = `${l.fixed_overhead_ms.toFixed(1)} ms`;
      }

      if (verdictLine) {
        if (r.status === 'Fits' || r.status === 'Tight Fit') {
          verdictLine.textContent = t('detail.verdictGpuSmooth', {
            backend: hardware.backend,
            margin: Math.max(0, usable - gpuUsed).toFixed(2),
          });
        } else if (r.status === 'Partial Offload') {
          if (r.gpu_layers_fit === 0) {
            verdictLine.textContent = t('sim.cpuFallbackNote', {
              ram: r.ram_used_gb.toFixed(2),
              total: r.total_layers,
            });
          } else {
            verdictLine.textContent = t('detail.verdictPartial', {
              fit: r.gpu_layers_fit,
              total: r.total_layers,
              bw: currentCpuBw,
            });
          }
        } else if (r.oom_reason === 'both') {
          verdictLine.textContent = t('sim.oomBoth', {
            gpuUsed: r.gpu_vram_used_gb.toFixed(1),
            gpuMax: usable.toFixed(1),
            ramUsed: r.ram_used_gb.toFixed(1),
            ramMax: r.available_ram_gb.toFixed(1),
          });
        } else if (r.oom_reason === 'ram') {
          verdictLine.textContent = t('sim.oomRam', {
            used: r.ram_used_gb.toFixed(1),
            max: r.available_ram_gb.toFixed(1),
          });
        } else if (r.oom_reason === 'vram') {
          verdictLine.textContent = t('sim.oomVram', {
            used: gpuUsed.toFixed(1),
            max: usable.toFixed(1),
          });
        } else if (r.oom_reason === 'unsupported_offload') {
          verdictLine.textContent = t('sim.oomUnsupported');
        } else {
          const rigPrefix = r.gpu_count > 1 ? `${r.gpu_count}x ${hardware.short_name}` : hardware.short_name;
          verdictLine.textContent = t('detail.verdictOom', {
            req: r.total_vram_gb.toFixed(2),
            rig: rigPrefix,
          });
        }
      }

      if (tightWarnEl && tightDescEl) {
        const showTight = r.status === 'Tight Fit';
        tightWarnEl.classList.toggle('hidden', !showTight);
        if (showTight) {
          tightDescEl.textContent = t('warn.tightFitDesc', {
            gb: Math.max(0, r.headroom_gb ?? usable - gpuUsed).toFixed(2),
          });
        }
      }

      if (pcieWarnEl && pcieDescEl) {
        const showPcie = Boolean(r.comm_warning) && (r.comm_overhead_pct ?? 0) > 0 && r.status !== 'OOM';
        pcieWarnEl.classList.toggle('hidden', !showPcie);
        if (showPcie) {
          pcieDescEl.textContent = t('warn.pcieTpDesc', {
            pct: Math.round(r.comm_overhead_pct ?? 0),
            layers: model.num_layers,
          });
        }
      }

      if (liveCmdEl) {
        const cmd = buildRuntimeCommand({
          model,
          hardware,
          format: currentFormat,
          quant: currentQuant,
          contextTokens: currentContext,
          kvQuant: currentKvQuant,
          gpuCount: r.gpu_count,
          splitMode: currentSplitMode,
          gpuLayersFit: r.gpu_layers_fit,
          fitsVram: r.fits_vram,
          nglMode: r.ngl_mode,
          kvOffloadToCpu: r.kv_offload_to_cpu,
          totalLayers: r.total_layers,
          recommendedThreads: 8,
        });
        liveCmdEl.textContent = cmd.command;
      }

      const defQuant = cfg.default_quant || 'Q4_K_M';
      const defCtx = Number(cfg.default_context || 8192);
      const defGpu = Number(cfg.default_gpu_count || 1);
      const defRam = Number(cfg.default_sys_ram || (hardware.vram_gb >= 24 ? 64 : 32));
      const isModified =
        currentFormat !== 'GGUF' ||
        currentQuant !== defQuant ||
        currentReserve !== 'desktop' ||
        currentContext !== defCtx ||
        currentKvQuant !== 'fp16' ||
        currentGpuCount !== defGpu ||
        currentSplitMode !== 'layer' ||
        currentCpuBw !== 35 ||
        currentSysRam !== defRam ||
        currentNglOverride !== null ||
        currentPcieLink !== 'pcie4_x16' ||
        currentThermal !== 'desktop' ||
        currentNkvo;

      if (oomRescueEl) oomRescueEl.classList.toggle('hidden', r.status !== 'OOM');
      if (resetBtnEl) resetBtnEl.classList.toggle('hidden', !isModified);
      if (splitWrap) splitWrap.classList.toggle('hidden', r.gpu_count <= 1);
      if (customReserveWrap) customReserveWrap.classList.toggle('hidden', currentReserve !== 'custom');

      fmtBtns.forEach((btn) => {
        const active = btn.getAttribute('data-fmt-btn') === currentFormat;
        btn.setAttribute('data-active', active ? 'true' : 'false');
      });

      reserveBtns.forEach((btn) => {
        const active = btn.getAttribute('data-reserve-btn') === currentReserve;
        btn.setAttribute('data-active', active ? 'true' : 'false');
      });

      quantWraps.forEach((wrap) => {
        const matchFmt = wrap.getAttribute('data-quant-wrap') === currentFormat;
        wrap.classList.toggle('hidden', !matchFmt);
      });

      quantBtns.forEach((btn) => {
        const active = btn.getAttribute('data-quant-btn') === currentQuant;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.setAttribute('data-active', active ? 'true' : 'false');
      });

      kvBtns.forEach((btn) => {
        const active = btn.getAttribute('data-kv-btn') === currentKvQuant;
        btn.setAttribute('data-active', active ? 'true' : 'false');
      });

      gpuCountBtns.forEach((btn) => {
        const val = Number(btn.getAttribute('data-gpu-count-btn') || 1);
        btn.setAttribute('data-active', val === currentGpuCount ? 'true' : 'false');
      });

      splitBtns.forEach((btn) => {
        const active = btn.getAttribute('data-split-btn') === currentSplitMode;
        btn.setAttribute('data-active', active ? 'true' : 'false');
      });

      presetBtns.forEach((btn) => {
        const val = Number(btn.getAttribute('data-ctx-preset'));
        btn.setAttribute('data-active', val === currentContext ? 'true' : 'false');
      });
    }

    fmtBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const fmt = (btn.getAttribute('data-fmt-btn') as RuntimeFormat) || 'GGUF';
        currentFormat = fmt;
        currentQuant = defaultQuantForFormat(fmt);
        render();
      });
    });

    reserveBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const prof = (btn.getAttribute('data-reserve-btn') as ReserveProfile) || 'desktop';
        currentReserve = prof;
        if (prof === 'custom' && customUsableInput) {
          currentCustomUsable = Number(customUsableInput.value || hardware.usable_vram_gb);
        }
        render();
      });
    });

    if (customUsableInput) {
      customUsableInput.addEventListener('input', () => {
        const parsed = Number(customUsableInput.value);
        if (!Number.isNaN(parsed) && parsed > 0) {
          currentCustomUsable = parsed;
          currentReserve = 'custom';
          render();
        }
      });
    }

    quantBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentQuant = (btn.getAttribute('data-quant-btn') as QuantKey) || 'Q4_K_M';
        render();
      });
    });

    kvBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentKvQuant = (btn.getAttribute('data-kv-btn') as KvQuantKey) || 'fp16';
        render();
      });
    });

    gpuCountBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentGpuCount = Number(btn.getAttribute('data-gpu-count-btn') || 1);
        render();
      });
    });

    splitBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentSplitMode = (btn.getAttribute('data-split-btn') as SplitMode) || 'layer';
        render();
      });
    });

    if (slider) {
      slider.addEventListener('input', () => {
        currentContext = Number(slider.value);
        render();
      });
    }

    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentContext = Number(btn.getAttribute('data-ctx-preset') || 8192);
        if (slider) slider.value = String(currentContext);
        render();
      });
    });

    ramBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentSysRam = Number(btn.getAttribute('data-calc-ram') || 32);
        render();
      });
    });

    if (nglAutoBtn) {
      nglAutoBtn.addEventListener('click', () => {
        currentNglOverride = null;
        render();
      });
    }

    if (nglSlider) {
      nglSlider.addEventListener('input', () => {
        currentNglOverride = Number(nglSlider.value);
        render();
      });
    }

    if (pcieSelect) {
      pcieSelect.addEventListener('change', () => {
        const v = pcieSelect.value as PcieLinkKey;
        if (v in PCIE_LINKS) currentPcieLink = v;
        render();
      });
    }

    thermalBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tp = btn.getAttribute('data-calc-thermal') as ThermalProfile | null;
        if (tp && tp in THERMAL_FACTORS) {
          currentThermal = tp;
          render();
        }
      });
    });

    if (nkvoCheck) {
      nkvoCheck.addEventListener('change', () => {
        currentNkvo = Boolean(nkvoCheck.checked);
        render();
      });
    }

    if (resetBtnEl) {
      resetBtnEl.addEventListener('click', () => {
        currentFormat = 'GGUF';
        currentQuant = cfg.default_quant || 'Q4_K_M';
        currentReserve = 'desktop';
        currentCustomUsable = null;
        currentContext = Number(cfg.default_context || 8192);
        currentKvQuant = 'fp16';
        currentGpuCount = Number(cfg.default_gpu_count || 1);
        currentSplitMode = 'layer';
        currentCpuBw = 35;
        currentSysRam = Number(cfg.default_sys_ram || (hardware.vram_gb >= 24 ? 64 : 32));
        currentNglOverride = null;
        currentPcieLink = 'pcie4_x16';
        currentThermal = 'desktop';
        currentNkvo = false;
        if (slider) slider.value = String(currentContext);
        cpuSelect?.setValue('35', true);
        render();
      });
    }

    onLocaleChange(() => render());
    render();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDetailCalculator);
  } else {
    initDetailCalculator();
  }
</script>
