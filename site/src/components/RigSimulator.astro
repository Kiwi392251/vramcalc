---
import catalogRaw from '../data/catalog_data.json';
import pagesRaw from '../data/pages_data.json';
import type { CatalogData, VramPageEntry } from '../types/vram';
import {
  classifySpeedTier,
  estimateRigRun,
  formatContextLabel,
  formatTpsRange,
  QUANT_BPW,
} from '../utils/physics';
import ComboboxField from './ComboboxField.astro';
import StatusBadge from './StatusBadge.astro';
import SpeedBadge from './SpeedBadge.astro';

const catalog = catalogRaw as CatalogData;
const curatedEntries = pagesRaw as VramPageEntry[];

const defaultModel =
  catalog.models.find((m) => m.id === 'qwen3-14b') ??
  catalog.models.find((m) => m.id === 'deepseek-r1-14b') ??
  catalog.models[0];
const defaultHw =
  catalog.hardware.find((h) => h.id === 'rtx-4070-12gb') ?? catalog.hardware[0];
const defaultCpu = catalog.cpus[0];
const defaultContext = 8192;
const defaultRam = 32;

const initRes = estimateRigRun({
  model: defaultModel,
  hardware: defaultHw,
  gpuCount: defaultHw.gpu_count ?? 1,
  cpu: defaultCpu,
  systemRamGb: defaultRam,
  quant: 'Q4_K_M',
  format: 'GGUF',
  contextTokens: defaultContext,
  kvQuant: 'fp16',
  splitMode: 'layer',
  reserveProfile: 'desktop',
});

const curatedSlugMap: Record<string, string> = {};
for (const e of curatedEntries) {
  curatedSlugMap[`${e.model.id}::${e.hardware.id}`] = e.slug;
}
const initCuratedSlug = curatedSlugMap[`${defaultModel.id}::${defaultHw.id}`];
const initCuratedHref = initCuratedSlug
  ? `/can-i-run/${initCuratedSlug}/`
  : `/model/${defaultModel.id}/`;
const initCuratedClass = initCuratedSlug
  ? 'badge-accent rounded-full px-3 py-1 text-xs font-semibold hover:opacity-85 transition-opacity'
  : 'hidden badge-accent rounded-full px-3 py-1 text-xs font-semibold hover:opacity-85 transition-opacity';

const initVerdictLine =
  initRes.status === 'Fits' || initRes.status === 'Tight Fit'
    ? `Resident inside ${initRes.usable_vram_gb.toFixed(1)} GB usable GPU memory (${Math.max(0, initRes.usable_vram_gb - initRes.total_vram_gb).toFixed(2)} GB headroom).`
    : initRes.status === 'Partial Offload'
      ? `Remaining layers spill to System RAM (${initRes.spill_ram_gb.toFixed(2)} GB offloaded).`
      : 'OOM: Exceeds memory capacity. Add GPUs, drop quant, compress KV cache, or trim context.';

const payloadJson = JSON.stringify({
  models: catalog.models,
  hardware: catalog.hardware,
  cpus: catalog.cpus,
  curatedSlugs: curatedSlugMap,
  defaults: {
    modelId: defaultModel.id,
    hwId: defaultHw.id,
    cpuId: defaultCpu.id,
    ramGb: defaultRam,
    format: 'GGUF',
    quant: 'Q4_K_M',
    contextTokens: defaultContext,
    kvQuant: 'fp16',
    reserveProfile: 'desktop',
  },
});

const formatTabs = [
  { key: 'GGUF', label: 'GGUF', i18n: 'fmt.ggufShort' },
  { key: 'AWQ', label: 'AWQ / FP8', i18n: 'fmt.awqShort' },
  { key: 'MLX', label: 'MLX', i18n: 'fmt.mlxShort' },
] as const;

const allQuantOptions = [
  { key: 'Q4_K_M', fmt: 'GGUF', bpw: `${QUANT_BPW.Q4_K_M} bpw` },
  { key: 'Q5_K_M', fmt: 'GGUF', bpw: `${QUANT_BPW.Q5_K_M} bpw` },
  { key: 'Q6_K', fmt: 'GGUF', bpw: `${QUANT_BPW.Q6_K} bpw` },
  { key: 'Q8_0', fmt: 'GGUF', bpw: `${QUANT_BPW.Q8_0} bpw` },
  { key: 'FP16', fmt: 'GGUF', bpw: '16.0 bpw' },
  { key: 'AWQ_4BIT', fmt: 'AWQ', bpw: '4.75 bpw' },
  { key: 'FP8', fmt: 'AWQ', bpw: '8.20 bpw' },
  { key: 'MLX_4BIT', fmt: 'MLX', bpw: '4.55 bpw' },
  { key: 'MLX_8BIT', fmt: 'MLX', bpw: '8.25 bpw' },
] as const;

const kvOptions = [
  { key: 'fp16', label: 'FP16 KV' },
  { key: 'q8_0', label: 'Q8_0 (-50%)' },
  { key: 'q4_0', label: 'Q4_0 (-75%)' },
] as const;

const gpuCounts = [1, 2, 3, 4, 6, 8] as const;
const ramOptions = [16, 32, 64, 128, 256, 512] as const;
const contextTicks = [4096, 8192, 16384, 32768, 49152, 65536] as const;

const presets = [
  {
    label: 'A10 24GB (Gemma-3-27B AWQ)',
    mode: 'gpu',
    hw: 'nvidia-a10-24gb',
    gpus: 1,
    split: 'layer',
    fmt: 'AWQ',
    quant: 'AWQ_4BIT',
    cpu: 'amd-epyc-9004-9005-12ch',
    ram: 64,
    model: 'gemma-3-27b',
  },
  {
    label: 'Apple M4 16GB (Qwen3-8B MLX)',
    mode: 'gpu',
    hw: 'apple-m4-16gb',
    gpus: 1,
    split: 'layer',
    fmt: 'MLX',
    quant: 'MLX_4BIT',
    cpu: 'default-ddr4-desktop',
    ram: 16,
    model: 'qwen3-8b',
  },
  {
    label: '2x RTX 4090 (70B Tensor PCIe)',
    mode: 'gpu',
    hw: 'rtx-4090-24gb',
    gpus: 2,
    split: 'tensor',
    fmt: 'GGUF',
    quant: 'Q4_K_M',
    cpu: 'amd-ryzen-7000-9000-ddr5-6000',
    ram: 64,
    model: 'llama-3.3-70b',
  },
  {
    label: '3x GTX 1080 8GB + DDR4',
    mode: 'gpu',
    hw: 'gtx-1080-8gb',
    gpus: 3,
    split: 'layer',
    fmt: 'GGUF',
    quant: 'Q4_K_M',
    cpu: 'intel-core-i5-i7-ddr4',
    ram: 32,
    model: 'mistral-small-24b',
  },
  {
    label: 'EPYC 12-Ch 256GB (CPU-Only)',
    mode: 'cpu',
    hw: 'rtx-4070-12gb',
    gpus: 0,
    split: 'layer',
    fmt: 'GGUF',
    quant: 'Q4_K_M',
    cpu: 'amd-epyc-9004-9005-12ch',
    ram: 256,
    model: 'qwen3-30b-a3b',
  },
  {
    label: 'NVIDIA T4 16GB (Qwen3-8B AWQ)',
    mode: 'gpu',
    hw: 'nvidia-t4-16gb',
    gpus: 1,
    split: 'layer',
    fmt: 'AWQ',
    quant: 'AWQ_4BIT',
    cpu: 'amd-epyc-9004-9005-12ch',
    ram: 32,
    model: 'qwen3-8b',
  },
] as const;

const initTier = initRes.speed_tier ?? classifySpeedTier(initRes.est_tps, initRes.status);
const initTpsText = formatTpsRange(
  initRes.est_tps_low,
  initRes.est_tps_high,
  initRes.est_tps,
  initRes.status,
);
const initCtxLabel = formatContextLabel(defaultContext);
const maxScale = Math.max(initRes.usable_vram_gb, initRes.total_vram_gb, 1);
const wPct = Math.min(100, (initRes.weights_gb / maxScale) * 100);
const kPct = Math.min(100 - wPct, (initRes.kv_cache_gb / maxScale) * 100);
const oPct = Math.min(100 - wPct - kPct, (initRes.overhead_gb / maxScale) * 100);
const cPct = Math.min(100, (initRes.usable_vram_gb / maxScale) * 100);
const wStyle = `width: ${wPct.toFixed(2)}%`;
const kStyle = `width: ${kPct.toFixed(2)}%`;
const oStyle = `width: ${oPct.toFixed(2)}%`;
const sStyle = 'width: 0%';
const cStyle = `left: ${cPct.toFixed(2)}%`;

const simSec1SubArgs = JSON.stringify({ count: catalog.hardware.length });
const simSelectHwArgs = JSON.stringify({ count: catalog.hardware.length });
const simSec2SubArgs = JSON.stringify({ count: catalog.models.length });
const simSelectLlmArgs = JSON.stringify({ count: catalog.models.length });
const simRamNoteArgs = JSON.stringify({
  ram: defaultRam,
  usable: defaultRam - 6,
  reserve: 6,
});
---

<section id="rig-simulator" class="min-w-0 max-w-full space-y-8">
  <!-- Quick Demo Presets + Share Bar -->
  <div class="surface-card flex flex-wrap items-center justify-between gap-3 p-4">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-semibold uppercase tracking-wider text-[var(--ink-tertiary)]" data-i18n="sim.quickPresets">Quick Rig Presets:</span>
      {presets.map((p) => (
        <button
          type="button"
          data-rig-preset
          data-p-mode={p.mode}
          data-p-hw={p.hw}
          data-p-gpus={p.gpus}
          data-p-split={p.split}
          data-p-fmt={p.fmt}
          data-p-quant={p.quant}
          data-p-cpu={p.cpu}
          data-p-ram={p.ram}
          data-p-model={p.model}
          class="rounded-full border border-[var(--border-subtle)] bg-[var(--bg-subtle)] px-3 py-1 text-xs font-medium text-[var(--ink-secondary)] hover:border-[var(--accent-border)] hover:bg-[var(--accent-soft)] hover:text-[var(--accent-ink)] transition-colors cursor-pointer"
        >
          {p.label}
        </button>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <button
        id="sim-copy-url-btn"
        type="button"
        data-copy-url=""
        data-copy-label="Shareable Rig URL"
        class="btn-secondary"
      >
        <span data-copy-icon="copy" aria-hidden="true">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
        </span>
        <span data-copy-icon="check" class="hidden" aria-hidden="true">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
        <span data-copy-text data-i18n="common.shareRigUrl">Share Rig URL</span>
      </button>
      <button
        id="sim-reset-btn"
        type="button"
        data-i18n="common.reset"
        class="btn-secondary text-[var(--ink-secondary)]"
      >
        Reset
      </button>
    </div>
  </div>

  <!-- Main Builder Grid -->
  <div class="grid grid-cols-1 min-w-0 gap-6 lg:grid-cols-12">
    <!-- Left Column: Hardware + CPU/RAM + Custom GPU -->
    <div class="surface-card min-w-0 lg:col-span-6 space-y-5 p-5 sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--border-hairline)] pb-4">
        <div>
          <h2 class="text-base font-bold text-[var(--ink-primary)]" data-i18n="sim.sec1Title">1. Hardware &amp; Multi-GPU Rig</h2>
          <p class="text-xs text-[var(--ink-secondary)]" data-i18n="sim.sec1Sub" data-i18n-args={simSec1SubArgs}>Pick any of {catalog.hardware.length} GPUs (1x–8x), CPU-only, or mixed VRAM.</p>
        </div>
        <div class="seg-track" role="tablist" aria-label="Hardware mode">
          <button type="button" role="tab" data-mode-btn="gpu" data-active="true" data-i18n="sim.modeGpu" class="seg-btn">
            GPU Rig
          </button>
          <button type="button" role="tab" data-mode-btn="cpu" data-active="false" data-i18n="sim.modeCpu" class="seg-btn">
            CPU-Only
          </button>
          <button type="button" role="tab" data-mode-btn="custom" data-active="false" data-i18n="sim.modeCustom" class="seg-btn">
            Custom / Mixed
          </button>
        </div>
      </div>

      <!-- GPU Rig Controls -->
      <div id="sim-panel-gpu" class="space-y-4">
        <ComboboxField
          id="sim-cb-hw"
          label={`Select Hardware (${catalog.hardware.length})`}
          placeholder="Search GPU or Apple Silicon (e.g. 4090, A10, T4, M4 Max)..."
          cascader={true}
          labelI18n="sim.selectHw"
          labelI18nArgs={simSelectHwArgs}
          placeholderI18n="sim.selectHwPh"
        />

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <div class="flex items-center justify-between gap-2">
              <label class="text-[11px] font-semibold uppercase tracking-wider text-[var(--ink-tertiary)]" data-i18n="sim.gpuCountLabel">
                GPU Count (1x – 8x)
              </label>
              <span id="sim-gpu-lock-note" class="text-[11px] text-[var(--ink-tertiary)]" data-i18n="sim.lockReady">Multi-GPU ready</span>
            </div>
            <div class="mt-2 seg-track grid w-full grid-cols-6" role="group" aria-label="GPU count">
              {gpuCounts.map((n) => {
                const active = n === (defaultHw.gpu_count ?? 1);
                return (
                  <button
                    type="button"
                    data-sim-gpu-count={n}
                    data-active={active ? 'true' : 'false'}
                    class="seg-btn font-mono text-xs py-1.5"
                  >
                    {n}x
                  </button>
                );
              })}
            </div>
          </div>

          <div id="sim-split-box">
            <label class="block text-[11px] font-semibold uppercase tracking-wider text-[var(--ink-tertiary)]" data-i18n="sim.splitStrategy">
              Multi-GPU Split Strategy
            </label>
            <div class="mt-2 seg-track grid w-full grid-cols-2">
              <button
                type="button"
                data-sim-split="layer"
                data-active="true"
                data-i18n="sim.layerSplitDefault"
                class="seg-btn py-1.5"
              >
                Layer Split (Default)
              </button>
              <button
                type="button"
                data-sim-split="tensor"
                data-active="false"
                data-i18n="sim.tensorParallel"
                class="seg-btn py-1.5"
              >
                Tensor Parallel
              </button>
            </div>
          </div>
        </div>

        <!-- OS Reserve Profile Controls -->
        <div class="border-t border-[var(--border-hairline)] pt-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-[var(--ink-tertiary)]" data-i18n="reserve.title">
              OS Reserve Profile
            </span>
            <div class="flex flex-wrap items-center gap-2">
              <div class="seg-track" role="group" aria-label="OS reserve profile">
                <button
                  type="button"
                  data-sim-reserve="desktop"
                  data-active="true"
                  data-i18n="reserve.desktop"
                  class="seg-btn text-[11px]"
                >
                  Daily Desktop
                </button>
                <button
                  type="button"
                  data-sim-reserve="clean"
                  data-active="false"
                  data-i18n="reserve.clean"
                  class="seg-btn text-[11px]"
                >
                  Clean OS
                </button>
                <button
                  type="button"
                  data-sim-reserve="custom"
                  data-active="false"
                  data-i18n="reserve.custom"
                  class="seg-btn text-[11px]"
                >
                  Custom GB
                </button>
              </div>

              <div id="sim-custom-reserve-wrap" class="hidden">
                <label class="inline-flex items-center gap-1.5 text-xs">
                  <input
                    id="sim-custom-usable-input"
                    type="number"
                    min="1"
                    max="2048"
                    step="0.5"
                    value={initRes.usable_vram_gb.toFixed(1)}
                    class="field-input w-20 px-2 py-1 font-mono text-xs font-bold"
                  />
                  <span class="font-mono text-[11px] text-[var(--ink-tertiary)]">GB</span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <div id="sim-gpu-summary-pill" class="rounded-xl border border-[var(--accent-border)] bg-[var(--accent-soft)] px-3.5 py-2.5 font-mono text-xs text-[var(--accent-ink)]">
          1x RTX 4070 12GB · 11.5 / 12 GB Usable · 504 GB/s · CUDA
        </div>
      </div>

      <!-- CPU-Only Banner -->
      <div id="sim-panel-cpu-banner" class="hidden rounded-xl border border-amber-500/30 bg-amber-500/10 p-4 text-xs leading-relaxed text-amber-800 dark:text-amber-300" data-i18n="sim.cpuBanner">
        CPU-Only Mode (-ngl 0): Zero discrete GPU required. Model weights &amp; KV cache reside completely in System RAM, streaming at your CPU memory-channel bandwidth below. Great for EPYC/Threadripper or DDR5 systems running MoE models like Qwen3-30B-A3B.
      </div>

      <!-- Custom / Mixed GPU Panel -->
      <div id="sim-panel-custom" class="hidden space-y-4">
        <div class="grid gap-3 sm:grid-cols-12">
          <div class="sm:col-span-3">
            <label for="sim-custom-vram" class="block text-[11px] font-semibold uppercase tracking-wider text-[var(--ink-tertiary)]" data-i18n="sim.customVram">
              Total Usable VRAM (GB)
            </label>
            <input
              id="sim-custom-vram"
              type="number"
              min="2"
              max="2048"
              step="0.5"
              value="36"
              class="field-input mt-1.5 w-full px-3 py-2 font-mono text-sm font-semibold"
            />
          </div>
          <div class="sm:col-span-3">
            <label for="sim-custom-bw" class="block text-[11px] font-semibold uppercase tracking-wider text-[var(--ink-tertiary)]" data-i18n="sim.customBw">
              Effective BW (GB/s)
            </label>
            <input
              id="sim-custom-bw"
              type="number"
              min="20"
              max="8000"
              step="10"
              value="450"
              class="field-input mt-1.5 w-full px-3 py-2 font-mono text-sm font-semibold"
            />
          </div>
          <div class="sm:col-span-6">
            <span class="block text-[11px] font-semibold uppercase tracking-wider text-[var(--ink-tertiary)]" data-i18n="sim.customBackend">
              Backend
            </span>
            <div class="mt-1.5 seg-track grid w-full grid-cols-4" role="group" aria-label="Backend">
              {(['CUDA', 'ROCm', 'Metal', 'Vulkan'] as const).map((b) => (
                <button
                  type="button"
                  data-sim-custom-backend={b}
                  data-active={b === 'CUDA' ? 'true' : 'false'}
                  class="seg-btn font-mono text-[11px] py-2"
                >
                  {b}
                </button>
              ))}
            </div>
          </div>
        </div>
        <label class="inline-flex items-center gap-2 text-xs font-medium text-[var(--ink-secondary)] cursor-pointer">
          <input id="sim-custom-unified" type="checkbox" class="rounded border-[var(--border-strong)] accent-[var(--accent)]" />
          <span data-i18n="sim.customUnified">Treat as Unified Memory architecture (shared OS pool)</span>
        </label>
      </div>

      <!-- Host CPU & System RAM Controls -->
      <div id="sim-cpu-ram-section" class="border-t border-[var(--border-hairline)] pt-4 space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--ink-secondary)]" data-i18n="sim.hostCpuRam">
            Host CPU &amp; System RAM (Offload &amp; CPU-Only Pool)
          </h3>
          <span id="sim-ram-note" class="font-mono text-[11px] text-[var(--ink-tertiary)]" data-i18n="sim.ramNoteDiscrete" data-i18n-args={simRamNoteArgs}>
            32 GB RAM (26 GB usable after 6 GB OS reserve)
          </span>
        </div>

        <div class="grid gap-3 sm:grid-cols-12 items-end">
          <div class="sm:col-span-7">
            <ComboboxField
              id="sim-cb-cpu"
              label="CPU"
              placeholder="Search host CPU (e.g. 9800X3D, 285K, EPYC)..."
              compact={true}
              cascader={true}
              placeholderI18n="sim.selectCpuPh"
            />
          </div>

          <div class="sm:col-span-5 seg-track grid grid-cols-3 sm:grid-cols-6 w-full" role="group" aria-label="System RAM capacity">
            {ramOptions.map((rGb) => {
              const active = rGb === defaultRam;
              return (
                <button
                  type="button"
                  data-sim-ram={rGb}
                  data-active={active ? 'true' : 'false'}
                  class="seg-btn font-mono text-[11px] py-1.5"
                >
                  {rGb}G
                </button>
              );
            })}
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Model, Quant, KV Cache & Context -->
    <div class="surface-card min-w-0 lg:col-span-6 space-y-5 p-5 sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--border-hairline)] pb-4">
        <div>
          <h2 class="text-base font-bold text-[var(--ink-primary)]" data-i18n="sim.sec2Title">2. Model, Quantization &amp; KV Context</h2>
          <p class="text-xs text-[var(--ink-secondary)]" data-i18n="sim.sec2Sub" data-i18n-args={simSec2SubArgs}>All {catalog.models.length} dense &amp; MoE LLMs across 7 GGUF formats and 3 KV cache tiers.</p>
        </div>
        <label class="inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--ink-secondary)] cursor-pointer">
          <input id="sim-custom-model-toggle" type="checkbox" class="rounded border-[var(--border-strong)] accent-[var(--accent)]" />
          <span data-i18n="sim.customModel">Custom Model</span>
        </label>
      </div>

      <div id="sim-model-preset-wrap">
        <ComboboxField
          id="sim-cb-model"
          label={`Select Open-Weight LLM (${catalog.models.length})`}
          placeholder="Search open LLM..."
          cascader={true}
          labelI18n="sim.selectLlm"
          labelI18nArgs={simSelectLlmArgs}
          placeholderI18n="sim.selectModelPh"
        />
      </div>

      <div id="sim-model-custom-wrap" class="hidden">
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
          <div>
            <label for="sim-cm-params" class="block text-[11px] font-semibold text-[var(--ink-secondary)]" data-i18n="sim.cmParams">Params (B)</label>
            <input id="sim-cm-params" type="number" min="0.5" max="1000" step="0.5" value="24" class="field-input mt-1 w-full px-2.5 py-1.5 font-mono text-xs font-bold" />
          </div>
          <div>
            <label for="sim-cm-layers" class="block text-[11px] font-semibold text-[var(--ink-secondary)]" data-i18n="sim.cmLayers">Layers</label>
            <input id="sim-cm-layers" type="number" min="8" max="200" step="1" value="40" class="field-input mt-1 w-full px-2.5 py-1.5 font-mono text-xs font-bold" />
          </div>
          <div>
            <label for="sim-cm-kvheads" class="block text-[11px] font-semibold text-[var(--ink-secondary)]" data-i18n="sim.cmKvHeads">KV Heads</label>
            <input id="sim-cm-kvheads" type="number" min="1" max="128" step="1" value="8" class="field-input mt-1 w-full px-2.5 py-1.5 font-mono text-xs font-bold" />
          </div>
          <div>
            <label for="sim-cm-headdim" class="block text-[11px] font-semibold text-[var(--ink-secondary)]" data-i18n="sim.cmHeadDim">Head Dim</label>
            <input id="sim-cm-headdim" type="number" min="64" max="512" step="64" value="128" class="field-input mt-1 w-full px-2.5 py-1.5 font-mono text-xs font-bold" />
          </div>
        </div>
      </div>

      <!-- Runtime Format & Quantization -->
      <div class="space-y-2.5">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <label class="text-[11px] font-semibold uppercase tracking-wider text-[var(--ink-tertiary)]" data-i18n="sim.weightQuant">
            Runtime Format &amp; Quantization
          </label>
          <div class="seg-track" role="group" aria-label="Runtime format">
            {formatTabs.map((ft) => {
              const active = ft.key === 'GGUF';
              return (
                <button
                  type="button"
                  data-sim-fmt={ft.key}
                  data-active={active ? 'true' : 'false'}
                  data-i18n={ft.i18n}
                  class="seg-btn text-[11px] py-0.5"
                >
                  {ft.label}
                </button>
              );
            })}
          </div>
        </div>

        <div class="surface-inset flex flex-wrap gap-1.5 p-1.5" role="radiogroup" aria-label="Weight quantization">
          {allQuantOptions.map((q) => {
            const active = q.key === 'Q4_K_M';
            const wrapVisible = q.fmt === 'GGUF' ? '' : 'hidden';
            return (
              <div data-sim-quant-wrap={q.fmt} class={wrapVisible}>
                <button
                  type="button"
                  data-sim-quant={q.key}
                  data-sim-quant-fmt={q.fmt}
                  data-active={active ? 'true' : 'false'}
                  class="quant-btn min-w-[78px]"
                >
                  <span class="font-mono text-xs font-bold">{q.key}</span>
                  <span class="quant-sub text-[10px]">{q.bpw}</span>
                </button>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Context Window & KV Cache Quant -->
      <div>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <label for="sim-ctx-slider" class="text-[11px] font-semibold uppercase tracking-wider text-[var(--ink-tertiary)]" data-i18n="sim.ctxAndKv">
            Context Window &amp; KV Cache
          </label>
          <div class="flex flex-wrap items-center gap-2">
            <div class="seg-track" role="group" aria-label="KV cache quantization">
              {kvOptions.map((kv) => {
                const active = kv.key === 'fp16';
                return (
                  <button
                    type="button"
                    data-sim-kv={kv.key}
                    data-active={active ? 'true' : 'false'}
                    class="seg-btn font-mono text-[11px] px-2 py-0.5"
                  >
                    {kv.label}
                  </button>
                );
              })}
            </div>
            <span id="sim-ctx-readout" class="badge-accent rounded-md px-2.5 py-0.5 font-mono text-xs font-bold tabular-nums">
              {initCtxLabel} ({defaultContext.toLocaleString()} tokens)
            </span>
          </div>
        </div>

        <input
          id="sim-ctx-slider"
          type="range"
          min="4096"
          max="65536"
          step="4096"
          value={defaultContext}
          class="vram-slider mt-3"
        />
        <div class="mt-2 flex items-center justify-between gap-1">
          {contextTicks.map((tick) => {
            const active = tick === defaultContext;
            return (
              <button
                type="button"
                data-sim-ctx-preset={tick}
                data-active={active ? 'true' : 'false'}
                class="seg-btn font-mono text-xs px-2 py-1"
              >
                {formatContextLabel(tick)}
              </button>
            );
          })}
        </div>
      </div>
    </div>
  </div>

  <!-- Live Telemetry & Memory Visualization -->
  <section class="surface-card min-w-0 max-w-full p-5 sm:p-7" aria-label="Live Rig Simulation Output">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[var(--border-hairline)] pb-4">
      <div>
        <h2 id="sim-result-headline" class="text-lg font-bold tracking-tight text-[var(--ink-primary)]">
          {defaultModel.name} on 1x {defaultHw.short_name}
        </h2>
        <p id="sim-result-subline" class="mt-0.5 text-sm text-[var(--ink-secondary)]">
          Q4_K_M @ 8K FP16 KV · Host RAM: 32 GB (Default DDR4 · 35 GB/s)
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <a
          id="sim-curated-link"
          href={initCuratedHref}
          data-i18n="sim.readFullGuide"
          class={initCuratedClass}
        >
          Read Full Benchmark Guide -&gt;
        </a>
        <StatusBadge status={initRes.status} size="md" id="sim-status-badge" />
        <SpeedBadge tier={initTier} id="sim-speed-badge" short={true} />
      </div>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="surface-inset p-4">
        <p id="sim-kpi-mem-label" class="text-xs font-medium text-[var(--ink-secondary)]" data-i18n="sim.kpiFootprintVram">Total Footprint vs VRAM</p>
        <div class="mt-1 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
          <span id="sim-total-gb" class="whitespace-nowrap font-mono text-2xl font-bold text-[var(--ink-primary)] tabular-nums">
            {initRes.total_vram_gb.toFixed(2)} GB
          </span>
          <span id="sim-budget-pct" class="whitespace-nowrap font-mono text-xs font-semibold text-[var(--ink-secondary)] tabular-nums">
            of {initRes.usable_vram_gb.toFixed(1)} GB
          </span>
        </div>
        <p id="sim-spill-note" class="mt-1 font-mono text-[11px] text-[var(--ink-tertiary)]">0.00 GB spilled to System RAM</p>
      </div>

      <div class="surface-inset p-4">
        <p class="text-xs font-medium text-[var(--ink-secondary)]" data-i18n="sim.kpiSpeed">Est. Decode Speed (Formula Range)</p>
        <div class="mt-1 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
          <span id="sim-tps" class="whitespace-nowrap font-mono text-2xl font-bold text-[var(--ink-primary)] tabular-nums">
            {initTpsText}
          </span>
        </div>
        <p id="sim-tps-rating" class="mt-1 text-xs text-[var(--ink-secondary)]">{initTier} · Formula Estimate (±15–25%)</p>
      </div>

      <div class="surface-inset p-4">
        <p class="text-xs font-medium text-[var(--ink-secondary)]" data-i18n="sim.kpiWeights">Weights + Sys Buffer</p>
        <div class="mt-1 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
          <span id="sim-weights-gb" class="whitespace-nowrap font-mono text-2xl font-bold text-[var(--ink-primary)] tabular-nums">
            {initRes.weights_gb.toFixed(2)} GB
          </span>
          <span id="sim-overhead-gb" class="whitespace-nowrap font-mono text-xs text-[var(--ink-secondary)] tabular-nums">
            + {initRes.overhead_gb.toFixed(2)} GB
          </span>
        </div>
        <p id="sim-kv-gb" class="mt-1 font-mono text-[11px] text-[var(--ink-secondary)] tabular-nums">
          KV Cache: {initRes.kv_cache_gb.toFixed(2)} GB (FP16)
        </p>
      </div>

      <div class="surface-inset p-4">
        <p class="text-xs font-medium text-[var(--ink-secondary)]" data-i18n="sim.kpiLayers">Layer Placement (GPU / CPU)</p>
        <div class="mt-1 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
          <span id="sim-layers" class="whitespace-nowrap font-mono text-2xl font-bold text-[var(--ink-primary)] tabular-nums">
            {initRes.gpu_layers_fit} / {initRes.total_layers}
          </span>
          <span class="whitespace-nowrap text-xs text-[var(--ink-secondary)]" data-i18n="sim.onGpu">on GPU</span>
        </div>
        <p id="sim-headroom" class="mt-1 text-xs text-[var(--ink-secondary)] tabular-nums">
          {Math.max(0, initRes.usable_vram_gb - initRes.total_vram_gb).toFixed(2)} GB free VRAM headroom
        </p>
      </div>
    </div>

    <!-- Tight Margin Warning -->
    <div id="sim-tight-warn" class="mt-4 hidden" role="note">
      <div class="rounded-xl border border-orange-500/30 bg-orange-500/10 px-4 py-3 text-xs text-orange-800 dark:text-orange-300">
        <strong class="font-bold" data-i18n="warn.tightFitTitle">Tight Margin Warning (&lt;5% / &lt;1 GB free):</strong>{' '}
        <span id="sim-tight-desc"></span>
      </div>
    </div>

    <!-- PCIe All-Reduce Synchronization Warning -->
    <div id="sim-pcie-warn" class="mt-3 hidden" role="note">
      <div class="rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-xs text-amber-800 dark:text-amber-300">
        <strong class="font-bold" data-i18n="warn.pcieTpTitle">PCIe All-Reduce Synchronization Overhead:</strong>{' '}
        <span id="sim-pcie-desc"></span>
      </div>
    </div>

    <!-- Memory Bar with Optional RAM Spill Indicator -->
    <div class="surface-inset mt-6 p-4">
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
        <span class="font-semibold text-[var(--ink-primary)]" data-i18n="sim.memBudgetTitle">Memory Budget Allocation (GPU VRAM + System RAM Offload)</span>
        <span id="sim-ceiling-text" class="font-mono text-[var(--ink-secondary)] tabular-nums">
          Usable VRAM: <strong class="text-[var(--ink-primary)]">{initRes.usable_vram_gb} GB</strong> · Usable RAM: <strong class="text-[var(--ink-primary)]">26 GB</strong>
        </span>
      </div>

      <div class="relative mt-3 h-4 w-full overflow-hidden rounded-full bg-[var(--border-subtle)]">
        <div class="flex h-full w-full">
          <div id="sim-bar-weights" class="h-full bg-[var(--accent)] transition-all duration-150" style={wStyle}></div>
          <div id="sim-bar-kv" class="h-full bg-cyan-500 transition-all duration-150" style={kStyle}></div>
          <div id="sim-bar-overhead" class="h-full bg-[var(--ink-tertiary)] transition-all duration-150" style={oStyle}></div>
          <div id="sim-bar-spill" class="h-full bg-amber-500 transition-all duration-150" style={sStyle}></div>
        </div>
        <div id="sim-bar-ceiling" class="pointer-events-none absolute top-0 bottom-0 w-0.5 bg-[var(--ink-primary)]" style={cStyle}></div>
      </div>

      <div class="mt-3 flex flex-wrap items-center justify-between gap-3 text-xs text-[var(--ink-secondary)]">
        <div class="flex flex-wrap items-center gap-4">
          <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-xs bg-[var(--accent)]"></span><span data-i18n="sim.legendWeights">Weights</span></span>
          <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-xs bg-cyan-500"></span><span data-i18n="sim.legendKv">KV Cache</span></span>
          <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-xs bg-[var(--ink-tertiary)]"></span><span data-i18n="sim.legendBuffer">Buffer</span></span>
          <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-xs bg-amber-500"></span><span data-i18n="sim.legendSpill">RAM Spill</span></span>
        </div>
        <p id="sim-verdict-line" class="font-medium text-[var(--ink-primary)]">
          {initVerdictLine}
        </p>
      </div>
    </div>

    <!-- Live CLI Commands Grid -->
    <div class="mt-5 grid grid-cols-1 min-w-0 gap-3 lg:grid-cols-3">
      <div class="code-card flex min-w-0 max-w-full flex-col justify-between overflow-hidden p-4">
        <div class="flex items-center justify-between gap-2">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Ollama Env Launch</span>
          <button
            type="button"
            data-copy-target="sim-cmd-ollama"
            data-copy-label="Ollama launch command"
            class="inline-flex items-center gap-1 rounded border border-white/15 bg-white/10 px-2 py-0.5 text-[11px] font-semibold text-slate-200 hover:bg-white/20 cursor-pointer"
          >
            <span data-copy-text data-i18n="common.copy">Copy</span>
          </button>
        </div>
        <pre id="sim-cmd-ollama" class="mt-2 w-full max-w-full overflow-x-auto font-mono text-xs text-emerald-300">OLLAMA_FLASH_ATTENTION=1 OLLAMA_NUM_CTX=8192 ollama run qwen3:14b</pre>
      </div>

      <div class="code-card flex min-w-0 max-w-full flex-col justify-between overflow-hidden p-4">
        <div class="flex items-center justify-between gap-2">
          <span id="sim-cmd-primary-label" class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">llama-cli (Interactive)</span>
          <button
            type="button"
            data-copy-target="sim-cmd-cli"
            data-copy-label="Primary launch command"
            class="inline-flex items-center gap-1 rounded border border-white/15 bg-white/10 px-2 py-0.5 text-[11px] font-semibold text-slate-200 hover:bg-white/20 cursor-pointer"
          >
            <span data-copy-text data-i18n="common.copy">Copy</span>
          </button>
        </div>
        <pre id="sim-cmd-cli" class="mt-2 w-full max-w-full overflow-x-auto font-mono text-xs text-sky-300">llama-cli -hf bartowski/Qwen_Qwen3-14B-GGUF:Q4_K_M -ngl 99 -c 8192 -fa on</pre>
      </div>

      <div class="code-card flex min-w-0 max-w-full flex-col justify-between overflow-hidden p-4">
        <div class="flex items-center justify-between gap-2">
          <span id="sim-cmd-alt-label" class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">vLLM / MLX / Server</span>
          <button
            type="button"
            data-copy-target="sim-cmd-srv"
            data-copy-label="Server or alt format command"
            class="inline-flex items-center gap-1 rounded border border-white/15 bg-white/10 px-2 py-0.5 text-[11px] font-semibold text-slate-200 hover:bg-white/20 cursor-pointer"
          >
            <span data-copy-text data-i18n="common.copy">Copy</span>
          </button>
        </div>
        <pre id="sim-cmd-srv" class="mt-2 w-full max-w-full overflow-x-auto font-mono text-xs text-indigo-300">llama-server -hf bartowski/Qwen_Qwen3-14B-GGUF:Q4_K_M -ngl 99 -c 8192 -fa on --host 127.0.0.1 --port 8080</pre>
      </div>
    </div>
  </section>

  <!-- Live Model Catalog Compatibility Scanner -->
  <section class="surface-card min-w-0 max-w-full p-5 sm:p-6" aria-label="Full Model Catalog Compatibility Scan">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 id="sim-scan-title" class="text-lg font-bold tracking-tight text-[var(--ink-primary)]">
          All {catalog.models.length} Models on This Rig (Live Scan)
        </h2>
        <p id="sim-scan-sub" class="mt-0.5 text-sm text-[var(--ink-secondary)]" data-i18n="sim.scanSub">
          Automatically recalculated for selected format, quant, reserve profile, GPU count, and KV tier. Click any row to load above.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter rig scan by status">
        <button type="button" data-scan-status="all" data-active="true" class="pill-filter">
          All ({catalog.models.length})
        </button>
        <button type="button" data-scan-status="Fits" data-active="false" data-i18n="status.fits" class="pill-filter">
          Fits
        </button>
        <button type="button" data-scan-status="Tight Fit" data-active="false" data-i18n="status.tightFit" class="pill-filter">
          Tight Fit
        </button>
        <button type="button" data-scan-status="Partial Offload" data-active="false" data-i18n="status.partialOffload" class="pill-filter">
          Partial Offload
        </button>
        <button type="button" data-scan-status="OOM" data-active="false" data-i18n="status.oom" class="pill-filter">
          OOM
        </button>
      </div>
    </div>

    <div class="table-shell mt-4">
      <table class="w-full min-w-[820px] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-[var(--border-subtle)] bg-[var(--bg-subtle)] text-xs font-semibold uppercase tracking-wider text-[var(--ink-secondary)]">
            <th class="px-4 py-3" data-i18n="sim.colModel">Model</th>
            <th class="px-4 py-3" data-i18n="sim.colStatus">Fit / Speed Tier</th>
            <th class="px-4 py-3" data-i18n="sim.colFootprint">Memory Footprint</th>
            <th class="px-4 py-3" data-i18n="sim.colLayers">GPU Layers</th>
            <th class="px-4 py-3" data-i18n="sim.colSpeed">Est. Range</th>
            <th class="px-4 py-3 text-right" data-i18n="sim.colAction">Action</th>
          </tr>
        </thead>
        <tbody id="sim-scan-tbody" class="divide-y divide-[var(--border-hairline)]"></tbody>
      </table>
    </div>
  </section>

  <script type="application/json" id="rig-sim-data" set:html={payloadJson}></script>
</section>

<script>
  import { SearchableCombobox } from '../utils/combobox';
  import {
    buildCpuCascaderOptions,
    buildHardwareCascaderOptions,
    buildModelCascaderOptions,
  } from '../utils/cascaderOptions';
  import { onLocaleChange, t, tSpeedTier, tStatus } from '../utils/i18n';
  import {
    buildRuntimeCommand,
    defaultQuantForFormat,
    estimateRigRun,
    formatContextLabel,
    formatTpsRange,
    osRamReserveGb,
  } from '../utils/physics';
  import type {
    CompatStatus,
    CpuSpec,
    HardwareBackend,
    HardwareSpec,
    KvQuantKey,
    ModelSpec,
    QuantKey,
    ReserveProfile,
    RuntimeFormat,
    SpeedTier,
    SplitMode,
  } from '../types/vram';

  interface SimPayload {
    models: ModelSpec[];
    hardware: HardwareSpec[];
    cpus: CpuSpec[];
    curatedSlugs: Record<string, string>;
    defaults: {
      modelId: string;
      hwId: string;
      cpuId: string;
      ramGb: number;
      format: RuntimeFormat;
      quant: QuantKey;
      contextTokens: number;
      kvQuant: KvQuantKey;
      reserveProfile: ReserveProfile;
    };
  }

  type RigMode = 'gpu' | 'cpu' | 'custom';

  function statusRank(s: CompatStatus): number {
    if (s === 'Fits') return 0;
    if (s === 'Tight Fit') return 1;
    if (s === 'Partial Offload') return 2;
    return 3;
  }

  function badgeClasses(s: CompatStatus): string {
    if (s === 'Fits') return 'badge-fits';
    if (s === 'Tight Fit') return 'badge-tight';
    if (s === 'Partial Offload') return 'badge-partial';
    return 'badge-oom';
  }

  function setAttrActive(els: Element[], isActive: (el: Element) => boolean) {
    els.forEach((el) => {
      el.setAttribute('data-active', isActive(el) ? 'true' : 'false');
    });
  }

  function initRigSimulator() {
    const dataEl = document.getElementById('rig-sim-data');
    if (!dataEl) return;
    const payload = JSON.parse(dataEl.textContent || '{}') as SimPayload;

    const hwById = new Map(payload.hardware.map((h) => [h.id, h]));
    const modelById = new Map(payload.models.map((m) => [m.id, m]));
    const cpuById = new Map(payload.cpus.map((c) => [c.id, c]));

    let mode: RigMode = 'gpu';
    let hwId = payload.defaults.hwId;
    let modelId = payload.defaults.modelId;
    let cpuId = payload.defaults.cpuId;
    let ramGb = payload.defaults.ramGb;
    let fmt: RuntimeFormat = payload.defaults.format || 'GGUF';
    let quant: QuantKey = payload.defaults.quant || 'Q4_K_M';
    let kvQuant: KvQuantKey = payload.defaults.kvQuant || 'fp16';
    let contextTokens = payload.defaults.contextTokens;
    let reserveProfile: ReserveProfile = payload.defaults.reserveProfile || 'desktop';
    let customUsableGb: number | null = null;
    let customBackend: HardwareBackend = 'CUDA';
    let gpuCount = 1;
    let splitMode: SplitMode = 'layer';
    let useCustomModel = false;
    let scanFilter = 'all';

    const modeBtns = Array.from(document.querySelectorAll('[data-mode-btn]'));
    const panelGpu = document.getElementById('sim-panel-gpu');
    const panelCpuBanner = document.getElementById('sim-panel-cpu-banner');
    const panelCustom = document.getElementById('sim-panel-custom');
    const cpuRamSection = document.getElementById('sim-cpu-ram-section');

    const hwCbRoot = document.getElementById('sim-cb-hw');
    const gpuCountBtns = Array.from(document.querySelectorAll('[data-sim-gpu-count]')) as HTMLButtonElement[];
    const gpuLockNoteEl = document.getElementById('sim-gpu-lock-note');
    const splitBox = document.getElementById('sim-split-box');
    const splitBtns = Array.from(document.querySelectorAll('[data-sim-split]'));
    const reserveBtns = Array.from(document.querySelectorAll('[data-sim-reserve]'));
    const customReserveWrap = document.getElementById('sim-custom-reserve-wrap');
    const customUsableInput = document.getElementById('sim-custom-usable-input') as HTMLInputElement | null;
    const gpuSummaryPill = document.getElementById('sim-gpu-summary-pill');

    const customVramEl = document.getElementById('sim-custom-vram') as HTMLInputElement | null;
    const customBwEl = document.getElementById('sim-custom-bw') as HTMLInputElement | null;
    const customBackendBtns = Array.from(document.querySelectorAll('[data-sim-custom-backend]'));
    const customUnifiedEl = document.getElementById('sim-custom-unified') as HTMLInputElement | null;

    const cpuCbRoot = document.getElementById('sim-cb-cpu');
    const ramBtns = Array.from(document.querySelectorAll('[data-sim-ram]'));
    const ramNoteEl = document.getElementById('sim-ram-note');

    const modelCbRoot = document.getElementById('sim-cb-model');
    const customModelToggle = document.getElementById('sim-custom-model-toggle') as HTMLInputElement | null;
    const modelPresetWrap = document.getElementById('sim-model-preset-wrap');
    const modelCustomWrap = document.getElementById('sim-model-custom-wrap');
    const cmParams = document.getElementById('sim-cm-params') as HTMLInputElement | null;
    const cmLayers = document.getElementById('sim-cm-layers') as HTMLInputElement | null;
    const cmKvHeads = document.getElementById('sim-cm-kvheads') as HTMLInputElement | null;
    const cmHeadDim = document.getElementById('sim-cm-headdim') as HTMLInputElement | null;

    const fmtBtns = Array.from(document.querySelectorAll('[data-sim-fmt]'));
    const quantWraps = Array.from(document.querySelectorAll('[data-sim-quant-wrap]'));
    const quantBtns = Array.from(document.querySelectorAll('[data-sim-quant]'));
    const kvBtns = Array.from(document.querySelectorAll('[data-sim-kv]'));
    const ctxSlider = document.getElementById('sim-ctx-slider') as HTMLInputElement | null;
    const ctxReadout = document.getElementById('sim-ctx-readout');
    const ctxPresetBtns = Array.from(document.querySelectorAll('[data-sim-ctx-preset]'));

    const headlineEl = document.getElementById('sim-result-headline');
    const sublineEl = document.getElementById('sim-result-subline');
    const curatedLinkEl = document.getElementById('sim-curated-link') as HTMLAnchorElement | null;
    const statusBadgeEl = document.getElementById('sim-status-badge');
    const speedBadgeEl = document.getElementById('sim-speed-badge');

    const kpiMemLabelEl = document.getElementById('sim-kpi-mem-label');
    const totalGbEl = document.getElementById('sim-total-gb');
    const budgetPctEl = document.getElementById('sim-budget-pct');
    const spillNoteEl = document.getElementById('sim-spill-note');
    const tpsEl = document.getElementById('sim-tps');
    const tpsRatingEl = document.getElementById('sim-tps-rating');
    const weightsGbEl = document.getElementById('sim-weights-gb');
    const overheadGbEl = document.getElementById('sim-overhead-gb');
    const kvGbEl = document.getElementById('sim-kv-gb');
    const layersEl = document.getElementById('sim-layers');
    const headroomEl = document.getElementById('sim-headroom');
    const ceilingTextEl = document.getElementById('sim-ceiling-text');
    const verdictLineEl = document.getElementById('sim-verdict-line');

    const tightWarnEl = document.getElementById('sim-tight-warn');
    const tightDescEl = document.getElementById('sim-tight-desc');
    const pcieWarnEl = document.getElementById('sim-pcie-warn');
    const pcieDescEl = document.getElementById('sim-pcie-desc');

    const barWeights = document.getElementById('sim-bar-weights');
    const barKv = document.getElementById('sim-bar-kv');
    const barOverhead = document.getElementById('sim-bar-overhead');
    const barSpill = document.getElementById('sim-bar-spill');
    const barCeiling = document.getElementById('sim-bar-ceiling');

    const cmdOllama = document.getElementById('sim-cmd-ollama');
    const cmdPrimaryLabel = document.getElementById('sim-cmd-primary-label');
    const cmdCli = document.getElementById('sim-cmd-cli');
    const cmdAltLabel = document.getElementById('sim-cmd-alt-label');
    const cmdSrv = document.getElementById('sim-cmd-srv');
    const shareBtn = document.getElementById('sim-copy-url-btn');
    const resetBtn = document.getElementById('sim-reset-btn');
    const presetRigBtns = Array.from(document.querySelectorAll('[data-rig-preset]'));

    const scanTitleEl = document.getElementById('sim-scan-title');
    const scanTbody = document.getElementById('sim-scan-tbody');
    const scanFilterBtns = Array.from(document.querySelectorAll('[data-scan-status]'));

    function cascaderLabels(searchKey: 'cb.searchGpuPh' | 'cb.searchCpuPh' | 'cb.searchModelPh') {
      return {
        searchPlaceholder: t(searchKey),
        brandHeader: t('cb.brandCol'),
        seriesHeader: t('cb.seriesCol'),
        modelHeader: t('cb.modelCol'),
        allBrandsLabel: (count: number) => t('cb.allBrands', { count }),
        allSeriesLabel: (count: number) => t('cb.allSeries', { count }),
        itemsCountFormatter: (count: number) => t('cb.countItems', { count }),
      };
    }

    function makeHwOpts() {
      return buildHardwareCascaderOptions({
        hardware: payload.hardware,
        t,
        prefixUnified: false,
        includeCpuOnly: false,
        includeMultiGpu: true,
      });
    }

    function makeCpuOpts() {
      return buildCpuCascaderOptions({
        cpus: payload.cpus,
        t,
        includeUnified: false,
        prefixX86: false,
      });
    }

    function makeModelOpts() {
      return buildModelCascaderOptions({
        models: payload.models,
        t,
        includeAllOption: false,
      });
    }

    const hwCb = hwCbRoot
      ? new SearchableCombobox({
          root: hwCbRoot,
          options: makeHwOpts(),
          mode: 'cascader',
          initialValue: hwId,
          emptyText: t('home.gpuEmpty'),
          ...cascaderLabels('cb.searchGpuPh'),
          onChange: (val) => {
            if (val && hwById.has(val)) {
              hwId = val;
              gpuCount = hwById.get(val)!.gpu_count || 1;
              render();
            }
          },
        })
      : null;

    const cpuCb = cpuCbRoot
      ? new SearchableCombobox({
          root: cpuCbRoot,
          options: makeCpuOpts(),
          mode: 'cascader',
          initialValue: cpuId,
          emptyText: t('home.cpuEmpty'),
          ...cascaderLabels('cb.searchCpuPh'),
          onChange: (val) => {
            if (val && cpuById.has(val)) {
              cpuId = val;
              render();
            }
          },
        })
      : null;

    const modelCb = modelCbRoot
      ? new SearchableCombobox({
          root: modelCbRoot,
          options: makeModelOpts(),
          mode: 'cascader',
          initialValue: modelId,
          emptyText: t('home.modelEmpty'),
          ...cascaderLabels('cb.searchModelPh'),
          onChange: (val) => {
            if (val && modelById.has(val)) {
              modelId = val;
              render();
            }
          },
        })
      : null;

    function getActiveCpu(): CpuSpec {
      return cpuById.get(cpuId) ?? payload.cpus[0];
    }

    function getActiveHardware(): HardwareSpec | null {
      if (mode === 'cpu') return null;
      if (mode === 'custom') {
        const usable = Math.max(1, Number(customVramEl?.value || 36));
        const bw = Math.max(10, Number(customBwEl?.value || 450));
        const backend = customBackend;
        const isUnified = Boolean(customUnifiedEl?.checked);
        return {
          id: 'custom-rig',
          name: `Custom ${usable}GB ${backend}`,
          short_name: `Custom ${usable}GB`,
          vendor: 'NVIDIA',
          series: 'Custom',
          category: 'Multi-GPU',
          gpu_count: 1,
          vram_gb: usable,
          usable_vram_gb: usable,
          bandwidth_gbps: bw,
          memory_type: 'Custom',
          is_unified: isUnified,
          backend,
          msrp_usd: 0,
        };
      }
      return hwById.get(hwId) ?? payload.hardware[0];
    }

    function getActiveModel(): ModelSpec {
      const base = modelById.get(modelId) ?? payload.models[0];
      if (!useCustomModel) return base;
      const p = Math.max(0.5, Number(cmParams?.value || 24));
      const l = Math.max(4, Number(cmLayers?.value || 40));
      const kv = Math.max(1, Number(cmKvHeads?.value || 8));
      const hd = Math.max(32, Number(cmHeadDim?.value || 128));
      return {
        ...base,
        id: 'custom-model',
        name: `Custom ${p}B LLM`,
        short_name: `Custom ${p}B`,
        params_b: p,
        active_params_b: undefined,
        num_layers: l,
        num_kv_heads: kv,
        head_dim: hd,
      };
    }

    function updateStatusBadge(el: HTMLElement | null, status: CompatStatus) {
      if (!el) return;
      const label = el.querySelector('[data-status-label]');
      if (label) {
        label.textContent = tStatus(status);
        label.setAttribute('data-i18n-status', status);
      }
      el.classList.remove('badge-fits', 'badge-tight', 'badge-partial', 'badge-oom');
      el.classList.add(badgeClasses(status));
    }

    function updateSpeedBadge(el: HTMLElement | null, tier: SpeedTier) {
      if (!el) return;
      const label = el.querySelector('[data-tier-label]');
      if (label) {
        label.textContent = tSpeedTier(tier, true);
        label.setAttribute('data-i18n-tier', tier);
      }
      el.setAttribute('data-tier', tier);
    }

    function syncUrl() {
      if (!window.history || !window.history.replaceState) return;
      const params = new URLSearchParams();
      const activeLang = new URLSearchParams(window.location.search).get('lang');
      if (activeLang) params.set('lang', activeLang);
      params.set('mode', mode);
      params.set('model', modelId);
      if (mode === 'gpu') {
        params.set('hw', hwId);
        if (gpuCount > 1) params.set('gpus', String(gpuCount));
        if (gpuCount > 1 && splitMode !== 'layer') params.set('split', splitMode);
      } else if (mode === 'custom') {
        if (customVramEl?.value) params.set('vram', customVramEl.value);
        if (customBwEl?.value) params.set('bw', customBwEl.value);
        if (customBackend) params.set('backend', customBackend);
        if (customUnifiedEl?.checked) params.set('unified', '1');
      }
      params.set('cpu', cpuId);
      params.set('ram', String(ramGb));
      if (fmt !== 'GGUF') params.set('fmt', fmt);
      if (quant !== 'Q4_K_M') params.set('quant', quant);
      if (reserveProfile !== 'desktop') params.set('reserve', reserveProfile);
      if (ctxSlider && Number(ctxSlider.value) !== 8192) params.set('ctx', String(contextTokens));
      if (kvQuant !== 'fp16') params.set('kv', kvQuant);
      const url = `${window.location.pathname}?${params.toString()}`;
      window.history.replaceState(null, '', url);
      if (shareBtn) {
        shareBtn.setAttribute('data-copy-url', `${window.location.origin}${url}`);
      }
    }

    function renderScanner(hw: HardwareSpec | null, cpu: CpuSpec, effGpuCount: number) {
      if (!scanTbody) return;
      const scanResults = payload.models.map((m) => {
        const res = estimateRigRun({
          model: m,
          hardware: hw,
          gpuCount: effGpuCount,
          cpu,
          systemRamGb: hw?.is_unified ? hw.vram_gb : ramGb,
          quant,
          format: fmt,
          contextTokens,
          kvQuant,
          splitMode,
          reserveProfile,
          customUsableGb: reserveProfile === 'custom' ? customUsableGb : null,
        });
        return { model: m, res };
      });

      const fitsCnt = scanResults.filter((x) => x.res.status === 'Fits').length;
      const tightCnt = scanResults.filter((x) => x.res.status === 'Tight Fit').length;
      const partialCnt = scanResults.filter((x) => x.res.status === 'Partial Offload').length;
      const oomCnt = scanResults.filter((x) => x.res.status === 'OOM').length;

      scanFilterBtns.forEach((btn) => {
        const st = btn.getAttribute('data-scan-status') || 'all';
        btn.setAttribute('data-active', st === scanFilter ? 'true' : 'false');

        if (st === 'all') btn.textContent = t('status.allWithCount', { count: scanResults.length });
        else if (st === 'Fits') btn.textContent = t('status.fitsWithCount', { count: fitsCnt });
        else if (st === 'Tight Fit') btn.textContent = t('status.tightWithCount', { count: tightCnt });
        else if (st === 'Partial Offload') btn.textContent = t('status.partialWithCount', { count: partialCnt });
        else if (st === 'OOM') btn.textContent = t('status.oomWithCount', { count: oomCnt });
      });

      const sorted = [...scanResults]
        .filter((x) => scanFilter === 'all' || x.res.status === scanFilter)
        .sort((a, b) => {
          const sr = statusRank(a.res.status) - statusRank(b.res.status);
          if (sr !== 0) return sr;
          if (b.model.params_b !== a.model.params_b) return b.model.params_b - a.model.params_b;
          return b.res.est_tps - a.res.est_tps;
        });

      const budget = hw === null || effGpuCount === 0
        ? Math.max(1, ramGb - osRamReserveGb(ramGb))
        : Math.max(1, scanResults[0]?.res.usable_vram_gb || 1);

      scanTbody.innerHTML = sorted
        .map(({ model: m, res }) => {
          const isSelected = !useCustomModel && m.id === modelId;
          const rowBg = isSelected ? 'bg-[var(--accent-soft)]' : 'hover:bg-[var(--bg-hover)]';
          const moeTag = m.active_params_b ? ` · ${m.active_params_b}B active` : '';
          const tier = (res.speed_tier ?? 'Readable') as SpeedTier;
          const tpsStr = formatTpsRange(res.est_tps_low, res.est_tps_high, res.est_tps, res.status);
          const layerStr = hw === null || effGpuCount === 0 ? `0/${res.total_layers} (CPU)` : `${res.gpu_layers_fit}/${res.total_layers}`;
          const curatedSlug =
            hw && !hw.is_unified && effGpuCount === (hw.gpu_count || 1)
              ? payload.curatedSlugs[`${m.id}::${hw.id}`]
              : hw?.is_unified
                ? payload.curatedSlugs[`${m.id}::${hw.id}`]
                : undefined;

          const guideHtml = curatedSlug
            ? `<a href="/can-i-run/${curatedSlug}/" class="mr-2 text-xs font-semibold text-[var(--accent-ink)] hover:underline">${t('common.fullGuide')}</a>`
            : '';

          return `
            <tr data-scan-pick="${m.id}" class="${rowBg} cursor-pointer transition-colors">
              <td class="px-4 py-3">
                <div class="font-bold text-[var(--ink-primary)]">${m.name}</div>
                <div class="font-mono text-xs text-[var(--ink-tertiary)]">${m.params_b}B${moeTag} · ${m.architecture}</div>
              </td>
              <td class="px-4 py-3">
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="${badgeClasses(res.status)}">
                    <span class="status-dot"></span>
                    ${tStatus(res.status)}
                  </span>
                  <span class="speed-pill">${tSpeedTier(tier, true)}</span>
                </div>
              </td>
              <td class="px-4 py-3 font-mono text-xs text-[var(--ink-primary)] tabular-nums whitespace-nowrap">
                ${res.total_vram_gb.toFixed(2)} / ${budget.toFixed(1)} GB
              </td>
              <td class="px-4 py-3 font-mono text-xs text-[var(--ink-secondary)] tabular-nums whitespace-nowrap">${layerStr}</td>
              <td class="px-4 py-3 font-mono text-xs font-bold ${res.status === 'OOM' ? 'text-rose-600 dark:text-rose-400' : 'text-[var(--ink-primary)]'} tabular-nums whitespace-nowrap">${tpsStr}</td>
              <td class="px-4 py-3 text-right whitespace-nowrap">
                ${guideHtml}
                <button type="button" data-scan-btn="${m.id}" class="btn-secondary px-2.5 py-1 text-xs">
                  ${t('common.load')}
                </button>
              </td>
            </tr>
          `;
        })
        .join('');

      scanTbody.querySelectorAll('[data-scan-pick]').forEach((row) => {
        row.addEventListener('click', (ev) => {
          const target = ev.target as HTMLElement | null;
          if (target && target.closest('a')) return;
          const mid = row.getAttribute('data-scan-pick');
          if (!mid) return;
          useCustomModel = false;
          if (customModelToggle) customModelToggle.checked = false;
          modelId = mid;
          modelCb?.setValue(mid);
          render();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });
    }

    function render() {
      const hw = getActiveHardware();
      const cpu = getActiveCpu();
      const model = getActiveModel();

      const isSingleLocked = Boolean(hw && (hw.is_unified || hw.category === 'Laptop GPU'));
      if (mode === 'gpu' && isSingleLocked) gpuCount = 1;
      const effGpuCount = mode === 'cpu' ? 0 : mode === 'custom' ? 1 : gpuCount;
      const isCpuMode = effGpuCount === 0 || hw === null;

      if (panelGpu) panelGpu.classList.toggle('hidden', mode !== 'gpu');
      if (panelCpuBanner) panelCpuBanner.classList.toggle('hidden', mode !== 'cpu');
      if (panelCustom) panelCustom.classList.toggle('hidden', mode !== 'custom');
      if (cpuRamSection) cpuRamSection.classList.toggle('opacity-50', Boolean(hw?.is_unified && mode === 'gpu'));
      if (modelPresetWrap) modelPresetWrap.classList.toggle('hidden', useCustomModel);
      if (modelCustomWrap) modelCustomWrap.classList.toggle('hidden', !useCustomModel);
      if (customReserveWrap) customReserveWrap.classList.toggle('hidden', reserveProfile !== 'custom');

      setAttrActive(modeBtns, (btn) => btn.getAttribute('data-mode-btn') === mode);

      gpuCountBtns.forEach((btn) => {
        const val = Number(btn.getAttribute('data-sim-gpu-count') || 1);
        const disabled = isSingleLocked && val > 1;
        const active = val === gpuCount;
        btn.disabled = disabled;
        btn.setAttribute('data-active', active ? 'true' : 'false');
        btn.classList.toggle('opacity-40', disabled);
        btn.classList.toggle('cursor-not-allowed', disabled);
      });

      if (gpuLockNoteEl) {
        gpuLockNoteEl.textContent = !hw
          ? t('sim.lockCpu')
          : hw.is_unified
            ? t('sim.lockUnified')
            : hw.category === 'Laptop GPU'
              ? t('sim.lockLaptop')
              : t('sim.lockReady');
      }

      if (splitBox) splitBox.classList.toggle('hidden', effGpuCount <= 1 || Boolean(hw?.is_unified));

      setAttrActive(splitBtns, (btn) => btn.getAttribute('data-sim-split') === splitMode);
      setAttrActive(reserveBtns, (btn) => btn.getAttribute('data-sim-reserve') === reserveProfile);
      setAttrActive(customBackendBtns, (btn) => btn.getAttribute('data-sim-custom-backend') === customBackend);
      setAttrActive(ramBtns, (btn) => Number(btn.getAttribute('data-sim-ram') || 32) === ramGb);
      setAttrActive(fmtBtns, (btn) => btn.getAttribute('data-sim-fmt') === fmt);

      quantWraps.forEach((wrap) => {
        wrap.classList.toggle('hidden', wrap.getAttribute('data-sim-quant-wrap') !== fmt);
      });

      setAttrActive(quantBtns, (btn) => btn.getAttribute('data-sim-quant') === quant);
      setAttrActive(kvBtns, (btn) => btn.getAttribute('data-sim-kv') === kvQuant);
      setAttrActive(ctxPresetBtns, (btn) => Number(btn.getAttribute('data-sim-ctx-preset')) === contextTokens);

      const ctxLabel = formatContextLabel(contextTokens);
      if (ctxReadout) ctxReadout.textContent = `${ctxLabel} (${contextTokens.toLocaleString()} tokens)`;

      const r = estimateRigRun({
        model,
        hardware: hw,
        gpuCount: effGpuCount,
        cpu,
        systemRamGb: hw?.is_unified ? hw.vram_gb : ramGb,
        quant,
        format: fmt,
        contextTokens,
        kvQuant,
        splitMode,
        reserveProfile,
        customUsableGb: reserveProfile === 'custom' ? customUsableGb : null,
      });

      const usableRam = r.available_ram_gb;
      if (ramNoteEl) {
        ramNoteEl.textContent = hw?.is_unified
          ? t('sim.ramNoteUnified', { usable: r.usable_vram_gb.toFixed(1), ram: hw.vram_gb })
          : t('sim.ramNoteDiscrete', { ram: ramGb, usable: usableRam.toFixed(1), reserve: r.os_ram_reserve_gb });
      }

      const rigName =
        mode === 'cpu'
          ? `CPU-Only (${cpu.short_name} · ${ramGb} GB RAM)`
          : mode === 'custom'
            ? `${hw?.name}`
            : effGpuCount > 1
              ? `${effGpuCount}x ${hw?.short_name}`
              : `${hw?.name}`;

      if (gpuSummaryPill && hw && mode === 'gpu') {
        const splitDesc =
          effGpuCount > 1 && !hw.is_unified
            ? ` · ${splitMode === 'tensor' ? t('home.tensorParallel') : t('home.layerSplit')}`
            : '';
        gpuSummaryPill.textContent = `${r.gpu_count}x ${hw.short_name} · ${r.usable_vram_gb.toFixed(1)} / ${r.raw_vram_gb.toFixed(1)} GB · ${hw.bandwidth_gbps} GB/s ${hw.backend}${splitDesc}`;
      }

      if (headlineEl) headlineEl.textContent = `${model.name} ${t('common.onPrefix', { hw: rigName })}`;
      if (sublineEl) {
        const kvDesc = `${kvQuant.toUpperCase()} KV`;
        const hostDesc = hw?.is_unified ? `${hw.memory_type} (${reserveProfile})` : `${cpu.short_name} · ${ramGb} GB RAM`;
        sublineEl.textContent = `${fmt} ${quant} @ ${ctxLabel} (${kvDesc}) · ${hostDesc}`;
      }

      if (curatedLinkEl) {
        const slug =
          !useCustomModel && hw && mode === 'gpu' && effGpuCount === (hw.gpu_count || 1)
            ? payload.curatedSlugs[`${model.id}::${hw.id}`]
            : undefined;
        if (slug) {
          curatedLinkEl.href = `/can-i-run/${slug}/`;
          curatedLinkEl.classList.remove('hidden');
        } else {
          curatedLinkEl.classList.add('hidden');
        }
      }

      updateStatusBadge(statusBadgeEl, r.status);
      updateSpeedBadge(speedBadgeEl, (r.speed_tier ?? 'Readable') as SpeedTier);

      const budget = isCpuMode ? r.available_ram_gb : r.usable_vram_gb;
      if (kpiMemLabelEl) kpiMemLabelEl.textContent = isCpuMode ? t('sim.kpiFootprintRam') : t('sim.kpiFootprintVram');
      if (totalGbEl) totalGbEl.textContent = `${r.total_vram_gb.toFixed(2)} GB`;
      if (budgetPctEl) budgetPctEl.textContent = t('sim.kpiOfBudget', { budget: budget.toFixed(1) });
      if (spillNoteEl) {
        spillNoteEl.textContent = isCpuMode
          ? t('sim.spillCpuOnly', { max: r.available_ram_gb.toFixed(1) })
          : r.spill_ram_gb > 0
            ? t('sim.spillRam', { gb: r.spill_ram_gb.toFixed(2), ram: ramGb })
            : t('sim.spillZero');
      }

      if (tpsEl) tpsEl.textContent = formatTpsRange(r.est_tps_low, r.est_tps_high, r.est_tps, r.status);
      if (tpsRatingEl) {
        tpsRatingEl.textContent =
          r.status === 'OOM'
            ? t('speed.oom')
            : `${tSpeedTier(r.speed_tier ?? 'Readable', false)} · ${t('speed.formulaDesc')}`;
      }
      if (weightsGbEl) weightsGbEl.textContent = `${r.weights_gb.toFixed(2)} GB`;
      if (overheadGbEl) overheadGbEl.textContent = `+ ${r.overhead_gb.toFixed(2)} GB`;
      if (kvGbEl) kvGbEl.textContent = `KV Cache: ${r.kv_cache_gb.toFixed(2)} GB (${kvQuant.toUpperCase()})`;
      if (layersEl) {
        layersEl.textContent = isCpuMode ? `0 / ${r.total_layers}` : `${r.gpu_layers_fit} / ${r.total_layers}`;
      }
      if (headroomEl) {
        headroomEl.textContent =
          r.status === 'OOM'
            ? t('speed.oom')
            : r.spill_ram_gb > 0
              ? t('sim.headroomOffload', { layers: r.total_layers - r.gpu_layers_fit, bw: cpu.effective_bw_gbps })
              : t('sim.headroomFree', { gb: Math.max(0, budget - r.total_vram_gb).toFixed(2) });
      }

      if (ceilingTextEl) {
        ceilingTextEl.textContent = isCpuMode
          ? t('sim.ceilingCpu', { usable: r.available_ram_gb.toFixed(1), ram: ramGb })
          : t('sim.ceilingGpu', { usable: r.usable_vram_gb.toFixed(1), ram: usableRam.toFixed(1) });
      }

      if (tightWarnEl && tightDescEl) {
        const showTight = r.status === 'Tight Fit';
        tightWarnEl.classList.toggle('hidden', !showTight);
        if (showTight) {
          tightDescEl.textContent = t('warn.tightFitDesc', {
            gb: Math.max(0, r.headroom_gb ?? budget - r.total_vram_gb).toFixed(2),
          });
        }
      }

      if (pcieWarnEl && pcieDescEl) {
        const showPcie = Boolean(r.comm_warning) && (r.comm_overhead_pct ?? 0) > 0 && r.status !== 'OOM';
        pcieWarnEl.classList.toggle('hidden', !showPcie);
        if (showPcie) {
          pcieDescEl.textContent = t('warn.pcieTpDesc', {
            pct: Math.round(r.comm_overhead_pct ?? 0),
            layers: model.num_layers,
          });
        }
      }

      const maxScale = Math.max(budget, r.total_vram_gb, 1);
      const gpuPortion = isCpuMode ? r.total_vram_gb : Math.min(r.total_vram_gb, budget);
      const spillPortion = isCpuMode ? 0 : Math.max(0, r.total_vram_gb - budget);
      const baseScale = Math.max(r.weights_gb + r.kv_cache_gb + r.overhead_gb, 0.01);
      const fitRatio = gpuPortion / baseScale;

      const wPct = Math.min(100, ((r.weights_gb * fitRatio) / maxScale) * 100);
      const kPct = Math.min(100 - wPct, ((r.kv_cache_gb * fitRatio) / maxScale) * 100);
      const oPct = Math.min(100 - wPct - kPct, ((r.overhead_gb * fitRatio) / maxScale) * 100);
      const spPct = Math.min(100 - wPct - kPct - oPct, (spillPortion / maxScale) * 100);
      const cPct = Math.min(100, (budget / maxScale) * 100);

      if (barWeights) barWeights.style.width = `${wPct.toFixed(2)}%`;
      if (barKv) barKv.style.width = `${kPct.toFixed(2)}%`;
      if (barOverhead) barOverhead.style.width = `${oPct.toFixed(2)}%`;
      if (barSpill) barSpill.style.width = `${spPct.toFixed(2)}%`;
      if (barCeiling) barCeiling.style.left = `${cPct.toFixed(2)}%`;

      if (verdictLineEl) {
        if (r.status === 'Fits' || r.status === 'Tight Fit') {
          verdictLineEl.textContent = t('sim.verdictGpuSmooth', {
            usable: r.usable_vram_gb.toFixed(1),
            margin: Math.max(0, r.headroom_gb ?? budget - r.total_vram_gb).toFixed(2),
          });
        } else if (r.status === 'Partial Offload') {
          verdictLineEl.textContent = isCpuMode
            ? t('sim.verdictCpuSmooth', {
                usable: r.available_ram_gb.toFixed(1),
                tps: formatTpsRange(r.est_tps_low, r.est_tps_high, r.est_tps, r.status),
              })
            : t('sim.verdictPartial', { gb: r.spill_ram_gb.toFixed(2) });
        } else {
          verdictLineEl.textContent = t('sim.verdictOom');
        }
      }

      const cmdRes = buildRuntimeCommand({
        model,
        hardware: hw,
        format: fmt,
        quant,
        contextTokens,
        kvQuant,
        gpuCount: r.gpu_count,
        splitMode,
        gpuLayersFit: r.gpu_layers_fit,
        fitsVram: r.fits_vram,
      });

      const ngl = isCpuMode ? 0 : r.fits_vram ? 99 : Math.max(1, r.gpu_layers_fit);
      const splitFlag = r.gpu_count > 1 && splitMode === 'tensor' ? ' -sm row' : '';
      const kvLlamaFlag = kvQuant === 'fp16' ? '' : ` --cache-type-k ${kvQuant} --cache-type-v ${kvQuant}`;
      const threadFlag = isCpuMode || r.spill_ram_gb > 0 ? ` -t ${cpu.recommended_threads}` : '';
      const ollamaGpuEnv = isCpuMode ? 'OLLAMA_NUM_GPU=0 ' : '';
      const ollamaKvEnv = kvQuant === 'fp16' ? 'OLLAMA_FLASH_ATTENTION=1 ' : `OLLAMA_FLASH_ATTENTION=1 OLLAMA_KV_CACHE_TYPE=${kvQuant} `;

      if (cmdOllama) {
        cmdOllama.textContent = `${ollamaGpuEnv}${ollamaKvEnv}OLLAMA_NUM_CTX=${contextTokens} ollama run ${model.ollama_tag}`;
      }
      if (cmdPrimaryLabel) cmdPrimaryLabel.textContent = cmdRes.primaryLabel;
      if (cmdCli) cmdCli.textContent = cmdRes.command;
      if (cmdAltLabel) {
        cmdAltLabel.textContent = fmt === 'AWQ' ? 'llama-cli Fallback' : fmt === 'MLX' ? 'vLLM AWQ Equivalent' : 'llama-server / API';
      }
      if (cmdSrv) {
        if (fmt === 'AWQ') {
          cmdSrv.textContent = `llama-cli -hf ${model.hf_repo}:Q4_K_M -ngl ${ngl} -c ${contextTokens} -fa on${splitFlag}${kvLlamaFlag}${threadFlag}`;
        } else if (fmt === 'MLX') {
          const awqRepo = model.awq_repo || model.hf_repo.replace('-GGUF', '-AWQ');
          cmdSrv.textContent = `vllm serve ${awqRepo} --quantization awq --max-model-len ${contextTokens}`;
        } else {
          cmdSrv.textContent = `llama-server -hf ${model.hf_repo}:${quant} -ngl ${ngl} -c ${contextTokens} -fa on${splitFlag}${kvLlamaFlag}${threadFlag} --host 127.0.0.1 --port 8080`;
        }
      }

      if (scanTitleEl) {
        scanTitleEl.textContent = t('sim.scanTitle', { count: payload.models.length, rig: rigName });
      }

      renderScanner(hw, cpu, effGpuCount);
      syncUrl();
    }

    function hydrateFromUrl() {
      const p = new URLSearchParams(window.location.search);
      const mParam = p.get('mode') as RigMode | null;
      const hwParam = p.get('hw');
      const gpusParam = p.get('gpus');
      const splitParam = p.get('split');
      const cpuParam = p.get('cpu');
      const ramParam = p.get('ram');
      const vramParam = p.get('vram');
      const bwParam = p.get('bw');
      const backendParam = p.get('backend');
      const unifiedParam = p.get('unified');
      const modParam = p.get('model');
      const fmtParam = p.get('fmt') as RuntimeFormat | null;
      const quantParam = p.get('quant') as QuantKey | null;
      const resParam = p.get('reserve') as ReserveProfile | null;
      const ctxParam = p.get('ctx');
      const kvParam = p.get('kv');

      if (mParam && ['gpu', 'cpu', 'custom'].includes(mParam)) mode = mParam;
      if (hwParam && hwById.has(hwParam)) {
        hwId = hwParam;
        hwCb?.setValue(hwParam);
        gpuCount = hwById.get(hwParam)!.gpu_count || 1;
      }
      if (gpusParam && [0, 1, 2, 3, 4, 6, 8].includes(Number(gpusParam))) {
        const gNum = Number(gpusParam);
        if (gNum === 0) mode = 'cpu';
        else gpuCount = gNum;
      }
      if (splitParam === 'tensor' || splitParam === 'row') splitMode = 'tensor';
      else if (splitParam === 'layer') splitMode = 'layer';
      if (cpuParam && cpuById.has(cpuParam)) {
        cpuId = cpuParam;
        cpuCb?.setValue(cpuParam);
      }
      if (ramParam) {
        const rNum = Math.round(Number(ramParam));
        if (Number.isFinite(rNum) && rNum >= 4 && rNum <= 2048) ramGb = rNum;
      }
      if (vramParam && customVramEl) {
        const vNum = Number(vramParam);
        if (Number.isFinite(vNum) && vNum >= 2 && vNum <= 2048) customVramEl.value = String(vNum);
      }
      if (bwParam && customBwEl) {
        const bNum = Number(bwParam);
        if (Number.isFinite(bNum) && bNum >= 20 && bNum <= 8000) customBwEl.value = String(bNum);
      }
      if (backendParam && ['CUDA', 'Metal', 'ROCm', 'Vulkan'].includes(backendParam)) {
        customBackend = backendParam as HardwareBackend;
      }
      if (unifiedParam && customUnifiedEl) {
        customUnifiedEl.checked = unifiedParam === '1' || unifiedParam === 'true';
      }
      if (modParam && modelById.has(modParam)) {
        modelId = modParam;
        modelCb?.setValue(modParam);
      }
      if (fmtParam && ['GGUF', 'AWQ', 'MLX'].includes(fmtParam)) {
        fmt = fmtParam;
        quant = defaultQuantForFormat(fmtParam);
      }
      if (quantParam && ['Q4_K_M', 'Q5_K_M', 'Q6_K', 'Q8_0', 'FP16', 'AWQ_4BIT', 'FP8', 'MLX_4BIT', 'MLX_8BIT'].includes(quantParam)) {
        quant = quantParam;
      }
      if (resParam && ['desktop', 'clean', 'custom'].includes(resParam)) {
        reserveProfile = resParam;
      }
      if (ctxParam && Number(ctxParam) >= 4096 && Number(ctxParam) <= 65536) {
        contextTokens = Number(ctxParam);
        if (ctxSlider) ctxSlider.value = String(contextTokens);
      }
      if (kvParam) {
        const normKv = kvParam.toLowerCase();
        if (normKv === 'fp16' || normKv === 'q8_0' || normKv === 'q4_0') kvQuant = normKv;
      }
    }

    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        mode = (btn.getAttribute('data-mode-btn') as RigMode) || 'gpu';
        render();
      });
    });

    gpuCountBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        gpuCount = Number(btn.getAttribute('data-sim-gpu-count') || 1);
        render();
      });
    });

    splitBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        splitMode = (btn.getAttribute('data-sim-split') as SplitMode) || 'layer';
        render();
      });
    });

    reserveBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const p = (btn.getAttribute('data-sim-reserve') as ReserveProfile) || 'desktop';
        reserveProfile = p;
        if (p === 'custom' && customUsableInput) {
          customUsableGb = Number(customUsableInput.value || 16);
        }
        render();
      });
    });

    if (customUsableInput) {
      customUsableInput.addEventListener('input', () => {
        const parsed = Number(customUsableInput.value);
        if (!Number.isNaN(parsed) && parsed > 0) {
          customUsableGb = parsed;
          reserveProfile = 'custom';
          render();
        }
      });
    }

    customBackendBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const b = btn.getAttribute('data-sim-custom-backend') as HardwareBackend | null;
        if (!b) return;
        customBackend = b;
        render();
      });
    });

    ramBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        ramGb = Number(btn.getAttribute('data-sim-ram') || 32);
        render();
      });
    });

    [customVramEl, customBwEl, customUnifiedEl].forEach((el) => {
      if (el) {
        el.addEventListener('input', render);
        el.addEventListener('change', render);
      }
    });

    if (customModelToggle) {
      customModelToggle.addEventListener('change', () => {
        useCustomModel = customModelToggle.checked;
        render();
      });
    }

    [cmParams, cmLayers, cmKvHeads, cmHeadDim].forEach((el) => {
      if (el) el.addEventListener('input', render);
    });

    fmtBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const chosen = (btn.getAttribute('data-sim-fmt') as RuntimeFormat) || 'GGUF';
        fmt = chosen;
        quant = defaultQuantForFormat(chosen);
        render();
      });
    });

    quantBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        quant = (btn.getAttribute('data-sim-quant') as QuantKey) || 'Q4_K_M';
        render();
      });
    });

    kvBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        kvQuant = (btn.getAttribute('data-sim-kv') as KvQuantKey) || 'fp16';
        render();
      });
    });

    if (ctxSlider) {
      ctxSlider.addEventListener('input', () => {
        contextTokens = Number(ctxSlider.value);
        render();
      });
    }

    ctxPresetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        contextTokens = Number(btn.getAttribute('data-sim-ctx-preset') || 8192);
        if (ctxSlider) ctxSlider.value = String(contextTokens);
        render();
      });
    });

    scanFilterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-scan-status') || 'all';
        scanFilter = raw === 'Smooth' ? 'Fits' : raw;
        render();
      });
    });

    presetRigBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        mode = (btn.getAttribute('data-p-mode') as RigMode) || 'gpu';
        const pHw = btn.getAttribute('data-p-hw');
        if (pHw && hwById.has(pHw)) {
          hwId = pHw;
          hwCb?.setValue(pHw);
        }
        gpuCount = Number(btn.getAttribute('data-p-gpus') || 1);
        splitMode = (btn.getAttribute('data-p-split') as SplitMode) || 'layer';
        const pFmt = (btn.getAttribute('data-p-fmt') as RuntimeFormat) || 'GGUF';
        fmt = pFmt;
        quant = (btn.getAttribute('data-p-quant') as QuantKey) || defaultQuantForFormat(pFmt);
        const pCpu = btn.getAttribute('data-p-cpu');
        if (pCpu && cpuById.has(pCpu)) {
          cpuId = pCpu;
          cpuCb?.setValue(pCpu);
        }
        ramGb = Number(btn.getAttribute('data-p-ram') || 32);
        const pMod = btn.getAttribute('data-p-model');
        if (pMod && modelById.has(pMod)) {
          modelId = pMod;
          modelCb?.setValue(pMod);
        }
        useCustomModel = false;
        if (customModelToggle) customModelToggle.checked = false;
        render();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        mode = 'gpu';
        hwId = payload.defaults.hwId;
        modelId = payload.defaults.modelId;
        cpuId = payload.defaults.cpuId;
        ramGb = payload.defaults.ramGb;
        fmt = payload.defaults.format || 'GGUF';
        quant = payload.defaults.quant || 'Q4_K_M';
        kvQuant = payload.defaults.kvQuant || 'fp16';
        reserveProfile = payload.defaults.reserveProfile || 'desktop';
        customUsableGb = null;
        customBackend = 'CUDA';
        contextTokens = payload.defaults.contextTokens;
        gpuCount = hwById.get(hwId)?.gpu_count || 1;
        splitMode = 'layer';
        useCustomModel = false;
        scanFilter = 'all';
        hwCb?.setValue(hwId);
        modelCb?.setValue(modelId);
        cpuCb?.setValue(cpuId);
        if (ctxSlider) ctxSlider.value = String(contextTokens);
        if (customModelToggle) customModelToggle.checked = false;
        render();
      });
    }

    onLocaleChange(() => {
      if (hwCb) {
        hwCb.setOptions(makeHwOpts(), true);
        hwCb.setEmptyText(t('home.gpuEmpty'));
        hwCb.setPlaceholder(t('sim.selectHwPh'));
        hwCb.setCascaderLabels(cascaderLabels('cb.searchGpuPh'));
      }
      if (cpuCb) {
        cpuCb.setOptions(makeCpuOpts(), true);
        cpuCb.setEmptyText(t('home.cpuEmpty'));
        cpuCb.setPlaceholder(t('sim.selectCpuPh'));
        cpuCb.setCascaderLabels(cascaderLabels('cb.searchCpuPh'));
      }
      if (modelCb) {
        modelCb.setOptions(makeModelOpts(), true);
        modelCb.setEmptyText(t('home.modelEmpty'));
        modelCb.setPlaceholder(t('sim.selectModelPh'));
        modelCb.setCascaderLabels(cascaderLabels('cb.searchModelPh'));
      }
      render();
    });

    hydrateFromUrl();
    render();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRigSimulator);
  } else {
    initRigSimulator();
  }
</script>
