---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import catalogRaw from '../data/catalog_data.json';
import rawPagesData from '../data/pages_data.json';
import type { CatalogData, PageEntry } from '../types/vram';
import { groupCatalogHardware, statusRank } from '../utils/hubs';

const PAGE_SIZE = 24;
const catalog = catalogRaw as CatalogData;
const rawEntries = rawPagesData as PageEntry[];

function featuredTier(e: PageEntry): number {
  const hid = e.hardware.id;
  if (hid.startsWith('apple-m1-8gb') || hid.startsWith('apple-m1-16gb')) return 2;
  return 0;
}

const entries = [...rawEntries].sort((a, b) => {
  const sr = statusRank(a.default_result.status) - statusRank(b.default_result.status);
  if (sr !== 0) return sr;
  const ft = featuredTier(a) - featuredTier(b);
  if (ft !== 0) return ft;
  if (b.model.params_b !== a.model.params_b) return b.model.params_b - a.model.params_b;
  if (b.default_result.est_tps !== a.default_result.est_tps) {
    return b.default_result.est_tps - a.default_result.est_tps;
  }
  return a.slug.localeCompare(b.slug);
});

const totalCount = entries.length;
const initialVisibleCount = Math.min(PAGE_SIZE, totalCount);
const initialRemainingCount = Math.max(0, totalCount - initialVisibleCount);
const initialProgressPct = totalCount > 0 ? Math.round((initialVisibleCount / totalCount) * 100) : 100;
const initialProgressStyle = `width: ${initialProgressPct}%`;
const paginationHiddenClass =
  initialRemainingCount > 0
    ? 'mt-7 rounded-2xl border border-slate-200 bg-white p-4 sm:p-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between'
    : 'hidden';
const smoothCount = entries.filter((e) => e.default_result.status === 'Smooth').length;
const partialCount = entries.filter((e) => e.default_result.status === 'Partial Offload').length;

// Full catalog lists for filter dropdowns & live calculations
const allModelsSorted = [...catalog.models].sort((a, b) => a.name.localeCompare(b.name));
const allHardwareSorted = [...catalog.hardware];
const catalogGroups = groupCatalogHardware(allHardwareSorted);

const uniqueHubModels = Array.from(
  new Map(entries.map((e) => [e.model.id, e.model])).values()
).sort((a, b) => a.name.localeCompare(b.name));

const uniqueHubHardware = Array.from(
  new Map(entries.map((e) => [e.hardware.id, e.hardware])).values()
).sort((a, b) => a.name.localeCompare(b.name));

const uniqueHubModelCount = uniqueHubModels.length;
const uniqueHubHwCount = uniqueHubHardware.length;
const catalogModelCount = catalog.models.length;
const catalogHwCount = catalog.hardware.length;

const curatedKeys = entries.map((e) => `${e.model.id}::${e.hardware.id}`);
const homeCatalogPayload = JSON.stringify({
  models: catalog.models,
  hardware: catalog.hardware,
  curatedKeys,
});

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'VRAMCalc.me',
  url: 'https://vramcalc.me/',
  description:
    'Local AI LLM VRAM calculator and inference tokens/sec estimator across NVIDIA RTX, Apple Silicon, AMD Radeon, Intel Arc, Multi-GPU rigs, and CPU/RAM.',
};

const homeCollectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Local AI Model VRAM & Inference Speed Matrix',
  url: 'https://vramcalc.me/',
  description: `Compatibility matrix indexing ${totalCount} deep benchmark guides and live calculations across ${catalogHwCount} GPUs (1x-8x) and ${catalogModelCount} open-weight models.`,
  hasPart: [
    {
      '@type': 'CollectionPage',
      name: 'Multi-GPU & CPU/RAM Rig Simulator',
      url: 'https://vramcalc.me/calculator/',
    },
    {
      '@type': 'CollectionPage',
      name: `All Local AI GPUs (${uniqueHubHwCount} Hardware Hubs)`,
      url: 'https://vramcalc.me/gpu/',
    },
    {
      '@type': 'CollectionPage',
      name: `All Open-Weight LLMs (${uniqueHubModelCount} Model Hubs)`,
      url: 'https://vramcalc.me/model/',
    },
  ],
};
const homeOgTitle = `Local AI LLM VRAM & Speed Calculator (${catalogModelCount} Models × ${catalogHwCount} GPUs) | VRAMCalc.me`;
const homeOgDescription = `Check exact 7-tier quant (Q2_K–FP16) VRAM, 1x–8x Multi-GPU & CPU/RAM tok/s across ${catalogHwCount} GPUs & Macs and ${catalogModelCount} open LLMs.`;
---

<BaseLayout
  title="VRAMCalc.me — Local AI Model VRAM & Speed Calculator"
  description="Check whether DeepSeek-R1, Qwen3, Qwen2.5-Coder, Gemma 3, and Llama run smoothly on Apple Silicon M1–M5, NVIDIA GTX/RTX (1x–8x), AMD Radeon / Strix Halo, Intel Arc, or CPU RAM."
  canonicalPath="/"
  totalPages={totalCount}
  ogTitle={homeOgTitle}
  ogDescription={homeOgDescription}
  ogImage="/og/home.png"
  ogImageAlt={homeOgTitle}
  themeColor="#2563eb"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(homeCollectionSchema)} />
  </Fragment>

  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12">
      <div class="max-w-3xl">
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl">
          Local AI Model VRAM &amp; Inference Speed Matrix
        </h1>
        <p class="mt-3 text-base leading-relaxed text-slate-600">
          Pick any of <strong class="text-slate-900">{catalogModelCount} models</strong> and{' '}
          <strong class="text-slate-900">{catalogHwCount} GPUs &amp; Macs</strong>—or simulate{' '}
          <strong class="text-slate-900">1x–8x multi-GPU rigs &amp; CPU/RAM offload</strong> across 7 GGUF quants
          (<span class="font-mono text-slate-900">Q2_K–FP16</span>) and realistic{' '}
          <span class="font-mono text-slate-900">tokens/sec</span> throughput.
        </p>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <a
            href="/calculator/"
            class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-4 py-2 text-xs font-semibold text-white hover:bg-blue-700 transition-colors"
          >
            Multi-GPU &amp; CPU Rig Simulator -&gt;
          </a>
          <a
            href="/gpu/"
            class="inline-flex items-center gap-1.5 rounded-lg bg-slate-950 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800 transition-colors"
          >
            Browse {uniqueHubHwCount} GPU Hubs -&gt;
          </a>
          <a
            href="/model/"
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-4 py-2 text-xs font-semibold text-slate-800 hover:border-blue-300 hover:bg-blue-50 hover:text-blue-700 transition-colors"
          >
            Browse {uniqueHubModelCount} Model Hubs -&gt;
          </a>
        </div>
      </div>

      <dl class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
        <div class="rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-3">
          <dt class="text-xs font-medium text-slate-500">Full Benchmark Guides</dt>
          <dd class="mt-1 font-mono text-2xl font-bold text-slate-950 tabular-nums">{totalCount}</dd>
        </div>
        <div class="rounded-xl border border-emerald-200/80 bg-emerald-50/50 px-4 py-3">
          <dt class="text-xs font-medium text-emerald-800">Smooth Guides (8K Q4)</dt>
          <dd class="mt-1 font-mono text-2xl font-bold text-emerald-900 tabular-nums">{smoothCount}</dd>
        </div>
        <div class="rounded-xl border border-amber-200/80 bg-amber-50/50 px-4 py-3">
          <dt class="text-xs font-medium text-amber-800">Partial Offload Guides</dt>
          <dd class="mt-1 font-mono text-2xl font-bold text-amber-900 tabular-nums">{partialCount}</dd>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-3">
          <dt class="text-xs font-medium text-slate-500">Live Catalog Engine</dt>
          <dd class="mt-1 font-mono text-2xl font-bold text-slate-950 tabular-nums">
            {catalogModelCount} × {catalogHwCount}
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Filter Controls + Compatibility Matrix -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs sm:p-5">
      <div class="grid gap-3 md:grid-cols-12 md:items-end">
        <div class="md:col-span-3">
          <label for="filter-model" class="block text-xs font-semibold uppercase tracking-wider text-slate-500">
            Filter by Model
          </label>
          <select
            id="filter-model"
            class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-900 focus:border-blue-600 focus:outline-none"
          >
            <option value="all">All Models ({catalogModelCount})</option>
            {allModelsSorted.map((m) => (
              <option value={m.id}>{m.name} ({m.params_b}B)</option>
            ))}
          </select>
        </div>

        <div class="md:col-span-3">
          <label for="filter-hardware" class="block text-xs font-semibold uppercase tracking-wider text-slate-500">
            Filter by Hardware
          </label>
          <select
            id="filter-hardware"
            class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-900 focus:border-blue-600 focus:outline-none"
          >
            <option value="all">All Hardware ({catalogHwCount} + CPU)</option>
            <option value="cpu-only">CPU-Only (System RAM · No GPU)</option>
            {catalogGroups.map((group) => (
              <optgroup label={group.label}>
                {group.items.map((h) => (
                  <option value={h.id}>{h.name}</option>
                ))}
              </optgroup>
            ))}
          </select>
        </div>

        <div class="md:col-span-4">
          <label for="filter-search" class="block text-xs font-semibold uppercase tracking-wider text-slate-500">
            Quick Search
          </label>
          <div class="relative mt-1.5">
            <input
              id="filter-search"
              type="search"
              placeholder="e.g. m4 16g, 1080, p40, b580, qwen3..."
              class="w-full rounded-lg border border-slate-300 bg-white py-2 pl-3 pr-10 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-none"
            />
            <kbd
              aria-hidden="true"
              title="Press / to focus search"
              class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 rounded border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-mono text-[10px] font-semibold text-slate-400"
            >
              /
            </kbd>
          </div>
        </div>

        <div class="md:col-span-2">
          <label for="filter-sort" class="block text-xs font-semibold uppercase tracking-wider text-slate-500">
            Sort By
          </label>
          <select
            id="filter-sort"
            class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-900 focus:border-blue-600 focus:outline-none"
          >
            <option value="featured">Recommended</option>
            <option value="tps-desc">Fastest tok/s</option>
            <option value="vram-asc">Lowest VRAM</option>
            <option value="params-desc">Largest Model</option>
          </select>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-3.5">
        <div class="flex flex-wrap items-center gap-3">
          <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter by status">
            {(['all', 'Smooth', 'Partial Offload', 'OOM'] as const).map((st) => {
              const btnClass =
                st === 'all'
                  ? 'rounded-full border px-3 py-1 text-xs font-semibold transition-colors cursor-pointer border-slate-900 bg-slate-900 text-white'
                  : 'rounded-full border px-3 py-1 text-xs font-semibold transition-colors cursor-pointer border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100';
              return (
                <button
                  type="button"
                  data-status-btn={st}
                  class={btnClass}
                >
                  {st === 'all' ? 'All Statuses' : st}
                </button>
              );
            })}
          </div>

          <span class="hidden h-4 w-px bg-slate-200 sm:inline-block" aria-hidden="true"></span>

          <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter by vendor">
            {(['all', 'NVIDIA', 'Apple', 'AMD', 'Intel'] as const).map((vnd) => {
              const vBtnClass =
                vnd === 'all'
                  ? 'rounded-full border px-3 py-1 text-xs font-semibold transition-colors cursor-pointer border-blue-600 bg-blue-600 text-white'
                  : 'rounded-full border px-3 py-1 text-xs font-semibold transition-colors cursor-pointer border-slate-200 bg-white text-slate-700 hover:bg-slate-100';
              return (
                <button
                  type="button"
                  data-vendor-btn={vnd}
                  class={vBtnClass}
                >
                  {vnd === 'all' ? 'All Vendors' : vnd}
                </button>
              );
            })}
          </div>
        </div>

        <div class="flex items-center gap-3 text-xs text-slate-600">
          <span id="filter-count" class="font-mono tabular-nums">
            Showing {initialVisibleCount} of {totalCount} full guides ({catalogModelCount}×{catalogHwCount} live)
          </span>
          <button
            id="filter-reset"
            type="button"
            class="hidden font-semibold text-blue-600 hover:text-blue-800 cursor-pointer"
          >
            Reset
          </button>
        </div>
      </div>
    </div>

    <!-- Curated Deep-Dive Cards Grid (SSR Progressive Window: first 24 visible, all 141 crawlable in DOM) -->
    <div id="cards-grid" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry, idx) => {
        const res = entry.default_result;
        const usable = entry.hardware.usable_vram_gb;
        const fillPct = Math.min(100, Math.round((res.total_vram_gb / usable) * 100));
        const barColor =
          res.status === 'Smooth'
            ? 'bg-emerald-500'
            : res.status === 'Partial Offload'
              ? 'bg-amber-500'
              : 'bg-rose-500';
        const tpsDisplay = res.status === 'OOM' ? 'OOM' : `${res.est_tps.toFixed(1)} tok/s`;
        const fillStyle = `width: ${fillPct}%`;
        const fillBarClass = `h-full rounded-full ${barColor}`;
        const detailHref = `/can-i-run/${entry.slug}/`;
        const rank = statusRank(res.status);
        const hiddenClass = idx >= PAGE_SIZE ? ' hidden' : '';
        const cardClass = `matrix-card group flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 transition-all hover:border-blue-300 hover:shadow-md${hiddenClass}`;
        const searchIndex = [
          entry.model.name,
          entry.model.short_name,
          entry.model.family,
          entry.hardware.id,
          entry.hardware.name,
          entry.hardware.short_name,
          entry.hardware.vendor,
          entry.hardware.series,
          entry.hardware.category || '',
          entry.hardware.backend,
          entry.hardware.memory_type,
          res.status,
        ]
          .join(' ')
          .toLowerCase();

        return (
          <article
            data-card
            data-index={idx}
            data-tps={res.est_tps}
            data-vram={res.total_vram_gb}
            data-params={entry.model.params_b}
            data-status-rank={rank}
            data-model={entry.model.id}
            data-hardware={entry.hardware.id}
            data-vendor={entry.hardware.vendor}
            data-status={res.status}
            data-search={searchIndex}
            class={cardClass}
          >
            <div>
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-1.5">
                  <StatusBadge status={res.status} />
                  <span class="rounded bg-blue-50 px-1.5 py-0.5 text-[10px] font-semibold text-blue-700">
                    Full Guide
                  </span>
                </div>
                <span class="rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[11px] font-semibold text-slate-600">
                  {entry.hardware.backend} · {entry.hardware.bandwidth_gbps} GB/s
                </span>
              </div>

              <h2 class="mt-3.5 text-base font-bold tracking-tight text-slate-950 group-hover:text-blue-600 transition-colors">
                <a href={detailHref} class="focus:outline-none">
                  {entry.model.short_name}
                  <span class="block text-sm font-semibold text-slate-600">
                    on {entry.hardware.name}
                  </span>
                </a>
              </h2>

              <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-slate-600">
                {entry.verdict_summary}
              </p>
            </div>

            <div class="mt-4 pt-4 border-t border-slate-100">
              <div class="flex items-center justify-between text-xs">
                <span class="text-slate-500">VRAM ({entry.default_quant} @ 8K)</span>
                <span class="font-mono font-semibold text-slate-900 tabular-nums">
                  {res.total_vram_gb.toFixed(1)} / {usable} GB
                </span>
              </div>
              <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-slate-100">
                <div class={fillBarClass} style={fillStyle}></div>
              </div>

              <div class="mt-3.5 flex items-center justify-between">
                <div class="flex items-baseline gap-1.5">
                  <span class="font-mono text-lg font-bold text-slate-950 tabular-nums">
                    {tpsDisplay}
                  </span>
                  <span class="text-[11px] text-slate-500 tabular-nums">
                    ({res.gpu_layers_fit}/{res.total_layers} layers)
                  </span>
                </div>

                <a
                  href={detailHref}
                  class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-800"
                >
                  Open Calc
                  <span aria-hidden="true">-&gt;</span>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Progressive Pagination Controls (Curated Guides) -->
    <div id="pagination-bar" class={paginationHiddenClass}>
      <div class="w-full sm:max-w-xs">
        <p id="pagination-summary" class="font-mono text-xs font-medium text-slate-600 tabular-nums">
          Viewing {initialVisibleCount} of {totalCount} matching guides
        </p>
        <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-slate-100">
          <div
            id="pagination-bar-fill"
            class="h-full rounded-full bg-blue-600 transition-all duration-200"
            style={initialProgressStyle}
          ></div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 shrink-0">
        <button
          id="load-more-btn"
          type="button"
          class="rounded-lg bg-slate-950 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800 transition-colors cursor-pointer"
        >
          Load 24 More ({initialRemainingCount} left)
        </button>
        <button
          id="show-all-btn"
          type="button"
          class="rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 hover:border-blue-300 hover:text-blue-700 transition-colors cursor-pointer"
        >
          Show All Remaining
        </button>
      </div>
    </div>

    <!-- Live Full-Catalog Calculations (Populated when searching/filtering catalog hardware, models, Intel, or CPU) -->
    <section id="live-calc-section" class="mt-8 hidden" aria-label="Live Catalog Estimates">
      <div class="flex flex-col gap-3 rounded-2xl border border-blue-200 bg-blue-50/60 p-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-blue-600 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-white">
              Live Catalog Physics
            </span>
            <h2 id="live-calc-heading" class="text-sm font-bold text-slate-950">
              Additional Live Catalog Estimates
            </h2>
          </div>
          <p id="live-calc-sub" class="mt-1 text-xs text-slate-600">
            Instant Q4_K_M @ 8K estimates across all {catalogModelCount} models &amp; {catalogHwCount} GPUs. Click any card to tweak 7 quants, KV cache, multi-GPU, or CPU offload.
          </p>
        </div>
        <a
          id="live-sim-cta"
          href="/calculator/"
          class="inline-flex shrink-0 items-center justify-center rounded-lg bg-blue-600 px-3.5 py-2 text-xs font-semibold text-white hover:bg-blue-700 transition-colors"
        >
          Open in Multi-GPU / CPU Simulator -&gt;
        </a>
      </div>

      <div id="live-calc-grid" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>

      <div id="live-pagination-bar" class="mt-5 hidden flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-xs">
        <span id="live-pagination-summary" class="font-mono text-slate-600 tabular-nums"></span>
        <button
          id="live-load-more-btn"
          type="button"
          class="rounded-lg bg-slate-900 px-3.5 py-1.5 font-semibold text-white hover:bg-slate-800 cursor-pointer"
        >
          Load More Live Estimates
        </button>
      </div>
    </section>

    <!-- Empty Filter State -->
    <div
      id="empty-state"
      class="mt-8 hidden rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center"
    >
      <p class="text-base font-semibold text-slate-900">No matching Model × Hardware configurations</p>
      <p class="mt-1 text-sm text-slate-500">
        Try clearing your search query or launch the custom Rig Simulator to model custom VRAM &amp; CPU setups.
      </p>
      <div class="mt-4 flex flex-wrap justify-center gap-2">
        <button
          id="empty-reset-btn"
          type="button"
          class="rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800 cursor-pointer"
        >
          Reset All Filters
        </button>
        <a
          href="/calculator/"
          class="rounded-lg border border-blue-200 bg-blue-50 px-4 py-2 text-xs font-semibold text-blue-700 hover:bg-blue-100"
        >
          Open Custom Rig Simulator -&gt;
        </a>
      </div>
    </div>

    <script type="application/json" id="home-catalog-json" set:html={homeCatalogPayload}></script>
  </section>

  <!-- Aggregation Hubs Discovery -->
  <section class="mx-auto max-w-6xl px-4 pt-6 sm:px-6" aria-labelledby="hubs-heading">
    <h2 id="hubs-heading" class="sr-only">Browse GPU and Model Aggregation Hubs</h2>
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
        <div class="flex items-center justify-between gap-2">
          <h3 class="text-sm font-bold tracking-tight text-slate-950">
            Model Hubs ({uniqueHubModelCount})
          </h3>
          <a href="/model/" class="text-xs font-semibold text-blue-600 hover:text-blue-800">
            View All -&gt;
          </a>
        </div>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {uniqueHubModels.map((m) => {
            const mHref = `/model/${m.id}/`;
            return (
              <a
                href={mHref}
                class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-700 hover:border-blue-300 hover:bg-blue-50 hover:text-blue-700 transition-colors"
              >
                {m.short_name}
              </a>
            );
          })}
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
        <div class="flex items-center justify-between gap-2">
          <h3 class="text-sm font-bold tracking-tight text-slate-950">
            Hardware Hubs ({uniqueHubHwCount})
          </h3>
          <a href="/gpu/" class="text-xs font-semibold text-blue-600 hover:text-blue-800">
            View All -&gt;
          </a>
        </div>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {uniqueHubHardware.map((h) => {
            const hHref = `/gpu/${h.id}/`;
            return (
              <a
                href={hHref}
                class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-700 hover:border-blue-300 hover:bg-blue-50 hover:text-blue-700 transition-colors"
              >
                {h.short_name}
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- Estimation Formula & Methodology -->
  <section id="methodology" class="mx-auto max-w-6xl px-4 pt-6 sm:px-6">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
      <h2 class="text-lg font-bold tracking-tight text-slate-950">
        How VRAMCalc.me Estimates Memory &amp; Tokens/sec
      </h2>
      <div class="mt-4 grid gap-6 text-sm leading-relaxed text-slate-600 md:grid-cols-3">
        <div>
          <h3 class="font-semibold text-slate-900">1. 7-Tier GGUF &amp; MoE Math</h3>
          <p class="mt-1.5">
            Total weights scale from <span class="font-mono text-xs text-slate-800">Q2_K (3.0 bpw)</span> through{' '}
            <span class="font-mono text-xs text-slate-800">Q4_K_M (4.85)</span>,{' '}
            <span class="font-mono text-xs text-slate-800">Q8_0 (8.50)</span> to{' '}
            <span class="font-mono text-xs text-slate-800">FP16</span>, while MoE models compute speed using active parameters.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-slate-900">2. GQA KV-Cache Compression</h3>
          <p class="mt-1.5">
            KV cache uses exact layer geometry (<span class="font-mono text-xs text-slate-800">2 × layers × kv_heads × head_dim × ctx</span>)
            with FP16, Q8_0 (-50%), or Q4_0 (-75%) KV options.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-slate-900">3. Multi-GPU &amp; CPU/RAM Bandwith</h3>
          <p class="mt-1.5">
            Smooth runs scale by CUDA/Metal/ROCm/Vulkan efficiency and Layer-Split or Tensor-Parallel scaling across{' '}
            <span class="font-mono text-xs text-slate-800">1x–8x GPUs</span>; spill/CPU-only uses selected DDR4/DDR5/EPYC RAM speed.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { estimateRigRun } from '../utils/physics';
  import type { CatalogData, CompatStatus, HardwareSpec, ModelSpec, RigRunEstimate } from '../types/vram';

  interface HomeCatalogPayload {
    models: ModelSpec[];
    hardware: HardwareSpec[];
    curatedKeys: string[];
  }

  interface LiveItem {
    model: ModelSpec;
    hw: HardwareSpec | null;
    res: RigRunEstimate;
    rank: number;
    simHref: string;
  }

  function rankOf(s: CompatStatus): number {
    if (s === 'Smooth') return 0;
    if (s === 'Partial Offload') return 1;
    return 2;
  }

  function badgeClasses(s: CompatStatus): string {
    if (s === 'Smooth') return 'border-emerald-200 bg-emerald-50 text-emerald-800';
    if (s === 'Partial Offload') return 'border-amber-200 bg-amber-50 text-amber-800';
    return 'border-rose-200 bg-rose-50 text-rose-800';
  }

  function dotClass(s: CompatStatus): string {
    if (s === 'Smooth') return 'bg-emerald-600';
    if (s === 'Partial Offload') return 'bg-amber-500';
    return 'bg-rose-600';
  }

  function initMatrixPage() {
    const PAGE_SIZE = 24;
    const modelSelect = document.getElementById('filter-model') as HTMLSelectElement | null;
    const hwSelect = document.getElementById('filter-hardware') as HTMLSelectElement | null;
    const searchInput = document.getElementById('filter-search') as HTMLInputElement | null;
    const sortSelect = document.getElementById('filter-sort') as HTMLSelectElement | null;
    const statusButtons = Array.from(document.querySelectorAll('[data-status-btn]'));
    const vendorButtons = Array.from(document.querySelectorAll('[data-vendor-btn]'));
    const cards = Array.from(document.querySelectorAll('[data-card]'));
    const countEl = document.getElementById('filter-count');
    const resetBtn = document.getElementById('filter-reset');
    const emptyState = document.getElementById('empty-state');
    const emptyResetBtn = document.getElementById('empty-reset-btn');
    const cardsGrid = document.getElementById('cards-grid');
    const paginationBar = document.getElementById('pagination-bar');
    const paginationSummary = document.getElementById('pagination-summary');
    const paginationFill = document.getElementById('pagination-bar-fill') as HTMLElement | null;
    const loadMoreBtn = document.getElementById('load-more-btn');
    const showAllBtn = document.getElementById('show-all-btn');

    const liveSection = document.getElementById('live-calc-section');
    const liveHeading = document.getElementById('live-calc-heading');
    const liveSub = document.getElementById('live-calc-sub');
    const liveSimCta = document.getElementById('live-sim-cta') as HTMLAnchorElement | null;
    const liveGrid = document.getElementById('live-calc-grid');
    const livePagBar = document.getElementById('live-pagination-bar');
    const livePagSummary = document.getElementById('live-pagination-summary');
    const liveLoadMoreBtn = document.getElementById('live-load-more-btn');

    const catalogEl = document.getElementById('home-catalog-json');
    const catData: HomeCatalogPayload = catalogEl
      ? (JSON.parse(catalogEl.textContent || '{}') as HomeCatalogPayload)
      : { models: [], hardware: [], curatedKeys: [] };
    const curatedKeySet = new Set(catData.curatedKeys || []);

    let selectedStatus = 'all';
    let selectedVendor = 'all';
    let visibleLimit = PAGE_SIZE;
    let liveVisibleLimit = PAGE_SIZE;
    let currentSort = 'featured';
    const totalCurated = cards.length;
    const totalCombinations = catData.models.length * catData.hardware.length;

    // Precompute normalized search blobs for models & hardware
    const modelSearchMap = new Map<string, string>();
    for (const m of catData.models) {
      modelSearchMap.set(
        m.id,
        [m.id, m.name, m.short_name, m.family, m.architecture].join(' ').toLowerCase(),
      );
    }
    const hwSearchMap = new Map<string, string>();
    for (const h of catData.hardware) {
      hwSearchMap.set(
        h.id,
        [h.id, h.name, h.short_name, h.vendor, h.series, h.category || '', h.backend, h.memory_type]
          .join(' ')
          .toLowerCase(),
      );
    }

    function updateStatusPills() {
      statusButtons.forEach((b) => {
        const active = (b.getAttribute('data-status-btn') || 'all') === selectedStatus;
        b.classList.toggle('border-slate-900', active);
        b.classList.toggle('bg-slate-900', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('border-slate-200', !active);
        b.classList.toggle('bg-slate-50', !active);
        b.classList.toggle('text-slate-700', !active);
      });
    }

    function updateVendorPills() {
      vendorButtons.forEach((b) => {
        const active = (b.getAttribute('data-vendor-btn') || 'all') === selectedVendor;
        b.classList.toggle('border-blue-600', active);
        b.classList.toggle('bg-blue-600', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('border-slate-200', !active);
        b.classList.toggle('bg-white', !active);
        b.classList.toggle('text-slate-700', !active);
      });
    }

    function sortCardsInDom(sortMode: string) {
      if (!cardsGrid) return;
      const sorted = [...cards].sort((a, b) => {
        if (sortMode === 'tps-desc') {
          const td = Number(b.getAttribute('data-tps') || 0) - Number(a.getAttribute('data-tps') || 0);
          if (td !== 0) return td;
          return Number(a.getAttribute('data-status-rank') || 0) - Number(b.getAttribute('data-status-rank') || 0);
        }
        if (sortMode === 'vram-asc') {
          const vd = Number(a.getAttribute('data-vram') || 0) - Number(b.getAttribute('data-vram') || 0);
          if (vd !== 0) return vd;
          return Number(b.getAttribute('data-tps') || 0) - Number(a.getAttribute('data-tps') || 0);
        }
        if (sortMode === 'params-desc') {
          const pd = Number(b.getAttribute('data-params') || 0) - Number(a.getAttribute('data-params') || 0);
          if (pd !== 0) return pd;
          const sr = Number(a.getAttribute('data-status-rank') || 0) - Number(b.getAttribute('data-status-rank') || 0);
          if (sr !== 0) return sr;
          return Number(b.getAttribute('data-tps') || 0) - Number(a.getAttribute('data-tps') || 0);
        }
        return Number(a.getAttribute('data-index') || 0) - Number(b.getAttribute('data-index') || 0);
      });
      const frag = document.createDocumentFragment();
      sorted.forEach((c) => frag.appendChild(c));
      cardsGrid.appendChild(frag);
    }

    function syncUrl(mVal: string, hVal: string, query: string, sortVal: string) {
      if (!window.history || !window.history.replaceState) return;
      const params = new URLSearchParams();
      if (query) params.set('q', query);
      if (selectedStatus !== 'all') params.set('status', selectedStatus);
      if (selectedVendor !== 'all') params.set('vendor', selectedVendor);
      if (mVal !== 'all') params.set('model', mVal);
      if (hVal !== 'all') params.set('hw', hVal);
      if (sortVal !== 'featured') params.set('sort', sortVal);
      const qs = params.toString();
      const targetUrl = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
      window.history.replaceState(null, '', targetUrl);
    }

    function computeLiveCatalogMatches(
      mVal: string,
      hVal: string,
      tokens: string[],
      sortVal: string,
    ): LiveItem[] {
      const shouldActivate =
        hVal !== 'all' || mVal !== 'all' || selectedVendor !== 'all' || tokens.length > 0;
      if (!shouldActivate) return [];

      const items: LiveItem[] = [];

      if (hVal === 'cpu-only') {
        if (selectedVendor !== 'all') return [];
        for (const m of catData.models) {
          if (mVal !== 'all' && m.id !== mVal) continue;
          const mBlob = `${modelSearchMap.get(m.id) || ''} cpu system ram ddr5`.toLowerCase();
          if (tokens.length > 0 && !tokens.every((t) => mBlob.includes(t))) continue;
          const res = estimateRigRun(m, null, {
            quant: 'Q4_K_M',
            contextTokens: 8192,
            kvQuant: 'FP16',
            gpuCount: 0,
            cpuBwGbps: 68,
            systemRamGb: 64,
          });
          if (selectedStatus !== 'all' && res.status !== selectedStatus) continue;
          items.push({
            model: m,
            hw: null,
            res,
            rank: rankOf(res.status),
            simHref: `/calculator/?mode=cpu&cpu=amd-ryzen-7000-9000-ddr5-6000&ram=64&model=${encodeURIComponent(m.id)}`,
          });
        }
      } else {
        const candidateModels = catData.models.filter((m) => mVal === 'all' || m.id === mVal);
        const candidateHw = catData.hardware.filter((h) => {
          if (hVal !== 'all' && h.id !== hVal) return false;
          if (selectedVendor !== 'all' && h.vendor !== selectedVendor) return false;
          return true;
        });

        for (const h of candidateHw) {
          const hBlob = hwSearchMap.get(h.id) || '';
          for (const m of candidateModels) {
            if (curatedKeySet.has(`${m.id}::${h.id}`)) continue;
            const comboBlob = `${modelSearchMap.get(m.id) || ''} ${hBlob}`;
            if (tokens.length > 0 && !tokens.every((t) => comboBlob.includes(t))) continue;

            const res = estimateRigRun(m, h, {
              quant: 'Q4_K_M',
              contextTokens: 8192,
              kvQuant: 'FP16',
              gpuCount: h.gpu_count || 1,
            });
            if (selectedStatus !== 'all' && res.status !== selectedStatus) continue;
            items.push({
              model: m,
              hw: h,
              res,
              rank: rankOf(res.status),
              simHref: `/calculator/?model=${encodeURIComponent(m.id)}&hw=${encodeURIComponent(h.id)}`,
            });
          }
        }
      }

      items.sort((a, b) => {
        if (sortVal === 'tps-desc') {
          if (b.res.est_tps !== a.res.est_tps) return b.res.est_tps - a.res.est_tps;
          return a.rank - b.rank;
        }
        if (sortVal === 'vram-asc') {
          if (a.res.total_vram_gb !== b.res.total_vram_gb) return a.res.total_vram_gb - b.res.total_vram_gb;
          return b.res.est_tps - a.res.est_tps;
        }
        if (sortVal === 'params-desc') {
          if (b.model.params_b !== a.model.params_b) return b.model.params_b - a.model.params_b;
          if (a.rank !== b.rank) return a.rank - b.rank;
          return b.res.est_tps - a.res.est_tps;
        }
        // Featured order: Smooth first -> Larger params -> Faster tok/s
        if (a.rank !== b.rank) return a.rank - b.rank;
        if (b.model.params_b !== a.model.params_b) return b.model.params_b - a.model.params_b;
        return b.res.est_tps - a.res.est_tps;
      });

      return items;
    }

    function renderLiveCards(liveItems: LiveItem[], hVal: string, mVal: string, curatedMatchCount: number) {
      if (!liveSection || !liveGrid) return;

      if (liveItems.length === 0) {
        liveSection.classList.add('hidden');
        liveGrid.innerHTML = '';
        if (livePagBar) livePagBar.classList.add('hidden');
        return;
      }

      liveSection.classList.remove('hidden');

      // Contextual Simulator CTA banner
      const firstHw = liveItems[0]?.hw;
      const singleHwMatch =
        hVal !== 'all' && hVal !== 'cpu-only'
          ? catData.hardware.find((h) => h.id === hVal)
          : liveItems.every((x) => x.hw?.id === firstHw?.id)
            ? firstHw
            : null;

      if (liveHeading && liveSimCta && liveSub) {
        if (hVal === 'cpu-only') {
          liveHeading.textContent = `${liveItems.length} Live CPU-Only Model Estimates (DDR5 64 GB RAM Baseline)`;
          liveSub.textContent =
            'Switch between 16 CPUs (DDR4, DDR5, Threadripper, EPYC 12-Ch) and 16–512 GB RAM in the Rig Simulator.';
          liveSimCta.textContent = 'Customize CPU & RAM in Rig Simulator ->';
          liveSimCta.href =
            mVal !== 'all'
              ? `/calculator/?mode=cpu&model=${encodeURIComponent(mVal)}&cpu=amd-ryzen-7000-9000-ddr5-6000&ram=64`
              : '/calculator/?mode=cpu&cpu=amd-epyc-9004-9005-12ch&ram=256';
        } else if (singleHwMatch) {
          const multiCapable = !singleHwMatch.is_unified && singleHwMatch.category !== 'Laptop GPU';
          liveHeading.textContent = `${curatedMatchCount} Full Guides + ${liveItems.length} Live Catalog Estimates for ${singleHwMatch.name}`;
          liveSub.textContent = multiCapable
            ? `Test all ${catData.models.length} models across 7 GGUF quants, KV compression, 1x–8x ${singleHwMatch.short_name} multi-GPU, or CPU offload.`
            : `Showing full ${catData.models.length}-model coverage for ${singleHwMatch.short_name}. Open any card to adjust 7 quants & Q8_0/Q4_0 KV cache.`;
          liveSimCta.textContent = multiCapable
            ? `Try 2x / 3x / 4x ${singleHwMatch.short_name} in Simulator ->`
            : `Open ${singleHwMatch.short_name} in Rig Simulator ->`;
          liveSimCta.href = multiCapable
            ? `/calculator/?hw=${encodeURIComponent(singleHwMatch.id)}&gpus=2`
            : `/calculator/?hw=${encodeURIComponent(singleHwMatch.id)}`;
        } else {
          liveHeading.textContent = `${liveItems.length} Additional Live Catalog Estimates`;
          liveSub.textContent = `Computed live across ${catData.models.length} models × ${catData.hardware.length} GPUs at Q4_K_M @ 8K. Open any card for 7 quants & Multi-GPU simulation.`;
          liveSimCta.textContent = 'Open Multi-GPU / CPU Rig Simulator ->';
          liveSimCta.href = mVal !== 'all' ? `/calculator/?model=${encodeURIComponent(mVal)}` : '/calculator/';
        }
      }

      const slice = liveItems.slice(0, liveVisibleLimit);
      liveGrid.innerHTML = slice
        .map(({ model, hw, res, simHref }) => {
          const budget = hw ? hw.usable_vram_gb : res.usable_ram_gb;
          const pct = Math.min(100, Math.round((res.total_vram_gb / Math.max(1, budget)) * 100));
          const barColor =
            res.status === 'Smooth'
              ? 'bg-emerald-500'
              : res.status === 'Partial Offload'
                ? 'bg-amber-500'
                : 'bg-rose-500';
          const tpsDisplay = res.status === 'OOM' ? 'OOM' : `${res.est_tps.toFixed(1)} tok/s`;
          const hwTitle = hw ? hw.name : 'CPU-Only (DDR5 · 64 GB RAM)';
          const hwChip = hw ? `${hw.backend} · ${hw.bandwidth_gbps} GB/s` : 'CPU · 68 GB/s';
          const budgetLabel = hw ? `VRAM (Q4_K_M @ 8K)` : `RAM (Q4_K_M @ 8K)`;
          const layersText = hw
            ? `(${res.gpu_layers_fit}/${res.total_layers} layers)`
            : `(CPU-only ${res.total_layers}L)`;
          const moeLine = model.active_params_b
            ? `${model.params_b}B MoE (${model.active_params_b}B active) · ${model.architecture}`
            : `${model.params_b}B Params · ${model.architecture}`;

          return `
            <article class="group flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 transition-all hover:border-blue-300 hover:shadow-md">
              <div>
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-1.5">
                    <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-semibold ${badgeClasses(res.status)}">
                      <span class="h-1.5 w-1.5 rounded-full ${dotClass(res.status)}"></span>
                      ${res.status}
                    </span>
                    <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-semibold text-slate-600">Live Calc</span>
                  </div>
                  <span class="rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[11px] font-semibold text-slate-600">${hwChip}</span>
                </div>

                <h3 class="mt-3.5 text-base font-bold tracking-tight text-slate-950 group-hover:text-blue-600 transition-colors">
                  <a href="${simHref}" class="focus:outline-none">
                    ${model.short_name}
                    <span class="block text-sm font-semibold text-slate-600">on ${hwTitle}</span>
                  </a>
                </h3>

                <p class="mt-1.5 font-mono text-xs text-slate-500">${moeLine}</p>
              </div>

              <div class="mt-4 pt-4 border-t border-slate-100">
                <div class="flex items-center justify-between text-xs">
                  <span class="text-slate-500">${budgetLabel}</span>
                  <span class="font-mono font-semibold text-slate-900 tabular-nums">${res.total_vram_gb.toFixed(1)} / ${budget.toFixed(1)} GB</span>
                </div>
                <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-slate-100">
                  <div class="h-full rounded-full ${barColor}" style="width: ${pct}%"></div>
                </div>

                <div class="mt-3.5 flex items-center justify-between">
                  <div class="flex items-baseline gap-1.5">
                    <span class="font-mono text-lg font-bold text-slate-950 tabular-nums">${tpsDisplay}</span>
                    <span class="text-[11px] text-slate-500 tabular-nums">${layersText}</span>
                  </div>
                  <a href="${simHref}" class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-800">
                    Simulate -&gt;
                  </a>
                </div>
              </div>
            </article>
          `;
        })
        .join('');

      const liveRemaining = Math.max(0, liveItems.length - slice.length);
      if (livePagBar && livePagSummary && liveLoadMoreBtn) {
        livePagBar.classList.toggle('hidden', liveRemaining === 0);
        livePagSummary.textContent = `Showing ${slice.length} of ${liveItems.length} live catalog estimates`;
        liveLoadMoreBtn.textContent = `Load ${Math.min(PAGE_SIZE, liveRemaining)} More (${liveRemaining} left)`;
      }
    }

    function applyFilters(resetPagination = true) {
      if (resetPagination) {
        visibleLimit = PAGE_SIZE;
        liveVisibleLimit = PAGE_SIZE;
      }

      const mVal = modelSelect ? modelSelect.value : 'all';
      const hVal = hwSelect ? hwSelect.value : 'all';
      const rawQuery = searchInput ? searchInput.value.trim() : '';
      const tokens = rawQuery.toLowerCase().split(/\s+/).filter(Boolean);
      const sortVal = sortSelect ? sortSelect.value : 'featured';

      if (sortVal !== currentSort) {
        currentSort = sortVal;
        sortCardsInDom(sortVal);
      }

      const orderedCards = cardsGrid
        ? Array.from(cardsGrid.querySelectorAll('[data-card]'))
        : cards;

      const matching: Element[] = [];
      orderedCards.forEach((card) => {
        const matchModel = mVal === 'all' || card.getAttribute('data-model') === mVal;
        const matchHw =
          hVal === 'all'
            ? true
            : hVal === 'cpu-only'
              ? false
              : card.getAttribute('data-hardware') === hVal;
        const matchStatus = selectedStatus === 'all' || card.getAttribute('data-status') === selectedStatus;
        const matchVendor = selectedVendor === 'all' || card.getAttribute('data-vendor') === selectedVendor;
        const searchBlob = card.getAttribute('data-search') || '';
        const matchQuery = tokens.length === 0 || tokens.every((t) => searchBlob.includes(t));

        const isMatch = matchModel && matchHw && matchStatus && matchVendor && matchQuery;
        if (isMatch) {
          matching.push(card);
        } else {
          card.classList.add('hidden');
        }
      });

      const shownCount = Math.min(visibleLimit, matching.length);
      matching.forEach((card, i) => {
        card.classList.toggle('hidden', i >= visibleLimit);
      });

      const liveItems = computeLiveCatalogMatches(mVal, hVal, tokens, sortVal);
      renderLiveCards(liveItems, hVal, mVal, matching.length);

      const remaining = Math.max(0, matching.length - shownCount);
      const isFiltered =
        mVal !== 'all' ||
        hVal !== 'all' ||
        selectedStatus !== 'all' ||
        selectedVendor !== 'all' ||
        sortVal !== 'featured' ||
        tokens.length > 0;

      if (countEl) {
        if (!isFiltered) {
          countEl.textContent = `Showing ${shownCount} of ${totalCurated} full guides (${totalCombinations} live)`;
        } else if (liveItems.length > 0) {
          countEl.textContent = `${matching.length} Full Guides + ${liveItems.length} Live Estimates (${matching.length + liveItems.length} matched)`;
        } else {
          countEl.textContent = `Showing ${shownCount} of ${matching.length} matched (${totalCurated} guides)`;
        }
      }

      if (paginationBar) {
        paginationBar.classList.toggle('hidden', remaining === 0);
      }
      if (paginationSummary) {
        paginationSummary.textContent = `Viewing ${shownCount} of ${matching.length} matching full guides`;
      }
      if (paginationFill) {
        const pct = matching.length > 0 ? Math.round((shownCount / matching.length) * 100) : 100;
        paginationFill.style.width = `${pct}%`;
      }
      if (loadMoreBtn) {
        const nextChunk = Math.min(PAGE_SIZE, remaining);
        loadMoreBtn.textContent = `Load ${nextChunk} More (${remaining} left)`;
      }

      const anyMatched = matching.length > 0 || liveItems.length > 0;
      if (resetBtn) resetBtn.classList.toggle('hidden', !isFiltered);
      if (emptyState) emptyState.classList.toggle('hidden', anyMatched);
      if (cardsGrid) cardsGrid.classList.toggle('hidden', matching.length === 0);

      syncUrl(mVal, hVal, rawQuery, sortVal);
    }

    function hydrateFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const qParam = params.get('q');
      const stParam = params.get('status');
      const vndParam = params.get('vendor');
      const modParam = params.get('model');
      const hwParam = params.get('hw');
      const sortParam = params.get('sort');

      let hadParam = false;
      if (qParam && searchInput) {
        searchInput.value = qParam;
        hadParam = true;
      }
      if (stParam && ['Smooth', 'Partial Offload', 'OOM'].includes(stParam)) {
        selectedStatus = stParam;
        updateStatusPills();
        hadParam = true;
      }
      if (vndParam && ['NVIDIA', 'Apple', 'AMD', 'Intel'].includes(vndParam)) {
        selectedVendor = vndParam;
        updateVendorPills();
        hadParam = true;
      }
      if (modParam && modelSelect && Array.from(modelSelect.options).some((o) => o.value === modParam)) {
        modelSelect.value = modParam;
        hadParam = true;
      }
      if (hwParam && hwSelect && Array.from(hwSelect.options).some((o) => o.value === hwParam)) {
        hwSelect.value = hwParam;
        hadParam = true;
      }
      if (sortParam && sortSelect && Array.from(sortSelect.options).some((o) => o.value === sortParam)) {
        sortSelect.value = sortParam;
        hadParam = true;
      }
      if (hadParam) {
        applyFilters(true);
      }
    }

    function resetAll() {
      if (modelSelect) modelSelect.value = 'all';
      if (hwSelect) hwSelect.value = 'all';
      if (searchInput) searchInput.value = '';
      if (sortSelect) sortSelect.value = 'featured';
      selectedStatus = 'all';
      selectedVendor = 'all';
      updateStatusPills();
      updateVendorPills();
      applyFilters(true);
    }

    if (modelSelect) modelSelect.addEventListener('change', () => applyFilters(true));
    if (hwSelect) hwSelect.addEventListener('change', () => applyFilters(true));
    if (searchInput) searchInput.addEventListener('input', () => applyFilters(true));
    if (sortSelect) sortSelect.addEventListener('change', () => applyFilters(true));
    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        visibleLimit += PAGE_SIZE;
        applyFilters(false);
      });
    }

    if (showAllBtn) {
      showAllBtn.addEventListener('click', () => {
        visibleLimit = totalCurated;
        applyFilters(false);
      });
    }

    if (liveLoadMoreBtn) {
      liveLoadMoreBtn.addEventListener('click', () => {
        liveVisibleLimit += PAGE_SIZE;
        applyFilters(false);
      });
    }

    statusButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedStatus = btn.getAttribute('data-status-btn') || 'all';
        updateStatusPills();
        applyFilters(true);
      });
    });

    vendorButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedVendor = btn.getAttribute('data-vendor-btn') || 'all';
        updateVendorPills();
        applyFilters(true);
      });
    });

    document.addEventListener('keydown', (ev) => {
      if (ev.key === '/' && !ev.metaKey && !ev.ctrlKey && !ev.altKey) {
        const tag = document.activeElement ? document.activeElement.tagName : '';
        if (!['INPUT', 'SELECT', 'TEXTAREA'].includes(tag) && searchInput) {
          ev.preventDefault();
          searchInput.focus();
        }
      } else if (ev.key === 'Escape' && document.activeElement === searchInput && searchInput) {
        if (searchInput.value.length > 0) {
          searchInput.value = '';
          applyFilters(true);
        }
        searchInput.blur();
      }
    });

    hydrateFromUrl();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMatrixPage);
  } else {
    initMatrixPage();
  }
</script>
