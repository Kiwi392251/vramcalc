---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComboboxField from '../components/ComboboxField.astro';
import StatusBadge from '../components/StatusBadge.astro';
import SpeedBadge from '../components/SpeedBadge.astro';
import catalogRaw from '../data/catalog_data.json';
import rawPagesData from '../data/pages_data.json';
import type { CatalogData, PageEntry, SpeedTier } from '../types/vram';
import {
  buildHardwareHubs,
  buildModelHubs,
  getBenchmarksMethodologyNote,
  getReferenceBenchmarks,
  statusRank,
} from '../utils/hubs';
import {
  classifySpeedTier,
  effectiveUsableVramGb,
  estimateRigRun,
  formatContextLabel,
  formatTpsRange,
} from '../utils/physics';

const PAGE_SIZE = 24;
const catalog = catalogRaw as CatalogData;
const rawEntries = rawPagesData as PageEntry[];
const updatedAt = catalog.updated_at ?? '2026-11-24';
const engineVersion = catalog.engine_version ?? 'v3.3';

const FEATURED_TOP_SLUGS = [
  'qwen3.8-27b-on-nvidia-a10-24gb',
  'qwen3.8-27b-on-rtx-4090-24gb',
  'qwen3.8-27b-on-apple-m4-pro-48gb',
  'qwen3.8-27b-on-apple-m4-16gb',
  'qwen3-8b-on-apple-m4-16gb',
  'qwen3.8-27b-on-rtx-5090-32gb',
  'qwen3.8-27b-on-nvidia-l4-24gb',
  'qwen3-14b-on-nvidia-t4-16gb',
  'qwen3-32b-on-nvidia-a10-24gb',
  'gemma-3-27b-on-nvidia-a10-24gb',
  'qwen3-30b-a3b-on-apple-m4-pro-48gb',
  'llama-3.3-70b-on-dual-rtx-4090-48gb',
  'deepseek-r1-70b-on-ryzen-ai-max-395-128gb',
  'qwen3.8-27b-on-apple-m4-max-128gb',
  'qwen3-32b-on-rtx-4090-24gb',
  'qwen3-32b-on-rtx-5090-32gb',
  'qwen3-8b-on-nvidia-t4-16gb',
  'qwen3-14b-on-nvidia-a10-24gb',
  'gemma-3-27b-on-rtx-4090-24gb',
  'qwen3-32b-on-apple-m4-max-128gb',
  'qwen3-30b-a3b-on-nvidia-a10-24gb',
  'deepseek-r1-7b-on-apple-m4-16gb',
  'llama-3.1-8b-on-apple-m4-16gb',
  'gemma-3-27b-on-nvidia-l4-24gb',
];
const featuredRank = new Map(FEATURED_TOP_SLUGS.map((slug, idx) => [slug, idx]));

const entries = [...rawEntries].sort((a, b) => {
  const fa = featuredRank.get(a.slug);
  const fb = featuredRank.get(b.slug);
  if (fa !== undefined && fb !== undefined) return fa - fb;
  if (fa !== undefined) return -1;
  if (fb !== undefined) return 1;
  const sr = statusRank(a.default_result.status) - statusRank(b.default_result.status);
  if (sr !== 0) return sr;
  if (b.model.params_b !== a.model.params_b) return b.model.params_b - a.model.params_b;
  if (b.default_result.est_tps !== a.default_result.est_tps) {
    return b.default_result.est_tps - a.default_result.est_tps;
  }
  return a.slug.localeCompare(b.slug);
});

const totalCount = entries.length;
const initialVisibleCount = Math.min(PAGE_SIZE, totalCount);
const initialRemainingCount = Math.max(0, totalCount - initialVisibleCount);
const initialProgressPct = totalCount > 0 ? Math.round((initialVisibleCount / totalCount) * 100) : 100;
const initialProgressStyle = `width: ${initialProgressPct}%`;
const paginationHiddenClass =
  initialRemainingCount > 0
    ? 'mt-7 rounded-2xl border border-slate-200 bg-white p-4 sm:p-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between'
    : 'hidden';
const fitsCount = entries.filter((e) => e.default_result.status === 'Fits').length;
const tightPartialCount = entries.filter(
  (e) => e.default_result.status === 'Tight Fit' || e.default_result.status === 'Partial Offload',
).length;

// Full static catalog hubs (all 22 models + all 103 hardware SKUs reachable in 1 hop from '/')
const uniqueHubModels = [...catalog.models].sort((a, b) => a.name.localeCompare(b.name));
const uniqueHubHardware = [...catalog.hardware].sort((a, b) => a.name.localeCompare(b.name));

const uniqueHubModelCount = uniqueHubModels.length;
const uniqueHubHwCount = uniqueHubHardware.length;
const catalogModelCount = catalog.models.length;
const catalogHwCount = catalog.hardware.length;
const updatedArgs = JSON.stringify({ date: updatedAt });

const curatedKeys = entries.map((e) => `${e.model.id}::${e.hardware.id}`);
const curatedSlugs: Record<string, string> = {};
for (const e of entries) {
  curatedSlugs[`${e.model.id}::${e.hardware.id}`] = e.slug;
}
const measuredAnchors = getReferenceBenchmarks({});
const measuredNote = getBenchmarksMethodologyNote();
const measuredByPair = new Map<string, (typeof measuredAnchors)[number]>();
const measuredPairs: Record<string, string> = {};
for (const anc of measuredAnchors) {
  const pk = `${anc.model_id}::${anc.hardware_id}`;
  if (!measuredByPair.has(pk)) {
    measuredByPair.set(pk, anc);
    measuredPairs[pk] = `${anc.gen_tps_low}–${anc.gen_tps_high} tok/s measured`;
  }
}
const homeCatalogPayload = JSON.stringify({
  models: catalog.models,
  hardware: catalog.hardware,
  cpus: catalog.cpus,
  curatedKeys,
  curatedSlugs,
  measuredPairs,
});

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'VRAMCalc.me',
  url: 'https://vramcalc.me/',
  description:
    'Local AI LLM VRAM calculator and inference tokens/sec estimator across NVIDIA RTX, Apple Silicon, AMD Radeon, Intel Arc, Multi-GPU rigs, and CPU/RAM.',
};

const homeCollectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Local AI Model VRAM & Inference Speed Matrix',
  url: 'https://vramcalc.me/',
  description: `Compatibility matrix indexing ${totalCount} deep benchmark guides and live calculations across ${catalogHwCount} GPUs (1x-8x) and ${catalogModelCount} open-weight models.`,
  hasPart: [
    {
      '@type': 'CollectionPage',
      name: 'Multi-GPU & CPU/RAM Rig Simulator',
      url: 'https://vramcalc.me/calculator/',
    },
    {
      '@type': 'CollectionPage',
      name: `All Local AI GPUs (${uniqueHubHwCount} Hardware Hubs)`,
      url: 'https://vramcalc.me/gpu/',
    },
    {
      '@type': 'CollectionPage',
      name: `All Open-Weight LLMs (${uniqueHubModelCount} Model Hubs)`,
      url: 'https://vramcalc.me/model/',
    },
  ],
};
const homeOgTitle = `Local AI LLM VRAM & Speed Calculator (${catalogModelCount} Models × ${catalogHwCount} GPUs · Updated ${updatedAt}) | VRAMCalc.me`;
const homeOgDescription = `Check GGUF, AWQ & MLX VRAM fit, max safe context, Tight Fit & PCIe All-Reduce headroom, and measured + formula tok/s ranges across ${catalogHwCount} GPUs & Macs and ${catalogModelCount} open LLMs (Qwen3.8-27B, Qwen3, Gemma 3, DeepSeek-R1, Llama-3.3).`;

const curatedSlugMap = new Map(Object.entries(curatedSlugs));
const modelCatalogMap = new Map(catalog.models.map((m) => [m.id, m]));
const hwCatalogMap = new Map(catalog.hardware.map((h) => [h.id, h]));

const measuredRows = measuredAnchors
  .map((anc) => {
    const m = modelCatalogMap.get(anc.model_id);
    const h = hwCatalogMap.get(anc.hardware_id);
    if (!m || !h) return null;
    const est = estimateRigRun({
      model: m,
      hardware: h,
      gpuCount: h.gpu_count || 1,
      quant: anc.quant,
      format: anc.format,
      contextTokens: anc.context_tokens,
      kvQuant: 'fp16',
      reserveProfile: 'desktop',
    });
    const slug = curatedSlugMap.get(`${m.id}::${h.id}`);
    const measMid = (anc.gen_tps_low + anc.gen_tps_high) / 2.0;
    const fLow = est.est_tps_low ?? 0;
    const fHigh = est.est_tps_high ?? 0;
    const fMid = (fLow + fHigh) / 2.0;
    const deltaPct = Math.round(((fMid - measMid) / measMid) * 1000) / 10;
    const deltaText = deltaPct === 0 ? '0.0%' : `${deltaPct > 0 ? '+' : ''}${deltaPct.toFixed(1)}%`;
    const is2026 = anc.date.startsWith('2026');
    const is2025 = anc.date.startsWith('2025');
    const freshKey = is2026
      ? 'home.measuredFresh2026'
      : is2025
        ? 'home.measuredFresh2025'
        : 'home.measuredFreshLegacy';
    const freshLabel = is2026 ? '2026 run' : is2025 ? '2025 baseline' : 'Legacy 2024';
    const freshClass = is2026
      ? 'inline-block rounded border border-emerald-200 bg-emerald-50 px-1.5 py-0.5 font-mono text-[10px] font-semibold text-emerald-800'
      : is2025
        ? 'inline-block rounded border border-slate-200 bg-slate-100 px-1.5 py-0.5 font-mono text-[10px] font-medium text-slate-600'
        : 'inline-block rounded border border-amber-200 bg-amber-50 px-1.5 py-0.5 font-mono text-[10px] font-semibold text-amber-800';
    return {
      anc,
      model: m,
      hardware: h,
      est,
      pairHref: slug ? `/can-i-run/${slug}/` : `/gpu/${h.id}/`,
      ctxLabel: formatContextLabel(anc.context_tokens),
      measuredText: `${anc.gen_tps_low}–${anc.gen_tps_high} tok/s measured`,
      measuredUnitArgs: JSON.stringify({ low: anc.gen_tps_low, high: anc.gen_tps_high }),
      formulaText: formatTpsRange(est.est_tps_low, est.est_tps_high, est.est_tps, est.status),
      deltaText,
      freshKey,
      freshLabel,
      freshClass,
    };
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);

const modelHubRows = buildModelHubs(entries);
const hwHubRows = buildHardwareHubs(entries);

const staticIndexRows = entries.map((e) => {
  const res = e.default_result;
  const usable =
    res.effective_usable_vram_gb ??
    effectiveUsableVramGb(e.hardware, e.hardware.gpu_count || 1, 'desktop')[1];
  const speedTier: SpeedTier = res.speed_tier ?? classifySpeedTier(res.est_tps, res.status);
  const tpsText = formatTpsRange(res.est_tps_low, res.est_tps_high, res.est_tps, res.status);
  const hasMaxFit = Boolean(e.max_fit_context && e.max_fit_context > 0 && e.max_fit_total_vram_gb);
  const hasMaxFitSpeed = Boolean(hasMaxFit && e.max_fit_tps_high && e.max_fit_tps_high > 0);
  const maxFitText = hasMaxFitSpeed
    ? `${formatContextLabel(e.max_fit_context!)} (${e.max_fit_total_vram_gb!.toFixed(1)} GB · ~${e.max_fit_tps_low}–${e.max_fit_tps_high} tok/s)`
    : hasMaxFit
      ? `${formatContextLabel(e.max_fit_context!)} (${e.max_fit_total_vram_gb!.toFixed(1)} GB)`
      : 'Offload req.';
  const alt = e.alt_format_summary;
  const altText = alt
    ? `${alt.format}: ${alt.total_vram_gb.toFixed(1)} GB · ${
        alt.status === 'OOM' ? 'OOM' : `~${alt.est_tps_low}–${alt.est_tps_high} tok/s`
      }`
    : '—';
  const isMeasured = measuredByPair.has(`${e.model.id}::${e.hardware.id}`);
  return {
    href: `/can-i-run/${e.slug}/`,
    modelShort: e.model.short_name,
    hwShort: e.hardware.name,
    vramText: `${res.total_vram_gb.toFixed(1)} / ${usable.toFixed(1)} GB`,
    altText,
    maxFitText,
    status: res.status,
    speedTier,
    tpsText,
    isMeasured,
    layersText: `${res.gpu_layers_fit}/${res.total_layers}`,
  };
});

const heroDescArgs = JSON.stringify({ models: catalogModelCount, hw: catalogHwCount });
const ctaGpusArgs = JSON.stringify({ count: uniqueHubHwCount });
const ctaModelsArgs = JSON.stringify({ count: uniqueHubModelCount });
const initCountArgs = JSON.stringify({
  shown: initialVisibleCount,
  total: totalCount,
  models: catalogModelCount,
  hw: catalogHwCount,
});
const initViewArgs = JSON.stringify({ shown: initialVisibleCount, total: totalCount });
const initLoadArgs = JSON.stringify({ chunk: Math.min(PAGE_SIZE, initialRemainingCount), left: initialRemainingCount });
const modelHubsArgs = JSON.stringify({ count: uniqueHubModelCount });
const hwHubsArgs = JSON.stringify({ count: uniqueHubHwCount });
const measuredSubArgs = JSON.stringify({ count: measuredRows.length });
const heroEngineArgs = JSON.stringify({ ver: engineVersion });
const formulaOnlyCount = Math.max(0, totalCount - measuredRows.length);
const measuredCoverageArgs = JSON.stringify({
  measured: measuredRows.length,
  total: totalCount,
  formulaOnly: formulaOnlyCount,
});
const staticIndexTitleArgs = JSON.stringify({ guides: totalCount });
const staticIndexSubArgs = JSON.stringify({
  guides: totalCount,
  models: catalogModelCount,
  hw: catalogHwCount,
  combos: catalogModelCount * catalogHwCount,
});
---

<BaseLayout
  title="VRAMCalc.me — Local AI Model VRAM & Speed Calculator"
  description="Check whether Qwen3.8-27B, Qwen3, Gemma 3, DeepSeek-R1, and Llama run on Apple Silicon M1–M5, NVIDIA GTX/RTX (1x–8x), T4/L4/A10/H200, AMD Radeon / Strix Halo, Intel Arc, or CPU RAM."
  canonicalPath="/"
  totalPages={totalCount}
  ogTitle={homeOgTitle}
  ogDescription={homeOgDescription}
  ogImage="/og/home.png"
  ogImageAlt={homeOgTitle}
  themeColor="#2563eb"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(homeCollectionSchema)} />
  </Fragment>

  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12">
      <div class="max-w-3xl">
        <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
          <span
            class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 font-mono font-semibold text-emerald-800"
            data-i18n="common.updated"
            data-i18n-args={updatedArgs}
          >
            Updated {updatedAt}
          </span>
          <a
            href="/changelog/"
            class="inline-flex items-center gap-1 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 font-mono font-medium text-slate-700 hover:border-blue-300 hover:bg-blue-50 hover:text-blue-700 transition-colors"
            data-i18n="home.heroEnginePill"
            data-i18n-args={heroEngineArgs}
          >
            Physics {engineVersion} · Changelog · Formula Estimate (±17–25%)
          </a>
          <a
            href="#measured-benchmarks"
            class="inline-flex items-center gap-1 rounded-full border border-sky-200 bg-sky-50 px-2.5 py-0.5 font-mono font-semibold text-sky-800 hover:bg-sky-100 transition-colors"
            data-i18n="home.heroMeasuredPill"
            data-i18n-args={measuredSubArgs}
          >
            {measuredRows.length} Measured
          </a>
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl" data-i18n="home.heroTitle">
          Local AI Model VRAM &amp; Inference Speed Matrix
        </h1>
        <p class="mt-3 text-base leading-relaxed text-slate-600" data-i18n="home.heroDesc" data-i18n-args={heroDescArgs}>
          Check memory fit, max safe context, and honest bandwidth throughput ranges across {catalogModelCount} models (Qwen3.8-27B, Qwen3, Gemma 3, DeepSeek-R1, Llama-3.3) and {catalogHwCount} GPUs &amp; Macs (M4 16GB, T4, L4, A10, RTX 5090), supporting GGUF, AWQ, MLX, and 1x–8x multi-GPU topologies.
        </p>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <a
            href="/calculator/"
            class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-4 py-2 text-xs font-semibold text-white hover:bg-blue-700 transition-colors"
            data-i18n="home.ctaSimulator"
          >
            Multi-GPU, AWQ/MLX &amp; CPU Simulator -&gt;
          </a>
          <a
            href="/gpu/"
            class="inline-flex items-center gap-1.5 rounded-lg bg-slate-950 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800 transition-colors"
            data-i18n="home.ctaGpus"
            data-i18n-args={ctaGpusArgs}
          >
            Browse {uniqueHubHwCount} GPU Hubs -&gt;
          </a>
          <a
            href="/model/"
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-4 py-2 text-xs font-semibold text-slate-800 hover:border-blue-300 hover:bg-blue-50 hover:text-blue-700 transition-colors"
            data-i18n="home.ctaModels"
            data-i18n-args={ctaModelsArgs}
          >
            Browse {uniqueHubModelCount} Model Hubs -&gt;
          </a>
        </div>
      </div>

      <dl class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
        <div class="rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-3">
          <dt class="text-xs font-medium text-slate-500" data-i18n="home.kpiGuides">Common Pairings</dt>
          <dd class="mt-1 font-mono text-2xl font-bold text-slate-950 tabular-nums">{totalCount}</dd>
        </div>
        <div class="rounded-xl border border-emerald-200/80 bg-emerald-50/50 px-4 py-3">
          <dt class="text-xs font-medium text-emerald-800" data-i18n="home.kpiSmooth">Fits in VRAM (8K Q4)</dt>
          <dd class="mt-1 font-mono text-2xl font-bold text-emerald-900 tabular-nums">{fitsCount}</dd>
        </div>
        <div class="rounded-xl border border-amber-200/80 bg-amber-50/50 px-4 py-3">
          <dt class="text-xs font-medium text-amber-800" data-i18n="home.kpiPartial">Tight Fit / RAM Offload</dt>
          <dd class="mt-1 font-mono text-2xl font-bold text-amber-900 tabular-nums">{tightPartialCount}</dd>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-3">
          <dt class="text-xs font-medium text-slate-500" data-i18n="home.kpiLiveEngine">Models × GPUs</dt>
          <dd class="mt-1 font-mono text-2xl font-bold text-slate-950 tabular-nums">
            {catalogModelCount} × {catalogHwCount}
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Hardware Rig Configurator + Compatibility Matrix -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <div id="rig-config-panel" class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs sm:p-5">
      <!-- Row 1: CPU + RAM + GPU + QTY -->
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.45fr)_minmax(0,0.75fr)_minmax(0,1.45fr)_116px] lg:items-end">
        <div>
          <ComboboxField
            id="cb-cpu"
            label="CPU / Unified Chip"
            placeholder="Search i5/i7, Ryzen, Apple M1–M5..."
            cascader={true}
            labelI18n="home.cpuLabel"
            placeholderI18n="home.cpuPlaceholder"
          />
        </div>

        <div>
          <ComboboxField
            id="cb-ram"
            label="RAM (GB)"
            placeholder="e.g. 32 GB"
            labelI18n="home.ramLabel"
            placeholderI18n="home.ramPlaceholder"
          />
        </div>

        <div>
          <ComboboxField
            id="cb-gpu"
            label="GPU (Graphics Card)"
            placeholder="Search GPU or None (CPU-Only)..."
            cascader={true}
            labelI18n="home.gpuLabel"
            placeholderI18n="home.gpuPlaceholder"
          />
        </div>

        <div>
          <label
            for="rig-gpu-count"
            class="block text-xs font-semibold uppercase tracking-wider text-slate-500"
            data-i18n="home.qtyLabel"
          >
            Qty
          </label>
          <select
            id="rig-gpu-count"
            disabled
            class="mt-1.5 h-10 w-full rounded-lg border border-slate-200 bg-slate-50 px-2.5 text-sm font-semibold text-slate-400 cursor-not-allowed focus:border-blue-600 focus:outline-none transition-colors"
          >
            <option value="0">—</option>
          </select>
        </div>
      </div>

      <!-- Conditional Sub-Bar: Unified Memory Info / Multi-GPU Split / CPU-Only Info -->
      <div
        id="rig-context-bar"
        class="mt-3 hidden rounded-xl border border-blue-200/80 bg-blue-50/70 px-3.5 py-2 text-xs text-slate-700"
      >
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span id="rig-context-text" class="font-medium text-slate-800"></span>
          <div id="rig-split-toggle" class="hidden">
            <div
              class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white p-0.5"
              role="group"
              aria-label="Multi-GPU split strategy"
            >
              <button
                type="button"
                data-home-split="layer"
                class="rounded-md px-2.5 py-1 text-[11px] font-semibold bg-slate-900 text-white cursor-pointer"
                data-i18n="home.layerSplit"
              >
                Layer Split
              </button>
              <button
                type="button"
                data-home-split="tensor"
                class="rounded-md px-2.5 py-1 text-[11px] font-medium text-slate-600 hover:text-slate-950 cursor-pointer"
                data-i18n="home.tensorParallel"
              >
                Tensor Parallel
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- OS Reserve Profile Selector (Daily Desktop / Clean OS / Custom GB) -->
      <div class="mt-3 flex flex-wrap items-center justify-between gap-2.5 border-t border-slate-100 pt-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-500" data-i18n="reserve.title">
            OS Reserve Profile
          </span>
          <div class="inline-flex items-center rounded-lg border border-slate-200 bg-slate-50 p-0.5 text-xs" role="group" aria-label="OS Reserve Profile">
            <button
              type="button"
              data-home-reserve="desktop"
              data-i18n="reserve.desktop"
              class="rounded-md px-2.5 py-1 font-semibold bg-slate-900 text-white cursor-pointer transition-colors"
            >
              Daily Desktop
            </button>
            <button
              type="button"
              data-home-reserve="clean"
              data-i18n="reserve.clean"
              class="rounded-md px-2.5 py-1 font-medium text-slate-700 hover:text-slate-950 cursor-pointer transition-colors"
            >
              Clean OS / Headless
            </button>
            <button
              type="button"
              data-home-reserve="custom"
              data-i18n="reserve.custom"
              class="rounded-md px-2.5 py-1 font-medium text-slate-700 hover:text-slate-950 cursor-pointer transition-colors"
            >
              Custom GB
            </button>
          </div>
          <div id="home-custom-gb-wrap" class="hidden items-center gap-1.5">
            <label for="home-custom-gb" class="sr-only" data-i18n="reserve.customLabel">Usable ceiling (GB)</label>
            <input
              id="home-custom-gb"
              type="number"
              min="1"
              max="512"
              step="0.5"
              data-i18n-placeholder="home.reserveCustomPh"
              placeholder="e.g. 22.4"
              class="h-8 w-24 rounded-lg border border-blue-300 bg-white px-2.5 font-mono text-xs font-semibold text-slate-900 focus:border-blue-600 focus:outline-none"
            />
            <span class="font-mono text-xs font-medium text-slate-500">GB</span>
          </div>
        </div>
      </div>

      <!-- Row 2: Model + Status + Sort + Count + Reset -->
      <div class="mt-4 flex flex-wrap items-center justify-between gap-2.5 border-t border-slate-100 pt-3.5">
        <div class="flex flex-wrap items-center gap-2.5">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500" data-i18n="home.modelLabel">Model</span>
            <div class="w-48 sm:w-56">
              <ComboboxField
                id="cb-model"
                label="Model"
                placeholder="All Models"
                compact={true}
                labelI18n="home.modelLabel"
              />
            </div>
          </div>

          <span class="hidden h-4 w-px bg-slate-200 sm:inline-block" aria-hidden="true"></span>

          <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter by status">
            {(['all', 'Fits', 'Tight Fit', 'Partial Offload', 'OOM'] as const).map((st) => {
              const btnClass =
                st === 'all'
                  ? 'rounded-full border px-2.5 py-1 text-xs font-semibold transition-colors cursor-pointer border-slate-900 bg-slate-900 text-white'
                  : 'rounded-full border px-2.5 py-1 text-xs font-semibold transition-colors cursor-pointer border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100';
              const stI18nKey =
                st === 'all'
                  ? 'status.allStatuses'
                  : st === 'Fits'
                    ? 'status.fits'
                    : st === 'Tight Fit'
                      ? 'status.tightFit'
                      : st === 'Partial Offload'
                        ? 'status.partialOffload'
                        : 'status.oom';
              return (
                <button
                  type="button"
                  data-status-btn={st}
                  data-i18n={stI18nKey}
                  class={btnClass}
                >
                  {st === 'all' ? 'All Statuses' : st}
                </button>
              );
            })}
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5 text-xs text-slate-600">
          <div class="flex items-center gap-1.5">
            <label for="filter-sort" class="text-[11px] font-semibold uppercase tracking-wider text-slate-400" data-i18n="home.sortLabel">
              Sort
            </label>
            <select
              id="filter-sort"
              class="h-8 rounded-lg border border-slate-300 bg-white px-2 text-xs font-medium text-slate-900 focus:border-blue-600 focus:outline-none"
            >
              <option value="featured" data-i18n="home.sortRecommended">Recommended</option>
              <option value="tps-desc" data-i18n="home.sortFastest">Fastest tok/s</option>
              <option value="vram-asc" data-i18n="home.sortLowestVram">Lowest VRAM</option>
              <option value="params-desc" data-i18n="home.sortLargestModel">Largest Model</option>
            </select>
          </div>

          <span id="filter-count" class="font-mono tabular-nums" data-i18n="home.countInitial" data-i18n-args={initCountArgs}>
            {initialVisibleCount} / {totalCount} guides · {catalogModelCount}×{catalogHwCount} static hubs
          </span>
          <button
            id="filter-reset"
            type="button"
            class="hidden font-semibold text-blue-600 hover:text-blue-800 cursor-pointer"
            data-i18n="common.reset"
          >
            Reset
          </button>
        </div>
      </div>
    </div>

    <!-- Dynamic Mode Header: Reference Presets vs. Selected Rig Results -->
    <div
      id="results-mode-banner"
      class="mt-6 flex flex-col gap-3 rounded-2xl border border-slate-200 bg-slate-50/90 px-4 py-3.5 sm:flex-row sm:items-center sm:justify-between sm:px-5 transition-colors"
    >
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <span
            id="results-mode-badge"
            data-i18n="home.modeBadgeRef"
            class="inline-flex shrink-0 items-center rounded-full border border-slate-300 bg-white px-2.5 py-0.5 text-[11px] font-bold tracking-wide text-slate-700"
          >
            Reference Presets
          </span>
          <h2
            id="results-mode-heading"
            data-i18n="home.modeHeadingRef"
            class="text-sm sm:text-base font-bold text-slate-950"
          >
            Popular Hardware References
          </h2>
        </div>
        <p
          id="results-mode-sub"
          data-i18n="home.modeSubRef"
          class="mt-1 text-xs leading-relaxed text-slate-600"
        >
          No hardware selected yet — cards below show preset Model × GPU examples. Pick your CPU or GPU above to switch to estimates for your own machine.
        </p>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <button
          id="results-mode-select-btn"
          type="button"
          data-i18n="home.modeCtaSelectHw"
          class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold text-slate-800 hover:border-blue-400 hover:text-blue-700 transition-colors cursor-pointer"
        >
          Select My Hardware ↑
        </button>
        <a
          id="results-mode-sim-cta"
          href="/calculator/"
          data-i18n="home.openRigSim"
          class="hidden items-center justify-center rounded-lg bg-blue-600 px-3.5 py-2 text-xs font-semibold text-white hover:bg-blue-700 transition-colors"
        >
          Open Full Rig in Simulator -&gt;
        </a>
      </div>
    </div>

    <!-- Curated Deep-Dive Cards Grid (SSR Progressive Window: first 24 visible, all 165 crawlable in DOM) -->
    <div id="cards-grid" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry, idx) => {
        const res = entry.default_result;
        const usable =
          res.effective_usable_vram_gb ??
          effectiveUsableVramGb(entry.hardware, entry.hardware.gpu_count || 1, 'desktop')[1];
        const fillPct = Math.min(100, Math.round((res.total_vram_gb / Math.max(0.5, usable)) * 100));
        const barColor =
          res.status === 'Fits'
            ? 'bg-emerald-500'
            : res.status === 'Tight Fit'
              ? 'bg-orange-500'
              : res.status === 'Partial Offload'
                ? 'bg-amber-500'
                : 'bg-rose-500';
        const speedTier: SpeedTier = res.speed_tier ?? classifySpeedTier(res.est_tps, res.status);
        const tpsDisplay = formatTpsRange(res.est_tps_low, res.est_tps_high, res.est_tps, res.status);
        const fillStyle = `width: ${fillPct}%`;
        const fillBarClass = `h-full rounded-full ${barColor}`;
        const detailHref = `/can-i-run/${entry.slug}/`;
        const rank = statusRank(res.status);
        const hiddenClass = idx >= PAGE_SIZE ? ' hidden' : '';
        const cardClass = `matrix-card group flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 transition-all hover:border-blue-300 hover:shadow-md${hiddenClass}`;
        const searchIndex = [
          entry.model.name,
          entry.model.short_name,
          entry.model.family,
          entry.hardware.id,
          entry.hardware.name,
          entry.hardware.short_name,
          entry.hardware.vendor,
          entry.hardware.series,
          entry.hardware.category || '',
          entry.hardware.backend,
          entry.hardware.memory_type,
          res.status,
          speedTier,
          'uncensored abliterated heretic dolphin',
        ]
          .join(' ')
          .toLowerCase();

        const hwOnArgs = JSON.stringify({ hw: entry.hardware.name });
        const layerArgs = JSON.stringify({ fit: res.gpu_layers_fit, total: res.total_layers });
        const statusAttrs = res.status === 'OOM' ? 'status.oom' : undefined;
        const hasMaxFit = Boolean(
          entry.max_fit_context && entry.max_fit_context > 0 && entry.max_fit_total_vram_gb,
        );
        const maxFitCtxLabel = hasMaxFit ? formatContextLabel(entry.max_fit_context!) : '';
        const maxFitGbStr = hasMaxFit ? entry.max_fit_total_vram_gb!.toFixed(1) : '';
        const hasMaxFitSpeed = Boolean(hasMaxFit && entry.max_fit_tps_high && entry.max_fit_tps_high > 0);
        const maxFitI18nKey = hasMaxFitSpeed
          ? 'common.maxFitWithSpeed'
          : hasMaxFit
            ? 'common.maxFitLabel'
            : 'common.maxFitNone';
        const maxFitArgs = hasMaxFitSpeed
          ? JSON.stringify({
              ctx: maxFitCtxLabel,
              gb: maxFitGbStr,
              low: entry.max_fit_tps_low,
              high: entry.max_fit_tps_high,
            })
          : hasMaxFit
            ? JSON.stringify({ ctx: maxFitCtxLabel, gb: maxFitGbStr })
            : undefined;
        const maxFitDisplayText = hasMaxFitSpeed
          ? `Max Fit: ${maxFitCtxLabel} (${maxFitGbStr} GB · ~${entry.max_fit_tps_low}–${entry.max_fit_tps_high} tok/s)`
          : hasMaxFit
            ? `Max Fit: ${maxFitCtxLabel} (${maxFitGbStr} GB)`
            : 'Max Fit: Offload req.';
        const altFmt = entry.alt_format_summary;
        const altLabelPrefix = altFmt ? (altFmt.format === 'MLX' ? 'MLX 4-bit' : 'AWQ 4-bit') : '';
        const altSpeedStr = altFmt
          ? altFmt.status === 'OOM'
            ? 'OOM'
            : `~${altFmt.est_tps_low}–${altFmt.est_tps_high} tok/s`
          : '';
        const altLineText = altFmt
          ? `${altLabelPrefix}: ${altFmt.total_vram_gb.toFixed(1)} GB · ${altSpeedStr}`
          : '';
        const cardMeasured = measuredByPair.get(`${entry.model.id}::${entry.hardware.id}`);
        const cardMeasuredText = cardMeasured
          ? `${cardMeasured.gen_tps_low}–${cardMeasured.gen_tps_high} tok/s measured`
          : '';
        const cardMeasuredArgs = cardMeasured
          ? JSON.stringify({ low: cardMeasured.gen_tps_low, high: cardMeasured.gen_tps_high })
          : undefined;
        const showMeasuredBadge = Boolean(cardMeasured);
        const showFormulaOnlyBadge = !cardMeasured && res.status !== 'OOM';
        const verdictKey =
          res.status === 'Fits'
            ? 'card.verdictFits'
            : res.status === 'Tight Fit'
              ? 'card.verdictTight'
              : res.status === 'Partial Offload'
                ? 'card.verdictPartial'
                : 'card.verdictOom';
        const verdictArgs = JSON.stringify({
          vram: res.total_vram_gb.toFixed(1),
          usable: usable.toFixed(1),
          margin: Math.max(0, usable - res.total_vram_gb).toFixed(1),
          fit: res.gpu_layers_fit,
          total: res.total_layers,
          params: entry.model.params_b,
          arch: entry.model.architecture,
        });

        return (
          <article
            data-card
            data-index={idx}
            data-tps={res.est_tps}
            data-vram={res.total_vram_gb}
            data-params={entry.model.params_b}
            data-status-rank={rank}
            data-model={entry.model.id}
            data-hardware={entry.hardware.id}
            data-vendor={entry.hardware.vendor}
            data-status={res.status}
            data-search={searchIndex}
            class={cardClass}
          >
            <div>
              <div class="flex items-start justify-between gap-2">
                <div class="flex flex-wrap items-center gap-1.5">
                  <StatusBadge status={res.status} />
                  <SpeedBadge tier={speedTier} short={true} />
                  <span
                    class="rounded bg-blue-50 px-1.5 py-0.5 text-[10px] font-semibold text-blue-700"
                    data-i18n="common.fullGuide"
                  >
                    Full Guide
                  </span>
                </div>
                <span class="shrink-0 rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[11px] font-semibold text-slate-600">
                  {entry.hardware.backend} · {entry.hardware.bandwidth_gbps} GB/s
                </span>
              </div>

              <h2 class="mt-3.5 text-base font-bold tracking-tight text-slate-950 group-hover:text-blue-600 transition-colors">
                <a href={detailHref} class="focus:outline-none">
                  {entry.model.short_name}
                  <span
                    class="block text-sm font-semibold text-slate-600"
                    data-i18n="common.onPrefix"
                    data-i18n-args={hwOnArgs}
                  >
                    on {entry.hardware.name}
                  </span>
                </a>
              </h2>

              <p
                class="mt-2 line-clamp-2 text-xs leading-relaxed text-slate-600"
                data-i18n={verdictKey}
                data-i18n-args={verdictArgs}
                data-i18n-keep-en="true"
              >
                {entry.verdict_summary}
              </p>
            </div>

            <div class="mt-4 pt-4 border-t border-slate-100">
              <div class="flex items-center justify-between text-xs">
                <span class="text-slate-500" data-i18n="common.vram8kLabel">VRAM @ 8K</span>
                <span class="font-mono font-semibold text-slate-900 tabular-nums">
                  {res.total_vram_gb.toFixed(1)} / {usable.toFixed(1)} GB
                </span>
              </div>
              <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-slate-100">
                <div class={fillBarClass} style={fillStyle}></div>
              </div>
              <div class="mt-1.5 flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-500 tabular-nums">
                <span data-i18n={maxFitI18nKey} data-i18n-args={maxFitArgs}>
                  {maxFitDisplayText}
                </span>
                <div class="flex items-center gap-1.5 shrink-0">
                  {showMeasuredBadge && (
                    <span
                      class="rounded border border-emerald-200 bg-emerald-50 px-1.5 py-0.5 font-mono text-[10px] font-semibold text-emerald-800"
                      data-i18n="speed.measuredUnit"
                      data-i18n-args={cardMeasuredArgs}
                    >
                      {cardMeasuredText}
                    </span>
                  )}
                  {showFormulaOnlyBadge && (
                    <span class="rounded border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-mono text-[10px] text-slate-500" data-i18n="speed.formulaOnly">
                      Formula only (unverified)
                    </span>
                  )}
                </div>
              </div>
              {altFmt && (
                <div class="mt-1 font-mono text-[11px] text-slate-600 tabular-nums">
                  {altLineText}
                </div>
              )}

              <div class="mt-3 flex items-center justify-between">
                <div class="flex items-baseline gap-1.5">
                  <span class="font-mono text-base sm:text-lg font-bold text-slate-950 tabular-nums" data-i18n={statusAttrs}>
                    {tpsDisplay}
                  </span>
                  <span
                    class="text-[11px] text-slate-500 tabular-nums"
                    data-i18n="common.layersCount"
                    data-i18n-args={layerArgs}
                  >
                    ({res.gpu_layers_fit}/{res.total_layers} layers)
                  </span>
                </div>

                <a
                  href={detailHref}
                  class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-800"
                  data-i18n="common.openCalc"
                >
                  Open Calc -&gt;
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Progressive Pagination Controls (Curated Guides) -->
    <div id="pagination-bar" class={paginationHiddenClass}>
      <div class="w-full sm:max-w-xs">
        <p
          id="pagination-summary"
          class="font-mono text-xs font-medium text-slate-600 tabular-nums"
          data-i18n="home.viewingGuides"
          data-i18n-args={initViewArgs}
        >
          Viewing {initialVisibleCount} of {totalCount} matching guides
        </p>
        <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-slate-100">
          <div
            id="pagination-bar-fill"
            class="h-full rounded-full bg-blue-600 transition-all duration-200"
            style={initialProgressStyle}
          ></div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 shrink-0">
        <button
          id="load-more-btn"
          type="button"
          class="rounded-lg bg-slate-950 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800 transition-colors cursor-pointer"
          data-i18n="home.loadMoreGuides"
          data-i18n-args={initLoadArgs}
        >
          Load 24 More ({initialRemainingCount} left)
        </button>
        <button
          id="show-all-btn"
          type="button"
          class="rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 hover:border-blue-300 hover:text-blue-700 transition-colors cursor-pointer"
          data-i18n="home.showAllRemaining"
        >
          Show All Remaining
        </button>
      </div>
    </div>

    <!-- Live Full-Catalog & Custom Rig Calculations -->
    <section id="live-calc-section" class="mt-6 hidden" aria-label="Live Catalog Estimates">
      <div id="live-calc-header" class="flex flex-col gap-3 rounded-2xl border border-blue-200 bg-blue-50/60 p-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <span
              id="live-calc-badge"
              class="rounded-full bg-blue-600 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-white"
            >
              Live Catalog Physics
            </span>
            <h2 id="live-calc-heading" class="text-sm font-bold text-slate-950">
              Additional Live Catalog Estimates
            </h2>
          </div>
          <p id="live-calc-sub" class="mt-1 text-xs text-slate-600">
            Instant @8K + Max Fit calculations across all {catalogModelCount} models &amp; {catalogHwCount} catalog GPUs. Click any card for AWQ/MLX format toggles, reserve profiles, and multi-GPU splits.
          </p>
        </div>
        <a
          id="live-sim-cta"
          href="/calculator/"
          class="inline-flex shrink-0 items-center justify-center rounded-lg bg-blue-600 px-3.5 py-2 text-xs font-semibold text-white hover:bg-blue-700 transition-colors"
        >
          Open in Multi-GPU / CPU Simulator -&gt;
        </a>
      </div>

      <div id="live-calc-grid" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>

      <div id="live-pagination-bar" class="mt-5 hidden">
        <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-xs">
          <span id="live-pagination-summary" class="font-mono text-slate-600 tabular-nums"></span>
          <button
            id="live-load-more-btn"
            type="button"
            class="rounded-lg bg-slate-900 px-3.5 py-1.5 font-semibold text-white hover:bg-slate-800 cursor-pointer"
          >
            Load More Live Estimates
          </button>
        </div>
      </div>
    </section>

    <!-- Empty Filter State -->
    <div
      id="empty-state"
      class="mt-6 hidden rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center"
    >
      <p class="text-base font-semibold text-slate-900" data-i18n="home.emptyTitle">No matching Model × Rig configurations</p>
      <p class="mt-1 text-sm text-slate-500" data-i18n="home.emptyDesc">
        Try relaxing the status filter, adding GPU capacity, or launch the full Rig Simulator.
      </p>
      <div class="mt-4 flex flex-wrap justify-center gap-2">
        <button
          id="empty-reset-btn"
          type="button"
          class="rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800 cursor-pointer"
          data-i18n="common.resetAll"
        >
          Reset All Filters
        </button>
        <a
          id="empty-sim-link"
          href="/calculator/"
          class="rounded-lg border border-blue-200 bg-blue-50 px-4 py-2 text-xs font-semibold text-blue-700 hover:bg-blue-100"
          data-i18n="home.emptySimBtn"
        >
          Open Custom Rig Simulator -&gt;
        </a>
      </div>
    </div>

    <script type="application/json" id="home-catalog-json" set:html={homeCatalogPayload}></script>
  </section>

  <!-- Measured Community Benchmarks vs Formula Estimates -->
  <section id="measured-benchmarks" class="mx-auto max-w-6xl px-4 pt-6 sm:px-6" aria-labelledby="measured-heading">
    <div class="min-w-0 max-w-full rounded-2xl border border-sky-200 bg-white p-5 shadow-xs sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h2 id="measured-heading" class="text-base font-bold tracking-tight text-slate-950" data-i18n="home.measuredTitle">
              Measured Community Benchmarks vs Formula Estimates
            </h2>
            <span
              class="rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 font-mono text-[10px] font-semibold text-emerald-800"
              data-i18n="speed.measuredBadge"
            >
              Measured
            </span>
            <span
              class="rounded-full border border-sky-200 bg-sky-50 px-2 py-0.5 font-mono text-[10px] font-semibold text-sky-900"
              data-i18n="home.measuredCoverage"
              data-i18n-args={measuredCoverageArgs}
            >
              {measuredRows.length} / {totalCount} guides measured · {formulaOnlyCount} formula-only
            </span>
          </div>
          <p class="mt-1 text-xs text-slate-600" data-i18n="home.measuredSub" data-i18n-args={measuredSubArgs}>
            Side-by-side comparison of {measuredRows.length} reproducible community &amp; framework runs (batch=1 decode, including Qwen3-30B-A3B MoE) against calibrated Physics {engineVersion} formula ranges.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 font-mono text-[11px] text-slate-600">
            llama.cpp · vLLM · mlx-lm
          </span>
          <a
            href="https://github.com/Kiwi392251/vramcalc/issues/new?title=Benchmark+Submission&labels=benchmark"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-lg border border-blue-200 bg-blue-50 px-2.5 py-1 text-[11px] font-semibold text-blue-700 hover:bg-blue-100 transition-colors"
            data-i18n="home.submitBenchmark"
          >
            Submit Real Run -&gt;
          </a>
        </div>
      </div>

      <div class="mt-4 w-full max-w-full overflow-x-auto rounded-xl border border-slate-200">
        <table class="w-full min-w-[1000px] border-collapse text-left text-xs">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50 text-[11px] font-semibold uppercase tracking-wider text-slate-500">
              <th class="px-3.5 py-2.5" data-i18n="home.measuredColPair">Model × Hardware</th>
              <th class="px-3.5 py-2.5" data-i18n="home.measuredColFormat">Format / Runtime</th>
              <th class="px-3.5 py-2.5" data-i18n="home.measuredColMeasured">Measured Speed</th>
              <th class="px-3.5 py-2.5" data-i18n="home.measuredColFormula">Formula Est. (±17–25%)</th>
              <th class="px-3.5 py-2.5" data-i18n="home.measuredColDelta">Δ Mid</th>
              <th class="px-3.5 py-2.5" data-i18n="home.measuredColRepro">Date · Prompt · Repro</th>
              <th class="px-3.5 py-2.5" data-i18n="home.measuredColSource">Source</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
