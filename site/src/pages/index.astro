---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComboboxField from '../components/ComboboxField.astro';
import CustomSelect from '../components/CustomSelect.astro';
import StatusBadge from '../components/StatusBadge.astro';
import catalogRaw from '../data/catalog_data.json';
import rawPagesData from '../data/pages_data.json';
import type { CatalogData, PageEntry, QuantKey, RuntimeFormat, SpeedTier } from '../types/vram';
import {
  buildHardwareHubs,
  buildModelHubs,
  getBenchmarksMethodologyNote,
  getReferenceBenchmarks,
  statusRank,
} from '../utils/hubs';
import {
  classifySpeedTier,
  effectiveUsableVramGb,
  estimateRigRun,
  formatContextLabel,
  formatTpsRange,
  QUANT_SHORT_LABELS,
} from '../utils/physics';

const PAGE_SIZE = 24;
const HOME_QUANT_OPTIONS: ReadonlyArray<{
  key: QuantKey;
  label: string;
  title: string;
}> = [
  { key: 'Q4_K_M', label: 'Q4_K_M', title: 'GGUF · 4.85 bpw (Default 4-bit)' },
  { key: 'Q5_K_M', label: 'Q5_K_M', title: 'GGUF · 5.65 bpw (5-bit)' },
  { key: 'Q6_K', label: 'Q6_K', title: 'GGUF · 6.56 bpw (6-bit)' },
  { key: 'Q8_0', label: 'Q8_0', title: 'GGUF · 8.50 bpw (8-bit)' },
  { key: 'FP16', label: 'FP16', title: 'Unquantized · 16.0 bpw' },
  { key: 'MLX_4BIT', label: 'MLX 4-bit', title: 'Apple Silicon MLX · 4.55 bpw' },
  { key: 'AWQ_4BIT', label: 'AWQ 4-bit', title: 'vLLM AWQ Marlin · 4.75 bpw' },
];
const catalog = catalogRaw as CatalogData;
const rawEntries = rawPagesData as PageEntry[];
const updatedAt = catalog.updated_at ?? '2026-11-24';
const engineVersion = catalog.engine_version ?? 'v3.3';

const FEATURED_TOP_SLUGS = [
  'qwen3.8-27b-on-nvidia-a10-24gb',
  'qwen3.8-27b-on-rtx-4090-24gb',
  'qwen3.8-27b-on-apple-m4-pro-48gb',
  'qwen3.8-27b-on-apple-m4-16gb',
  'qwen3-8b-on-apple-m4-16gb',
  'qwen3.8-27b-on-rtx-5090-32gb',
  'qwen3.8-27b-on-nvidia-l4-24gb',
  'qwen3-14b-on-nvidia-t4-16gb',
  'qwen3-32b-on-nvidia-a10-24gb',
  'gemma-3-27b-on-nvidia-a10-24gb',
  'qwen3-30b-a3b-on-apple-m4-pro-48gb',
  'llama-3.3-70b-on-dual-rtx-4090-48gb',
  'deepseek-r1-70b-on-ryzen-ai-max-395-128gb',
  'qwen3.8-27b-on-apple-m4-max-128gb',
  'qwen3-32b-on-rtx-4090-24gb',
  'qwen3-32b-on-rtx-5090-32gb',
  'qwen3-8b-on-nvidia-t4-16gb',
  'qwen3-14b-on-nvidia-a10-24gb',
  'gemma-3-27b-on-rtx-4090-24gb',
  'qwen3-32b-on-apple-m4-max-128gb',
  'qwen3-30b-a3b-on-nvidia-a10-24gb',
  'deepseek-r1-7b-on-apple-m4-16gb',
  'llama-3.1-8b-on-apple-m4-16gb',
  'gemma-3-27b-on-nvidia-l4-24gb',
];
const featuredRank = new Map(FEATURED_TOP_SLUGS.map((slug, idx) => [slug, idx]));

const entries = [...rawEntries].sort((a, b) => {
  const fa = featuredRank.get(a.slug);
  const fb = featuredRank.get(b.slug);
  if (fa !== undefined && fb !== undefined) return fa - fb;
  if (fa !== undefined) return -1;
  if (fb !== undefined) return 1;
  const sr = statusRank(a.default_result.status) - statusRank(b.default_result.status);
  if (sr !== 0) return sr;
  if (b.model.params_b !== a.model.params_b) return b.model.params_b - a.model.params_b;
  if (b.default_result.est_tps !== a.default_result.est_tps) {
    return b.default_result.est_tps - a.default_result.est_tps;
  }
  return a.slug.localeCompare(b.slug);
});

const totalCount = entries.length;
const initialVisibleCount = Math.min(PAGE_SIZE, totalCount);
const initialRemainingCount = Math.max(0, totalCount - initialVisibleCount);
const initialProgressPct = totalCount > 0 ? Math.round((initialVisibleCount / totalCount) * 100) : 100;
const initialProgressStyle = `width: ${initialProgressPct}%`;
const paginationHiddenClass =
  'mt-7 hidden surface-card p-4 sm:p-5 flex-col gap-4 sm:flex-row sm:items-center sm:justify-between';

const uniqueHubModels = [...catalog.models].sort((a, b) => a.name.localeCompare(b.name));
const uniqueHubHardware = [...catalog.hardware].sort((a, b) => a.name.localeCompare(b.name));

const uniqueHubModelCount = uniqueHubModels.length;
const uniqueHubHwCount = uniqueHubHardware.length;
const catalogModelCount = catalog.models.length;
const catalogHwCount = catalog.hardware.length;
const updatedArgs = JSON.stringify({ date: updatedAt });

const curatedKeys = entries.map((e) => `${e.model.id}::${e.hardware.id}`);
const curatedSlugs: Record<string, string> = {};
for (const e of entries) {
  curatedSlugs[`${e.model.id}::${e.hardware.id}`] = e.slug;
}
const measuredAnchors = getReferenceBenchmarks({});
const measuredNote = getBenchmarksMethodologyNote();
const measuredByPair = new Map<string, (typeof measuredAnchors)[number]>();
const measuredPairs: Record<string, string> = {};
const measuredAnchorDetails: Record<
  string,
  { low: number; high: number; quant: QuantKey; format: RuntimeFormat }
> = {};
for (const anc of measuredAnchors) {
  const pk = `${anc.model_id}::${anc.hardware_id}`;
  if (!measuredByPair.has(pk)) {
    measuredByPair.set(pk, anc);
    measuredPairs[pk] = `${anc.gen_tps_low}–${anc.gen_tps_high} tok/s measured`;
    measuredAnchorDetails[pk] = {
      low: anc.gen_tps_low,
      high: anc.gen_tps_high,
      quant: anc.quant,
      format: anc.format,
    };
  }
}
const homeCatalogPayload = JSON.stringify({
  models: catalog.models,
  hardware: catalog.hardware,
  cpus: catalog.cpus,
  curatedKeys,
  curatedSlugs,
  measuredPairs,
  measuredAnchorDetails,
});

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'VRAMCalc.me',
  url: 'https://vramcalc.me/',
  description:
    'Local AI LLM VRAM calculator and inference tokens/sec estimator across NVIDIA RTX, Apple Silicon, AMD Radeon, Intel Arc, Multi-GPU rigs, and CPU/RAM.',
};

const homeCollectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Local AI Model VRAM & Inference Speed Matrix',
  url: 'https://vramcalc.me/',
  description: `Compatibility matrix indexing ${totalCount} deep benchmark guides and live calculations across ${catalogHwCount} GPUs (1x-8x) and ${catalogModelCount} open-weight models.`,
  hasPart: [
    {
      '@type': 'CollectionPage',
      name: 'Multi-GPU & CPU/RAM Rig Simulator',
      url: 'https://vramcalc.me/calculator/',
    },
    {
      '@type': 'CollectionPage',
      name: `All Local AI GPUs (${uniqueHubHwCount} Hardware Hubs)`,
      url: 'https://vramcalc.me/gpu/',
    },
    {
      '@type': 'CollectionPage',
      name: `All Open-Weight LLMs (${uniqueHubModelCount} Model Hubs)`,
      url: 'https://vramcalc.me/model/',
    },
  ],
};
const homeOgTitle = `Local AI LLM VRAM & Speed Calculator (${catalogModelCount} Models × ${catalogHwCount} GPUs · Updated ${updatedAt}) | VRAMCalc.me`;
const homeOgDescription = `Check GGUF, AWQ & MLX VRAM fit, max safe context, Tight Fit & PCIe All-Reduce headroom, and measured + formula tok/s ranges across ${catalogHwCount} GPUs & Macs and ${catalogModelCount} open LLMs (Qwen3.8-27B, Qwen3, Gemma 3, DeepSeek-R1, Llama-3.3).`;

const curatedSlugMap = new Map(Object.entries(curatedSlugs));
const modelCatalogMap = new Map(catalog.models.map((m) => [m.id, m]));
const hwCatalogMap = new Map(catalog.hardware.map((h) => [h.id, h]));

const measuredRows = measuredAnchors
  .map((anc) => {
    const m = modelCatalogMap.get(anc.model_id);
    const h = hwCatalogMap.get(anc.hardware_id);
    if (!m || !h) return null;
    const est = estimateRigRun({
      model: m,
      hardware: h,
      gpuCount: h.gpu_count || 1,
      quant: anc.quant,
      format: anc.format,
      contextTokens: anc.context_tokens,
      kvQuant: 'fp16',
      reserveProfile: 'desktop',
    });
    const slug = curatedSlugMap.get(`${m.id}::${h.id}`);
    const measMid = (anc.gen_tps_low + anc.gen_tps_high) / 2.0;
    const fLow = est.est_tps_low ?? 0;
    const fHigh = est.est_tps_high ?? 0;
    const fMid = (fLow + fHigh) / 2.0;
    const deltaPct = Math.round(((fMid - measMid) / measMid) * 1000) / 10;
    const deltaText = deltaPct === 0 ? '0.0%' : `${deltaPct > 0 ? '+' : ''}${deltaPct.toFixed(1)}%`;
    const is2026 = anc.date.startsWith('2026');
    const is2025 = anc.date.startsWith('2025');
    const freshKey = is2026
      ? 'home.measuredFresh2026'
      : is2025
        ? 'home.measuredFresh2025'
        : 'home.measuredFreshLegacy';
    const freshLabel = is2026 ? '2026 run' : is2025 ? '2025 baseline' : 'Legacy 2024';
    const freshClass = is2026
      ? 'badge-fits inline-flex items-center rounded-md border px-1.5 py-0.5 font-mono text-[11px] font-semibold whitespace-nowrap'
      : is2025
        ? 'badge-neutral inline-flex items-center rounded-md border px-1.5 py-0.5 font-mono text-[11px] font-medium whitespace-nowrap'
        : 'badge-partial inline-flex items-center rounded-md border px-1.5 py-0.5 font-mono text-[11px] font-semibold whitespace-nowrap';
    const vendorDotClass =
      h.vendor === 'Apple'
        ? 'bg-[var(--ink-primary)]'
        : h.vendor === 'NVIDIA'
          ? 'bg-emerald-500'
          : h.vendor === 'AMD'
            ? 'bg-rose-500'
            : h.vendor === 'Intel'
              ? 'bg-sky-500'
              : 'bg-[var(--ink-tertiary)]';
    return {
      anc,
      model: m,
      hardware: h,
      est,
      pairHref: slug ? `/can-i-run/${slug}/` : `/gpu/${h.id}/`,
      ctxLabel: formatContextLabel(anc.context_tokens),
      measuredText: `${anc.gen_tps_low}–${anc.gen_tps_high} tok/s measured`,
      measuredUnitArgs: JSON.stringify({ low: anc.gen_tps_low, high: anc.gen_tps_high }),
      formulaText: formatTpsRange(est.est_tps_low, est.est_tps_high, est.est_tps, est.status),
      deltaText,
      freshKey,
      freshLabel,
      freshClass,
      vendorDotClass,
    };
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);

const modelHubRows = buildModelHubs(entries);
const hwHubRows = buildHardwareHubs(entries);

const staticIndexRows = entries.map((e) => {
  const res = e.default_result;
  const usable =
    res.effective_usable_vram_gb ??
    effectiveUsableVramGb(e.hardware, e.hardware.gpu_count || 1, 'desktop')[1];
  const speedTier: SpeedTier = res.speed_tier ?? classifySpeedTier(res.est_tps, res.status);
  const tpsText = formatTpsRange(res.est_tps_low, res.est_tps_high, res.est_tps, res.status);
  const hasMaxFit = Boolean(e.max_fit_context && e.max_fit_context > 0 && e.max_fit_total_vram_gb);
  const hasMaxFitSpeed = Boolean(hasMaxFit && e.max_fit_tps_high && e.max_fit_tps_high > 0);
  const maxFitText = hasMaxFitSpeed
    ? `${formatContextLabel(e.max_fit_context!)} (${e.max_fit_total_vram_gb!.toFixed(1)} GB · ~${e.max_fit_tps_low}–${e.max_fit_tps_high} tok/s)`
    : hasMaxFit
      ? `${formatContextLabel(e.max_fit_context!)} (${e.max_fit_total_vram_gb!.toFixed(1)} GB)`
      : 'Offload req.';
  const alt = e.alt_format_summary;
  const altText = alt
    ? `${alt.format}: ${alt.total_vram_gb.toFixed(1)} GB · ${
        alt.status === 'OOM' ? 'OOM' : `~${alt.est_tps_low}–${alt.est_tps_high} tok/s`
      }`
    : '—';
  const isMeasured = measuredByPair.has(`${e.model.id}::${e.hardware.id}`);
  return {
    href: `/can-i-run/${e.slug}/`,
    modelShort: e.model.short_name,
    hwShort: e.hardware.name,
    vramText: `${res.total_vram_gb.toFixed(1)} / ${usable.toFixed(1)} GB`,
    altText,
    maxFitText,
    status: res.status,
    speedTier,
    tpsText,
    isMeasured,
  };
});

const sortSelectOptions = [
  { value: 'featured', label: 'Recommended', dataI18n: 'home.sortRecommended' },
  { value: 'tps-desc', label: 'Fastest tok/s', dataI18n: 'home.sortFastest' },
  { value: 'vram-asc', label: 'Lowest VRAM', dataI18n: 'home.sortLowestVram' },
  { value: 'params-desc', label: 'Largest Model', dataI18n: 'home.sortLargestModel' },
];

const heroDescArgs = JSON.stringify({ models: catalogModelCount, hw: catalogHwCount });
const ctaGpusArgs = JSON.stringify({ count: uniqueHubHwCount });
const ctaModelsArgs = JSON.stringify({ count: uniqueHubModelCount });
const awaitCountArgs = JSON.stringify({ models: catalogModelCount, hw: catalogHwCount });
const awaitDescArgs = JSON.stringify({ models: catalogModelCount });
const awaitPresetsArgs = JSON.stringify({ total: totalCount });
const initViewArgs = JSON.stringify({ shown: initialVisibleCount, total: totalCount });
const initLoadArgs = JSON.stringify({ chunk: Math.min(PAGE_SIZE, initialRemainingCount), left: initialRemainingCount });
const modelHubsArgs = JSON.stringify({ count: uniqueHubModelCount });
const hwHubsArgs = JSON.stringify({ count: uniqueHubHwCount });
const dirSubArgs = JSON.stringify({ models: uniqueHubModelCount, hw: uniqueHubHwCount, guides: totalCount });
const measuredSubArgs = JSON.stringify({ count: measuredRows.length });
const heroEngineArgs = JSON.stringify({ ver: engineVersion });
const formulaOnlyCount = Math.max(0, totalCount - measuredRows.length);
const measuredCoverageArgs = JSON.stringify({
  measured: measuredRows.length,
  total: totalCount,
  formulaOnly: formulaOnlyCount,
});
const staticIndexTitleArgs = JSON.stringify({ count: totalCount });
const staticIndexSubArgs = JSON.stringify({
  guides: totalCount,
  models: catalogModelCount,
  hw: catalogHwCount,
  combos: catalogModelCount * catalogHwCount,
});
---

<BaseLayout
  title="VRAMCalc.me — Local AI Model VRAM & Speed Calculator"
  description="Check whether Qwen3.8-27B, Qwen3, Gemma 3, DeepSeek-R1, and Llama run on Apple Silicon M1–M5, NVIDIA GTX/RTX (1x–8x), T4/L4/A10/H200, AMD Radeon / Strix Halo, Intel Arc, or CPU RAM."
  canonicalPath="/"
  totalPages={totalCount}
  ogTitle={homeOgTitle}
  ogDescription={homeOgDescription}
  ogImage="/og/home.png"
  ogImageAlt={homeOgTitle}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(homeCollectionSchema)} />
  </Fragment>

  <section class="border-b border-[var(--border-hairline)] bg-[var(--bg-surface)]">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-[42px] font-bold tracking-[-0.03em] leading-[1.12] text-[var(--ink-primary)]" data-i18n="home.heroTitle">
          Local AI Model VRAM &amp; Inference Speed Matrix
        </h1>
        <p class="mt-4 text-[15px] sm:text-base leading-relaxed text-[var(--ink-secondary)]" data-i18n="home.heroDesc" data-i18n-args={heroDescArgs}>
          Check memory fit, max safe context, and honest bandwidth throughput ranges across {catalogModelCount} models (Qwen3.8-27B, Qwen3, Gemma 3, DeepSeek-R1, Llama-3.3) and {catalogHwCount} GPUs &amp; Macs (M4 16GB, T4, L4, A10, RTX 5090), supporting GGUF, AWQ, MLX, and 1x–8x multi-GPU topologies.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href="/calculator/"
            class="btn-primary px-4 py-2.5 text-xs sm:text-[13px]"
            data-i18n="home.ctaSimulator"
          >
            Multi-GPU, AWQ/MLX &amp; CPU Simulator -&gt;
          </a>
          <a
            href="/gpu/"
            class="btn-secondary px-4 py-2.5 text-xs sm:text-[13px]"
            data-i18n="home.ctaGpus"
            data-i18n-args={ctaGpusArgs}
          >
            Browse {uniqueHubHwCount} GPU Hubs -&gt;
          </a>
          <a
            href="/model/"
            class="btn-secondary px-4 py-2.5 text-xs sm:text-[13px]"
            data-i18n="home.ctaModels"
            data-i18n-args={ctaModelsArgs}
          >
            Browse {uniqueHubModelCount} Model Hubs -&gt;
          </a>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs text-[var(--ink-tertiary)]">
          <span class="inline-flex items-center gap-1.5 font-mono font-medium text-emerald-600 dark:text-emerald-400">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
            <span data-i18n="common.updated" data-i18n-args={updatedArgs}>
              Updated {updatedAt}
            </span>
          </span>
          <span aria-hidden="true">·</span>
          <a
            href="/changelog/"
            class="font-mono hover:text-[var(--accent-ink)] transition-colors"
            data-i18n="home.heroEnginePill"
            data-i18n-args={heroEngineArgs}
          >
            Physics {engineVersion} · Changelog · Formula Estimate (±17–25%)
          </a>
          <span aria-hidden="true">·</span>
          <a
            href="#measured-benchmarks"
            class="font-mono font-medium text-[var(--ink-secondary)] hover:text-[var(--accent-ink)] transition-colors"
            data-i18n="home.heroMeasuredPill"
            data-i18n-args={measuredSubArgs}
          >
            {measuredRows.length} Measured
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Hardware Rig Configurator + Compatibility Matrix -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <div id="rig-config-panel" class="surface-card p-5 sm:p-7">
      <!-- Row 1: CPU + RAM + GPU + QTY -->
      <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.45fr)_minmax(0,0.75fr)_minmax(0,1.45fr)_124px] lg:items-end">
        <div>
          <ComboboxField
            id="cb-cpu"
            label="CPU / Unified Chip"
            placeholder="Search i5/i7, Ryzen, Apple M1–M5..."
            cascader={true}
            labelI18n="home.cpuLabel"
            placeholderI18n="home.cpuPlaceholder"
          />
        </div>

        <div>
          <ComboboxField
            id="cb-ram"
            label="RAM (GB)"
            placeholder="e.g. 32 GB"
            labelI18n="home.ramLabel"
            placeholderI18n="home.ramPlaceholder"
          />
        </div>

        <div>
          <ComboboxField
            id="cb-gpu"
            label="GPU (Graphics Card)"
            placeholder="Search GPU or None (CPU-Only)..."
            cascader={true}
            labelI18n="home.gpuLabel"
            placeholderI18n="home.gpuPlaceholder"
          />
        </div>

        <div>
          <span
            class="block text-xs font-medium text-[var(--ink-secondary)]"
            data-i18n="home.qtyLabel"
          >
            Qty
          </span>
          <div class="mt-1.5">
            <CustomSelect
              id="rig-gpu-count"
              options={[{ value: '0', label: '—' }]}
              value="0"
              disabled={true}
              ariaLabel="GPU quantity"
              ariaLabelI18n="home.qtyLabel"
            />
          </div>
        </div>
      </div>

      <!-- Conditional Sub-Bar: Unified Memory Info / Multi-GPU Split / CPU-Only Info -->
      <div
        id="rig-context-bar"
        class="mt-3.5 hidden rounded-xl border border-[var(--accent-border)] bg-[var(--accent-soft)] px-3.5 py-2.5 text-xs text-[var(--ink-primary)]"
      >
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span id="rig-context-text" class="font-medium"></span>
          <div id="rig-split-toggle" class="hidden">
            <div class="seg-track" role="group" aria-label="Multi-GPU split strategy">
              <button
                type="button"
                data-home-split="layer"
                data-active="true"
                class="seg-btn text-[11px]"
                data-i18n="home.layerSplit"
              >
                Layer Split
              </button>
              <button
                type="button"
                data-home-split="tensor"
                data-active="false"
                class="seg-btn text-[11px]"
                data-i18n="home.tensorParallel"
              >
                Tensor Parallel
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Quantization + OS Reserve Profile Strip -->
      <div class="mt-3.5 flex flex-wrap items-center justify-between gap-x-5 gap-y-2.5 border-t border-[var(--border-hairline)] pt-3.5">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="text-xs font-medium text-[var(--ink-secondary)]" data-i18n="home.quantLabel">
            Quantization
          </span>
          <div class="seg-track" role="radiogroup" aria-label="Quantization" data-i18n-aria="home.quantLabel">
            {HOME_QUANT_OPTIONS.map((q) => {
              const active = q.key === 'Q4_K_M';
              return (
                <button
                  type="button"
                  role="radio"
                  aria-checked={active ? 'true' : 'false'}
                  data-home-quant={q.key}
                  data-active={active ? 'true' : 'false'}
                  title={q.title}
                  class="seg-btn font-mono text-[11px] sm:text-xs"
                >
                  {q.label}
                </button>
              );
            })}
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <span class="text-xs font-medium text-[var(--ink-secondary)]" data-i18n="reserve.title">
            OS Reserve Profile
          </span>
          <div class="seg-track" role="group" aria-label="OS Reserve Profile">
            <button
              type="button"
              data-home-reserve="desktop"
              data-active="true"
              data-i18n="reserve.desktop"
              class="seg-btn"
            >
              Daily Desktop
            </button>
            <button
              type="button"
              data-home-reserve="clean"
              data-active="false"
              data-i18n="reserve.clean"
              class="seg-btn"
            >
              Clean OS / Headless
            </button>
            <button
              type="button"
              data-home-reserve="custom"
              data-active="false"
              data-i18n="reserve.custom"
              class="seg-btn"
            >
              Custom GB
            </button>
          </div>
          <div id="home-custom-gb-wrap" class="hidden items-center gap-1.5">
            <label for="home-custom-gb" class="sr-only" data-i18n="reserve.customLabel">Usable ceiling (GB)</label>
            <input
              id="home-custom-gb"
              type="number"
              min="1"
              max="512"
              step="0.5"
              data-i18n-placeholder="home.reserveCustomPh"
              placeholder="e.g. 22.4"
              class="field-input h-8 w-24 px-2.5 font-mono text-xs font-semibold"
            />
            <span class="font-mono text-xs font-medium text-[var(--ink-tertiary)]">GB</span>
          </div>
        </div>
      </div>

      <!-- Row 2: Model + Status + Sort + Count + Reset -->
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-[var(--border-hairline)] pt-4">
        <div class="flex flex-wrap items-center gap-2.5">
          <div class="flex items-center gap-2">
            <span class="text-xs font-medium text-[var(--ink-secondary)]" data-i18n="home.modelLabel">Model</span>
            <div class="w-48 sm:w-56">
              <ComboboxField
                id="cb-model"
                label="Model"
                placeholder="All Models"
                compact={true}
                cascader={true}
                labelI18n="home.modelLabel"
              />
            </div>
          </div>

          <span class="hidden h-4 w-px bg-[var(--border-subtle)] sm:inline-block" aria-hidden="true"></span>

          <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter by status">
            {(['all', 'Fits', 'Tight Fit', 'Partial Offload', 'OOM'] as const).map((st) => {
              const stI18nKey =
                st === 'all'
                  ? 'status.allStatuses'
                  : st === 'Fits'
                    ? 'status.fits'
                    : st === 'Tight Fit'
                      ? 'status.tightFit'
                      : st === 'Partial Offload'
                        ? 'status.partialOffload'
                        : 'status.oom';
              return (
                <button
                  type="button"
                  data-status-btn={st}
                  data-active={st === 'all' ? 'true' : 'false'}
                  data-i18n={stI18nKey}
                  class="pill-filter"
                >
                  {st === 'all' ? 'All Statuses' : st}
                </button>
              );
            })}
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5 text-xs text-[var(--ink-secondary)]">
          <div class="flex items-center gap-1.5">
            <span class="text-[11px] font-medium text-[var(--ink-tertiary)]" data-i18n="home.sortLabel">
              Sort
            </span>
            <CustomSelect
              id="filter-sort"
              compact={true}
              align="right"
              options={sortSelectOptions}
              value="featured"
              ariaLabel="Sort results"
              ariaLabelI18n="home.sortLabel"
              buttonClass="min-w-[126px]"
            />
          </div>

          <span id="filter-count" class="font-mono text-[11px] text-[var(--ink-tertiary)] tabular-nums" data-i18n="home.countAwaitHw" data-i18n-args={awaitCountArgs}>
            Select hardware first · {catalogModelCount}×{catalogHwCount}
          </span>
          <button
            id="filter-reset"
            type="button"
            class="hidden font-semibold text-[var(--accent-ink)] hover:underline cursor-pointer"
            data-i18n="common.reset"
          >
            Reset
          </button>
        </div>
      </div>
    </div>

    <!-- Awaiting Hardware State (Default when no CPU / RAM / GPU is selected) -->
    <div
      id="await-hardware-panel"
      class="mt-6 surface-card px-5 py-9 text-center sm:px-8 sm:py-12"
    >
      <div class="mx-auto max-w-2xl">
        <div class="mx-auto mb-3.5 flex h-11 w-11 items-center justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-subtle)] text-[var(--ink-primary)]" aria-hidden="true">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="6" y="6" width="12" height="12" rx="2" />
            <rect x="9.5" y="9.5" width="5" height="5" rx="0.5" />
            <path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4" />
          </svg>
        </div>
        <span
          data-i18n="home.awaitBadge"
          class="badge-neutral inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-[11px] font-semibold"
        >
          No Hardware Selected
        </span>
        <h2
          data-i18n="home.awaitTitle"
          class="mt-3.5 text-lg font-semibold tracking-[-0.02em] text-[var(--ink-primary)] sm:text-xl"
        >
          Select your chip or GPU above to check VRAM fit
        </h2>
        <p
          data-i18n="home.awaitDesc"
          data-i18n-args={awaitDescArgs}
          class="mt-2 text-xs leading-relaxed text-[var(--ink-secondary)] sm:text-sm"
        >
          Until you pick a CPU/chip, RAM, or GPU above, no "Fits in VRAM" or speed verdict is shown. Choose any hardware to run live estimates across all {catalogModelCount} models.
        </p>

        <div
          id="await-model-req"
          class="mt-3.5 hidden rounded-xl border border-[var(--accent-border)] bg-[var(--accent-soft)] px-4 py-2.5 text-xs font-medium text-[var(--accent-ink)]"
        ></div>

        <div class="mt-6">
          <p class="text-[11px] font-medium text-[var(--ink-tertiary)]" data-i18n="home.awaitQuickTry">
            Or pick a common device to calculate right away:
          </p>
          <div class="mt-3 flex flex-wrap items-center justify-center gap-2">
            <button type="button" data-quick-soc="apple-m4" data-quick-ram="16" class="btn-secondary px-3.5 py-2 text-[13px] font-semibold hover:border-[var(--accent-border)] hover:text-[var(--accent-ink)]">Apple M4 <span class="rounded-md bg-[var(--bg-subtle)] px-1.5 py-0.5 font-mono text-[11px] font-medium text-[var(--ink-secondary)]">16GB</span></button>
            <button type="button" data-quick-soc="apple-m4-pro" data-quick-ram="48" class="btn-secondary px-3.5 py-2 text-[13px] font-semibold hover:border-[var(--accent-border)] hover:text-[var(--accent-ink)]">Apple M4 Pro <span class="rounded-md bg-[var(--bg-subtle)] px-1.5 py-0.5 font-mono text-[11px] font-medium text-[var(--ink-secondary)]">48GB</span></button>
            <button type="button" data-quick-gpu="rtx-4070-12gb" class="btn-secondary px-3.5 py-2 text-[13px] font-semibold hover:border-[var(--accent-border)] hover:text-[var(--accent-ink)]">RTX 4070 <span class="rounded-md bg-[var(--bg-subtle)] px-1.5 py-0.5 font-mono text-[11px] font-medium text-[var(--ink-secondary)]">12GB</span></button>
            <button type="button" data-quick-gpu="rtx-4090-24gb" class="btn-secondary px-3.5 py-2 text-[13px] font-semibold hover:border-[var(--accent-border)] hover:text-[var(--accent-ink)]">RTX 4090 <span class="rounded-md bg-[var(--bg-subtle)] px-1.5 py-0.5 font-mono text-[11px] font-medium text-[var(--ink-secondary)]">24GB</span></button>
            <button type="button" data-quick-gpu="nvidia-a10-24gb" class="btn-secondary px-3.5 py-2 text-[13px] font-semibold hover:border-[var(--accent-border)] hover:text-[var(--accent-ink)]">NVIDIA A10 <span class="rounded-md bg-[var(--bg-subtle)] px-1.5 py-0.5 font-mono text-[11px] font-medium text-[var(--ink-secondary)]">24GB</span></button>
            <button type="button" data-quick-gpu="nvidia-t4-16gb" class="btn-secondary px-3.5 py-2 text-[13px] font-semibold hover:border-[var(--accent-border)] hover:text-[var(--accent-ink)]">NVIDIA T4 <span class="rounded-md bg-[var(--bg-subtle)] px-1.5 py-0.5 font-mono text-[11px] font-medium text-[var(--ink-secondary)]">16GB</span></button>
          </div>
        </div>

        <div class="mt-7 flex flex-wrap items-center justify-center gap-3 border-t border-[var(--border-hairline)] pt-5">
          <button
            id="await-select-hw-btn"
            type="button"
            data-i18n="home.modeCtaSelectHw"
            class="btn-primary px-4 py-2 text-xs"
          >
            Select My Hardware ↑
          </button>
          <button
            id="open-presets-btn"
            type="button"
            data-i18n="home.awaitBrowsePresets"
            data-i18n-args={awaitPresetsArgs}
            class="rounded-lg px-3.5 py-2 text-xs font-medium text-[var(--ink-secondary)] hover:bg-[var(--bg-subtle)] hover:text-[var(--ink-primary)] transition-colors cursor-pointer"
          >
            Just browsing? View {totalCount} preset GPU reference pairings ↓
          </button>
        </div>
      </div>
    </div>

    <!-- Dynamic Mode Header: Reference Presets vs. Selected Rig Results -->
    <div
      id="results-mode-banner"
      class="mt-6 hidden surface-card flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-5 transition-colors"
    >
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <span
            id="results-mode-badge"
            data-i18n="home.modeBadgeRef"
            class="badge-neutral inline-flex shrink-0 items-center rounded-full border px-2.5 py-0.5 text-[11px] font-semibold"
          >
            Reference Presets
          </span>
          <h2
            id="results-mode-heading"
            data-i18n="home.modeHeadingRef"
            class="text-sm sm:text-base font-semibold text-[var(--ink-primary)]"
          >
            Popular Hardware References
          </h2>
        </div>
        <p
          id="results-mode-sub"
          data-i18n="home.modeSubRef"
          class="mt-1 text-xs leading-relaxed text-[var(--ink-secondary)]"
        >
          No hardware selected yet — cards below show preset Model × GPU examples. Pick your CPU or GPU above to switch to estimates for your own machine.
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap items-center gap-2">
        <button
          id="results-mode-select-btn"
          type="button"
          data-i18n="home.modeCtaSelectHw"
          class="btn-secondary px-3.5 py-2 text-xs"
        >
          Select My Hardware ↑
        </button>
        <button
          id="results-mode-close-presets-btn"
          type="button"
          data-i18n="home.modeClosePresets"
          class="hidden items-center justify-center rounded-lg px-3 py-2 text-xs font-medium text-[var(--ink-secondary)] hover:bg-[var(--bg-subtle)] hover:text-[var(--ink-primary)] transition-colors cursor-pointer"
        >
          Hide References
        </button>
        <a
          id="results-mode-sim-cta"
          href="/calculator/"
          data-i18n="home.openRigSim"
          class="hidden btn-primary px-3.5 py-2 text-xs"
        >
          Open Full Rig in Simulator -&gt;
        </a>
      </div>
    </div>

    <!-- Curated Deep-Dive Cards Grid (opt-in presets hidden until user chooses hardware or opens presets) -->
    <div id="cards-grid" class="mt-4 hidden gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry, idx) => {
        const res = entry.default_result;
        const usable =
          res.effective_usable_vram_gb ??
          effectiveUsableVramGb(entry.hardware, entry.hardware.gpu_count || 1, 'desktop')[1];
        const fillPct = Math.min(100, Math.round((res.total_vram_gb / Math.max(0.5, usable)) * 100));
        const barColor =
          res.status === 'Fits'
            ? 'bg-emerald-500'
            : res.status === 'Tight Fit'
              ? 'bg-orange-500'
              : res.status === 'Partial Offload'
                ? 'bg-amber-500'
                : 'bg-rose-500';
        const speedTier: SpeedTier = res.speed_tier ?? classifySpeedTier(res.est_tps, res.status);
        const tpsDisplay = formatTpsRange(res.est_tps_low, res.est_tps_high, res.est_tps, res.status);
        const fillStyle = `width: ${fillPct}%`;
        const fillBarClass = `h-full rounded-full ${barColor}`;
        const detailHref = `/can-i-run/${entry.slug}/`;
        const rank = statusRank(res.status);
        const hiddenClass = idx >= PAGE_SIZE ? ' hidden' : '';
        const cardClass = `matrix-card surface-card-interactive group flex flex-col justify-between p-5${hiddenClass}`;
        const searchIndex = [
          entry.model.name,
          entry.model.short_name,
          entry.model.family,
          entry.hardware.id,
          entry.hardware.name,
          entry.hardware.short_name,
          entry.hardware.vendor,
          entry.hardware.series,
          entry.hardware.category || '',
          entry.hardware.backend,
          entry.hardware.memory_type,
          res.status,
          speedTier,
          'uncensored abliterated heretic dolphin',
        ]
          .join(' ')
          .toLowerCase();

        const hwOnArgs = JSON.stringify({ hw: entry.hardware.name });
        const layerArgs = JSON.stringify({ fit: res.gpu_layers_fit, total: res.total_layers });
        const statusAttrs = res.status === 'OOM' ? 'status.oom' : undefined;
        const hasMaxFit = Boolean(
          entry.max_fit_context && entry.max_fit_context > 0 && entry.max_fit_total_vram_gb,
        );
        const maxFitCtxLabel = hasMaxFit ? formatContextLabel(entry.max_fit_context!) : '';
        const maxFitGbStr = hasMaxFit ? entry.max_fit_total_vram_gb!.toFixed(1) : '';
        const hasMaxFitSpeed = Boolean(hasMaxFit && entry.max_fit_tps_high && entry.max_fit_tps_high > 0);
        const maxFitI18nKey = hasMaxFitSpeed
          ? 'common.maxFitWithSpeed'
          : hasMaxFit
            ? 'common.maxFitLabel'
            : 'common.maxFitNone';
        const maxFitArgs = hasMaxFitSpeed
          ? JSON.stringify({
              ctx: maxFitCtxLabel,
              gb: maxFitGbStr,
              low: entry.max_fit_tps_low,
              high: entry.max_fit_tps_high,
            })
          : hasMaxFit
            ? JSON.stringify({ ctx: maxFitCtxLabel, gb: maxFitGbStr })
            : undefined;
        const maxFitDisplayText = hasMaxFitSpeed
          ? `Max Fit: ${maxFitCtxLabel} (${maxFitGbStr} GB · ~${entry.max_fit_tps_low}–${entry.max_fit_tps_high} tok/s)`
          : hasMaxFit
            ? `Max Fit: ${maxFitCtxLabel} (${maxFitGbStr} GB)`
            : 'Max Fit: Offload req.';
        const altFmt = entry.alt_format_summary;
        const altLabelPrefix = altFmt ? (altFmt.format === 'MLX' ? 'MLX 4-bit' : 'AWQ 4-bit') : '';
        const altSpeedStr = altFmt
          ? altFmt.status === 'OOM'
            ? 'OOM'
            : `~${altFmt.est_tps_low}–${altFmt.est_tps_high} tok/s`
          : '';
        const altLineText = altFmt
          ? `${altLabelPrefix}: ${altFmt.total_vram_gb.toFixed(1)} GB · ${altSpeedStr}`
          : '';
        const cardMeasured = measuredByPair.get(`${entry.model.id}::${entry.hardware.id}`);
        const cardMeasuredText = cardMeasured
          ? `${cardMeasured.gen_tps_low}–${cardMeasured.gen_tps_high} tok/s measured`
          : '';
        const cardMeasuredArgs = cardMeasured
          ? JSON.stringify({ low: cardMeasured.gen_tps_low, high: cardMeasured.gen_tps_high })
          : undefined;
        const showMeasuredBadge = Boolean(cardMeasured);
        const showFormulaText = !cardMeasured && res.status !== 'OOM';
        const verdictKey =
          res.status === 'Fits'
            ? 'card.verdictFits'
            : res.status === 'Tight Fit'
              ? 'card.verdictTight'
              : res.status === 'Partial Offload'
                ? 'card.verdictPartial'
                : 'card.verdictOom';
        const verdictArgs = JSON.stringify({
          vram: res.total_vram_gb.toFixed(1),
          usable: usable.toFixed(1),
          margin: Math.max(0, usable - res.total_vram_gb).toFixed(1),
          fit: res.gpu_layers_fit,
          total: res.total_layers,
          params: entry.model.params_b,
          arch: entry.model.architecture,
        });

        return (
          <article
            data-card
            data-index={idx}
            data-tps={res.est_tps}
            data-vram={res.total_vram_gb}
            data-params={entry.model.params_b}
            data-status-rank={rank}
            data-model={entry.model.id}
            data-hardware={entry.hardware.id}
            data-vendor={entry.hardware.vendor}
            data-status={res.status}
            data-search={searchIndex}
            class={cardClass}
          >
            <div>
              <div class="flex items-center justify-between gap-2">
                <StatusBadge status={res.status} />
                <span class="shrink-0 font-mono text-[11px] font-medium text-[var(--ink-tertiary)] whitespace-nowrap">
                  {entry.hardware.backend} · {entry.hardware.bandwidth_gbps} GB/s
                </span>
              </div>

              <h2 class="mt-3.5 tracking-tight">
                <a href={detailHref} class="block focus:outline-none">
                  <span class="block text-[17px] font-semibold text-[var(--ink-primary)] group-hover:text-[var(--accent-ink)] transition-colors">
                    {entry.model.short_name}
                  </span>
                  <span
                    class="mt-0.5 block text-[13.5px] font-medium text-[var(--ink-secondary)]"
                    data-i18n="common.onPrefix"
                    data-i18n-args={hwOnArgs}
                  >
                    on {entry.hardware.name}
                  </span>
                </a>
              </h2>

              <p
                class="mt-2 line-clamp-2 text-xs leading-relaxed text-[var(--ink-tertiary)]"
                data-i18n={verdictKey}
                data-i18n-args={verdictArgs}
                data-i18n-keep-en="true"
              >
                {entry.verdict_summary}
              </p>
            </div>

            <div class="mt-4 border-t border-[var(--border-hairline)] pt-3.5">
              <div class="flex items-center justify-between gap-2 text-xs">
                <span class="inline-flex min-w-0 items-center gap-1.5 text-[var(--ink-secondary)]">
                  <span class="whitespace-nowrap" data-i18n="common.vram8kLabel">VRAM @ 8K</span>
                  <span class="rounded border border-[var(--border-hairline)] bg-[var(--bg-subtle)] px-1.5 py-px font-mono text-[10px] font-semibold text-[var(--ink-primary)] whitespace-nowrap">
                    {QUANT_SHORT_LABELS[res.quant] ?? res.quant}
                  </span>
                </span>
                <span class="shrink-0 font-mono font-semibold text-[var(--ink-primary)] tabular-nums">
                  {res.total_vram_gb.toFixed(1)} / {usable.toFixed(1)} GB
                </span>
              </div>
              <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-[var(--bg-subtle)]">
                <div class={fillBarClass} style={fillStyle}></div>
              </div>
              <div class="mt-2 flex flex-wrap items-center justify-between gap-1.5 text-[11px] text-[var(--ink-tertiary)] tabular-nums">
                <span data-i18n={maxFitI18nKey} data-i18n-args={maxFitArgs}>
                  {maxFitDisplayText}
                </span>
              </div>
              {altFmt && (
                <div class="mt-1 font-mono text-[11px] text-[var(--ink-secondary)] tabular-nums">
                  {altLineText}
                </div>
              )}

              <div class="mt-3.5 flex flex-wrap items-end justify-between gap-x-2 gap-y-1.5">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-baseline gap-1.5">
                    <span class="font-mono text-base sm:text-[17px] font-semibold text-[var(--ink-primary)] tabular-nums" data-i18n={statusAttrs}>
                      {tpsDisplay}
                    </span>
                    <span
                      class="text-[11px] text-[var(--ink-tertiary)] tabular-nums"
                      data-i18n="common.layersCount"
                      data-i18n-args={layerArgs}
                    >
                      ({res.gpu_layers_fit}/{res.total_layers} layers)
                    </span>
                  </div>
                  {showMeasuredBadge && cardMeasured && (
                    <span class="badge-fits mt-1 inline-flex items-center rounded-md border px-1.5 py-0.5 font-mono text-[10px] font-semibold">
                      <span data-i18n="speed.measuredUnit" data-i18n-args={cardMeasuredArgs}>
                        {cardMeasuredText}
                      </span>
                      {cardMeasured.quant !== 'Q4_K_M' && (
                        <span title={QUANT_SHORT_LABELS[cardMeasured.quant] ?? cardMeasured.quant}>&nbsp;· {cardMeasured.format}</span>
                      )}
                    </span>
                  )}
                  {showFormulaText && (
                    <span class="mt-0.5 block text-[11px] text-[var(--ink-tertiary)]" data-i18n="speed.formulaOnly">
                      Formula only (unverified)
                    </span>
                  )}
                </div>

                <a
                  href={detailHref}
                  class="ml-auto inline-flex shrink-0 items-center gap-1 text-xs font-semibold text-[var(--accent-ink)] hover:underline whitespace-nowrap"
                  data-i18n="common.openCalc"
                >
                  Open Calc -&gt;
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Progressive Pagination Controls -->
    <div id="pagination-bar" class={paginationHiddenClass}>
      <div class="w-full sm:max-w-xs">
        <p
          id="pagination-summary"
          class="font-mono text-xs font-medium text-[var(--ink-secondary)] tabular-nums"
          data-i18n="home.viewingGuides"
          data-i18n-args={initViewArgs}
        >
          Viewing {initialVisibleCount} of {totalCount} matching guides
        </p>
        <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-[var(--bg-subtle)]">
          <div
            id="pagination-bar-fill"
            class="h-full rounded-full bg-[var(--accent)] transition-all duration-200"
            style={initialProgressStyle}
          ></div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 shrink-0">
        <button
          id="load-more-btn"
          type="button"
          class="btn-mono px-4 py-2 text-xs"
          data-i18n="home.loadMoreGuides"
          data-i18n-args={initLoadArgs}
        >
          Load 24 More ({initialRemainingCount} left)
        </button>
        <button
          id="show-all-btn"
          type="button"
          class="btn-secondary px-3.5 py-2 text-xs"
          data-i18n="home.showAllRemaining"
        >
          Show All Remaining
        </button>
      </div>
    </div>

    <!-- Live Full-Catalog & Custom Rig Calculations -->
    <section id="live-calc-section" class="mt-6 hidden" aria-label="Live Catalog Estimates">
      <div id="live-calc-header" class="flex flex-col gap-3 rounded-2xl border border-[var(--accent-border)] bg-[var(--accent-soft)] p-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <span
              id="live-calc-badge"
              class="rounded-full bg-[var(--accent)] px-2.5 py-0.5 text-[11px] font-semibold text-white"
            >
              Live Catalog Physics
            </span>
            <h2 id="live-calc-heading" class="text-sm font-semibold text-[var(--ink-primary)]">
              Additional Live Catalog Estimates
            </h2>
          </div>
          <p id="live-calc-sub" class="mt-1 text-xs text-[var(--ink-secondary)]">
            Instant @8K + Max Fit calculations across all {catalogModelCount} models &amp; {catalogHwCount} catalog GPUs.
          </p>
        </div>
        <a
          id="live-sim-cta"
          href="/calculator/"
          class="btn-primary shrink-0 px-3.5 py-2 text-xs"
        >
          Open in Multi-GPU / CPU Simulator -&gt;
        </a>
      </div>

      <div id="live-calc-grid" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>

      <div id="live-pagination-bar" class="mt-5 hidden">
        <div class="surface-card flex items-center justify-between px-4 py-3 text-xs">
          <span id="live-pagination-summary" class="font-mono text-[var(--ink-secondary)] tabular-nums"></span>
          <button
            id="live-load-more-btn"
