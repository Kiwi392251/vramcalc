            class="badge-neutral rounded-full border px-2.5 py-0.5 font-mono text-[11px] font-medium"
            data-i18n="common.updated"
            data-i18n-args={updatedArgs}
          >
            Updated {updatedAt}
          </span>
        </div>
      </div>
      <div class="mt-5 grid gap-6 border-t border-[var(--border-hairline)] pt-5 text-sm leading-relaxed text-[var(--ink-secondary)] md:grid-cols-3">
        <div>
          <h3 class="font-semibold text-[var(--ink-primary)]" data-i18n="home.method1Title">1. Tiered OS Reserves &amp; Custom GB Override</h3>
          <p class="mt-1.5" data-i18n="home.method1Desc">
            VRAM Fit pairs weight (GGUF/AWQ/MLX) + GQA KV + per-card CUDA overhead against capacity-tiered Daily Desktop / Clean OS reserves (non-linear headroom scaling across 8GB–192GB devices, not a flat %) or your exact Custom GB limit from nvidia-smi / Activity Monitor directly on /, /calculator/, and guide pages; &lt;5% / &lt;1 GB flags Tight Fit.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-[var(--ink-primary)]" data-i18n="home.method2Title">2. Inline AWQ/MLX + Separate @8K vs @Max Fit Speeds</h3>
          <p class="mt-1.5" data-i18n="home.method2Desc">
            Every guide reports GGUF (llama.cpp), vLLM AWQ 4-bit, or Apple MLX 4-bit VRAM + speeds side-by-side, and separates 8K decode speed from @Max Fit long-context speed after KV-read and attention scaling.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-[var(--ink-primary)]" data-i18n="home.method3Title">3. MoE/Turing Calibration &amp; Transparent 17/173 Coverage</h3>
          <p class="mt-1.5" data-i18n="home.method3Desc">
            Physics v3.3 achieves 17/17 full range containment (max midpoint error 8.7%) across Turing/Volta, CUDA MoE router gather, and DeltaNet dispatch benchmarks. Only 17/173 curated guides have verified telemetry; the remaining 156 stay clearly tagged "Formula only (unverified)".
          </p>
        </div>
      </div>

      <div class="surface-inset mt-6 p-4 text-xs leading-relaxed text-[var(--ink-secondary)]">
        <div class="font-semibold text-[var(--ink-primary)]" data-i18n="home.uncensoredTitle">
          Uncensored / Abliterated / Heretic Models (1:1 Drop-In)
        </div>
        <p class="mt-1" data-i18n="home.uncensoredDesc">
          Community uncensored, abliterated, and Heretic fine-tunes use identical layer counts, hidden dimensions, and GQA KV geometry as the base checkpoints above — apply the same @8K VRAM, Max Fit context, and tok/s estimates directly (allow ~±3–5% for custom imatrix quant variance).
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    buildCpuCascaderOptions,
    buildHardwareCascaderOptions,
    buildModelCascaderOptions,
  } from '../utils/cascaderOptions';
  import { SearchableCombobox, type ComboboxOption } from '../utils/combobox';
  import { CustomSelect } from '../utils/customSelect';
  import { getLocale, onLocaleChange, t, tStatus } from '../utils/i18n';
  import {
    effectiveUsableVramGb,
    estimateRigRun,
    formatContextLabel,
    formatForQuant,
    formatTpsRange,
    maxFitContextDetails,
    osRamReserveGb,
    QUANT_LABELS,
    QUANT_SHORT_LABELS,
  } from '../utils/physics';
  import {
    buildSimulatorUrl,
    extractUnifiedSocProfiles,
    getDiscreteSingleGpus,
    GPU_COUNT_OPTIONS,
    isMultiGpuCapable,
    parseRamGb,
    resolveCuratedGuideSlug,
    resolveUnifiedHardware,
    STANDARD_RAM_OPTIONS,
    type UnifiedSocProfile,
  } from '../utils/rigCatalog';
  import type {
    CompatStatus,
    CpuSpec,
    HardwareSpec,
    ModelSpec,
    QuantKey,
    ReserveProfile,
    RigRunEstimate,
    RuntimeFormat,
    SplitMode,
  } from '../types/vram';

  interface MeasuredAnchorDetail {
    low: number;
    high: number;
    quant: QuantKey;
    format: RuntimeFormat;
  }

  interface HomeCatalogPayload {
    models: ModelSpec[];
    hardware: HardwareSpec[];
    cpus: CpuSpec[];
    curatedKeys: string[];
    curatedSlugs: Record<string, string>;
    measuredPairs?: Record<string, string>;
    measuredAnchorDetails?: Record<string, MeasuredAnchorDetail>;
  }

  const VALID_QUANTS: readonly QuantKey[] = [
    'Q4_K_M',
    'Q5_K_M',
    'Q6_K',
    'Q8_0',
    'FP16',
    'AWQ_4BIT',
    'FP8',
    'MLX_4BIT',
    'MLX_8BIT',
  ];

  interface LiveItem {
    model: ModelSpec;
    hw: HardwareSpec | null;
    res: RigRunEstimate;
    rank: number;
    simHref: string;
    guideSlug?: string;
    chipLabel: string;
    hwSubtitle: string;
    layersText: string;
    maxFitLabel: string;
  }

  function rankOf(s: CompatStatus): number {
    if (s === 'Fits') return 0;
    if (s === 'Tight Fit') return 1;
    if (s === 'Partial Offload') return 2;
    return 3;
  }

  function badgeClasses(s: CompatStatus): string {
    if (s === 'Fits') return 'badge-fits';
    if (s === 'Tight Fit') return 'badge-tight';
    if (s === 'Partial Offload') return 'badge-partial';
    return 'badge-oom';
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function initMatrixPage() {
    const PAGE_SIZE = 24;

    const cpuRoot = document.getElementById('cb-cpu');
    const ramRoot = document.getElementById('cb-ram');
    const gpuRoot = document.getElementById('cb-gpu');
    const modelRoot = document.getElementById('cb-model');
    const gpuCountRoot = document.getElementById('rig-gpu-count');
    const sortRoot = document.getElementById('filter-sort');
    const contextBar = document.getElementById('rig-context-bar');
    const contextTextEl = document.getElementById('rig-context-text');
    const splitToggleEl = document.getElementById('rig-split-toggle');
    const splitBtns = Array.from(document.querySelectorAll('[data-home-split]'));
    const quantBtns = Array.from(document.querySelectorAll('[data-home-quant]'));
    const reserveBtns = Array.from(document.querySelectorAll('[data-home-reserve]'));
    const customGbWrap = document.getElementById('home-custom-gb-wrap');
    const customGbInput = document.getElementById('home-custom-gb') as HTMLInputElement | null;

    const statusButtons = Array.from(document.querySelectorAll('[data-status-btn]'));
    const cards = Array.from(document.querySelectorAll('[data-card]'));
    const countEl = document.getElementById('filter-count');
    const resetBtn = document.getElementById('filter-reset');
    const emptyState = document.getElementById('empty-state');
    const emptyResetBtn = document.getElementById('empty-reset-btn');
    const emptySimLink = document.getElementById('empty-sim-link') as HTMLAnchorElement | null;
    const cardsGrid = document.getElementById('cards-grid');
    const paginationBar = document.getElementById('pagination-bar');
    const paginationSummary = document.getElementById('pagination-summary');
    const paginationFill = document.getElementById('pagination-bar-fill') as HTMLElement | null;
    const loadMoreBtn = document.getElementById('load-more-btn');
    const showAllBtn = document.getElementById('show-all-btn');

    const liveSection = document.getElementById('live-calc-section');
    const liveHeader = document.getElementById('live-calc-header');
    const liveBadge = document.getElementById('live-calc-badge');
    const liveHeading = document.getElementById('live-calc-heading');
    const liveSub = document.getElementById('live-calc-sub');
    const liveSimCta = document.getElementById('live-sim-cta') as HTMLAnchorElement | null;
    const liveGrid = document.getElementById('live-calc-grid');
    const livePagBar = document.getElementById('live-pagination-bar');
    const livePagSummary = document.getElementById('live-pagination-summary');
    const liveLoadMoreBtn = document.getElementById('live-load-more-btn');

    const rigConfigPanel = document.getElementById('rig-config-panel');
    const awaitPanel = document.getElementById('await-hardware-panel');
    const awaitModelReq = document.getElementById('await-model-req');
    const awaitSelectHwBtn = document.getElementById('await-select-hw-btn');
    const openPresetsBtn = document.getElementById('open-presets-btn');
    const quickSocBtns = Array.from(document.querySelectorAll('[data-quick-soc]'));
    const quickGpuBtns = Array.from(document.querySelectorAll('[data-quick-gpu]'));
    const modeBanner = document.getElementById('results-mode-banner');
    const modeBadge = document.getElementById('results-mode-badge');
    const modeHeading = document.getElementById('results-mode-heading');
    const modeSub = document.getElementById('results-mode-sub');
    const modeSelectBtn = document.getElementById('results-mode-select-btn');
    const modeClosePresetsBtn = document.getElementById('results-mode-close-presets-btn');
    const modeSimCta = document.getElementById('results-mode-sim-cta') as HTMLAnchorElement | null;

    const dirTabBtns = Array.from(document.querySelectorAll('[data-dir-tab]'));
    const dirPanels = Array.from(document.querySelectorAll('[data-dir-panel]'));
    const dirViewAllLink = document.getElementById('dir-view-all-link') as HTMLAnchorElement | null;

    const catalogEl = document.getElementById('home-catalog-json');
    const catData: HomeCatalogPayload = catalogEl
      ? (JSON.parse(catalogEl.textContent || '{}') as HomeCatalogPayload)
      : { models: [], hardware: [], cpus: [], curatedKeys: [], curatedSlugs: {} };

    if (!cpuRoot || !ramRoot || !gpuRoot || !modelRoot || !gpuCountRoot || !sortRoot) return;

    const curatedKeySet = new Set(catData.curatedKeys || []);
    const curatedSlugMap = new Map<string, string>(Object.entries(catData.curatedSlugs || {}));
    const measuredAnchorMap = new Map<string, MeasuredAnchorDetail>(
      Object.entries(catData.measuredAnchorDetails || {}),
    );
    const hwById = new Map(catData.hardware.map((h) => [h.id, h]));
    const cpuById = new Map(catData.cpus.map((c) => [c.id, c]));
    const modelById = new Map(catData.models.map((m) => [m.id, m]));
    const defaultCpu = catData.cpus[0];

    const socProfiles = extractUnifiedSocProfiles(catData.hardware);
    const socById = new Map(socProfiles.map((s) => [s.id, s]));
    const discreteGpus = getDiscreteSingleGpus(catData.hardware);

    let selectedCpuVal: string = '';
    let selectedRamGb: number | null = null;
    let selectedGpuVal: string = '';
    let gpuCount = 1;
    let splitMode: SplitMode = 'layer';
    let selectedQuant: QuantKey = 'Q4_K_M';
    let reserveProfile: ReserveProfile = 'desktop';
    let customUsableGb: number | null = null;
    let selectedModel = 'all';
    let selectedStatus = 'all';
    let visibleLimit = PAGE_SIZE;
    let liveVisibleLimit = PAGE_SIZE;
    let currentSort = 'featured';
    let browsePresetsOpen = false;

    const hwSearchMap = new Map<string, string>();
    for (const h of catData.hardware) {
      hwSearchMap.set(
        h.id,
        [h.id, h.name, h.short_name, h.vendor, h.series, h.category || '', h.backend, h.memory_type]
          .join(' ')
          .toLowerCase(),
      );
    }

    const totalCurated = cards.length;

    function updateQuantUi() {
      quantBtns.forEach((b) => {
        const active = (b.getAttribute('data-home-quant') || 'Q4_K_M') === selectedQuant;
        b.setAttribute('data-active', active ? 'true' : 'false');
        b.setAttribute('aria-checked', active ? 'true' : 'false');
      });
    }

    function updateReserveUi() {
      reserveBtns.forEach((b) => {
        const active = (b.getAttribute('data-home-reserve') || 'desktop') === reserveProfile;
        b.setAttribute('data-active', active ? 'true' : 'false');
      });
      if (customGbWrap) {
        const isCustom = reserveProfile === 'custom';
        customGbWrap.classList.toggle('hidden', !isCustom);
        customGbWrap.classList.toggle('flex', isCustom);
      }
      if (customGbInput && customUsableGb !== null && document.activeElement !== customGbInput) {
        customGbInput.value = String(customUsableGb);
      }
    }

    function buildRamOptions(soc: UnifiedSocProfile | null): ComboboxOption[] {
      const opts: ComboboxOption[] = [];
      if (soc) {
        for (const gb of soc.ramTiers) {
          const sku = soc.skus.find((s) => Math.round(s.vram_gb) === gb);
          opts.push({
            value: String(gb),
            label: `${gb} GB`,
            group: t('home.grpSocTiers', { soc: soc.shortName }),
            badge: sku ? `${sku.bandwidth_gbps} GB/s` : 'Unified',
            searchBlob: `${gb} ${gb}gb ${gb}g unified official ${soc.shortName}`.toLowerCase(),
          });
        }
        for (const gb of STANDARD_RAM_OPTIONS) {
          if (soc.ramTiers.includes(gb)) continue;
          opts.push({
            value: String(gb),
            label: `${gb} GB`,
            group: t('home.grpCustomRam'),
            badge: `${gb} GB`,
            searchBlob: `${gb} ${gb}gb ${gb}g custom`.toLowerCase(),
          });
        }
      } else {
        for (const gb of STANDARD_RAM_OPTIONS) {
          opts.push({
            value: String(gb),
            label: `${gb} GB`,
            group: t('home.grpSystemRam'),
            badge: t('home.usableShort', { gb: Math.max(0, gb - osRamReserveGb(gb)) }),
            searchBlob: `${gb} ${gb}gb ${gb}g ram system memory`.toLowerCase(),
          });
        }
      }
      return opts;
    }

    const gpuCountSelect = new CustomSelect({
      root: gpuCountRoot,
      disabled: true,
      onChange: (val) => {
        gpuCount = Math.max(1, Number(val || 1));
        updateContextBar();
        applyFilters(true);
      },
    });

    const sortSelect = new CustomSelect({
      root: sortRoot,
      align: 'right',
      initialValue: 'featured',
      onChange: () => {
        applyFilters(true);
      },
    });

    function getActiveUnifiedSoc(): UnifiedSocProfile | null {
      if (!selectedCpuVal.startsWith('soc:')) return null;
      return socById.get(selectedCpuVal.slice(4)) ?? null;
    }

    function getActiveX86Cpu(): CpuSpec {
      if (selectedCpuVal.startsWith('x86:')) {
        return cpuById.get(selectedCpuVal.slice(4)) ?? defaultCpu;
      }
      return defaultCpu;
    }

    function syncGpuQtyControl() {
      const soc = getActiveUnifiedSoc();
      const hw = selectedGpuVal && selectedGpuVal !== 'none' ? hwById.get(selectedGpuVal) ?? null : null;

      if (soc) {
        const lbl = t('home.qtyNone');
        gpuCountSelect.setOptions([{ value: '0', label: lbl }], false);
        gpuCountSelect.setValue('0', true);
        gpuCountSelect.setDisabled(true, lbl);
      } else if (selectedGpuVal === 'none' || !hw) {
        const lbl = selectedGpuVal === 'none' ? t('home.qtyNone') : '—';
        gpuCountSelect.setOptions([{ value: '0', label: lbl }], false);
        gpuCountSelect.setValue('0', true);
        gpuCountSelect.setDisabled(true, lbl);
      } else if (!isMultiGpuCapable(hw)) {
        gpuCount = 1;
        const lbl = t('home.qtyLaptop');
        gpuCountSelect.setOptions([{ value: '1', label: lbl }], false);
        gpuCountSelect.setValue('1', true);
        gpuCountSelect.setDisabled(true, lbl);
      } else {
        gpuCountSelect.setOptions(
          GPU_COUNT_OPTIONS.map((n) => ({
            value: String(n),
            label: n === 1 ? t('home.qtySingle') : t('home.qtyMulti', { n }),
          })),
          false,
        );
        gpuCountSelect.setDisabled(false);
        gpuCountSelect.setValue(String(gpuCount), true);
      }
    }

    function updateSplitToggleUi() {
      splitBtns.forEach((b) => {
        const active = b.getAttribute('data-home-split') === splitMode;
        b.setAttribute('data-active', active ? 'true' : 'false');
      });
    }

    function updateContextBar() {
      if (!contextBar || !contextTextEl || !splitToggleEl) return;
      const soc = getActiveUnifiedSoc();
      const hw = selectedGpuVal && selectedGpuVal !== 'none' ? hwById.get(selectedGpuVal) ?? null : null;

      if (soc) {
        const ram = selectedRamGb ?? soc.defaultRamGb;
        const { hw: resolvedHw, isExactCatalogSku } = resolveUnifiedHardware(soc, ram);
        const tag = isExactCatalogSku ? '' : t('home.ctxUnifiedCustomTag');
        const usableUnified = effectiveUsableVramGb(resolvedHw, 1, 'desktop')[1];
        contextBar.classList.remove('hidden');
        splitToggleEl.classList.add('hidden');
        contextTextEl.textContent = t('home.ctxUnified', {
          soc: soc.shortName,
          ram,
          usable: usableUnified,
          bw: resolvedHw.bandwidth_gbps,
          backend: resolvedHw.backend,
          custom: tag,
        });
      } else if (hw && gpuCount >= 2 && isMultiGpuCapable(hw)) {
        const totalVram = Math.round(hw.vram_gb * gpuCount * 10) / 10;
        const usableVram = effectiveUsableVramGb(hw, gpuCount, 'desktop')[1];
        contextBar.classList.remove('hidden');
        splitToggleEl.classList.remove('hidden');
        contextTextEl.textContent = t('home.ctxMultiGpu', {
          n: gpuCount,
          hw: hw.short_name,
          total: totalVram,
          usable: usableVram,
          bw: hw.bandwidth_gbps,
        });
        updateSplitToggleUi();
      } else if (selectedGpuVal === 'none') {
        const cpu = getActiveX86Cpu();
        const ram = selectedRamGb ?? 32;
        const usableRam = Math.max(0, ram - osRamReserveGb(ram));
        contextBar.classList.remove('hidden');
        splitToggleEl.classList.add('hidden');
        contextTextEl.textContent = t('home.ctxCpuOnly', {
          cpu: cpu.short_name,
          ram,
          usable: usableRam,
        });
      } else {
        contextBar.classList.add('hidden');
        splitToggleEl.classList.add('hidden');
      }
    }

    const cpuCombo = new SearchableCombobox({
      root: cpuRoot,
      mode: 'cascader',
      options: buildCpuCascaderOptions({
        cpus: catData.cpus,
        socProfiles,
        t,
        includeUnified: true,
        prefixX86: true,
      }),
      placeholder: t('home.cpuPlaceholder'),
      searchPlaceholder: t('cb.searchCpuPh'),
      brandHeader: t('cb.brandCol'),
      seriesHeader: t('cb.seriesCol'),
      modelHeader: t('cb.modelCol'),
      allBrandsLabel: (n) => t('cb.allBrands', { count: n }),
      allSeriesLabel: (n) => t('cb.allSeries', { count: n }),
      itemsCountFormatter: (n) => t('cb.countItems', { count: n }),
      emptyText: t('home.cpuEmpty'),
      onChange: (val) => applyCpuSelection(val),
    });

    const ramCombo = new SearchableCombobox({
      root: ramRoot,
      options: buildRamOptions(null),
      placeholder: t('home.ramPlaceholder'),
      emptyText: t('home.ramEmpty'),
      allowCustomNumeric: true,
      parseCustomNumeric: parseRamGb,
      formatCustomNumeric: (n) => `${n} GB`,
      formatCustomActionLabel: (n) => t('home.customRamUse', { ram: n }),
      onChange: (val) => {
        selectedRamGb = val ? parseRamGb(val) : null;
        if (!isRigConfigured()) browsePresetsOpen = false;
        updateContextBar();
        applyFilters(true);
      },
    });

    const gpuCombo = new SearchableCombobox({
      root: gpuRoot,
      mode: 'cascader',
      options: buildHardwareCascaderOptions({
        hardware: catData.hardware,
        t,
        prefixUnified: true,
        includeCpuOnly: true,
        includeMultiGpu: false,
      }),
      placeholder: t('home.gpuPlaceholder'),
      searchPlaceholder: t('cb.searchGpuPh'),
      brandHeader: t('cb.brandCol'),
      seriesHeader: t('cb.seriesCol'),
      modelHeader: t('cb.modelCol'),
      allBrandsLabel: (n) => t('cb.allBrands', { count: n }),
      allSeriesLabel: (n) => t('cb.allSeries', { count: n }),
      itemsCountFormatter: (n) => t('cb.countItems', { count: n }),
      emptyText: t('home.gpuEmpty'),
      onChange: (val) => applyGpuSelection(val, false),
    });

    const modelCombo = new SearchableCombobox({
      root: modelRoot,
      mode: 'cascader',
      options: buildModelCascaderOptions({
        models: catData.models,
        t,
        includeAllOption: true,
      }),
      placeholder: t('home.allModels', { count: catData.models.length }),
      searchPlaceholder: t('cb.searchModelPh'),
      brandHeader: t('cb.brandCol'),
      seriesHeader: t('cb.seriesCol'),
      modelHeader: t('cb.modelCol'),
      allBrandsLabel: (n) => t('cb.allBrands', { count: n }),
      allSeriesLabel: (n) => t('cb.allSeries', { count: n }),
      itemsCountFormatter: (n) => t('cb.countItems', { count: n }),
      emptyValue: 'all',
      initialValue: 'all',
      emptyText: t('home.modelEmpty'),
      onChange: (val) => {
        selectedModel = val || 'all';
        applyFilters(true);
      },
    });

    function activateUnifiedSoc(soc: UnifiedSocProfile, targetRamGb: number | null) {
      selectedCpuVal = `soc:${soc.id}`;
      cpuCombo.setValue(selectedCpuVal);

      let nextRam = targetRamGb;
      if (nextRam === null || !soc.ramTiers.includes(nextRam)) {
        nextRam = soc.defaultRamGb;
      }
      selectedRamGb = nextRam;
      ramCombo.setOptions(buildRamOptions(soc), false);
      ramCombo.setValue(String(nextRam), `${nextRam} GB`);

      selectedGpuVal = '';
      gpuCount = 1;
      gpuCombo.setDisplayOverride(t('home.noneUnifiedAuto'), true, false);
      syncGpuQtyControl();
      updateContextBar();
      applyFilters(true);
    }

    function applyCpuSelection(val: string) {
      const wasUnified = selectedCpuVal.startsWith('soc:');
      if (!val) {
        selectedCpuVal = '';
        if (wasUnified) {
          selectedRamGb = null;
          ramCombo.setOptions(buildRamOptions(null), false);
          ramCombo.clear(true);
          gpuCombo.clear(true);
          selectedGpuVal = '';
          gpuCount = 1;
          syncGpuQtyControl();
        }
        if (!isRigConfigured()) browsePresetsOpen = false;
        updateContextBar();
        applyFilters(true);
        return;
      }

      if (val.startsWith('soc:')) {
        const soc = socById.get(val.slice(4));
        if (soc) {
          activateUnifiedSoc(soc, selectedRamGb);
          return;
        }
      }

      selectedCpuVal = val;
      if (wasUnified) {
        ramCombo.setOptions(buildRamOptions(null), true);
        if (!selectedGpuVal) {
          gpuCombo.clear(true);
        }
        syncGpuQtyControl();
      }
      updateContextBar();
      applyFilters(true);
    }

    function applyGpuSelection(val: string, preserveQty: boolean) {
      if (val.startsWith('uni:')) {
        const skuId = val.slice(4);
        const sku = hwById.get(skuId);
        if (sku) {
          const socId = sku.id.replace(/-\d+gb$/, '');
          const soc = socById.get(socId);
          if (soc) {
            activateUnifiedSoc(soc, Math.round(sku.vram_gb));
            return;
          }
        }
      }

      if (selectedCpuVal.startsWith('soc:')) {
        selectedCpuVal = '';
        cpuCombo.clear(true);
        ramCombo.setOptions(buildRamOptions(null), true);
      }

      selectedGpuVal = val;
      if (!preserveQty) {
        gpuCount = 1;
      }
      if (!isRigConfigured()) browsePresetsOpen = false;
      syncGpuQtyControl();
      updateContextBar();
      applyFilters(true);
    }

    function isRigConfigured(): boolean {
      return Boolean(selectedCpuVal || selectedRamGb !== null || selectedGpuVal);
    }

    function resolveActiveRigForSim(): {
      hw: HardwareSpec | null;
      isUnified: boolean;
      isExactCatalogSku: boolean;
      cpu: CpuSpec;
      effGpuCount: number;
      systemRamArg: number | null;
      ramForLink: number;
      rigTitle: string;
    } {
      const soc = getActiveUnifiedSoc();
      if (soc) {
        const ram = selectedRamGb ?? soc.defaultRamGb;
        const { hw, isExactCatalogSku } = resolveUnifiedHardware(soc, ram);
        return {
          hw,
          isUnified: true,
          isExactCatalogSku,
          cpu: defaultCpu,
          effGpuCount: 1,
          systemRamArg: hw.vram_gb,
          ramForLink: ram,
          rigTitle: hw.name,
        };
      }

      const cpu = getActiveX86Cpu();
      const hasCustomCpu = selectedCpuVal.startsWith('x86:');
      const hw = selectedGpuVal && selectedGpuVal !== 'none' ? hwById.get(selectedGpuVal) ?? null : null;

      if (!hw) {
        const ram = selectedRamGb ?? 32;
        const titleParts = [hasCustomCpu ? cpu.short_name : 'Default DDR4 (35 GB/s)', `${ram} GB RAM`];
        return {
          hw: null,
          isUnified: false,
          isExactCatalogSku: false,
          cpu,
          effGpuCount: 0,
          systemRamArg: ram,
          ramForLink: ram,
          rigTitle: `CPU-Only (${titleParts.join(' · ')})`,
        };
      }

      const effGpuCount = isMultiGpuCapable(hw) ? gpuCount : 1;
      const hwLabel = effGpuCount > 1 ? `${effGpuCount}× ${hw.short_name}` : hw.name;
      const hostBits: string[] = [];
      if (hasCustomCpu) hostBits.push(cpu.short_name);
      if (selectedRamGb !== null) hostBits.push(`${selectedRamGb} GB RAM`);
      const rigTitle = hostBits.length > 0 ? `${hwLabel} + ${hostBits.join(' · ')}` : hwLabel;

      return {
        hw,
        isUnified: false,
        isExactCatalogSku: true,
        cpu,
        effGpuCount,
        systemRamArg: selectedRamGb,
        ramForLink: selectedRamGb ?? 32,
        rigTitle,
      };
    }

    function updateStatusPills() {
      statusButtons.forEach((b) => {
        const active = (b.getAttribute('data-status-btn') || 'all') === selectedStatus;
        b.setAttribute('data-active', active ? 'true' : 'false');
      });
    }

    function sortCardsInDom(sortMode: string) {
      if (!cardsGrid) return;
      const sorted = [...cards].sort((a, b) => {
        if (sortMode === 'tps-desc') {
          const td = Number(b.getAttribute('data-tps') || 0) - Number(a.getAttribute('data-tps') || 0);
          if (td !== 0) return td;
          return Number(a.getAttribute('data-status-rank') || 0) - Number(b.getAttribute('data-status-rank') || 0);
        }
        if (sortMode === 'vram-asc') {
          const vd = Number(a.getAttribute('data-vram') || 0) - Number(b.getAttribute('data-vram') || 0);
          if (vd !== 0) return vd;
          return Number(b.getAttribute('data-tps') || 0) - Number(a.getAttribute('data-tps') || 0);
        }
        if (sortMode === 'params-desc') {
          const pd = Number(b.getAttribute('data-params') || 0) - Number(a.getAttribute('data-params') || 0);
          if (pd !== 0) return pd;
          const sr = Number(a.getAttribute('data-status-rank') || 0) - Number(b.getAttribute('data-status-rank') || 0);
          if (sr !== 0) return sr;
          return Number(b.getAttribute('data-tps') || 0) - Number(a.getAttribute('data-tps') || 0);
        }
        return Number(a.getAttribute('data-index') || 0) - Number(b.getAttribute('data-index') || 0);
      });
      const frag = document.createDocumentFragment();
      sorted.forEach((c) => frag.appendChild(c));
      cardsGrid.appendChild(frag);
    }

    function syncUrl() {
      if (!window.history || !window.history.replaceState) return;
      const params = new URLSearchParams();
      const activeLang = new URLSearchParams(window.location.search).get('lang');
      if (activeLang) params.set('lang', activeLang);
      if (selectedCpuVal) params.set('cpu', selectedCpuVal);
      if (selectedRamGb !== null) params.set('ram', String(selectedRamGb));
      if (selectedGpuVal) params.set('gpu', selectedGpuVal);
      if (selectedGpuVal && selectedGpuVal !== 'none' && gpuCount > 1) {
        params.set('gpus', String(gpuCount));
        if (splitMode !== 'layer') params.set('split', splitMode);
      }
      if (selectedModel !== 'all') params.set('model', selectedModel);
      if (selectedStatus !== 'all') params.set('status', selectedStatus);
      if (currentSort !== 'featured') params.set('sort', currentSort);
      if (selectedQuant !== 'Q4_K_M') params.set('quant', selectedQuant);
      if (reserveProfile !== 'desktop') {
        params.set('reserve', reserveProfile);
        if (reserveProfile === 'custom' && customUsableGb !== null && customUsableGb > 0) {
          params.set('customGb', String(customUsableGb));
        }
      }

      const qs = params.toString();
      const targetUrl = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
      window.history.replaceState(null, '', targetUrl);
    }

    function sortLiveItems(items: LiveItem[], sortVal: string) {
      items.sort((a, b) => {
        if (sortVal === 'tps-desc') {
          if (b.res.est_tps !== a.res.est_tps) return b.res.est_tps - a.res.est_tps;
          return a.rank - b.rank;
        }
        if (sortVal === 'vram-asc') {
          if (a.res.total_vram_gb !== b.res.total_vram_gb) return a.res.total_vram_gb - b.res.total_vram_gb;
          return b.res.est_tps - a.res.est_tps;
        }
        if (sortVal === 'params-desc') {
          if (b.model.params_b !== a.model.params_b) return b.model.params_b - a.model.params_b;
          if (a.rank !== b.rank) return a.rank - b.rank;
          return b.res.est_tps - a.res.est_tps;
        }
        if (a.rank !== b.rank) return a.rank - b.rank;
        if (b.model.params_b !== a.model.params_b) return b.model.params_b - a.model.params_b;
        return b.res.est_tps - a.res.est_tps;
      });
    }

    function buildLiveItemForPair(model: ModelSpec, h: HardwareSpec, guideSlug?: string): LiveItem | null {
      const effCustom = reserveProfile === 'custom' ? customUsableGb : null;
      const activeFormat = formatForQuant(selectedQuant);
      const res = estimateRigRun({
        model,
        hardware: h,
        gpuCount: h.gpu_count || 1,
        quant: selectedQuant,
        format: activeFormat,
        contextTokens: 8192,
        kvQuant: 'fp16',
        reserveProfile,
        customUsableGb: effCustom,
      });
      if (selectedStatus !== 'all' && res.status !== selectedStatus) return null;
      const maxFit = maxFitContextDetails(model, h, selectedQuant, reserveProfile, 'fp16', effCustom);
      const maxFitLabel =
        maxFit.contextTokens > 0 && maxFit.estTpsHigh > 0
          ? t('common.maxFitWithSpeed', {
              ctx: formatContextLabel(maxFit.contextTokens),
              gb: maxFit.totalVramGb.toFixed(1),
              low: maxFit.estTpsLow,
              high: maxFit.estTpsHigh,
            })
          : maxFit.contextTokens > 0
            ? t('common.maxFitLabel', {
                ctx: formatContextLabel(maxFit.contextTokens),
                gb: maxFit.totalVramGb.toFixed(1),
              })
            : t('common.maxFitNone');
      const simParams = new URLSearchParams({ model: model.id, hw: h.id });
      if (selectedQuant !== 'Q4_K_M') {
        simParams.set('fmt', activeFormat);
        simParams.set('quant', selectedQuant);
      }
      if (reserveProfile !== 'desktop') {
        simParams.set('reserve', reserveProfile);
      }
      return {
        model,
        hw: h,
        res,
        rank: rankOf(res.status),
        simHref: `/calculator/?${simParams.toString()}`,
        guideSlug,
        chipLabel: `${h.backend} · ${h.bandwidth_gbps} GB/s`,
        hwSubtitle: t('common.onPrefix', { hw: h.name }),
        layersText: t('common.layersCount', {
          fit: res.gpu_layers_fit,
          total: res.total_layers,
        }),
        maxFitLabel,
      };
    }

    function computeModelOnlyLiveItems(): LiveItem[] {
      if (selectedModel === 'all') return [];
      const model = modelById.get(selectedModel);
      if (!model) return [];

      const items: LiveItem[] = [];
      for (const h of catData.hardware) {
        if (curatedKeySet.has(`${model.id}::${h.id}`)) continue;
        const item = buildLiveItemForPair(model, h);
        if (item) items.push(item);
      }
      sortLiveItems(items, currentSort);
      return items;
    }

    function computeCuratedReserveLiveItems(): LiveItem[] {
      const items: LiveItem[] = [];
      for (const [pairKey, slug] of curatedSlugMap.entries()) {
        const sepIdx = pairKey.indexOf('::');
        if (sepIdx < 0) continue;
        const mId = pairKey.slice(0, sepIdx);
        const hId = pairKey.slice(sepIdx + 2);
        if (selectedModel !== 'all' && mId !== selectedModel) continue;
        const m = modelById.get(mId);
        const h = hwById.get(hId);
        if (!m || !h) continue;
        const item = buildLiveItemForPair(m, h, slug);
        if (item) items.push(item);
      }
      if (selectedModel !== 'all') {
        const m = modelById.get(selectedModel);
        if (m) {
          for (const h of catData.hardware) {
            if (curatedKeySet.has(`${m.id}::${h.id}`)) continue;
            const item = buildLiveItemForPair(m, h);
            if (item) items.push(item);
          }
        }
      }
      sortLiveItems(items, currentSort);
      return items;
    }

    function computeRigLiveResults(): {
      items: LiveItem[];
      allFits: number;
      allTight: number;
      allPartial: number;
      allOom: number;
      rigTitle: string;
      rigSimHref: string;
    } {
      const rig = resolveActiveRigForSim();
      const candidateModels =
        selectedModel === 'all'
          ? catData.models
          : catData.models.filter((m) => m.id === selectedModel);

      const items: LiveItem[] = [];
      let allFits = 0;
      let allTight = 0;
      let allPartial = 0;
      let allOom = 0;

      const effCustom = reserveProfile === 'custom' ? customUsableGb : null;
      const activeFormat = formatForQuant(selectedQuant);
      for (const m of candidateModels) {
        const res = estimateRigRun({
          model: m,
          hardware: rig.hw,
          gpuCount: rig.effGpuCount,
          cpu: rig.cpu,
          systemRamGb: rig.systemRamArg ?? undefined,
          quant: selectedQuant,
          format: activeFormat,
          contextTokens: 8192,
          kvQuant: 'fp16',
          splitMode,
          reserveProfile,
          customUsableGb: effCustom,
        });

        if (res.status === 'Fits') allFits += 1;
        else if (res.status === 'Tight Fit') allTight += 1;
        else if (res.status === 'Partial Offload') allPartial += 1;
        else allOom += 1;

        if (selectedStatus !== 'all' && res.status !== selectedStatus) continue;

        const simHref = buildSimulatorUrl({
          modelId: m.id,
          hw: rig.hw,
          isExactCatalogSku: rig.isExactCatalogSku,
          gpuCount: rig.effGpuCount,
          splitMode,
          cpuId: rig.cpu.id,
          ramGb: rig.ramForLink,
          quant: selectedQuant,
          format: activeFormat,
          reserveProfile,
        });

        const guideSlug = resolveCuratedGuideSlug(
          m.id,
          rig.hw,
          rig.effGpuCount,
          rig.isExactCatalogSku,
          curatedSlugMap,
        );

        const isCpuOnly = res.gpu_count === 0;
        const chipLabel = rig.hw
          ? `${rig.hw.backend} · ${rig.hw.bandwidth_gbps} GB/s`
          : `CPU · ${rig.cpu.effective_bw_gbps} GB/s`;
        const layersText = isCpuOnly
          ? t('common.cpuOnlyLayers', { total: res.total_layers })
          : t('common.layersCount', { fit: res.gpu_layers_fit, total: res.total_layers });

        let maxFitLabel = '';
        if (rig.hw && res.gpu_count === 1) {
          const maxFit = maxFitContextDetails(m, rig.hw, selectedQuant, reserveProfile, 'fp16', effCustom);
          maxFitLabel =
            maxFit.contextTokens > 0 && maxFit.estTpsHigh > 0
              ? t('common.maxFitWithSpeed', {
                  ctx: formatContextLabel(maxFit.contextTokens),
                  gb: maxFit.totalVramGb.toFixed(1),
                  low: maxFit.estTpsLow,
                  high: maxFit.estTpsHigh,
                })
              : maxFit.contextTokens > 0
                ? t('common.maxFitLabel', {
                    ctx: formatContextLabel(maxFit.contextTokens),
                    gb: maxFit.totalVramGb.toFixed(1),
                  })
                : t('common.maxFitNone');
        } else if (res.comm_warning) {
          maxFitLabel = `PCIe TP · -${Math.round(res.comm_overhead_pct || 0)}% sync`;
        } else if (res.headroom_gb > 0) {
          maxFitLabel = t('sim.headroomFree', { gb: res.headroom_gb.toFixed(1) });
        } else {
          maxFitLabel = t('common.maxFitNone');
        }

        items.push({
          model: m,
          hw: rig.hw,
          res,
          rank: rankOf(res.status),
          simHref,
          guideSlug,
          chipLabel,
          hwSubtitle: t('common.onPrefix', { hw: rig.rigTitle }),
          layersText,
          maxFitLabel,
        });
      }

      sortLiveItems(items, currentSort);

      const rigSimHref = buildSimulatorUrl({
        modelId: selectedModel !== 'all' ? selectedModel : undefined,
        hw: rig.hw,
        isExactCatalogSku: rig.isExactCatalogSku,
        gpuCount: rig.effGpuCount,
        splitMode,
        cpuId: rig.cpu.id,
        ramGb: rig.ramForLink,
        quant: selectedQuant,
        format: activeFormat,
        reserveProfile,
      });

      return {
        items,
        allFits,
        allTight,
        allPartial,
        allOom,
        rigTitle: rig.rigTitle,
        rigSimHref,
      };
    }

    function setGridVisible(el: Element | null, visible: boolean, displayClass: string) {
      if (!el) return;
      el.classList.toggle('hidden', !visible);
      el.classList.toggle(displayClass, visible);
    }

    function updateResultsModeBanner(opts: {
      isRig: boolean;
      rigResult?: {
        items: LiveItem[];
        allFits: number;
        allTight: number;
        allPartial: number;
        allOom: number;
        rigTitle: string;
        rigSimHref: string;
      };
    }) {
      if (!modeBanner || !modeBadge || !modeHeading || !modeSub || !modeSelectBtn || !modeSimCta) return;

      setGridVisible(modeBanner, true, 'flex');

      if (opts.isRig && opts.rigResult) {
        const rig = opts.rigResult;
        const guideCount = rig.items.filter((x) => Boolean(x.guideSlug)).length;

        modeBadge.removeAttribute('data-i18n');
        modeHeading.removeAttribute('data-i18n');
        modeSub.removeAttribute('data-i18n');
        modeSimCta.removeAttribute('data-i18n');

        modeBanner.classList.add('!border-[var(--accent-border)]', '!bg-[var(--accent-soft)]');
        modeBadge.classList.remove('badge-neutral');
        modeBadge.classList.add('badge-accent');

        modeBadge.textContent = t('home.modeBadgeRig');
        modeHeading.textContent = t('home.modeHeadingRig', { rig: rig.rigTitle });
        modeSub.textContent = t('home.subRigSummary', {
          fits: rig.allFits,
          tight: rig.allTight,
          partial: rig.allPartial,
          oom: rig.allOom,
          quant: QUANT_SHORT_LABELS[selectedQuant],
          guides: guideCount,
        });

        setGridVisible(modeSelectBtn, false, 'inline-flex');
        setGridVisible(modeClosePresetsBtn, false, 'inline-flex');
        setGridVisible(modeSimCta, true, 'inline-flex');
        modeSimCta.href = rig.rigSimHref;
        modeSimCta.textContent = t('home.openRigSim');
        return;
      }

      modeBanner.classList.remove('!border-[var(--accent-border)]', '!bg-[var(--accent-soft)]');
      modeBadge.classList.remove('badge-accent');
      modeBadge.classList.add('badge-neutral');

      modeBadge.setAttribute('data-i18n', 'home.modeBadgeRef');
      modeBadge.textContent = t('home.modeBadgeRef');

      const detailParts: string[] = [];
      if (selectedModel !== 'all') {
        const m = modelById.get(selectedModel);
        if (m) detailParts.push(m.short_name);
      }
      if (selectedQuant !== 'Q4_K_M') {
        detailParts.push(QUANT_SHORT_LABELS[selectedQuant]);
      }
      if (reserveProfile === 'clean') {
        detailParts.push(t('reserve.clean'));
      } else if (reserveProfile === 'custom' && customUsableGb !== null) {
        detailParts.push(`${t('reserve.custom')} (${customUsableGb} GB)`);
      }

      if (detailParts.length > 0) {
        modeHeading.removeAttribute('data-i18n');
        modeHeading.textContent = t('home.modeHeadingRefDetail', { detail: detailParts.join(' · ') });
      } else {
        modeHeading.setAttribute('data-i18n', 'home.modeHeadingRef');
        modeHeading.textContent = t('home.modeHeadingRef');
      }

      modeSub.setAttribute('data-i18n', 'home.modeSubRef');
      modeSub.textContent = t('home.modeSubRef');

      setGridVisible(modeSelectBtn, true, 'inline-flex');
      modeSelectBtn.textContent = t('home.modeCtaSelectHw');
      if (modeClosePresetsBtn) {
        setGridVisible(modeClosePresetsBtn, true, 'inline-flex');
        modeClosePresetsBtn.textContent = t('home.modeClosePresets');
      }
      setGridVisible(modeSimCta, false, 'inline-flex');
    }

    function renderLiveCards(
      items: LiveItem[],
      isRigMode: boolean,
      bannerMeta?: {
        allFits: number;
        allTight: number;
        allPartial: number;
        allOom: number;
        rigTitle: string;
        rigSimHref: string;
      },
    ) {
      if (!liveSection || !liveGrid) return;

      if (items.length === 0) {
        liveSection.classList.add('hidden');
        liveGrid.innerHTML = '';
        if (livePagBar) livePagBar.classList.add('hidden');
        return;
      }

      liveSection.classList.remove('hidden');

      const showSubHeader =
        !isRigMode && reserveProfile === 'desktop' && selectedQuant === 'Q4_K_M';
      if (liveHeader) {
        liveHeader.classList.toggle('hidden', !showSubHeader);
        liveHeader.classList.toggle('flex', showSubHeader);
      }
      liveSection.classList.toggle('mt-6', showSubHeader);
      liveSection.classList.toggle('mt-4', !showSubHeader);
      liveGrid.classList.toggle('mt-4', showSubHeader);
      liveGrid.classList.toggle('mt-0', !showSubHeader);

      if (liveBadge && liveHeading && liveSub && liveSimCta) {
        if (isRigMode && bannerMeta) {
          const guideCount = items.filter((x) => Boolean(x.guideSlug)).length;
          liveBadge.textContent = t('home.badgeRig');
          liveHeading.textContent =
            items.length === 1
              ? t('home.headingRigModelOne', { rig: bannerMeta.rigTitle })
              : t('home.headingRigModels', { count: items.length, rig: bannerMeta.rigTitle });
          liveSub.textContent = t('home.subRigSummary', {
            fits: bannerMeta.allFits,
            tight: bannerMeta.allTight,
            partial: bannerMeta.allPartial,
            oom: bannerMeta.allOom,
            quant: QUANT_SHORT_LABELS[selectedQuant],
