  interface HomeCatalogPayload {
    models: ModelSpec[];
    hardware: HardwareSpec[];
    cpus: CpuSpec[];
    curatedKeys: string[];
    curatedSlugs: Record<string, string>;
    measuredPairs?: Record<string, string>;
  }

  interface LiveItem {
    model: ModelSpec;
    hw: HardwareSpec | null;
    res: RigRunEstimate;
    rank: number;
    simHref: string;
    guideSlug?: string;
    gpuCountLabel: string;
    chipLabel: string;
    hwSubtitle: string;
    layersText: string;
    maxFitLabel: string;
  }

  function rankOf(s: CompatStatus): number {
    if (s === 'Fits') return 0;
    if (s === 'Tight Fit') return 1;
    if (s === 'Partial Offload') return 2;
    return 3;
  }

  function badgeClasses(s: CompatStatus): string {
    if (s === 'Fits') return 'border-emerald-200 bg-emerald-50 text-emerald-800';
    if (s === 'Tight Fit') return 'border-orange-200 bg-orange-50 text-orange-800';
    if (s === 'Partial Offload') return 'border-amber-200 bg-amber-50 text-amber-800';
    return 'border-rose-200 bg-rose-50 text-rose-800';
  }

  function dotClass(s: CompatStatus): string {
    if (s === 'Fits') return 'bg-emerald-600';
    if (s === 'Tight Fit') return 'bg-orange-500';
    if (s === 'Partial Offload') return 'bg-amber-500';
    return 'bg-rose-600';
  }

  function speedBadgeClasses(tier: SpeedTier): string {
    if (tier === 'Fast') return 'border-sky-200 bg-sky-50 text-sky-800';
    if (tier === 'Interactive') return 'border-indigo-200 bg-indigo-50 text-indigo-800';
    if (tier === 'Readable') return 'border-slate-200 bg-slate-100 text-slate-700';
    if (tier === 'Slow') return 'border-amber-200 bg-amber-50 text-amber-800';
    return 'border-rose-200 bg-rose-50 text-rose-800';
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function initMatrixPage() {
    const PAGE_SIZE = 24;

    const cpuRoot = document.getElementById('cb-cpu');
    const ramRoot = document.getElementById('cb-ram');
