---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComboboxField from '../components/ComboboxField.astro';
import StatusBadge from '../components/StatusBadge.astro';
import SpeedBadge from '../components/SpeedBadge.astro';
import catalogRaw from '../data/catalog_data.json';
import rawPagesData from '../data/pages_data.json';
import type { CatalogData, PageEntry, SpeedTier } from '../types/vram';
import { statusRank } from '../utils/hubs';
import {
  classifySpeedTier,
  effectiveUsableVramGb,
  formatContextLabel,
  formatTpsRange,
} from '../utils/physics';

const PAGE_SIZE = 24;
const catalog = catalogRaw as CatalogData;
const rawEntries = rawPagesData as PageEntry[];
const updatedAt = catalog.updated_at ?? '2026-11-24';
const engineVersion = catalog.engine_version ?? 'v3.0';

const FEATURED_TOP_SLUGS = [
  'qwen3-8b-on-apple-m4-16gb',
  'qwen3-14b-on-nvidia-t4-16gb',
  'qwen3-32b-on-nvidia-a10-24gb',
  'gemma-3-27b-on-nvidia-a10-24gb',
  'qwen3-30b-a3b-on-apple-m4-pro-48gb',
  'gemma-3-27b-on-nvidia-l4-24gb',
  'qwen3-32b-on-rtx-4090-24gb',
  'qwen3-32b-on-rtx-5090-32gb',
  'llama-3.3-70b-on-dual-rtx-4090-48gb',
  'deepseek-r1-70b-on-ryzen-ai-max-395-128gb',
  'qwen3-8b-on-nvidia-t4-16gb',
  'qwen3-14b-on-nvidia-a10-24gb',
  'gemma-3-27b-on-rtx-4090-24gb',
  'qwen3-32b-on-apple-m4-max-128gb',
  'gemma-3-27b-on-apple-m4-pro-48gb',
  'qwen3-30b-a3b-on-nvidia-a10-24gb',
  'deepseek-r1-7b-on-apple-m4-16gb',
  'llama-3.1-8b-on-apple-m4-16gb',
  'gemma-3-27b-on-rtx-5090-32gb',
  'qwen3-14b-on-nvidia-l4-24gb',
  'qwen3-32b-on-apple-m4-pro-48gb',
  'llama-3.1-8b-on-nvidia-t4-16gb',
  'gemma-3-27b-on-nvidia-a10g-24gb',
  'llama-3.3-70b-on-ryzen-ai-max-395-128gb',
];
const featuredRank = new Map(FEATURED_TOP_SLUGS.map((slug, idx) => [slug, idx]));

const entries = [...rawEntries].sort((a, b) => {
  const fa = featuredRank.get(a.slug);
  const fb = featuredRank.get(b.slug);
  if (fa !== undefined && fb !== undefined) return fa - fb;
  if (fa !== undefined) return -1;
  if (fb !== undefined) return 1;
  const sr = statusRank(a.default_result.status) - statusRank(b.default_result.status);
  if (sr !== 0) return sr;
  if (b.model.params_b !== a.model.params_b) return b.model.params_b - a.model.params_b;
  if (b.default_result.est_tps !== a.default_result.est_tps) {
    return b.default_result.est_tps - a.default_result.est_tps;
  }
  return a.slug.localeCompare(b.slug);
});

const totalCount = entries.length;
const initialVisibleCount = Math.min(PAGE_SIZE, totalCount);
const initialRemainingCount = Math.max(0, totalCount - initialVisibleCount);
const initialProgressPct = totalCount > 0 ? Math.round((initialVisibleCount / totalCount) * 100) : 100;
const initialProgressStyle = `width: ${initialProgressPct}%`;
const paginationHiddenClass =
  initialRemainingCount > 0
    ? 'mt-7 rounded-2xl border border-slate-200 bg-white p-4 sm:p-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between'
    : 'hidden';
const fitsCount = entries.filter((e) => e.default_result.status === 'Fits').length;
const tightPartialCount = entries.filter(
  (e) => e.default_result.status === 'Tight Fit' || e.default_result.status === 'Partial Offload',
).length;

// Full static catalog hubs (all 22 models + all 103 hardware SKUs reachable in 1 hop from '/')
const uniqueHubModels = [...catalog.models].sort((a, b) => a.name.localeCompare(b.name));
const uniqueHubHardware = [...catalog.hardware].sort((a, b) => a.name.localeCompare(b.name));

const uniqueHubModelCount = uniqueHubModels.length;
const uniqueHubHwCount = uniqueHubHardware.length;
const catalogModelCount = catalog.models.length;
const catalogHwCount = catalog.hardware.length;
const updatedArgs = JSON.stringify({ date: updatedAt });

const curatedKeys = entries.map((e) => `${e.model.id}::${e.hardware.id}`);
const curatedSlugs: Record<string, string> = {};
for (const e of entries) {
  curatedSlugs[`${e.model.id}::${e.hardware.id}`] = e.slug;
}
const homeCatalogPayload = JSON.stringify({
  models: catalog.models,
  hardware: catalog.hardware,
  cpus: catalog.cpus,
  curatedKeys,
  curatedSlugs,
});

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'VRAMCalc.me',
  url: 'https://vramcalc.me/',
  description:
    'Local AI LLM VRAM calculator and inference tokens/sec estimator across NVIDIA RTX, Apple Silicon, AMD Radeon, Intel Arc, Multi-GPU rigs, and CPU/RAM.',
};

const homeCollectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Local AI Model VRAM & Inference Speed Matrix',
  url: 'https://vramcalc.me/',
  description: `Compatibility matrix indexing ${totalCount} deep benchmark guides and live calculations across ${catalogHwCount} GPUs (1x-8x) and ${catalogModelCount} open-weight models.`,
  hasPart: [
    {
      '@type': 'CollectionPage',
      name: 'Multi-GPU & CPU/RAM Rig Simulator',
      url: 'https://vramcalc.me/calculator/',
    },
    {
      '@type': 'CollectionPage',
      name: `All Local AI GPUs (${uniqueHubHwCount} Hardware Hubs)`,
      url: 'https://vramcalc.me/gpu/',
    },
    {
      '@type': 'CollectionPage',
      name: `All Open-Weight LLMs (${uniqueHubModelCount} Model Hubs)`,
      url: 'https://vramcalc.me/model/',
    },
  ],
};
const homeOgTitle = `Local AI LLM VRAM & Speed Calculator (${catalogModelCount} Models × ${catalogHwCount} GPUs · Updated ${updatedAt}) | VRAMCalc.me`;
const homeOgDescription = `Check GGUF, AWQ & MLX VRAM fit, max safe context, Tight Fit & PCIe All-Reduce headroom, and bandwidth tok/s estimate ranges across ${catalogHwCount} GPUs & Macs and ${catalogModelCount} open LLMs (Qwen3, Gemma 3, DeepSeek-R1, Llama-3.3).`;

const heroDescArgs = JSON.stringify({ models: catalogModelCount, hw: catalogHwCount });
const ctaGpusArgs = JSON.stringify({ count: uniqueHubHwCount });
const ctaModelsArgs = JSON.stringify({ count: uniqueHubModelCount });
const initCountArgs = JSON.stringify({
  shown: initialVisibleCount,
  total: totalCount,
  models: catalogModelCount,
  hw: catalogHwCount,
});
const initViewArgs = JSON.stringify({ shown: initialVisibleCount, total: totalCount });
const initLoadArgs = JSON.stringify({ chunk: Math.min(PAGE_SIZE, initialRemainingCount), left: initialRemainingCount });
const modelHubsArgs = JSON.stringify({ count: uniqueHubModelCount });
const hwHubsArgs = JSON.stringify({ count: uniqueHubHwCount });
---

<BaseLayout
  title="VRAMCalc.me — Local AI Model VRAM & Speed Calculator"
  description="Check whether DeepSeek-R1, Qwen3, Qwen2.5-Coder, Gemma 3, and Llama run smoothly on Apple Silicon M1–M5, NVIDIA GTX/RTX (1x–8x), AMD Radeon / Strix Halo, Intel Arc, or CPU RAM."
  canonicalPath="/"
  totalPages={totalCount}
  ogTitle={homeOgTitle}
  ogDescription={homeOgDescription}
  ogImage="/og/home.png"
  ogImageAlt={homeOgTitle}
  themeColor="#2563eb"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(homeCollectionSchema)} />
  </Fragment>

  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12">
      <div class="max-w-3xl">
        <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
          <span
            class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 font-mono font-semibold text-emerald-800"
            data-i18n="common.updated"
            data-i18n-args={updatedArgs}
          >
            Updated {updatedAt}
          </span>
          <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 font-mono font-medium text-slate-700">
            Physics {engineVersion} · <span class="ml-1" data-i18n="speed.formulaDesc">Formula Estimate (±15–25%)</span>
          </span>
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl" data-i18n="home.heroTitle">
          Local AI Model VRAM &amp; Inference Speed Matrix
        </h1>
        <p class="mt-3 text-base leading-relaxed text-slate-600" data-i18n="home.heroDesc" data-i18n-args={heroDescArgs}>
          Check memory fit, max safe context, and honest bandwidth throughput ranges across {catalogModelCount} models (Qwen3, Gemma 3, DeepSeek-R1, Llama-3.3) and {catalogHwCount} GPUs &amp; Macs (M4 16GB, T4, L4, A10, RTX 5090), supporting GGUF, AWQ, MLX, and 1x–8x multi-GPU topologies.
        </p>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <a
            href="/calculator/"
            class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-4 py-2 text-xs font-semibold text-white hover:bg-blue-700 transition-colors"
            data-i18n="home.ctaSimulator"
          >
            Multi-GPU, AWQ/MLX &amp; CPU Simulator -&gt;
          </a>
          <a
            href="/gpu/"
            class="inline-flex items-center gap-1.5 rounded-lg bg-slate-950 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800 transition-colors"
            data-i18n="home.ctaGpus"
            data-i18n-args={ctaGpusArgs}
          >
            Browse {uniqueHubHwCount} GPU Hubs -&gt;
          </a>
          <a
            href="/model/"
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-4 py-2 text-xs font-semibold text-slate-800 hover:border-blue-300 hover:bg-blue-50 hover:text-blue-700 transition-colors"
            data-i18n="home.ctaModels"
            data-i18n-args={ctaModelsArgs}
          >
            Browse {uniqueHubModelCount} Model Hubs -&gt;
          </a>
        </div>
      </div>

      <dl class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
        <div class="rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-3">
          <dt class="text-xs font-medium text-slate-500" data-i18n="home.kpiGuides">Curated Pairings</dt>
          <dd class="mt-1 font-mono text-2xl font-bold text-slate-950 tabular-nums">{totalCount}</dd>
        </div>
        <div class="rounded-xl border border-emerald-200/80 bg-emerald-50/50 px-4 py-3">
          <dt class="text-xs font-medium text-emerald-800" data-i18n="home.kpiSmooth">Full Fits (8K Q4)</dt>
          <dd class="mt-1 font-mono text-2xl font-bold text-emerald-900 tabular-nums">{fitsCount}</dd>
        </div>
        <div class="rounded-xl border border-amber-200/80 bg-amber-50/50 px-4 py-3">
          <dt class="text-xs font-medium text-amber-800" data-i18n="home.kpiPartial">Tight / Partial Offload</dt>
          <dd class="mt-1 font-mono text-2xl font-bold text-amber-900 tabular-nums">{tightPartialCount}</dd>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-3">
          <dt class="text-xs font-medium text-slate-500" data-i18n="home.kpiLiveEngine">Static Matrix Coverage</dt>
          <dd class="mt-1 font-mono text-2xl font-bold text-slate-950 tabular-nums">
            {catalogModelCount} × {catalogHwCount}
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Hardware Rig Configurator + Compatibility Matrix -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs sm:p-5">
      <!-- Row 1: CPU + RAM + GPU + QTY -->
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.45fr)_minmax(0,0.75fr)_minmax(0,1.45fr)_116px] lg:items-end">
        <div>
          <ComboboxField
            id="cb-cpu"
            label="CPU / Unified Chip"
            placeholder="Search i5/i7, Ryzen, Apple M1–M5..."
            labelI18n="home.cpuLabel"
            placeholderI18n="home.cpuPlaceholder"
          />
        </div>

        <div>
          <ComboboxField
            id="cb-ram"
            label="RAM (GB)"
            placeholder="e.g. 32 GB"
            labelI18n="home.ramLabel"
            placeholderI18n="home.ramPlaceholder"
          />
        </div>

        <div>
          <ComboboxField
            id="cb-gpu"
            label="GPU (Graphics Card)"
            placeholder="Search GPU or None (CPU-Only)..."
            labelI18n="home.gpuLabel"
            placeholderI18n="home.gpuPlaceholder"
          />
        </div>

        <div>
          <label
            for="rig-gpu-count"
            class="block text-xs font-semibold uppercase tracking-wider text-slate-500"
            data-i18n="home.qtyLabel"
          >
            Qty
          </label>
          <select
            id="rig-gpu-count"
            disabled
            class="mt-1.5 h-10 w-full rounded-lg border border-slate-200 bg-slate-50 px-2.5 text-sm font-semibold text-slate-400 cursor-not-allowed focus:border-blue-600 focus:outline-none transition-colors"
          >
            <option value="0">—</option>
          </select>
        </div>
      </div>

      <!-- Conditional Sub-Bar: Unified Memory Info / Multi-GPU Split / CPU-Only Info -->
      <div
        id="rig-context-bar"
        class="mt-3 hidden rounded-xl border border-blue-200/80 bg-blue-50/70 px-3.5 py-2 text-xs text-slate-700"
      >
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span id="rig-context-text" class="font-medium text-slate-800"></span>
          <div id="rig-split-toggle" class="hidden">
            <div
              class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white p-0.5"
              role="group"
              aria-label="Multi-GPU split strategy"
            >
              <button
                type="button"
                data-home-split="layer"
                class="rounded-md px-2.5 py-1 text-[11px] font-semibold bg-slate-900 text-white cursor-pointer"
                data-i18n="home.layerSplit"
              >
                Layer Split
              </button>
              <button
                type="button"
                data-home-split="tensor"
                class="rounded-md px-2.5 py-1 text-[11px] font-medium text-slate-600 hover:text-slate-950 cursor-pointer"
                data-i18n="home.tensorParallel"
              >
                Tensor Parallel
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Row 2: Model + Status + Sort + Count + Reset -->
      <div class="mt-4 flex flex-wrap items-center justify-between gap-2.5 border-t border-slate-100 pt-3.5">
        <div class="flex flex-wrap items-center gap-2.5">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500" data-i18n="home.modelLabel">Model</span>
            <div class="w-48 sm:w-56">
              <ComboboxField
                id="cb-model"
                label="Model"
                placeholder="All Models"
                compact={true}
                labelI18n="home.modelLabel"
              />
            </div>
          </div>

          <span class="hidden h-4 w-px bg-slate-200 sm:inline-block" aria-hidden="true"></span>

          <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter by status">
            {(['all', 'Fits', 'Tight Fit', 'Partial Offload', 'OOM'] as const).map((st) => {
              const btnClass =
                st === 'all'
                  ? 'rounded-full border px-2.5 py-1 text-xs font-semibold transition-colors cursor-pointer border-slate-900 bg-slate-900 text-white'
                  : 'rounded-full border px-2.5 py-1 text-xs font-semibold transition-colors cursor-pointer border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100';
              const stI18nKey =
                st === 'all'
                  ? 'status.allStatuses'
                  : st === 'Fits'
                    ? 'status.fits'
                    : st === 'Tight Fit'
                      ? 'status.tightFit'
                      : st === 'Partial Offload'
                        ? 'status.partialOffload'
                        : 'status.oom';
              return (
                <button
                  type="button"
                  data-status-btn={st}
                  data-i18n={stI18nKey}
                  class={btnClass}
                >
                  {st === 'all' ? 'All Statuses' : st}
                </button>
              );
            })}
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5 text-xs text-slate-600">
          <div class="flex items-center gap-1.5">
            <label for="filter-sort" class="text-[11px] font-semibold uppercase tracking-wider text-slate-400" data-i18n="home.sortLabel">
              Sort
            </label>
            <select
              id="filter-sort"
              class="h-8 rounded-lg border border-slate-300 bg-white px-2 text-xs font-medium text-slate-900 focus:border-blue-600 focus:outline-none"
            >
              <option value="featured" data-i18n="home.sortRecommended">Recommended</option>
              <option value="tps-desc" data-i18n="home.sortFastest">Fastest tok/s</option>
              <option value="vram-asc" data-i18n="home.sortLowestVram">Lowest VRAM</option>
              <option value="params-desc" data-i18n="home.sortLargestModel">Largest Model</option>
            </select>
          </div>

          <span id="filter-count" class="font-mono tabular-nums" data-i18n="home.countInitial" data-i18n-args={initCountArgs}>
            {initialVisibleCount} / {totalCount} guides · {catalogModelCount}×{catalogHwCount} static hubs
          </span>
          <button
            id="filter-reset"
            type="button"
            class="hidden font-semibold text-blue-600 hover:text-blue-800 cursor-pointer"
            data-i18n="common.reset"
          >
            Reset
          </button>
        </div>
      </div>
    </div>

    <!-- Curated Deep-Dive Cards Grid (SSR Progressive Window: first 24 visible, all 165 crawlable in DOM) -->
    <div id="cards-grid" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry, idx) => {
        const res = entry.default_result;
        const usable =
          res.effective_usable_vram_gb ??
          effectiveUsableVramGb(entry.hardware, entry.hardware.gpu_count || 1, 'desktop')[1];
        const fillPct = Math.min(100, Math.round((res.total_vram_gb / Math.max(0.5, usable)) * 100));
        const barColor =
          res.status === 'Fits'
            ? 'bg-emerald-500'
            : res.status === 'Tight Fit'
              ? 'bg-orange-500'
              : res.status === 'Partial Offload'
                ? 'bg-amber-500'
                : 'bg-rose-500';
        const speedTier: SpeedTier = res.speed_tier ?? classifySpeedTier(res.est_tps, res.status);
        const tpsDisplay = formatTpsRange(res.est_tps_low, res.est_tps_high, res.est_tps, res.status);
        const fillStyle = `width: ${fillPct}%`;
        const fillBarClass = `h-full rounded-full ${barColor}`;
        const detailHref = `/can-i-run/${entry.slug}/`;
        const rank = statusRank(res.status);
        const hiddenClass = idx >= PAGE_SIZE ? ' hidden' : '';
        const cardClass = `matrix-card group flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 transition-all hover:border-blue-300 hover:shadow-md${hiddenClass}`;
        const searchIndex = [
          entry.model.name,
          entry.model.short_name,
          entry.model.family,
          entry.hardware.id,
          entry.hardware.name,
          entry.hardware.short_name,
          entry.hardware.vendor,
          entry.hardware.series,
          entry.hardware.category || '',
          entry.hardware.backend,
          entry.hardware.memory_type,
          res.status,
          speedTier,
        ]
          .join(' ')
          .toLowerCase();

        const hwOnArgs = JSON.stringify({ hw: entry.hardware.name });
        const layerArgs = JSON.stringify({ fit: res.gpu_layers_fit, total: res.total_layers });
        const statusAttrs = res.status === 'OOM' ? 'status.oom' : undefined;
        const hasMaxFit = Boolean(
          entry.max_fit_context && entry.max_fit_context > 0 && entry.max_fit_total_vram_gb,
        );
        const maxFitCtxLabel = hasMaxFit ? formatContextLabel(entry.max_fit_context!) : '';
        const maxFitGbStr = hasMaxFit ? entry.max_fit_total_vram_gb!.toFixed(1) : '';
        const maxFitArgs = hasMaxFit ? JSON.stringify({ ctx: maxFitCtxLabel, gb: maxFitGbStr }) : undefined;

        return (
          <article
            data-card
            data-index={idx}
            data-tps={res.est_tps}
            data-vram={res.total_vram_gb}
            data-params={entry.model.params_b}
            data-status-rank={rank}
            data-model={entry.model.id}
            data-hardware={entry.hardware.id}
            data-vendor={entry.hardware.vendor}
            data-status={res.status}
            data-search={searchIndex}
            class={cardClass}
          >
            <div>
              <div class="flex items-start justify-between gap-2">
                <div class="flex flex-wrap items-center gap-1.5">
                  <StatusBadge status={res.status} />
                  <SpeedBadge tier={speedTier} short={true} />
                  <span
                    class="rounded bg-blue-50 px-1.5 py-0.5 text-[10px] font-semibold text-blue-700"
                    data-i18n="common.fullGuide"
                  >
                    Full Guide
                  </span>
                </div>
                <span class="shrink-0 rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[11px] font-semibold text-slate-600">
                  {entry.hardware.backend} · {entry.hardware.bandwidth_gbps} GB/s
                </span>
              </div>

              <h2 class="mt-3.5 text-base font-bold tracking-tight text-slate-950 group-hover:text-blue-600 transition-colors">
                <a href={detailHref} class="focus:outline-none">
                  {entry.model.short_name}
                  <span
                    class="block text-sm font-semibold text-slate-600"
                    data-i18n="common.onPrefix"
                    data-i18n-args={hwOnArgs}
                  >
                    on {entry.hardware.name}
                  </span>
                </a>
              </h2>

              <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-slate-600">
                {entry.verdict_summary}
              </p>
            </div>

            <div class="mt-4 pt-4 border-t border-slate-100">
              <div class="flex items-center justify-between text-xs">
                <span class="text-slate-500" data-i18n="common.vram8kLabel">VRAM @ 8K</span>
                <span class="font-mono font-semibold text-slate-900 tabular-nums">
                  {res.total_vram_gb.toFixed(1)} / {usable.toFixed(1)} GB
                </span>
              </div>
              <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-slate-100">
                <div class={fillBarClass} style={fillStyle}></div>
              </div>
              <div class="mt-1.5 flex items-center justify-between gap-2 text-[11px] text-slate-500 tabular-nums">
                {hasMaxFit ? (
                  <span data-i18n="common.maxFitLabel" data-i18n-args={maxFitArgs}>
                    Max Fit: {maxFitCtxLabel} ({maxFitGbStr} GB)
                  </span>
                ) : (
                  <span data-i18n="common.maxFitNone">Max Fit: Offload req.</span>
                )}
                {res.status !== 'OOM' && (
                  <span class="shrink-0 font-mono text-[10px] text-slate-400" data-i18n="speed.formulaEst">
                    Formula est.
                  </span>
                )}
              </div>

              <div class="mt-3 flex items-center justify-between">
                <div class="flex items-baseline gap-1.5">
                  <span class="font-mono text-base sm:text-lg font-bold text-slate-950 tabular-nums" data-i18n={statusAttrs}>
                    {tpsDisplay}
                  </span>
                  <span
                    class="text-[11px] text-slate-500 tabular-nums"
                    data-i18n="common.layersCount"
                    data-i18n-args={layerArgs}
                  >
                    ({res.gpu_layers_fit}/{res.total_layers} layers)
                  </span>
                </div>

                <a
                  href={detailHref}
                  class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-800"
                  data-i18n="common.openCalc"
                >
                  Open Calc -&gt;
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Progressive Pagination Controls (Curated Guides) -->
    <div id="pagination-bar" class={paginationHiddenClass}>
      <div class="w-full sm:max-w-xs">
        <p
          id="pagination-summary"
          class="font-mono text-xs font-medium text-slate-600 tabular-nums"
          data-i18n="home.viewingGuides"
          data-i18n-args={initViewArgs}
        >
          Viewing {initialVisibleCount} of {totalCount} matching guides
        </p>
        <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-slate-100">
          <div
            id="pagination-bar-fill"
            class="h-full rounded-full bg-blue-600 transition-all duration-200"
            style={initialProgressStyle}
          ></div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 shrink-0">
        <button
          id="load-more-btn"
          type="button"
          class="rounded-lg bg-slate-950 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800 transition-colors cursor-pointer"
          data-i18n="home.loadMoreGuides"
          data-i18n-args={initLoadArgs}
        >
          Load 24 More ({initialRemainingCount} left)
        </button>
        <button
          id="show-all-btn"
          type="button"
          class="rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 hover:border-blue-300 hover:text-blue-700 transition-colors cursor-pointer"
          data-i18n="home.showAllRemaining"
        >
          Show All Remaining
        </button>
      </div>
    </div>

    <!-- Live Full-Catalog & Custom Rig Calculations -->
    <section id="live-calc-section" class="mt-6 hidden" aria-label="Live Catalog Estimates">
      <div class="flex flex-col gap-3 rounded-2xl border border-blue-200 bg-blue-50/60 p-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <span
              id="live-calc-badge"
              class="rounded-full bg-blue-600 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-white"
            >
              Live Catalog Physics
            </span>
            <h2 id="live-calc-heading" class="text-sm font-bold text-slate-950">
              Additional Live Catalog Estimates
            </h2>
          </div>
          <p id="live-calc-sub" class="mt-1 text-xs text-slate-600">
            Instant @8K + Max Fit calculations across all {catalogModelCount} models &amp; {catalogHwCount} catalog GPUs. Click any card for AWQ/MLX format toggles, reserve profiles, and multi-GPU splits.
          </p>
        </div>
        <a
          id="live-sim-cta"
          href="/calculator/"
          class="inline-flex shrink-0 items-center justify-center rounded-lg bg-blue-600 px-3.5 py-2 text-xs font-semibold text-white hover:bg-blue-700 transition-colors"
        >
          Open in Multi-GPU / CPU Simulator -&gt;
        </a>
      </div>

      <div id="live-calc-grid" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>

      <div id="live-pagination-bar" class="mt-5 hidden">
        <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-xs">
          <span id="live-pagination-summary" class="font-mono text-slate-600 tabular-nums"></span>
          <button
            id="live-load-more-btn"
            type="button"
            class="rounded-lg bg-slate-900 px-3.5 py-1.5 font-semibold text-white hover:bg-slate-800 cursor-pointer"
          >
            Load More Live Estimates
          </button>
        </div>
      </div>
    </section>

    <!-- Empty Filter State -->
    <div
      id="empty-state"
      class="mt-6 hidden rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center"
    >
      <p class="text-base font-semibold text-slate-900" data-i18n="home.emptyTitle">No matching Model × Rig configurations</p>
      <p class="mt-1 text-sm text-slate-500" data-i18n="home.emptyDesc">
        Try relaxing the status filter, adding GPU capacity, or launch the full Rig Simulator.
      </p>
      <div class="mt-4 flex flex-wrap justify-center gap-2">
        <button
          id="empty-reset-btn"
          type="button"
          class="rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800 cursor-pointer"
          data-i18n="common.resetAll"
        >
          Reset All Filters
        </button>
        <a
          id="empty-sim-link"
          href="/calculator/"
          class="rounded-lg border border-blue-200 bg-blue-50 px-4 py-2 text-xs font-semibold text-blue-700 hover:bg-blue-100"
          data-i18n="home.emptySimBtn"
        >
          Open Custom Rig Simulator -&gt;
        </a>
      </div>
    </div>

    <script type="application/json" id="home-catalog-json" set:html={homeCatalogPayload}></script>
  </section>

  <!-- Aggregation Hubs Discovery -->
  <section class="mx-auto max-w-6xl px-4 pt-6 sm:px-6" aria-labelledby="hubs-heading">
    <h2 id="hubs-heading" class="sr-only">Browse GPU and Model Aggregation Hubs</h2>
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
        <div class="flex items-center justify-between gap-2">
          <h3 class="text-sm font-bold tracking-tight text-slate-950" data-i18n="home.modelHubsHeading" data-i18n-args={modelHubsArgs}>
            Model Hubs ({uniqueHubModelCount})
          </h3>
          <a href="/model/" class="text-xs font-semibold text-blue-600 hover:text-blue-800" data-i18n="common.viewAll">
            View All -&gt;
          </a>
        </div>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {uniqueHubModels.map((m) => {
            const mHref = `/model/${m.id}/`;
            return (
              <a
                href={mHref}
                class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-700 hover:border-blue-300 hover:bg-blue-50 hover:text-blue-700 transition-colors"
              >
                {m.short_name}
              </a>
            );
          })}
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
        <div class="flex items-center justify-between gap-2">
          <h3 class="text-sm font-bold tracking-tight text-slate-950" data-i18n="home.hwHubsHeading" data-i18n-args={hwHubsArgs}>
            Hardware Hubs ({uniqueHubHwCount})
          </h3>
          <a href="/gpu/" class="text-xs font-semibold text-blue-600 hover:text-blue-800" data-i18n="common.viewAll">
            View All -&gt;
          </a>
        </div>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {uniqueHubHardware.map((h) => {
            const hHref = `/gpu/${h.id}/`;
            return (
              <a
                href={hHref}
                class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-700 hover:border-blue-300 hover:bg-blue-50 hover:text-blue-700 transition-colors"
              >
                {h.short_name}
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- Estimation Formula & Methodology -->
  <section id="methodology" class="mx-auto max-w-6xl px-4 pt-6 sm:px-6">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-bold tracking-tight text-slate-950" data-i18n="home.methodTitle">
          Physics Engine v3.0: Transparent Formula Ranges vs Real Benchmarks
        </h2>
        <span
          class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 font-mono text-[11px] font-medium text-slate-600"
          data-i18n="common.updated"
          data-i18n-args={updatedArgs}
        >
          Updated {updatedAt}
        </span>
      </div>
      <div class="mt-4 grid gap-6 text-sm leading-relaxed text-slate-600 md:grid-cols-3">
        <div>
          <h3 class="font-semibold text-slate-900" data-i18n="home.method1Title">1. Fit Status vs Independent Speed Tiers</h3>
          <p class="mt-1.5" data-i18n="home.method1Desc">
            VRAM Fit checks weight (GGUF/AWQ/MLX) + GQA KV + per-card CUDA overhead against Daily Desktop or Clean OS reserves, flagging &lt;5% / &lt;1 GB headroom as Tight Fit. Speed is scored separately: Fast (&gt;=25), Interactive (12–24), Readable (6–11), Slow (&lt;6 tok/s).
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-slate-900" data-i18n="home.method2Title">2. Runtime Formats &amp; Context Alignment</h3>
          <p class="mt-1.5" data-i18n="home.method2Desc">
            Compute exact footprint across GGUF (llama.cpp), 4-bit AWQ / FP8 (vLLM Marlin), and 4/8-bit Apple MLX (mlx-lm), always pairing the @8K baseline with the full footprint required at Max Fit context.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-slate-900" data-i18n="home.method3Title">3. Multi-GPU PCIe Sync &amp; Reference Anchors</h3>
          <p class="mt-1.5" data-i18n="home.method3Desc">
            Token throughput is reported as a ±15–25% formula estimate range rather than false 0.1 tok/s precision. Multi-GPU Tensor Parallel on PCIe includes 2×per-layer All-Reduce latency penalties, alongside verified community reference benchmarks.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { SearchableCombobox, type ComboboxOption } from '../utils/combobox';
  import { groupCatalogHardware } from '../utils/hubs';
  import { getLocale, onLocaleChange, t, tSpeedTier, tStatus } from '../utils/i18n';
  import {
    classifySpeedTier,
    effectiveUsableVramGb,
    estimateRigRun,
    formatContextLabel,
    formatTpsRange,
    maxFitContextDetails,
    osRamReserveGb,
  } from '../utils/physics';
  import {
    buildSimulatorUrl,
    extractUnifiedSocProfiles,
    getDiscreteSingleGpus,
    GPU_COUNT_OPTIONS,
    isMultiGpuCapable,
    parseRamGb,
    resolveCuratedGuideSlug,
    resolveUnifiedHardware,
    STANDARD_RAM_OPTIONS,
    type UnifiedSocProfile,
  } from '../utils/rigCatalog';
  import type {
    CompatStatus,
    CpuSpec,
    HardwareSpec,
    ModelSpec,
    RigRunEstimate,
    SpeedTier,
    SplitMode,
  } from '../types/vram';

  interface HomeCatalogPayload {
    models: ModelSpec[];
    hardware: HardwareSpec[];
    cpus: CpuSpec[];
    curatedKeys: string[];
    curatedSlugs: Record<string, string>;
  }

  interface LiveItem {
    model: ModelSpec;
    hw: HardwareSpec | null;
    res: RigRunEstimate;
    rank: number;
    simHref: string;
    guideSlug?: string;
    gpuCountLabel: string;
    chipLabel: string;
    hwSubtitle: string;
    layersText: string;
    maxFitLabel: string;
  }

  function rankOf(s: CompatStatus): number {
    if (s === 'Fits') return 0;
    if (s === 'Tight Fit') return 1;
    if (s === 'Partial Offload') return 2;
    return 3;
  }

  function badgeClasses(s: CompatStatus): string {
    if (s === 'Fits') return 'border-emerald-200 bg-emerald-50 text-emerald-800';
    if (s === 'Tight Fit') return 'border-orange-200 bg-orange-50 text-orange-800';
    if (s === 'Partial Offload') return 'border-amber-200 bg-amber-50 text-amber-800';
    return 'border-rose-200 bg-rose-50 text-rose-800';
  }

  function dotClass(s: CompatStatus): string {
    if (s === 'Fits') return 'bg-emerald-600';
    if (s === 'Tight Fit') return 'bg-orange-500';
    if (s === 'Partial Offload') return 'bg-amber-500';
    return 'bg-rose-600';
  }

  function speedBadgeClasses(tier: SpeedTier): string {
    if (tier === 'Fast') return 'border-sky-200 bg-sky-50 text-sky-800';
    if (tier === 'Interactive') return 'border-indigo-200 bg-indigo-50 text-indigo-800';
    if (tier === 'Readable') return 'border-slate-200 bg-slate-100 text-slate-700';
    if (tier === 'Slow') return 'border-amber-200 bg-amber-50 text-amber-800';
    return 'border-rose-200 bg-rose-50 text-rose-800';
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function initMatrixPage() {
    const PAGE_SIZE = 24;

    const cpuRoot = document.getElementById('cb-cpu');
    const ramRoot = document.getElementById('cb-ram');
    const gpuRoot = document.getElementById('cb-gpu');
    const modelRoot = document.getElementById('cb-model');
    const gpuCountSelect = document.getElementById('rig-gpu-count') as HTMLSelectElement | null;
    const contextBar = document.getElementById('rig-context-bar');
    const contextTextEl = document.getElementById('rig-context-text');
    const splitToggleEl = document.getElementById('rig-split-toggle');
    const splitBtns = Array.from(document.querySelectorAll('[data-home-split]'));

    const sortSelect = document.getElementById('filter-sort') as HTMLSelectElement | null;
    const statusButtons = Array.from(document.querySelectorAll('[data-status-btn]'));
    const cards = Array.from(document.querySelectorAll('[data-card]'));
    const countEl = document.getElementById('filter-count');
    const resetBtn = document.getElementById('filter-reset');
    const emptyState = document.getElementById('empty-state');
    const emptyResetBtn = document.getElementById('empty-reset-btn');
    const emptySimLink = document.getElementById('empty-sim-link') as HTMLAnchorElement | null;
    const cardsGrid = document.getElementById('cards-grid');
    const paginationBar = document.getElementById('pagination-bar');
    const paginationSummary = document.getElementById('pagination-summary');
    const paginationFill = document.getElementById('pagination-bar-fill') as HTMLElement | null;
    const loadMoreBtn = document.getElementById('load-more-btn');
    const showAllBtn = document.getElementById('show-all-btn');

    const liveSection = document.getElementById('live-calc-section');
    const liveBadge = document.getElementById('live-calc-badge');
    const liveHeading = document.getElementById('live-calc-heading');
    const liveSub = document.getElementById('live-calc-sub');
    const liveSimCta = document.getElementById('live-sim-cta') as HTMLAnchorElement | null;
    const liveGrid = document.getElementById('live-calc-grid');
    const livePagBar = document.getElementById('live-pagination-bar');
    const livePagSummary = document.getElementById('live-pagination-summary');
    const liveLoadMoreBtn = document.getElementById('live-load-more-btn');

    const catalogEl = document.getElementById('home-catalog-json');
    const catData: HomeCatalogPayload = catalogEl
      ? (JSON.parse(catalogEl.textContent || '{}') as HomeCatalogPayload)
      : { models: [], hardware: [], cpus: [], curatedKeys: [], curatedSlugs: {} };

    if (!cpuRoot || !ramRoot || !gpuRoot || !modelRoot) return;

    const curatedKeySet = new Set(catData.curatedKeys || []);
    const curatedSlugMap = new Map<string, string>(Object.entries(catData.curatedSlugs || {}));
    const hwById = new Map(catData.hardware.map((h) => [h.id, h]));
    const cpuById = new Map(catData.cpus.map((c) => [c.id, c]));
    const modelById = new Map(catData.models.map((m) => [m.id, m]));
    const defaultCpu = catData.cpus[0];

    const socProfiles = extractUnifiedSocProfiles(catData.hardware);
    const socById = new Map(socProfiles.map((s) => [s.id, s]));
    const discreteGpus = getDiscreteSingleGpus(catData.hardware);
    const discreteGroupList = groupCatalogHardware(discreteGpus);

    // State
    let selectedCpuVal: string = ''; // '', 'soc:<id>', or 'x86:<id>'
    let selectedRamGb: number | null = null;
    let selectedGpuVal: string = ''; // '', 'none', or discrete hw.id
    let gpuCount = 1;
    let splitMode: SplitMode = 'layer';
    let selectedModel = 'all';
    let selectedStatus = 'all';
    let visibleLimit = PAGE_SIZE;
    let liveVisibleLimit = PAGE_SIZE;
    let currentSort = 'featured';

    const totalCurated = cards.length;
    const totalCombinations = catData.models.length * catData.hardware.length;

    const hwSearchMap = new Map<string, string>();
    for (const h of catData.hardware) {
      hwSearchMap.set(
        h.id,
        [h.id, h.name, h.short_name, h.vendor, h.series, h.category || '', h.backend, h.memory_type]
          .join(' ')
          .toLowerCase(),
      );
    }

    // Build CPU options (Unified Silicon + x86 Tiers)
    function buildCpuOptions(): ComboboxOption[] {
      const opts: ComboboxOption[] = [];
      for (const soc of socProfiles) {
        opts.push({
          value: `soc:${soc.id}`,
          label: soc.name,
          group: t('home.grpUnified'),
          sublabel: `${soc.ramTiers.join(' / ')} GB · ${soc.backend} ${soc.bwLabel}`,
          badge: `${soc.backend} Unified`,
          searchBlob: soc.searchBlob,
        });
      }

      const cpuTiers = [
        { tier: 'Consumer DDR5', groupKey: 'home.grpDdr5' as const },
        { tier: 'Consumer DDR4', groupKey: 'home.grpDdr4' as const },
        { tier: 'Laptop LPDDR5X', groupKey: 'home.grpLaptopCpu' as const },
        { tier: 'Workstation HEDT', groupKey: 'home.grpWorkstationCpu' as const },
        { tier: 'Server EPYC / Xeon', groupKey: 'home.grpServerCpu' as const },
      ];
      for (const { tier, groupKey } of cpuTiers) {
        for (const c of catData.cpus) {
          if (c.tier !== tier) continue;
          const aliases = (c.search_aliases || []).join(' ');
          opts.push({
            value: `x86:${c.id}`,
            label: c.name,
            group: t(groupKey),
            sublabel: `${c.memory_type} · ${c.channels}-Ch · ${c.simd}`,
            badge: `${c.effective_bw_gbps} GB/s`,
            searchBlob: [c.id, c.name, c.short_name, c.vendor, c.tier, c.memory_type, aliases]
              .join(' ')
              .toLowerCase(),
          });
        }
      }
      return opts;
    }

    function buildRamOptions(soc: UnifiedSocProfile | null): ComboboxOption[] {
      const opts: ComboboxOption[] = [];
      if (soc) {
        for (const gb of soc.ramTiers) {
          const sku = soc.skus.find((s) => Math.round(s.vram_gb) === gb);
          opts.push({
            value: String(gb),
            label: `${gb} GB`,
            group: t('home.grpSocTiers', { soc: soc.shortName }),
            badge: sku ? `${sku.bandwidth_gbps} GB/s` : 'Unified',
            searchBlob: `${gb} ${gb}gb ${gb}g unified official ${soc.shortName}`.toLowerCase(),
          });
        }
        for (const gb of STANDARD_RAM_OPTIONS) {
          if (soc.ramTiers.includes(gb)) continue;
          opts.push({
            value: String(gb),
            label: `${gb} GB`,
            group: t('home.grpCustomRam'),
            badge: `${gb} GB`,
            searchBlob: `${gb} ${gb}gb ${gb}g custom`.toLowerCase(),
          });
        }
      } else {
        for (const gb of STANDARD_RAM_OPTIONS) {
          opts.push({
            value: String(gb),
            label: `${gb} GB`,
            group: t('home.grpSystemRam'),
            badge: t('home.usableShort', { gb: Math.max(0, gb - osRamReserveGb(gb)) }),
            searchBlob: `${gb} ${gb}gb ${gb}g ram system memory`.toLowerCase(),
          });
        }
      }
      return opts;
    }

    const gpuGroupKeyMap: Record<
      string,
      | 'home.grpGpuDesktopNvidia'
      | 'home.grpGpuClassicNvidia'
      | 'home.grpGpuWorkstationNvidia'
      | 'home.grpGpuLaptopNvidia'
      | 'home.grpGpuAmd'
      | 'home.grpGpuIntel'
      | 'home.grpGpuUnified'
    > = {
      'NVIDIA Desktop RTX': 'home.grpGpuDesktopNvidia',
      'NVIDIA Classic GTX & RTX 20': 'home.grpGpuClassicNvidia',
      'NVIDIA Multi-GPU & Workstation': 'home.grpGpuWorkstationNvidia',
      'NVIDIA Laptop RTX': 'home.grpGpuLaptopNvidia',
      'AMD Radeon & Ryzen AI': 'home.grpGpuAmd',
      'Intel Arc': 'home.grpGpuIntel',
      'Apple Silicon Unified': 'home.grpGpuUnified',
    };

    function buildGpuOptions(): ComboboxOption[] {
      const opts: ComboboxOption[] = [
        {
          value: 'none',
          label: t('home.noneCpuOnly'),
          group: t('home.grpNoGpu'),
          sublabel: t('home.noneCpuOnlySub'),
          badge: 'CPU-Only',
          searchBlob: 'none no gpu cpu only system ram integrated ddr4 ddr5',
        },
      ];

      for (const grp of discreteGroupList) {
        const gKey = gpuGroupKeyMap[grp.label];
        const grpTitle = gKey ? t(gKey) : grp.label;
        for (const h of grp.items) {
          const usableDesktop = effectiveUsableVramGb(h, 1, 'desktop')[1];
          opts.push({
            value: h.id,
            label: h.name,
            group: grpTitle,
            sublabel: t('home.vramLineSub', {
              vram: h.vram_gb,
              mem: h.memory_type,
              usable: usableDesktop,
            }),
            badge: `${h.bandwidth_gbps} GB/s`,
            searchBlob: hwSearchMap.get(h.id) || h.name.toLowerCase(),
          });
        }
      }

      for (const sku of catData.hardware) {
        if (!sku.is_unified) continue;
        opts.push({
          value: `uni:${sku.id}`,
          label: sku.name,
          group: t('home.grpGpuUnified'),
          sublabel: t('home.unifiedChipNote', {
            ram: Math.round(sku.vram_gb),
            backend: sku.backend,
          }),
          badge: `${sku.bandwidth_gbps} GB/s`,
          searchBlob: `${hwSearchMap.get(sku.id) || ''} unified macbook mac studio mac mini`.toLowerCase(),
        });
      }
      return opts;
    }

    const allModelsSorted = [...catData.models].sort((a, b) => a.name.localeCompare(b.name));
    function buildModelOptions(): ComboboxOption[] {
      return [
        {
          value: 'all',
          label: t('home.allModels', { count: catData.models.length }),
          group: t('home.grpModelSel'),
          searchBlob: 'all models clear reset any',
        },
        ...allModelsSorted.map((m) => ({
          value: m.id,
          label: `${m.short_name} (${m.params_b}B)`,
          group: m.family,
          sublabel: m.active_params_b
            ? `${m.name} · MoE ${m.active_params_b}B`
            : `${m.name} · ${m.architecture}`,
          badge: m.active_params_b ? `${m.active_params_b}B` : `${m.params_b}B`,
          searchBlob: [
            m.id,
            m.name,
            m.short_name,
            m.family,
            m.architecture,
            `${m.params_b}b`,
            m.active_params_b ? `moe ${m.active_params_b}b` : 'dense',
          ]
            .join(' ')
            .toLowerCase(),
        })),
      ];
    }

    function getActiveUnifiedSoc(): UnifiedSocProfile | null {
      if (!selectedCpuVal.startsWith('soc:')) return null;
      return socById.get(selectedCpuVal.slice(4)) ?? null;
    }

    function getActiveX86Cpu(): CpuSpec {
      if (selectedCpuVal.startsWith('x86:')) {
        return cpuById.get(selectedCpuVal.slice(4)) ?? defaultCpu;
      }
      return defaultCpu;
    }

    function syncGpuQtyControl() {
      if (!gpuCountSelect) return;
      const soc = getActiveUnifiedSoc();
      const hw = selectedGpuVal && selectedGpuVal !== 'none' ? hwById.get(selectedGpuVal) ?? null : null;

      if (soc) {
        gpuCountSelect.innerHTML = `<option value="0">${escapeHtml(t('home.qtyNone'))}</option>`;
        gpuCountSelect.value = '0';
        gpuCountSelect.disabled = true;
      } else if (selectedGpuVal === 'none' || !hw) {
        gpuCountSelect.innerHTML =
          selectedGpuVal === 'none'
            ? `<option value="0">${escapeHtml(t('home.qtyNone'))}</option>`
            : '<option value="0">—</option>';
        gpuCountSelect.value = '0';
        gpuCountSelect.disabled = true;
      } else if (!isMultiGpuCapable(hw)) {
        gpuCount = 1;
        gpuCountSelect.innerHTML = `<option value="1">${escapeHtml(t('home.qtyLaptop'))}</option>`;
        gpuCountSelect.value = '1';
        gpuCountSelect.disabled = true;
      } else {
        gpuCountSelect.innerHTML = GPU_COUNT_OPTIONS.map((n) => {
          const txt = n === 1 ? t('home.qtySingle') : t('home.qtyMulti', { n });
          return `<option value="${n}">${escapeHtml(txt)}</option>`;
        }).join('');
        gpuCountSelect.disabled = false;
        gpuCountSelect.value = String(gpuCount);
      }

      const enabled = !gpuCountSelect.disabled;
      gpuCountSelect.classList.toggle('bg-white', enabled);
      gpuCountSelect.classList.toggle('border-slate-300', enabled);
      gpuCountSelect.classList.toggle('text-slate-900', enabled);
      gpuCountSelect.classList.toggle('cursor-pointer', enabled);
      gpuCountSelect.classList.toggle('bg-slate-50', !enabled);
      gpuCountSelect.classList.toggle('border-slate-200', !enabled);
      gpuCountSelect.classList.toggle('text-slate-400', !enabled);
      gpuCountSelect.classList.toggle('cursor-not-allowed', !enabled);
    }

    function updateSplitToggleUi() {
      splitBtns.forEach((b) => {
        const active = b.getAttribute('data-home-split') === splitMode;
        b.classList.toggle('bg-slate-900', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('font-semibold', active);
        b.classList.toggle('text-slate-600', !active);
        b.classList.toggle('font-medium', !active);
        b.classList.toggle('hover:text-slate-950', !active);
      });
    }

    function updateContextBar() {
      if (!contextBar || !contextTextEl || !splitToggleEl) return;
      const soc = getActiveUnifiedSoc();
      const hw = selectedGpuVal && selectedGpuVal !== 'none' ? hwById.get(selectedGpuVal) ?? null : null;

      if (soc) {
        const ram = selectedRamGb ?? soc.defaultRamGb;
        const { hw: resolvedHw, isExactCatalogSku } = resolveUnifiedHardware(soc, ram);
        const tag = isExactCatalogSku ? '' : t('home.ctxUnifiedCustomTag');
        const usableUnified = effectiveUsableVramGb(resolvedHw, 1, 'desktop')[1];
        contextBar.classList.remove('hidden');
        splitToggleEl.classList.add('hidden');
        contextTextEl.textContent = t('home.ctxUnified', {
          soc: soc.shortName,
          ram,
          usable: usableUnified,
          bw: resolvedHw.bandwidth_gbps,
          backend: resolvedHw.backend,
          custom: tag,
        });
      } else if (hw && gpuCount >= 2 && isMultiGpuCapable(hw)) {
        const totalVram = Math.round(hw.vram_gb * gpuCount * 10) / 10;
        const usableVram = effectiveUsableVramGb(hw, gpuCount, 'desktop')[1];
        contextBar.classList.remove('hidden');
        splitToggleEl.classList.remove('hidden');
        contextTextEl.textContent = t('home.ctxMultiGpu', {
          n: gpuCount,
          hw: hw.short_name,
          total: totalVram,
          usable: usableVram,
          bw: hw.bandwidth_gbps,
        });
        updateSplitToggleUi();
      } else if (selectedGpuVal === 'none') {
        const cpu = getActiveX86Cpu();
        const ram = selectedRamGb ?? 32;
        const usableRam = Math.max(0, ram - osRamReserveGb(ram));
        contextBar.classList.remove('hidden');
        splitToggleEl.classList.add('hidden');
        contextTextEl.textContent = t('home.ctxCpuOnly', {
          cpu: cpu.short_name,
          ram,
          usable: usableRam,
        });
      } else {
        contextBar.classList.add('hidden');
        splitToggleEl.classList.add('hidden');
      }
    }

    // Instantiate Comboboxes
    const cpuCombo = new SearchableCombobox({
      root: cpuRoot,
      options: buildCpuOptions(),
      placeholder: t('home.cpuPlaceholder'),
      emptyText: t('home.cpuEmpty'),
      onChange: (val) => applyCpuSelection(val),
    });

    const ramCombo = new SearchableCombobox({
      root: ramRoot,
      options: buildRamOptions(null),
      placeholder: t('home.ramPlaceholder'),
      emptyText: t('home.ramEmpty'),
      allowCustomNumeric: true,
      parseCustomNumeric: parseRamGb,
      formatCustomNumeric: (n) => `${n} GB`,
      formatCustomActionLabel: (n) => t('home.customRamUse', { ram: n }),
      onChange: (val) => {
        selectedRamGb = val ? parseRamGb(val) : null;
        updateContextBar();
        applyFilters(true);
      },
    });

    const gpuCombo = new SearchableCombobox({
      root: gpuRoot,
      options: buildGpuOptions(),
      placeholder: t('home.gpuPlaceholder'),
      emptyText: t('home.gpuEmpty'),
      onChange: (val) => applyGpuSelection(val, false),
    });

    const modelCombo = new SearchableCombobox({
      root: modelRoot,
      options: buildModelOptions(),
      placeholder: t('home.allModels', { count: catData.models.length }),
      emptyValue: 'all',
      initialValue: 'all',
      emptyText: t('home.modelEmpty'),
      onChange: (val) => {
        selectedModel = val || 'all';
        applyFilters(true);
      },
    });

    function activateUnifiedSoc(soc: UnifiedSocProfile, targetRamGb: number | null) {
      selectedCpuVal = `soc:${soc.id}`;
      cpuCombo.setValue(selectedCpuVal);

      let nextRam = targetRamGb;
      if (nextRam === null || !soc.ramTiers.includes(nextRam)) {
        nextRam = soc.defaultRamGb;
      }
      selectedRamGb = nextRam;
      ramCombo.setOptions(buildRamOptions(soc), false);
      ramCombo.setValue(String(nextRam), `${nextRam} GB`);

      selectedGpuVal = '';
      gpuCount = 1;
      gpuCombo.setDisplayOverride(t('home.noneUnifiedAuto'), true, false);
      syncGpuQtyControl();
      updateContextBar();
      applyFilters(true);
    }

    function applyCpuSelection(val: string) {
      const wasUnified = selectedCpuVal.startsWith('soc:');
      if (!val) {
        selectedCpuVal = '';
        if (wasUnified) {
          ramCombo.setOptions(buildRamOptions(null), true);
          gpuCombo.clear(true);
          selectedGpuVal = '';
          gpuCount = 1;
          syncGpuQtyControl();
        }
        updateContextBar();
        applyFilters(true);
        return;
      }

      if (val.startsWith('soc:')) {
        const soc = socById.get(val.slice(4));
        if (soc) {
          activateUnifiedSoc(soc, selectedRamGb);
          return;
        }
      }

      // x86 CPU selected
      selectedCpuVal = val;
      if (wasUnified) {
        ramCombo.setOptions(buildRamOptions(null), true);
        if (!selectedGpuVal) {
          gpuCombo.clear(true);
        }
        syncGpuQtyControl();
      }
      updateContextBar();
      applyFilters(true);
    }

    function applyGpuSelection(val: string, preserveQty: boolean) {
      if (val.startsWith('uni:')) {
        const skuId = val.slice(4);
        const sku = hwById.get(skuId);
        if (sku) {
          const socId = sku.id.replace(/-\d+gb$/, '');
          const soc = socById.get(socId);
          if (soc) {
            activateUnifiedSoc(soc, Math.round(sku.vram_gb));
            return;
          }
        }
      }

      // Leaving unified mode if switching GPU explicitly
      if (selectedCpuVal.startsWith('soc:')) {
        selectedCpuVal = '';
        cpuCombo.clear(true);
        ramCombo.setOptions(buildRamOptions(null), true);
      }

      selectedGpuVal = val;
      if (!preserveQty) {
        gpuCount = 1;
      }
      syncGpuQtyControl();
      updateContextBar();
      applyFilters(true);
    }

    function isRigConfigured(): boolean {
      return Boolean(selectedCpuVal || selectedRamGb !== null || selectedGpuVal);
    }

    function resolveActiveRigForSim(): {
      hw: HardwareSpec | null;
      isUnified: boolean;
      isExactCatalogSku: boolean;
      cpu: CpuSpec;
      effGpuCount: number;
      systemRamArg: number | null;
      ramForLink: number;
      rigTitle: string;
    } {
      const soc = getActiveUnifiedSoc();
      if (soc) {
        const ram = selectedRamGb ?? soc.defaultRamGb;
        const { hw, isExactCatalogSku } = resolveUnifiedHardware(soc, ram);
        return {
          hw,
          isUnified: true,
          isExactCatalogSku,
          cpu: defaultCpu,
          effGpuCount: 1,
          systemRamArg: hw.vram_gb,
          ramForLink: ram,
          rigTitle: hw.name,
        };
      }

      const cpu = getActiveX86Cpu();
      const hasCustomCpu = selectedCpuVal.startsWith('x86:');
      const hw = selectedGpuVal && selectedGpuVal !== 'none' ? hwById.get(selectedGpuVal) ?? null : null;

      if (!hw) {
        // CPU-Only (either GPU === 'none', OR only CPU/RAM chosen so far)
        const ram = selectedRamGb ?? 32;
        const titleParts = [hasCustomCpu ? cpu.short_name : 'Default DDR4 (35 GB/s)', `${ram} GB RAM`];
        return {
          hw: null,
          isUnified: false,
          isExactCatalogSku: false,
          cpu,
          effGpuCount: 0,
          systemRamArg: ram,
          ramForLink: ram,
          rigTitle: `CPU-Only (${titleParts.join(' · ')})`,
        };
      }

      const effGpuCount = isMultiGpuCapable(hw) ? gpuCount : 1;
      const hwLabel = effGpuCount > 1 ? `${effGpuCount}× ${hw.short_name}` : hw.name;
      const hostBits: string[] = [];
      if (hasCustomCpu) hostBits.push(cpu.short_name);
      if (selectedRamGb !== null) hostBits.push(`${selectedRamGb} GB RAM`);
      const rigTitle = hostBits.length > 0 ? `${hwLabel} + ${hostBits.join(' · ')}` : hwLabel;

      return {
        hw,
        isUnified: false,
        isExactCatalogSku: true,
        cpu,
        effGpuCount,
        systemRamArg: selectedRamGb,
        ramForLink: selectedRamGb ?? 32,
        rigTitle,
      };
    }

    function updateStatusPills() {
      statusButtons.forEach((b) => {
        const active = (b.getAttribute('data-status-btn') || 'all') === selectedStatus;
        b.classList.toggle('border-slate-900', active);
        b.classList.toggle('bg-slate-900', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('border-slate-200', !active);
        b.classList.toggle('bg-slate-50', !active);
        b.classList.toggle('text-slate-700', !active);
      });
    }

    function sortCardsInDom(sortMode: string) {
      if (!cardsGrid) return;
      const sorted = [...cards].sort((a, b) => {
        if (sortMode === 'tps-desc') {
          const td = Number(b.getAttribute('data-tps') || 0) - Number(a.getAttribute('data-tps') || 0);
          if (td !== 0) return td;
          return Number(a.getAttribute('data-status-rank') || 0) - Number(b.getAttribute('data-status-rank') || 0);
        }
        if (sortMode === 'vram-asc') {
          const vd = Number(a.getAttribute('data-vram') || 0) - Number(b.getAttribute('data-vram') || 0);
          if (vd !== 0) return vd;
          return Number(b.getAttribute('data-tps') || 0) - Number(a.getAttribute('data-tps') || 0);
        }
        if (sortMode === 'params-desc') {
          const pd = Number(b.getAttribute('data-params') || 0) - Number(a.getAttribute('data-params') || 0);
          if (pd !== 0) return pd;
          const sr = Number(a.getAttribute('data-status-rank') || 0) - Number(b.getAttribute('data-status-rank') || 0);
          if (sr !== 0) return sr;
          return Number(b.getAttribute('data-tps') || 0) - Number(a.getAttribute('data-tps') || 0);
        }
        return Number(a.getAttribute('data-index') || 0) - Number(b.getAttribute('data-index') || 0);
      });
      const frag = document.createDocumentFragment();
      sorted.forEach((c) => frag.appendChild(c));
      cardsGrid.appendChild(frag);
    }

    function syncUrl() {
      if (!window.history || !window.history.replaceState) return;
      const params = new URLSearchParams();
      const activeLang = new URLSearchParams(window.location.search).get('lang');
      if (activeLang) params.set('lang', activeLang);
      if (selectedCpuVal) params.set('cpu', selectedCpuVal);
      if (selectedRamGb !== null) params.set('ram', String(selectedRamGb));
      if (selectedGpuVal) params.set('gpu', selectedGpuVal);
      if (selectedGpuVal && selectedGpuVal !== 'none' && gpuCount > 1) {
        params.set('gpus', String(gpuCount));
        if (splitMode !== 'layer') params.set('split', splitMode);
      }
      if (selectedModel !== 'all') params.set('model', selectedModel);
      if (selectedStatus !== 'all') params.set('status', selectedStatus);
      if (currentSort !== 'featured') params.set('sort', currentSort);

      const qs = params.toString();
      const targetUrl = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
      window.history.replaceState(null, '', targetUrl);
    }

    function sortLiveItems(items: LiveItem[], sortVal: string) {
      items.sort((a, b) => {
        if (sortVal === 'tps-desc') {
          if (b.res.est_tps !== a.res.est_tps) return b.res.est_tps - a.res.est_tps;
          return a.rank - b.rank;
        }
        if (sortVal === 'vram-asc') {
          if (a.res.total_vram_gb !== b.res.total_vram_gb) return a.res.total_vram_gb - b.res.total_vram_gb;
          return b.res.est_tps - a.res.est_tps;
        }
        if (sortVal === 'params-desc') {
          if (b.model.params_b !== a.model.params_b) return b.model.params_b - a.model.params_b;
          if (a.rank !== b.rank) return a.rank - b.rank;
          return b.res.est_tps - a.res.est_tps;
        }
        if (a.rank !== b.rank) return a.rank - b.rank;
        if (b.model.params_b !== a.model.params_b) return b.model.params_b - a.model.params_b;
        return b.res.est_tps - a.res.est_tps;
      });
    }

    function computeModelOnlyLiveItems(): LiveItem[] {
      if (selectedModel === 'all') return [];
      const model = modelById.get(selectedModel);
      if (!model) return [];

      const items: LiveItem[] = [];
      for (const h of catData.hardware) {
        if (curatedKeySet.has(`${model.id}::${h.id}`)) continue;
        const res = estimateRigRun({
          model,
          hardware: h,
          gpuCount: h.gpu_count || 1,
          quant: 'Q4_K_M',
          format: 'GGUF',
          contextTokens: 8192,
          kvQuant: 'fp16',
          reserveProfile: 'desktop',
        });
        if (selectedStatus !== 'all' && res.status !== selectedStatus) continue;
        const maxFit = maxFitContextDetails(model, h, 'Q4_K_M', 'desktop', 'fp16');
        const maxFitLabel =
          maxFit.contextTokens > 0
            ? t('common.maxFitLabel', {
                ctx: formatContextLabel(maxFit.contextTokens),
                gb: maxFit.totalVramGb.toFixed(1),
              })
            : t('common.maxFitNone');
        items.push({
          model,
          hw: h,
          res,
          rank: rankOf(res.status),
          simHref: `/calculator/?model=${encodeURIComponent(model.id)}&hw=${encodeURIComponent(h.id)}`,
          gpuCountLabel: '',
          chipLabel: `${h.backend} · ${h.bandwidth_gbps} GB/s`,
          hwSubtitle: t('common.onPrefix', { hw: h.name }),
          layersText: t('common.layersCount', {
            fit: res.gpu_layers_fit,
            total: res.total_layers,
          }),
          maxFitLabel,
        });
      }
      sortLiveItems(items, currentSort);
      return items;
    }

    function computeRigLiveResults(): {
      items: LiveItem[];
      allFits: number;
      allTight: number;
      allPartial: number;
      allOom: number;
      rigTitle: string;
      rigSimHref: string;
    } {
      const rig = resolveActiveRigForSim();
      const candidateModels =
        selectedModel === 'all'
          ? catData.models
          : catData.models.filter((m) => m.id === selectedModel);

      const items: LiveItem[] = [];
      let allFits = 0;
      let allTight = 0;
      let allPartial = 0;
      let allOom = 0;

      for (const m of candidateModels) {
        const res = estimateRigRun({
          model: m,
          hardware: rig.hw,
          gpuCount: rig.effGpuCount,
          cpu: rig.cpu,
          systemRamGb: rig.systemRamArg ?? undefined,
          quant: 'Q4_K_M',
          format: 'GGUF',
          contextTokens: 8192,
          kvQuant: 'fp16',
          splitMode,
          reserveProfile: 'desktop',
        });

        if (res.status === 'Fits') allFits += 1;
        else if (res.status === 'Tight Fit') allTight += 1;
        else if (res.status === 'Partial Offload') allPartial += 1;
        else allOom += 1;

        if (selectedStatus !== 'all' && res.status !== selectedStatus) continue;

        const simHref = buildSimulatorUrl({
          modelId: m.id,
          hw: rig.hw,
          isExactCatalogSku: rig.isExactCatalogSku,
          gpuCount: rig.effGpuCount,
          splitMode,
          cpuId: rig.cpu.id,
          ramGb: rig.ramForLink,
        });

        const guideSlug = resolveCuratedGuideSlug(
          m.id,
          rig.hw,
          rig.effGpuCount,
          rig.isExactCatalogSku,
          curatedSlugMap,
        );

        const isCpuOnly = res.gpu_count === 0;
        const chipLabel = rig.hw
          ? `${rig.hw.backend} · ${rig.hw.bandwidth_gbps} GB/s`
          : `CPU · ${rig.cpu.effective_bw_gbps} GB/s`;
        const layersText = isCpuOnly
          ? t('common.cpuOnlyLayers', { total: res.total_layers })
          : t('common.layersCount', { fit: res.gpu_layers_fit, total: res.total_layers });

        let maxFitLabel = '';
        if (rig.hw && res.gpu_count === 1) {
          const maxFit = maxFitContextDetails(m, rig.hw, 'Q4_K_M', 'desktop', 'fp16');
          maxFitLabel =
            maxFit.contextTokens > 0
              ? t('common.maxFitLabel', {
                  ctx: formatContextLabel(maxFit.contextTokens),
                  gb: maxFit.totalVramGb.toFixed(1),
                })
              : t('common.maxFitNone');
        } else if (res.comm_warning) {
          maxFitLabel = `PCIe TP · -${Math.round(res.comm_overhead_pct || 0)}% sync`;
        } else if (res.headroom_gb > 0) {
          maxFitLabel = t('sim.headroomFree', { gb: res.headroom_gb.toFixed(1) });
        } else {
          maxFitLabel = t('common.maxFitNone');
        }

        items.push({
          model: m,
          hw: rig.hw,
          res,
          rank: rankOf(res.status),
          simHref,
          guideSlug,
          gpuCountLabel: rig.effGpuCount > 1 ? `${rig.effGpuCount}× ` : '',
          chipLabel,
          hwSubtitle: t('common.onPrefix', { hw: rig.rigTitle }),
          layersText,
          maxFitLabel,
        });
      }

      sortLiveItems(items, currentSort);

      const rigSimHref = buildSimulatorUrl({
        modelId: selectedModel !== 'all' ? selectedModel : undefined,
        hw: rig.hw,
        isExactCatalogSku: rig.isExactCatalogSku,
        gpuCount: rig.effGpuCount,
        splitMode,
        cpuId: rig.cpu.id,
        ramGb: rig.ramForLink,
      });

      return {
        items,
        allFits,
        allTight,
        allPartial,
        allOom,
        rigTitle: rig.rigTitle,
        rigSimHref,
      };
    }

    function renderLiveCards(
      items: LiveItem[],
      isRigMode: boolean,
      bannerMeta?: {
        allFits: number;
        allTight: number;
        allPartial: number;
        allOom: number;
        rigTitle: string;
        rigSimHref: string;
      },
    ) {
      if (!liveSection || !liveGrid) return;

      if (items.length === 0) {
        liveSection.classList.add('hidden');
        liveGrid.innerHTML = '';
        if (livePagBar) livePagBar.classList.add('hidden');
        return;
      }

      liveSection.classList.remove('hidden');

      if (liveBadge && liveHeading && liveSub && liveSimCta) {
        if (isRigMode && bannerMeta) {
          const guideCount = items.filter((x) => Boolean(x.guideSlug)).length;
          liveBadge.textContent = t('home.badgeRig');
          liveHeading.textContent =
            items.length === 1
              ? t('home.headingRigModelOne', { rig: bannerMeta.rigTitle })
              : t('home.headingRigModels', { count: items.length, rig: bannerMeta.rigTitle });
          liveSub.textContent = t('home.subRigSummary', {
            fits: bannerMeta.allFits,
            tight: bannerMeta.allTight,
            partial: bannerMeta.allPartial,
            oom: bannerMeta.allOom,
            guides: guideCount,
          });
          liveSimCta.textContent = t('home.openRigSim');
          liveSimCta.href = bannerMeta.rigSimHref;
        } else {
          const model = modelById.get(selectedModel);
          liveBadge.textContent = t('home.badgeCatalog');
          liveHeading.textContent = t('home.headingAdditionalGpus', {
            count: items.length,
            model: model ? model.short_name : '',
          });
          liveSub.textContent = t('home.subAdditionalGpus', {
            hwTotal: catData.hardware.length,
          });
          liveSimCta.textContent = t('common.openFullSim');
          liveSimCta.href =
            selectedModel !== 'all'
              ? `/calculator/?model=${encodeURIComponent(selectedModel)}`
              : '/calculator/';
        }
      }

      const slice = items.slice(0, liveVisibleLimit);
      liveGrid.innerHTML = slice
        .map(({ model, res, simHref, guideSlug, chipLabel, hwSubtitle, layersText, maxFitLabel }) => {
          const isCpuOnly = res.gpu_count === 0;
          const budget = isCpuOnly ? res.available_ram_gb : res.usable_vram_gb;
          const pct = Math.min(100, Math.round((res.total_vram_gb / Math.max(1, budget)) * 100));
          const barColor =
            res.status === 'Fits'
              ? 'bg-emerald-500'
              : res.status === 'Tight Fit'
                ? 'bg-orange-500'
                : res.status === 'Partial Offload'
                  ? 'bg-amber-500'
                  : 'bg-rose-500';
          const speedTier = res.speed_tier ?? classifySpeedTier(res.est_tps, res.status);
          const tpsDisplay =
            res.status === 'OOM'
              ? escapeHtml(t('status.oom'))
              : escapeHtml(formatTpsRange(res.est_tps_low, res.est_tps_high, res.est_tps, res.status));
          const budgetLabel = isCpuOnly ? t('common.ram8kLabel') : t('common.vram8kLabel');
          const formulaTag =
            res.status !== 'OOM'
              ? `<span class="shrink-0 font-mono text-[10px] text-slate-400">${escapeHtml(t('speed.formulaEst'))}</span>`
              : '';
          const moeLine = model.active_params_b
            ? t('common.moeLine', {
                params: model.params_b,
                active: model.active_params_b,
                arch: model.architecture,
              })
            : t('common.denseLine', {
                params: model.params_b,
                arch: model.architecture,
              });

          const primaryHref = guideSlug ? `/can-i-run/${encodeURIComponent(guideSlug)}/` : simHref;
          const kindBadge = guideSlug
            ? `<span class="rounded bg-blue-50 px-1.5 py-0.5 text-[10px] font-semibold text-blue-700">${escapeHtml(t('common.fullGuide'))}</span>`
            : `<span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-semibold text-slate-600">${escapeHtml(t('common.liveCalc'))}</span>`;

          const footerActions = guideSlug
            ? `<div class="flex items-center gap-2.5">
                 <a href="${simHref}" class="text-[11px] font-medium text-slate-500 hover:text-blue-600">${escapeHtml(t('common.simShort'))}</a>
                 <a href="${primaryHref}" class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-800">${escapeHtml(t('common.openGuide'))}</a>
               </div>`
            : `<a href="${simHref}" class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-800">${escapeHtml(t('common.simulate'))}</a>`;

          return `
            <article class="group flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 transition-all hover:border-blue-300 hover:shadow-md">
              <div>
                <div class="flex items-start justify-between gap-2">
                  <div class="flex flex-wrap items-center gap-1.5">
                    <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-semibold ${badgeClasses(res.status)}">
                      <span class="h-1.5 w-1.5 rounded-full ${dotClass(res.status)}"></span>
                      ${escapeHtml(tStatus(res.status))}
                    </span>
                    <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-semibold ${speedBadgeClasses(speedTier)}">
                      ${escapeHtml(tSpeedTier(speedTier, true))}
                    </span>
                    ${kindBadge}
                  </div>
                  <span class="shrink-0 rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[11px] font-semibold text-slate-600">${escapeHtml(chipLabel)}</span>
                </div>

                <h3 class="mt-3.5 text-base font-bold tracking-tight text-slate-950 group-hover:text-blue-600 transition-colors">
                  <a href="${primaryHref}" class="focus:outline-none">
                    ${escapeHtml(model.short_name)}
                    <span class="block text-sm font-semibold text-slate-600">${escapeHtml(hwSubtitle)}</span>
                  </a>
                </h3>

                <p class="mt-1.5 font-mono text-xs text-slate-500">${escapeHtml(moeLine)}</p>
              </div>

              <div class="mt-4 pt-4 border-t border-slate-100">
                <div class="flex items-center justify-between text-xs">
                  <span class="text-slate-500">${escapeHtml(budgetLabel)}</span>
                  <span class="font-mono font-semibold text-slate-900 tabular-nums">${res.total_vram_gb.toFixed(1)} / ${budget.toFixed(1)} GB</span>
                </div>
                <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-slate-100">
                  <div class="h-full rounded-full ${barColor}" style="width: ${pct}%"></div>
                </div>
                <div class="mt-1.5 flex items-center justify-between gap-2 text-[11px] text-slate-500 tabular-nums">
                  <span>${escapeHtml(maxFitLabel)}</span>
                  ${formulaTag}
                </div>

                <div class="mt-3 flex items-center justify-between">
                  <div class="flex items-baseline gap-1.5">
                    <span class="font-mono text-base sm:text-lg font-bold text-slate-950 tabular-nums">${tpsDisplay}</span>
                    <span class="text-[11px] text-slate-500 tabular-nums">${escapeHtml(layersText)}</span>
                  </div>
                  ${footerActions}
                </div>
              </div>
            </article>
          `;
        })
        .join('');

      const liveRemaining = Math.max(0, items.length - slice.length);
      if (livePagBar && livePagSummary && liveLoadMoreBtn) {
        livePagBar.classList.toggle('hidden', liveRemaining === 0);
        livePagSummary.textContent = t('home.showingLive', {
          shown: slice.length,
          total: items.length,
        });
        liveLoadMoreBtn.textContent = t('home.loadMoreGuides', {
          chunk: Math.min(PAGE_SIZE, liveRemaining),
          left: liveRemaining,
        });
      }
    }

    function applyFilters(resetPagination = true) {
      if (resetPagination) {
        visibleLimit = PAGE_SIZE;
        liveVisibleLimit = PAGE_SIZE;
      }

      const sortVal = sortSelect ? sortSelect.value : 'featured';
      if (sortVal !== currentSort) {
        currentSort = sortVal;
        sortCardsInDom(sortVal);
      }

      const rigActive = isRigConfigured();

      if (rigActive) {
        // Unified live 22-model view for the configured CPU + RAM + GPU rig
        if (cardsGrid) cardsGrid.classList.add('hidden');
        if (paginationBar) paginationBar.classList.add('hidden');

        const rigResult = computeRigLiveResults();
        renderLiveCards(rigResult.items, true, rigResult);

        if (countEl) {
          countEl.textContent = t('home.countRig', { count: rigResult.items.length });
        }
        if (emptySimLink) {
          emptySimLink.href = rigResult.rigSimHref;
        }
        if (emptyState) {
          emptyState.classList.toggle('hidden', rigResult.items.length > 0);
        }
        if (resetBtn) {
          resetBtn.classList.remove('hidden');
        }
        syncUrl();
        return;
      }

      // Default SSR Curated Matrix View (no rig hardware configured)
      const orderedCards = cardsGrid
        ? Array.from(cardsGrid.querySelectorAll('[data-card]'))
        : cards;

      const matching: Element[] = [];
      orderedCards.forEach((card) => {
        const matchModel =
          selectedModel === 'all' || card.getAttribute('data-model') === selectedModel;
        const matchStatus =
          selectedStatus === 'all' || card.getAttribute('data-status') === selectedStatus;
        if (matchModel && matchStatus) {
          matching.push(card);
        } else {
          card.classList.add('hidden');
        }
      });

      const shownCount = Math.min(visibleLimit, matching.length);
      matching.forEach((card, i) => {
        card.classList.toggle('hidden', i >= visibleLimit);
      });

      const modelLiveItems = computeModelOnlyLiveItems();
      renderLiveCards(modelLiveItems, false);

      const remaining = Math.max(0, matching.length - shownCount);
      const isFiltered =
        selectedModel !== 'all' || selectedStatus !== 'all' || currentSort !== 'featured';

      if (countEl) {
        if (!isFiltered) {
          countEl.textContent = t('home.countInitial', {
            shown: shownCount,
            total: totalCurated,
            models: catData.models.length,
            hw: catData.hardware.length,
          });
        } else if (modelLiveItems.length > 0) {
          countEl.textContent = t('home.countModelPlusLive', {
            guides: matching.length,
            live: modelLiveItems.length,
          });
        } else {
          countEl.textContent = t('home.countMatched', {
            shown: shownCount,
            matched: matching.length,
          });
        }
      }

      if (paginationBar) {
        paginationBar.classList.toggle('hidden', remaining === 0);
      }
      if (paginationSummary) {
        paginationSummary.textContent = t('home.viewingGuides', {
          shown: shownCount,
          total: matching.length,
        });
      }
      if (paginationFill) {
        const pct = matching.length > 0 ? Math.round((shownCount / matching.length) * 100) : 100;
        paginationFill.style.width = `${pct}%`;
      }
      if (loadMoreBtn) {
        const nextChunk = Math.min(PAGE_SIZE, remaining);
        loadMoreBtn.textContent = t('home.loadMoreGuides', {
          chunk: nextChunk,
          left: remaining,
        });
      }

      const anyMatched = matching.length > 0 || modelLiveItems.length > 0;
      if (resetBtn) resetBtn.classList.toggle('hidden', !isFiltered);
      if (emptySimLink) emptySimLink.href = '/calculator/';
      if (emptyState) emptyState.classList.toggle('hidden', anyMatched);
      if (cardsGrid) cardsGrid.classList.toggle('hidden', matching.length === 0);

      syncUrl();
    }

    function applyLegacyQueryFallback(qParam: string) {
      const tokens = qParam.trim().toLowerCase().split(/\s+/).filter(Boolean);
      if (tokens.length === 0) return false;

      // 1. Unified SKU match (e.g. "m4 16g")
      const matchedUnified = catData.hardware.find(
        (h) => h.is_unified && tokens.every((t) => (hwSearchMap.get(h.id) || '').includes(t)),
      );
      if (matchedUnified) {
        const socId = matchedUnified.id.replace(/-\d+gb$/, '');
        const soc = socById.get(socId);
        if (soc) {
          selectedCpuVal = `soc:${soc.id}`;
          selectedRamGb = Math.round(matchedUnified.vram_gb);
          cpuCombo.setValue(selectedCpuVal);
          ramCombo.setOptions(buildRamOptions(soc), false);
          ramCombo.setValue(String(selectedRamGb), `${selectedRamGb} GB`);
          gpuCombo.setDisplayOverride(t('home.noneUnifiedAuto'), true, false);
          return true;
        }
      }

      // 2. Discrete GPU match (e.g. "1080", "4070", "p40", "b580")
      const matchedGpu = discreteGpus.find((h) =>
        tokens.every((t) => (hwSearchMap.get(h.id) || '').includes(t)),
      );
      if (matchedGpu) {
        selectedGpuVal = matchedGpu.id;
        gpuCombo.setValue(matchedGpu.id);
        return true;
      }

      // 3. Model match (e.g. "qwen3", "deepseek r1 14b")
      const matchedModel = catData.models.find((m) =>
        tokens.every((t) =>
          [m.id, m.name, m.short_name, m.family, `${m.params_b}b`].join(' ').toLowerCase().includes(t),
        ),
      );
      if (matchedModel) {
        selectedModel = matchedModel.id;
        modelCombo.setValue(matchedModel.id);
        return true;
      }

      return false;
    }

    function hydrateFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const cpuParam = params.get('cpu');
      const ramParam = params.get('ram');
      const gpuParam = params.get('gpu');
      const gpusParam = params.get('gpus');
      const splitParam = params.get('split');
      const hwParam = params.get('hw');
      const modParam = params.get('model');
      const stParam = params.get('status');
      const sortParam = params.get('sort');
      const qParam = params.get('q');

      let hadParam = false;

      // CPU
      if (cpuParam) {
        if (cpuParam.startsWith('soc:') && socById.has(cpuParam.slice(4))) {
          selectedCpuVal = cpuParam;
          hadParam = true;
        } else if (socById.has(cpuParam)) {
          selectedCpuVal = `soc:${cpuParam}`;
          hadParam = true;
        } else if (cpuParam.startsWith('x86:') && cpuById.has(cpuParam.slice(4))) {
          selectedCpuVal = cpuParam;
          hadParam = true;
        } else if (cpuById.has(cpuParam)) {
          selectedCpuVal = `x86:${cpuParam}`;
          hadParam = true;
        }
      }

      // RAM
      if (ramParam) {
        const parsedRam = parseRamGb(ramParam);
        if (parsedRam !== null) {
          selectedRamGb = parsedRam;
          hadParam = true;
        }
      }

      // GPU (explicit)
      if (gpuParam) {
        if (gpuParam === 'none' || gpuParam === 'cpu-only') {
          selectedGpuVal = 'none';
          hadParam = true;
        } else if (hwById.has(gpuParam) && !hwById.get(gpuParam)!.is_unified) {
          selectedGpuVal = gpuParam;
          hadParam = true;
        }
      } else if (hwParam) {
        // Legacy ?hw= support
        if (hwParam === 'cpu-only') {
          selectedGpuVal = 'none';
          hadParam = true;
        } else if (hwParam === 'dual-rtx-3090-48gb') {
          selectedGpuVal = 'rtx-3090-24gb';
          gpuCount = 2;
          hadParam = true;
        } else if (hwParam === 'dual-rtx-4090-48gb') {
          selectedGpuVal = 'rtx-4090-24gb';
          gpuCount = 2;
          hadParam = true;
        } else if (hwById.has(hwParam)) {
          const h = hwById.get(hwParam)!;
          if (h.is_unified) {
            const socId = h.id.replace(/-\d+gb$/, '');
            if (socById.has(socId)) {
              selectedCpuVal = `soc:${socId}`;
              selectedRamGb = selectedRamGb ?? Math.round(h.vram_gb);
              hadParam = true;
            }
          } else {
            selectedGpuVal = h.id;
            hadParam = true;
          }
        }
      }

      if (gpusParam) {
        const gNum = Number(gpusParam);
        if (GPU_COUNT_OPTIONS.includes(gNum)) {
          gpuCount = gNum;
          hadParam = true;
        }
      }
      if (splitParam === 'tensor' || splitParam === 'row') {
        splitMode = 'tensor';
        hadParam = true;
      } else if (splitParam === 'layer') {
        splitMode = 'layer';
        hadParam = true;
      }

      if (modParam && modelById.has(modParam)) {
        selectedModel = modParam;
        modelCombo.setValue(modParam);
        hadParam = true;
      }
      if (stParam) {
        const normStatus = stParam === 'Smooth' ? 'Fits' : stParam;
        if (['Fits', 'Tight Fit', 'Partial Offload', 'OOM'].includes(normStatus)) {
          selectedStatus = normStatus;
          updateStatusPills();
          hadParam = true;
        }
      }
      if (sortParam && sortSelect && Array.from(sortSelect.options).some((o) => o.value === sortParam)) {
        sortSelect.value = sortParam;
        hadParam = true;
      }

      // Reflect hydrated CPU / RAM / GPU state into comboboxes
      const activeSoc = getActiveUnifiedSoc();
      if (activeSoc) {
        cpuCombo.setValue(selectedCpuVal);
        const effRam = selectedRamGb ?? activeSoc.defaultRamGb;
        selectedRamGb = effRam;
        ramCombo.setOptions(buildRamOptions(activeSoc), false);
        ramCombo.setValue(String(effRam), `${effRam} GB`);
        selectedGpuVal = '';
        gpuCombo.setDisplayOverride(t('home.noneUnifiedAuto'), true, false);
      } else {
        if (selectedCpuVal) cpuCombo.setValue(selectedCpuVal);
        if (selectedRamGb !== null) {
          ramCombo.setValue(String(selectedRamGb), `${selectedRamGb} GB`);
        }
        if (selectedGpuVal) {
          gpuCombo.setValue(selectedGpuVal);
        }
      }

      if (!hadParam && qParam) {
        hadParam = applyLegacyQueryFallback(qParam);
      }

      syncGpuQtyControl();
      updateContextBar();
      if (hadParam) {
        applyFilters(true);
      } else if (getLocale() !== 'en') {
        applyFilters(false);
      }
    }

    function resetAll() {
      selectedCpuVal = '';
      selectedRamGb = null;
      selectedGpuVal = '';
      gpuCount = 1;
      splitMode = 'layer';
      selectedModel = 'all';
      selectedStatus = 'all';

      cpuCombo.clear(true);
      ramCombo.setOptions(buildRamOptions(null), false);
      ramCombo.clear(true);
      gpuCombo.clear(true);
      modelCombo.setValue('all');
      if (sortSelect) sortSelect.value = 'featured';

      syncGpuQtyControl();
      updateContextBar();
      updateStatusPills();
      applyFilters(true);
    }

    if (gpuCountSelect) {
      gpuCountSelect.addEventListener('change', () => {
        const val = Number(gpuCountSelect.value || 1);
        gpuCount = Math.max(1, val);
        updateContextBar();
        applyFilters(true);
      });
    }

    splitBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        splitMode = (btn.getAttribute('data-home-split') as SplitMode) || 'layer';
        updateContextBar();
        applyFilters(true);
      });
    });

    if (sortSelect) sortSelect.addEventListener('change', () => applyFilters(true));
    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        visibleLimit += PAGE_SIZE;
        applyFilters(false);
      });
    }

    if (showAllBtn) {
      showAllBtn.addEventListener('click', () => {
        visibleLimit = totalCurated;
        applyFilters(false);
      });
    }

    if (liveLoadMoreBtn) {
      liveLoadMoreBtn.addEventListener('click', () => {
        liveVisibleLimit += PAGE_SIZE;
        applyFilters(false);
      });
    }

    statusButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedStatus = btn.getAttribute('data-status-btn') || 'all';
        updateStatusPills();
        applyFilters(true);
      });
    });

    document.addEventListener('keydown', (ev) => {
      if (ev.key === '/' && !ev.metaKey && !ev.ctrlKey && !ev.altKey) {
        const tag = document.activeElement ? document.activeElement.tagName : '';
        if (!['INPUT', 'SELECT', 'TEXTAREA'].includes(tag)) {
          ev.preventDefault();
          gpuCombo.focus();
        }
      }
    });

    onLocaleChange(() => {
      cpuCombo.setOptions(buildCpuOptions(), false);
      cpuCombo.setPlaceholder(t('home.cpuPlaceholder'));
      cpuCombo.setEmptyText(t('home.cpuEmpty'));
      if (selectedCpuVal) cpuCombo.setValue(selectedCpuVal);

      ramCombo.setOptions(buildRamOptions(getActiveUnifiedSoc()), false);
      ramCombo.setPlaceholder(t('home.ramPlaceholder'));
      ramCombo.setEmptyText(t('home.ramEmpty'));
      ramCombo.setCustomActionFormatter((n) => t('home.customRamUse', { ram: n }));
      if (selectedRamGb !== null) ramCombo.setValue(String(selectedRamGb), `${selectedRamGb} GB`);

      gpuCombo.setOptions(buildGpuOptions(), false);
      gpuCombo.setPlaceholder(t('home.gpuPlaceholder'));
      gpuCombo.setEmptyText(t('home.gpuEmpty'));
      if (getActiveUnifiedSoc()) {
        gpuCombo.setDisplayOverride(t('home.noneUnifiedAuto'), true, false);
      } else if (selectedGpuVal) {
        gpuCombo.setValue(selectedGpuVal);
      }

      modelCombo.setOptions(buildModelOptions(), false);
      modelCombo.setPlaceholder(t('home.allModels', { count: catData.models.length }));
      modelCombo.setEmptyText(t('home.modelEmpty'));
      modelCombo.setValue(selectedModel);

      syncGpuQtyControl();
      updateContextBar();
      applyFilters(false);
    });

    syncGpuQtyControl();
    hydrateFromUrl();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMatrixPage);
  } else {
    initMatrixPage();
  }
</script>
