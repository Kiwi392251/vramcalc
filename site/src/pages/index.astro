                <div class="flex items-center justify-between gap-2 text-xs">
                  <span class="inline-flex min-w-0 items-center gap-1.5 text-[var(--ink-secondary)]">
                    <span class="whitespace-nowrap">${escapeHtml(budgetLabel)}</span>
                    <span class="rounded border px-1.5 py-px font-mono text-[10px] font-semibold whitespace-nowrap ${quantBadgeCls}" title="${escapeHtml(QUANT_LABELS[res.quant] || res.quant)}">${escapeHtml(quantLabel)}</span>
                  </span>
                  <span class="shrink-0 font-mono font-semibold text-[var(--ink-primary)] tabular-nums">${res.total_vram_gb.toFixed(1)} / ${budget.toFixed(1)} GB</span>
                </div>
                <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-[var(--bg-subtle)]">
                  <div class="h-full rounded-full ${barColor}" style="width: ${pct}%"></div>
                </div>
                <div class="mt-2 flex items-center justify-between gap-2 text-[11px] text-[var(--ink-tertiary)] tabular-nums">
                  <span>${escapeHtml(maxFitLabel)}</span>
                </div>

                <div class="mt-3.5 flex flex-wrap items-end justify-between gap-x-2 gap-y-1.5">
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-baseline gap-1.5">
                      <span class="font-mono text-base sm:text-[17px] font-semibold text-[var(--ink-primary)] tabular-nums">${tpsDisplay}</span>
                      <span class="text-[11px] text-[var(--ink-tertiary)] tabular-nums">${escapeHtml(layersText)}</span>
                    </div>
                    ${provenanceTag}
                  </div>
                  ${footerActions}
                </div>
              </div>
            </article>
          `;
        })
        .join('');

      const liveRemaining = Math.max(0, items.length - slice.length);
      if (livePagBar && livePagSummary && liveLoadMoreBtn) {
        livePagBar.classList.toggle('hidden', liveRemaining === 0);
        livePagSummary.textContent = t('home.showingLive', {
          shown: slice.length,
          total: items.length,
        });
        liveLoadMoreBtn.textContent = t('home.loadMoreGuides', {
          chunk: Math.min(PAGE_SIZE, liveRemaining),
          left: liveRemaining,
        });
      }
    }

    function applyFilters(resetPagination = true) {
      if (resetPagination) {
        visibleLimit = PAGE_SIZE;
        liveVisibleLimit = PAGE_SIZE;
      }

      const sortVal = sortSelect.getValue() || 'featured';
      if (sortVal !== currentSort) {
        currentSort = sortVal;
        sortCardsInDom(sortVal);
      }

      const rigActive = isRigConfigured();

      if (rigActive) {
        if (awaitPanel) awaitPanel.classList.add('hidden');
        setGridVisible(cardsGrid, false, 'grid');
        setGridVisible(paginationBar, false, 'flex');

        const rigResult = computeRigLiveResults();
        updateResultsModeBanner({ isRig: true, rigResult });
        renderLiveCards(rigResult.items, true, rigResult);

        if (countEl) {
          countEl.removeAttribute('data-i18n');
          countEl.removeAttribute('data-i18n-args');
          countEl.textContent = t('home.countRig', {
            count: rigResult.items.length,
            quant: QUANT_SHORT_LABELS[selectedQuant],
          });
        }
        if (emptySimLink) {
          emptySimLink.href = rigResult.rigSimHref;
        }
        if (emptyState) {
          emptyState.classList.toggle('hidden', rigResult.items.length > 0);
        }
        if (resetBtn) {
          resetBtn.classList.remove('hidden');
        }
        syncUrl();
        return;
      }

      if (!browsePresetsOpen) {
        if (awaitPanel) awaitPanel.classList.remove('hidden');
        setGridVisible(modeBanner, false, 'flex');
        setGridVisible(cardsGrid, false, 'grid');
        setGridVisible(paginationBar, false, 'flex');
        if (liveSection) liveSection.classList.add('hidden');
        if (liveGrid) liveGrid.innerHTML = '';
        if (livePagBar) livePagBar.classList.add('hidden');
        if (emptyState) emptyState.classList.add('hidden');

        if (awaitModelReq) {
          const selModelObj = selectedModel !== 'all' ? modelById.get(selectedModel) : undefined;
          if (selModelObj) {
            const activeFormat = formatForQuant(selectedQuant);
            const mReq = estimateRigRun({
              model: selModelObj,
              hardware: null,
              quant: selectedQuant,
              format: activeFormat,
              contextTokens: 8192,
            });
            awaitModelReq.textContent = t('home.awaitModelReq', {
              model: selModelObj.short_name,
              quant: QUANT_SHORT_LABELS[selectedQuant],
              gb: mReq.total_vram_gb.toFixed(1),
            });
            awaitModelReq.classList.remove('hidden');
          } else {
            awaitModelReq.classList.add('hidden');
          }
        }

        if (countEl) {
          countEl.setAttribute('data-i18n', 'home.countAwaitHw');
          countEl.setAttribute(
            'data-i18n-args',
            JSON.stringify({ models: catData.models.length, hw: catData.hardware.length }),
          );
          countEl.textContent = t('home.countAwaitHw', {
            models: catData.models.length,
            hw: catData.hardware.length,
          });
        }

        const hasFilterInAwait =
          selectedModel !== 'all' ||
          selectedStatus !== 'all' ||
          selectedQuant !== 'Q4_K_M' ||
          reserveProfile !== 'desktop' ||
          currentSort !== 'featured';
        if (resetBtn) resetBtn.classList.toggle('hidden', !hasFilterInAwait);
        syncUrl();
        return;
      }

      if (reserveProfile !== 'desktop' || selectedQuant !== 'Q4_K_M') {
        if (awaitPanel) awaitPanel.classList.add('hidden');
        setGridVisible(cardsGrid, false, 'grid');
        setGridVisible(paginationBar, false, 'flex');

        updateResultsModeBanner({ isRig: false });
        const reserveLiveItems = computeCuratedReserveLiveItems();
        renderLiveCards(reserveLiveItems, false);

        if (countEl) {
          countEl.removeAttribute('data-i18n');
          countEl.removeAttribute('data-i18n-args');
          countEl.textContent = t('home.countRig', {
            count: reserveLiveItems.length,
            quant: QUANT_SHORT_LABELS[selectedQuant],
          });
        }
        if (emptySimLink) {
          emptySimLink.href = '/calculator/';
        }
        if (emptyState) {
          emptyState.classList.toggle('hidden', reserveLiveItems.length > 0);
        }
        if (resetBtn) {
          resetBtn.classList.remove('hidden');
        }
        syncUrl();
        return;
      }

      if (awaitPanel) awaitPanel.classList.add('hidden');
      updateResultsModeBanner({ isRig: false });
      const orderedCards = cardsGrid
        ? Array.from(cardsGrid.querySelectorAll('[data-card]'))
        : cards;

      const matching: Element[] = [];
      orderedCards.forEach((card) => {
        const matchModel =
          selectedModel === 'all' || card.getAttribute('data-model') === selectedModel;
        const matchStatus =
          selectedStatus === 'all' || card.getAttribute('data-status') === selectedStatus;
        if (matchModel && matchStatus) {
          matching.push(card);
        } else {
          card.classList.add('hidden');
        }
      });

      const shownCount = Math.min(visibleLimit, matching.length);
      matching.forEach((card, i) => {
        card.classList.toggle('hidden', i >= visibleLimit);
      });

      const modelLiveItems = computeModelOnlyLiveItems();
      renderLiveCards(modelLiveItems, false);

      const remaining = Math.max(0, matching.length - shownCount);
      const isFiltered =
        selectedModel !== 'all' || selectedStatus !== 'all' || currentSort !== 'featured';

      if (countEl) {
        countEl.removeAttribute('data-i18n');
        countEl.removeAttribute('data-i18n-args');
        if (!isFiltered) {
          countEl.textContent = t('home.countInitial', {
            shown: shownCount,
            total: totalCurated,
            models: catData.models.length,
            hw: catData.hardware.length,
          });
        } else if (modelLiveItems.length > 0) {
          countEl.textContent = t('home.countModelPlusLive', {
            guides: matching.length,
            live: modelLiveItems.length,
          });
        } else {
          countEl.textContent = t('home.countMatched', {
            shown: shownCount,
            matched: matching.length,
          });
        }
      }

      setGridVisible(paginationBar, remaining > 0, 'flex');
      if (paginationSummary) {
        paginationSummary.textContent = t('home.viewingGuides', {
          shown: shownCount,
          total: matching.length,
        });
      }
      if (paginationFill) {
        const pct = matching.length > 0 ? Math.round((shownCount / matching.length) * 100) : 100;
        paginationFill.style.width = `${pct}%`;
      }
      if (loadMoreBtn) {
        const nextChunk = Math.min(PAGE_SIZE, remaining);
        loadMoreBtn.textContent = t('home.loadMoreGuides', {
          chunk: nextChunk,
          left: remaining,
        });
      }

      const anyMatched = matching.length > 0 || modelLiveItems.length > 0;
      if (resetBtn) resetBtn.classList.toggle('hidden', !isFiltered);
      if (emptySimLink) emptySimLink.href = '/calculator/';
      if (emptyState) emptyState.classList.toggle('hidden', anyMatched);
      setGridVisible(cardsGrid, matching.length > 0, 'grid');

      syncUrl();
    }

    function applyLegacyQueryFallback(qParam: string) {
      const tokens = qParam.trim().toLowerCase().split(/\s+/).filter(Boolean);
      if (tokens.length === 0) return false;

      const matchedUnified = catData.hardware.find(
        (h) => h.is_unified && tokens.every((tk) => (hwSearchMap.get(h.id) || '').includes(tk)),
      );
      if (matchedUnified) {
        const socId = matchedUnified.id.replace(/-\d+gb$/, '');
        const soc = socById.get(socId);
        if (soc) {
          selectedCpuVal = `soc:${soc.id}`;
          selectedRamGb = Math.round(matchedUnified.vram_gb);
          cpuCombo.setValue(selectedCpuVal);
          ramCombo.setOptions(buildRamOptions(soc), false);
          ramCombo.setValue(String(selectedRamGb), `${selectedRamGb} GB`);
          gpuCombo.setDisplayOverride(t('home.noneUnifiedAuto'), true, false);
          return true;
        }
      }

      const matchedGpu = discreteGpus.find((h) =>
        tokens.every((tk) => (hwSearchMap.get(h.id) || '').includes(tk)),
      );
      if (matchedGpu) {
        selectedGpuVal = matchedGpu.id;
        gpuCombo.setValue(matchedGpu.id);
        return true;
      }

      const matchedModel = catData.models.find((m) =>
        tokens.every((tk) =>
          [m.id, m.name, m.short_name, m.family, `${m.params_b}b`].join(' ').toLowerCase().includes(tk),
        ),
      );
      if (matchedModel) {
        selectedModel = matchedModel.id;
        modelCombo.setValue(matchedModel.id);
        return true;
      }

      return false;
    }

    function hydrateFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const cpuParam = params.get('cpu');
      const ramParam = params.get('ram');
      const gpuParam = params.get('gpu');
      const gpusParam = params.get('gpus');
      const splitParam = params.get('split');
      const hwParam = params.get('hw');
      const modParam = params.get('model');
      const stParam = params.get('status');
      const sortParam = params.get('sort');
      const quantParam = params.get('quant');
      const resParam = params.get('reserve');
      const customGbParam = params.get('customGb');
      const qParam = params.get('q');

      let hadParam = false;

      if (cpuParam) {
        if (cpuParam.startsWith('soc:') && socById.has(cpuParam.slice(4))) {
          selectedCpuVal = cpuParam;
          hadParam = true;
        } else if (socById.has(cpuParam)) {
          selectedCpuVal = `soc:${cpuParam}`;
          hadParam = true;
        } else if (cpuParam.startsWith('x86:') && cpuById.has(cpuParam.slice(4))) {
          selectedCpuVal = cpuParam;
          hadParam = true;
        } else if (cpuById.has(cpuParam)) {
          selectedCpuVal = `x86:${cpuParam}`;
          hadParam = true;
        }
      }

      if (ramParam) {
        const parsedRam = parseRamGb(ramParam);
        if (parsedRam !== null) {
          selectedRamGb = parsedRam;
          hadParam = true;
        }
      }

      if (gpuParam) {
        if (gpuParam === 'none' || gpuParam === 'cpu-only') {
          selectedGpuVal = 'none';
          hadParam = true;
        } else if (hwById.has(gpuParam) && !hwById.get(gpuParam)!.is_unified) {
          selectedGpuVal = gpuParam;
          hadParam = true;
        }
      } else if (hwParam) {
        if (hwParam === 'cpu-only') {
          selectedGpuVal = 'none';
          hadParam = true;
        } else if (hwParam === 'dual-rtx-3090-48gb') {
          selectedGpuVal = 'rtx-3090-24gb';
          gpuCount = 2;
          hadParam = true;
        } else if (hwParam === 'dual-rtx-4090-48gb') {
          selectedGpuVal = 'rtx-4090-24gb';
          gpuCount = 2;
          hadParam = true;
        } else if (hwById.has(hwParam)) {
          const h = hwById.get(hwParam)!;
          if (h.is_unified) {
            const socId = h.id.replace(/-\d+gb$/, '');
            if (socById.has(socId)) {
              selectedCpuVal = `soc:${socId}`;
              selectedRamGb = selectedRamGb ?? Math.round(h.vram_gb);
              hadParam = true;
            }
          } else {
            selectedGpuVal = h.id;
            hadParam = true;
          }
        }
      }

      if (gpusParam) {
        const gNum = Number(gpusParam);
        if (GPU_COUNT_OPTIONS.includes(gNum)) {
          gpuCount = gNum;
          hadParam = true;
        }
      }
      if (splitParam === 'tensor' || splitParam === 'row') {
        splitMode = 'tensor';
        hadParam = true;
      } else if (splitParam === 'layer') {
        splitMode = 'layer';
        hadParam = true;
      }

      if (modParam && modelById.has(modParam)) {
        selectedModel = modParam;
        modelCombo.setValue(modParam);
        hadParam = true;
      }
      if (stParam) {
        const normStatus = stParam === 'Smooth' ? 'Fits' : stParam;
        if (['Fits', 'Tight Fit', 'Partial Offload', 'OOM'].includes(normStatus)) {
          selectedStatus = normStatus;
          updateStatusPills();
          hadParam = true;
        }
      }
      if (sortParam && sortSelect.hasOption(sortParam)) {
        sortSelect.setValue(sortParam, true);
        hadParam = true;
      }
      if (quantParam && (VALID_QUANTS as readonly string[]).includes(quantParam)) {
        selectedQuant = quantParam as QuantKey;
        hadParam = true;
      }
      if (resParam === 'clean' || resParam === 'custom') {
        reserveProfile = resParam;
        hadParam = true;
      }
      if (customGbParam) {
        const parsedCustom = Number(customGbParam);
        if (Number.isFinite(parsedCustom) && parsedCustom > 0 && parsedCustom <= 512) {
          customUsableGb = parsedCustom;
          reserveProfile = 'custom';
          hadParam = true;
        }
      }

      const activeSoc = getActiveUnifiedSoc();
      if (activeSoc) {
        cpuCombo.setValue(selectedCpuVal);
        const effRam = selectedRamGb ?? activeSoc.defaultRamGb;
        selectedRamGb = effRam;
        ramCombo.setOptions(buildRamOptions(activeSoc), false);
        ramCombo.setValue(String(effRam), `${effRam} GB`);
        selectedGpuVal = '';
        gpuCombo.setDisplayOverride(t('home.noneUnifiedAuto'), true, false);
      } else {
        if (selectedCpuVal) cpuCombo.setValue(selectedCpuVal);
        if (selectedRamGb !== null) {
          ramCombo.setValue(String(selectedRamGb), `${selectedRamGb} GB`);
        }
        if (selectedGpuVal) {
          gpuCombo.setValue(selectedGpuVal);
        }
      }

      if (!hadParam && qParam) {
        hadParam = applyLegacyQueryFallback(qParam);
      }

      syncGpuQtyControl();
      updateQuantUi();
      updateReserveUi();
      updateContextBar();
      if (hadParam) {
        applyFilters(true);
      } else if (getLocale() !== 'en') {
        applyFilters(false);
      }
    }

    function resetAll() {
      selectedCpuVal = '';
      selectedRamGb = null;
      selectedGpuVal = '';
      gpuCount = 1;
      splitMode = 'layer';
      selectedQuant = 'Q4_K_M';
      reserveProfile = 'desktop';
      customUsableGb = null;
      selectedModel = 'all';
      selectedStatus = 'all';
      browsePresetsOpen = false;
      if (customGbInput) customGbInput.value = '';

      cpuCombo.clear(true);
      ramCombo.setOptions(buildRamOptions(null), false);
      ramCombo.clear(true);
      gpuCombo.clear(true);
      modelCombo.setValue('all');
      sortSelect.setValue('featured', true);

      syncGpuQtyControl();
      updateQuantUi();
      updateReserveUi();
      updateContextBar();
      updateStatusPills();
      applyFilters(true);
    }

    quantBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const qVal = btn.getAttribute('data-home-quant') as QuantKey | null;
        if (!qVal || !(VALID_QUANTS as readonly string[]).includes(qVal) || qVal === selectedQuant) return;
        selectedQuant = qVal;
        updateQuantUi();
        applyFilters(true);
      });
    });

    reserveBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = (btn.getAttribute('data-home-reserve') as ReserveProfile) || 'desktop';
        reserveProfile = val;
        if (val === 'custom' && customUsableGb === null) {
          const typed = customGbInput ? Number(customGbInput.value) : NaN;
          customUsableGb = Number.isFinite(typed) && typed > 0 ? typed : 22.4;
        }
        updateReserveUi();
        applyFilters(true);
        if (val === 'custom' && customGbInput) customGbInput.focus();
      });
    });

    if (customGbInput) {
      customGbInput.addEventListener('input', () => {
        const val = Number(customGbInput.value);
        if (Number.isFinite(val) && val > 0 && val <= 512) {
          customUsableGb = val;
          reserveProfile = 'custom';
          updateReserveUi();
          applyFilters(true);
        }
      });
    }

    splitBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        splitMode = (btn.getAttribute('data-home-split') as SplitMode) || 'layer';
        updateContextBar();
        applyFilters(true);
      });
    });

    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        visibleLimit += PAGE_SIZE;
        applyFilters(false);
      });
    }

    if (showAllBtn) {
      showAllBtn.addEventListener('click', () => {
        visibleLimit = totalCurated;
        applyFilters(false);
      });
    }

    let hwHighlightTimer: number | null = null;
    function highlightHardwareInputs() {
      rigConfigPanel?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      const cpuInput = cpuRoot?.querySelector('input');
      const gpuInput = gpuRoot?.querySelector('input');
      const targets = [cpuInput, gpuInput].filter((el): el is HTMLInputElement => Boolean(el));
      targets.forEach((el) => {
        el.classList.add('ring-2', 'ring-[var(--accent)]', 'border-[var(--accent)]');
      });
      if (hwHighlightTimer !== null) window.clearTimeout(hwHighlightTimer);
      hwHighlightTimer = window.setTimeout(() => {
        targets.forEach((el) => {
          el.classList.remove('ring-2', 'ring-[var(--accent)]', 'border-[var(--accent)]');
        });
        hwHighlightTimer = null;
      }, 1400);
    }

    if (modeSelectBtn) modeSelectBtn.addEventListener('click', highlightHardwareInputs);
    if (awaitSelectHwBtn) awaitSelectHwBtn.addEventListener('click', highlightHardwareInputs);

    quickSocBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const socId = btn.getAttribute('data-quick-soc') || '';
        const ramStr = btn.getAttribute('data-quick-ram') || '';
        const soc = socById.get(socId);
        if (soc) {
          const ramNum = Number(ramStr);
          activateUnifiedSoc(soc, Number.isFinite(ramNum) && ramNum > 0 ? ramNum : null);
        }
      });
    });

    quickGpuBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const gpuId = btn.getAttribute('data-quick-gpu') || '';
        if (gpuId && hwById.has(gpuId)) {
          gpuCombo.setValue(gpuId);
          applyGpuSelection(gpuId, false);
        }
      });
    });

    if (openPresetsBtn) {
      openPresetsBtn.addEventListener('click', () => {
        browsePresetsOpen = true;
        applyFilters(true);
      });
    }

    if (modeClosePresetsBtn) {
      modeClosePresetsBtn.addEventListener('click', () => {
        browsePresetsOpen = false;
        applyFilters(false);
      });
    }

    // 3-tab catalog directory switcher (all 3 panels remain statically in DOM)
    function activateDirTab(tabName: string) {
      dirTabBtns.forEach((b) => {
        const isAct = b.getAttribute('data-dir-tab') === tabName;
        b.setAttribute('data-active', isAct ? 'true' : 'false');
        b.setAttribute('aria-selected', isAct ? 'true' : 'false');
      });
      dirPanels.forEach((p) => {
        const match = p.getAttribute('data-dir-panel') === tabName;
        p.classList.toggle('hidden', !match);
      });
      if (dirViewAllLink) {
        if (tabName === 'models') {
          dirViewAllLink.href = '/model/';
          dirViewAllLink.classList.remove('hidden');
        } else if (tabName === 'hardware') {
          dirViewAllLink.href = '/gpu/';
          dirViewAllLink.classList.remove('hidden');
        } else {
          dirViewAllLink.classList.add('hidden');
        }
      }
    }

    dirTabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-dir-tab') || 'models';
        activateDirTab(target);
      });
    });

    if (window.location.hash === '#static-compatibility-index') {
      activateDirTab('index');
    }

    const cmdTimers = new WeakMap<Element, number>();
    document.querySelectorAll('[data-copy-cmd]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cmd = btn.getAttribute('data-copy-cmd') || '';
        if (!cmd) return;
        const doFeedback = () => {
          const copyIcon = btn.querySelector('[data-cmd-copy-icon]');
          const checkIcon = btn.querySelector('[data-cmd-check-icon]');
          if (copyIcon) copyIcon.classList.add('hidden');
          if (checkIcon) checkIcon.classList.remove('hidden');
          btn.classList.add('badge-fits');
          const prev = cmdTimers.get(btn);
          if (prev) window.clearTimeout(prev);
          const tid = window.setTimeout(() => {
            if (copyIcon) copyIcon.classList.remove('hidden');
            if (checkIcon) checkIcon.classList.add('hidden');
            btn.classList.remove('badge-fits');
          }, 1400);
          cmdTimers.set(btn, tid);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(cmd).then(doFeedback).catch(doFeedback);
        } else {
          doFeedback();
        }
      });
    });

    if (liveLoadMoreBtn) {
      liveLoadMoreBtn.addEventListener('click', () => {
        liveVisibleLimit += PAGE_SIZE;
        applyFilters(false);
      });
    }

    statusButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedStatus = btn.getAttribute('data-status-btn') || 'all';
        updateStatusPills();
        applyFilters(true);
      });
    });

    document.addEventListener('keydown', (ev) => {
      if (ev.key === '/' && !ev.metaKey && !ev.ctrlKey && !ev.altKey) {
        const tag = document.activeElement ? document.activeElement.tagName : '';
        if (!['INPUT', 'SELECT', 'TEXTAREA'].includes(tag)) {
          ev.preventDefault();
          gpuCombo.focus();
        }
      }
    });

    onLocaleChange(() => {
      cpuCombo.setOptions(
        buildCpuCascaderOptions({
          cpus: catData.cpus,
          socProfiles,
          t,
          includeUnified: true,
          prefixX86: true,
        }),
        true,
      );
      cpuCombo.setPlaceholder(t('home.cpuPlaceholder'));
      cpuCombo.setEmptyText(t('home.cpuEmpty'));
      cpuCombo.setCascaderLabels({
        searchPlaceholder: t('cb.searchCpuPh'),
        brandHeader: t('cb.brandCol'),
        seriesHeader: t('cb.seriesCol'),
        modelHeader: t('cb.modelCol'),
        allBrandsLabel: (n) => t('cb.allBrands', { count: n }),
        allSeriesLabel: (n) => t('cb.allSeries', { count: n }),
        itemsCountFormatter: (n) => t('cb.countItems', { count: n }),
      });
      if (selectedCpuVal) cpuCombo.setValue(selectedCpuVal);

      ramCombo.setOptions(buildRamOptions(getActiveUnifiedSoc()), true);
      ramCombo.setPlaceholder(t('home.ramPlaceholder'));
      ramCombo.setEmptyText(t('home.ramEmpty'));
      ramCombo.setCustomActionFormatter((n) => t('home.customRamUse', { ram: n }));
      if (selectedRamGb !== null) ramCombo.setValue(String(selectedRamGb), `${selectedRamGb} GB`);

      gpuCombo.setOptions(
        buildHardwareCascaderOptions({
          hardware: catData.hardware,
          t,
          prefixUnified: true,
          includeCpuOnly: true,
          includeMultiGpu: false,
        }),
        true,
      );
      gpuCombo.setPlaceholder(t('home.gpuPlaceholder'));
      gpuCombo.setEmptyText(t('home.gpuEmpty'));
      gpuCombo.setCascaderLabels({
        searchPlaceholder: t('cb.searchGpuPh'),
        brandHeader: t('cb.brandCol'),
        seriesHeader: t('cb.seriesCol'),
        modelHeader: t('cb.modelCol'),
        allBrandsLabel: (n) => t('cb.allBrands', { count: n }),
        allSeriesLabel: (n) => t('cb.allSeries', { count: n }),
        itemsCountFormatter: (n) => t('cb.countItems', { count: n }),
      });
      if (getActiveUnifiedSoc()) {
        gpuCombo.setDisplayOverride(t('home.noneUnifiedAuto'), true, false);
      } else if (selectedGpuVal) {
        gpuCombo.setValue(selectedGpuVal);
      }

      modelCombo.setOptions(
        buildModelCascaderOptions({
          models: catData.models,
          t,
          includeAllOption: true,
        }),
        true,
      );
      modelCombo.setPlaceholder(t('home.allModels', { count: catData.models.length }));
      modelCombo.setEmptyText(t('home.modelEmpty'));
      modelCombo.setCascaderLabels({
        searchPlaceholder: t('cb.searchModelPh'),
        brandHeader: t('cb.brandCol'),
        seriesHeader: t('cb.seriesCol'),
        modelHeader: t('cb.modelCol'),
        allBrandsLabel: (n) => t('cb.allBrands', { count: n }),
        allSeriesLabel: (n) => t('cb.allSeries', { count: n }),
        itemsCountFormatter: (n) => t('cb.countItems', { count: n }),
      });
      modelCombo.setValue(selectedModel);

      sortSelect.syncLocaleLabels();
      syncGpuQtyControl();
      updateContextBar();
      applyFilters(false);
    });

    syncGpuQtyControl();
    updateQuantUi();
    updateReserveUi();
    hydrateFromUrl();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMatrixPage);
  } else {
    initMatrixPage();
  }
</script>
