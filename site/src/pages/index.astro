                 <a href="${primaryHref}" class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-800">${escapeHtml(t('common.openGuide'))}</a>
               </div>`
            : `<a href="${simHref}" class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-800">${escapeHtml(t('common.simulate'))}</a>`;

          return `
            <article class="group flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 transition-all hover:border-blue-300 hover:shadow-md">
              <div>
                <div class="flex items-start justify-between gap-2">
                  <div class="flex flex-wrap items-center gap-1.5">
                    <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-semibold ${badgeClasses(res.status)}">
                      <span class="h-1.5 w-1.5 rounded-full ${dotClass(res.status)}"></span>
                      ${escapeHtml(tStatus(res.status))}
                    </span>
                    <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-semibold ${speedBadgeClasses(speedTier)}">
                      ${escapeHtml(tSpeedTier(speedTier, true))}
                    </span>
                    ${kindBadge}
                  </div>
                  <span class="shrink-0 rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[11px] font-semibold text-slate-600">${escapeHtml(chipLabel)}</span>
                </div>

                <h3 class="mt-3.5 text-base font-bold tracking-tight text-slate-950 group-hover:text-blue-600 transition-colors">
                  <a href="${primaryHref}" class="focus:outline-none">
                    ${escapeHtml(model.short_name)}
                    <span class="block text-sm font-semibold text-slate-600">${escapeHtml(hwSubtitle)}</span>
                  </a>
                </h3>

                <p class="mt-1.5 font-mono text-xs text-slate-500">${escapeHtml(moeLine)}</p>
              </div>

              <div class="mt-4 pt-4 border-t border-slate-100">
                <div class="flex items-center justify-between text-xs">
                  <span class="text-slate-500">${escapeHtml(budgetLabel)}</span>
                  <span class="font-mono font-semibold text-slate-900 tabular-nums">${res.total_vram_gb.toFixed(1)} / ${budget.toFixed(1)} GB</span>
                </div>
                <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-slate-100">
                  <div class="h-full rounded-full ${barColor}" style="width: ${pct}%"></div>
                </div>
                <div class="mt-1.5 flex items-center justify-between gap-2 text-[11px] text-slate-500 tabular-nums">
                  <span>${escapeHtml(maxFitLabel)}</span>
                  ${formulaTag}
                </div>

                <div class="mt-3 flex items-center justify-between">
                  <div class="flex items-baseline gap-1.5">
                    <span class="font-mono text-base sm:text-lg font-bold text-slate-950 tabular-nums">${tpsDisplay}</span>
                    <span class="text-[11px] text-slate-500 tabular-nums">${escapeHtml(layersText)}</span>
                  </div>
                  ${footerActions}
                </div>
              </div>
            </article>
          `;
        })
        .join('');

      const liveRemaining = Math.max(0, items.length - slice.length);
      if (livePagBar && livePagSummary && liveLoadMoreBtn) {
        livePagBar.classList.toggle('hidden', liveRemaining === 0);
        livePagSummary.textContent = t('home.showingLive', {
          shown: slice.length,
          total: items.length,
        });
        liveLoadMoreBtn.textContent = t('home.loadMoreGuides', {
          chunk: Math.min(PAGE_SIZE, liveRemaining),
          left: liveRemaining,
        });
      }
    }

    function applyFilters(resetPagination = true) {
      if (resetPagination) {
        visibleLimit = PAGE_SIZE;
        liveVisibleLimit = PAGE_SIZE;
      }

      const sortVal = sortSelect ? sortSelect.value : 'featured';
      if (sortVal !== currentSort) {
        currentSort = sortVal;
        sortCardsInDom(sortVal);
      }

      const rigActive = isRigConfigured();

      if (rigActive) {
        // Unified live 22-model view for the configured CPU + RAM + GPU rig
        if (cardsGrid) cardsGrid.classList.add('hidden');
        if (paginationBar) paginationBar.classList.add('hidden');

        const rigResult = computeRigLiveResults();
        updateResultsModeBanner({ isRig: true, rigResult });
        renderLiveCards(rigResult.items, true, rigResult);

        if (countEl) {
          countEl.textContent = t('home.countRig', { count: rigResult.items.length });
        }
        if (emptySimLink) {
          emptySimLink.href = rigResult.rigSimHref;
        }
        if (emptyState) {
          emptyState.classList.toggle('hidden', rigResult.items.length > 0);
        }
        if (resetBtn) {
          resetBtn.classList.remove('hidden');
        }
        syncUrl();
        return;
      }

      if (reserveProfile !== 'desktop') {
        if (cardsGrid) cardsGrid.classList.add('hidden');
        if (paginationBar) paginationBar.classList.add('hidden');

        updateResultsModeBanner({ isRig: false });
        const reserveLiveItems = computeCuratedReserveLiveItems();
        renderLiveCards(reserveLiveItems, false);

        if (countEl) {
          countEl.textContent = t('home.countRig', { count: reserveLiveItems.length });
        }
        if (emptySimLink) {
          emptySimLink.href = '/calculator/';
        }
        if (emptyState) {
          emptyState.classList.toggle('hidden', reserveLiveItems.length > 0);
        }
        if (resetBtn) {
          resetBtn.classList.remove('hidden');
        }
        syncUrl();
        return;
      }

      // Default SSR Curated Matrix View (no rig hardware configured)
      updateResultsModeBanner({ isRig: false });
      const orderedCards = cardsGrid
        ? Array.from(cardsGrid.querySelectorAll('[data-card]'))
        : cards;

      const matching: Element[] = [];
      orderedCards.forEach((card) => {
        const matchModel =
          selectedModel === 'all' || card.getAttribute('data-model') === selectedModel;
        const matchStatus =
          selectedStatus === 'all' || card.getAttribute('data-status') === selectedStatus;
        if (matchModel && matchStatus) {
          matching.push(card);
        } else {
          card.classList.add('hidden');
        }
      });

      const shownCount = Math.min(visibleLimit, matching.length);
      matching.forEach((card, i) => {
        card.classList.toggle('hidden', i >= visibleLimit);
      });

      const modelLiveItems = computeModelOnlyLiveItems();
      renderLiveCards(modelLiveItems, false);

      const remaining = Math.max(0, matching.length - shownCount);
      const isFiltered =
        selectedModel !== 'all' || selectedStatus !== 'all' || currentSort !== 'featured';

      if (countEl) {
        if (!isFiltered) {
          countEl.textContent = t('home.countInitial', {
            shown: shownCount,
            total: totalCurated,
            models: catData.models.length,
            hw: catData.hardware.length,
          });
        } else if (modelLiveItems.length > 0) {
          countEl.textContent = t('home.countModelPlusLive', {
            guides: matching.length,
            live: modelLiveItems.length,
          });
        } else {
          countEl.textContent = t('home.countMatched', {
            shown: shownCount,
            matched: matching.length,
          });
        }
      }

      if (paginationBar) {
        paginationBar.classList.toggle('hidden', remaining === 0);
      }
      if (paginationSummary) {
        paginationSummary.textContent = t('home.viewingGuides', {
          shown: shownCount,
          total: matching.length,
        });
      }
      if (paginationFill) {
        const pct = matching.length > 0 ? Math.round((shownCount / matching.length) * 100) : 100;
        paginationFill.style.width = `${pct}%`;
      }
      if (loadMoreBtn) {
        const nextChunk = Math.min(PAGE_SIZE, remaining);
        loadMoreBtn.textContent = t('home.loadMoreGuides', {
          chunk: nextChunk,
          left: remaining,
        });
      }

      const anyMatched = matching.length > 0 || modelLiveItems.length > 0;
      if (resetBtn) resetBtn.classList.toggle('hidden', !isFiltered);
      if (emptySimLink) emptySimLink.href = '/calculator/';
      if (emptyState) emptyState.classList.toggle('hidden', anyMatched);
      if (cardsGrid) cardsGrid.classList.toggle('hidden', matching.length === 0);

      syncUrl();
    }

    function applyLegacyQueryFallback(qParam: string) {
      const tokens = qParam.trim().toLowerCase().split(/\s+/).filter(Boolean);
      if (tokens.length === 0) return false;

      // 1. Unified SKU match (e.g. "m4 16g")
      const matchedUnified = catData.hardware.find(
        (h) => h.is_unified && tokens.every((t) => (hwSearchMap.get(h.id) || '').includes(t)),
      );
      if (matchedUnified) {
        const socId = matchedUnified.id.replace(/-\d+gb$/, '');
        const soc = socById.get(socId);
        if (soc) {
          selectedCpuVal = `soc:${soc.id}`;
          selectedRamGb = Math.round(matchedUnified.vram_gb);
          cpuCombo.setValue(selectedCpuVal);
          ramCombo.setOptions(buildRamOptions(soc), false);
          ramCombo.setValue(String(selectedRamGb), `${selectedRamGb} GB`);
          gpuCombo.setDisplayOverride(t('home.noneUnifiedAuto'), true, false);
          return true;
        }
      }

      // 2. Discrete GPU match (e.g. "1080", "4070", "p40", "b580")
      const matchedGpu = discreteGpus.find((h) =>
        tokens.every((t) => (hwSearchMap.get(h.id) || '').includes(t)),
      );
      if (matchedGpu) {
        selectedGpuVal = matchedGpu.id;
        gpuCombo.setValue(matchedGpu.id);
        return true;
      }

      // 3. Model match (e.g. "qwen3", "deepseek r1 14b")
      const matchedModel = catData.models.find((m) =>
        tokens.every((t) =>
          [m.id, m.name, m.short_name, m.family, `${m.params_b}b`].join(' ').toLowerCase().includes(t),
        ),
      );
      if (matchedModel) {
        selectedModel = matchedModel.id;
        modelCombo.setValue(matchedModel.id);
        return true;
      }

      return false;
    }

    function hydrateFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const cpuParam = params.get('cpu');
      const ramParam = params.get('ram');
      const gpuParam = params.get('gpu');
      const gpusParam = params.get('gpus');
      const splitParam = params.get('split');
      const hwParam = params.get('hw');
      const modParam = params.get('model');
      const stParam = params.get('status');
      const sortParam = params.get('sort');
      const resParam = params.get('reserve');
      const customGbParam = params.get('customGb');
      const qParam = params.get('q');

      let hadParam = false;

      // CPU
      if (cpuParam) {
        if (cpuParam.startsWith('soc:') && socById.has(cpuParam.slice(4))) {
          selectedCpuVal = cpuParam;
          hadParam = true;
        } else if (socById.has(cpuParam)) {
          selectedCpuVal = `soc:${cpuParam}`;
          hadParam = true;
        } else if (cpuParam.startsWith('x86:') && cpuById.has(cpuParam.slice(4))) {
          selectedCpuVal = cpuParam;
          hadParam = true;
        } else if (cpuById.has(cpuParam)) {
          selectedCpuVal = `x86:${cpuParam}`;
          hadParam = true;
        }
      }

      // RAM
      if (ramParam) {
        const parsedRam = parseRamGb(ramParam);
        if (parsedRam !== null) {
          selectedRamGb = parsedRam;
          hadParam = true;
        }
      }

      // GPU (explicit)
      if (gpuParam) {
        if (gpuParam === 'none' || gpuParam === 'cpu-only') {
          selectedGpuVal = 'none';
          hadParam = true;
        } else if (hwById.has(gpuParam) && !hwById.get(gpuParam)!.is_unified) {
          selectedGpuVal = gpuParam;
          hadParam = true;
        }
      } else if (hwParam) {
        // Legacy ?hw= support
        if (hwParam === 'cpu-only') {
          selectedGpuVal = 'none';
          hadParam = true;
        } else if (hwParam === 'dual-rtx-3090-48gb') {
          selectedGpuVal = 'rtx-3090-24gb';
          gpuCount = 2;
          hadParam = true;
        } else if (hwParam === 'dual-rtx-4090-48gb') {
          selectedGpuVal = 'rtx-4090-24gb';
          gpuCount = 2;
          hadParam = true;
        } else if (hwById.has(hwParam)) {
          const h = hwById.get(hwParam)!;
          if (h.is_unified) {
            const socId = h.id.replace(/-\d+gb$/, '');
            if (socById.has(socId)) {
              selectedCpuVal = `soc:${socId}`;
              selectedRamGb = selectedRamGb ?? Math.round(h.vram_gb);
              hadParam = true;
            }
          } else {
            selectedGpuVal = h.id;
            hadParam = true;
          }
        }
      }

      if (gpusParam) {
        const gNum = Number(gpusParam);
        if (GPU_COUNT_OPTIONS.includes(gNum)) {
          gpuCount = gNum;
          hadParam = true;
        }
      }
      if (splitParam === 'tensor' || splitParam === 'row') {
        splitMode = 'tensor';
        hadParam = true;
      } else if (splitParam === 'layer') {
        splitMode = 'layer';
        hadParam = true;
      }

      if (modParam && modelById.has(modParam)) {
        selectedModel = modParam;
        modelCombo.setValue(modParam);
        hadParam = true;
      }
      if (stParam) {
        const normStatus = stParam === 'Smooth' ? 'Fits' : stParam;
        if (['Fits', 'Tight Fit', 'Partial Offload', 'OOM'].includes(normStatus)) {
          selectedStatus = normStatus;
          updateStatusPills();
          hadParam = true;
        }
      }
      if (sortParam && sortSelect && Array.from(sortSelect.options).some((o) => o.value === sortParam)) {
        sortSelect.value = sortParam;
        hadParam = true;
      }
      if (resParam === 'clean' || resParam === 'custom') {
        reserveProfile = resParam;
        hadParam = true;
      }
      if (customGbParam) {
        const parsedCustom = Number(customGbParam);
        if (Number.isFinite(parsedCustom) && parsedCustom > 0 && parsedCustom <= 512) {
          customUsableGb = parsedCustom;
          reserveProfile = 'custom';
          hadParam = true;
        }
      }

      // Reflect hydrated CPU / RAM / GPU state into comboboxes
      const activeSoc = getActiveUnifiedSoc();
      if (activeSoc) {
        cpuCombo.setValue(selectedCpuVal);
        const effRam = selectedRamGb ?? activeSoc.defaultRamGb;
        selectedRamGb = effRam;
        ramCombo.setOptions(buildRamOptions(activeSoc), false);
        ramCombo.setValue(String(effRam), `${effRam} GB`);
        selectedGpuVal = '';
        gpuCombo.setDisplayOverride(t('home.noneUnifiedAuto'), true, false);
      } else {
        if (selectedCpuVal) cpuCombo.setValue(selectedCpuVal);
        if (selectedRamGb !== null) {
          ramCombo.setValue(String(selectedRamGb), `${selectedRamGb} GB`);
        }
        if (selectedGpuVal) {
          gpuCombo.setValue(selectedGpuVal);
        }
      }

      if (!hadParam && qParam) {
        hadParam = applyLegacyQueryFallback(qParam);
      }

      syncGpuQtyControl();
      updateReserveUi();
      updateContextBar();
      if (hadParam) {
        applyFilters(true);
      } else if (getLocale() !== 'en') {
        applyFilters(false);
      }
    }

    function resetAll() {
      selectedCpuVal = '';
      selectedRamGb = null;
      selectedGpuVal = '';
      gpuCount = 1;
      splitMode = 'layer';
      reserveProfile = 'desktop';
      customUsableGb = null;
      selectedModel = 'all';
      selectedStatus = 'all';
      if (customGbInput) customGbInput.value = '';

      cpuCombo.clear(true);
      ramCombo.setOptions(buildRamOptions(null), false);
      ramCombo.clear(true);
      gpuCombo.clear(true);
      modelCombo.setValue('all');
      if (sortSelect) sortSelect.value = 'featured';

      syncGpuQtyControl();
      updateReserveUi();
      updateContextBar();
      updateStatusPills();
      applyFilters(true);
    }

    reserveBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = (btn.getAttribute('data-home-reserve') as ReserveProfile) || 'desktop';
        reserveProfile = val;
        if (val === 'custom' && customUsableGb === null) {
          const typed = customGbInput ? Number(customGbInput.value) : NaN;
          customUsableGb = Number.isFinite(typed) && typed > 0 ? typed : 22.4;
        }
        updateReserveUi();
        applyFilters(true);
        if (val === 'custom' && customGbInput) customGbInput.focus();
      });
    });

    if (customGbInput) {
      customGbInput.addEventListener('input', () => {
        const val = Number(customGbInput.value);
        if (Number.isFinite(val) && val > 0 && val <= 512) {
          customUsableGb = val;
          reserveProfile = 'custom';
          updateReserveUi();
          applyFilters(true);
        }
      });
    }

    if (gpuCountSelect) {
      gpuCountSelect.addEventListener('change', () => {
        const val = Number(gpuCountSelect.value || 1);
        gpuCount = Math.max(1, val);
        updateContextBar();
        applyFilters(true);
      });
    }

    splitBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        splitMode = (btn.getAttribute('data-home-split') as SplitMode) || 'layer';
        updateContextBar();
        applyFilters(true);
      });
    });

    if (sortSelect) sortSelect.addEventListener('change', () => applyFilters(true));
    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        visibleLimit += PAGE_SIZE;
        applyFilters(false);
      });
    }

    if (showAllBtn) {
      showAllBtn.addEventListener('click', () => {
        visibleLimit = totalCurated;
        applyFilters(false);
      });
    }

    let hwHighlightTimer: number | null = null;
    if (modeSelectBtn) {
      modeSelectBtn.addEventListener('click', () => {
        rigConfigPanel?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        const cpuInput = cpuRoot?.querySelector('input');
        const gpuInput = gpuRoot?.querySelector('input');
        const targets = [cpuInput, gpuInput].filter((el): el is HTMLInputElement => Boolean(el));
        targets.forEach((el) => {
          el.classList.add('ring-2', 'ring-blue-500/70', 'border-blue-500');
        });
        if (hwHighlightTimer !== null) window.clearTimeout(hwHighlightTimer);
        hwHighlightTimer = window.setTimeout(() => {
          targets.forEach((el) => {
            el.classList.remove('ring-2', 'ring-blue-500/70', 'border-blue-500');
          });
          hwHighlightTimer = null;
        }, 1400);
      });
    }

    if (liveLoadMoreBtn) {
      liveLoadMoreBtn.addEventListener('click', () => {
        liveVisibleLimit += PAGE_SIZE;
        applyFilters(false);
      });
    }

    statusButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedStatus = btn.getAttribute('data-status-btn') || 'all';
        updateStatusPills();
        applyFilters(true);
      });
    });

    document.addEventListener('keydown', (ev) => {
      if (ev.key === '/' && !ev.metaKey && !ev.ctrlKey && !ev.altKey) {
        const tag = document.activeElement ? document.activeElement.tagName : '';
        if (!['INPUT', 'SELECT', 'TEXTAREA'].includes(tag)) {
          ev.preventDefault();
          gpuCombo.focus();
        }
      }
    });

    onLocaleChange(() => {
      cpuCombo.setOptions(buildCpuOptions(), true);
      cpuCombo.setPlaceholder(t('home.cpuPlaceholder'));
      cpuCombo.setEmptyText(t('home.cpuEmpty'));
      cpuCombo.setCascaderLabels({
        searchPlaceholder: t('cb.searchCpuPh'),
        brandHeader: t('cb.brandCol'),
        seriesHeader: t('cb.seriesCol'),
        modelHeader: t('cb.modelCol'),
        allBrandsLabel: (n) => t('cb.allBrands', { count: n }),
        allSeriesLabel: (n) => t('cb.allSeries', { count: n }),
        itemsCountFormatter: (n) => t('cb.countItems', { count: n }),
      });
      if (selectedCpuVal) cpuCombo.setValue(selectedCpuVal);

      ramCombo.setOptions(buildRamOptions(getActiveUnifiedSoc()), true);
      ramCombo.setPlaceholder(t('home.ramPlaceholder'));
      ramCombo.setEmptyText(t('home.ramEmpty'));
      ramCombo.setCustomActionFormatter((n) => t('home.customRamUse', { ram: n }));
      if (selectedRamGb !== null) ramCombo.setValue(String(selectedRamGb), `${selectedRamGb} GB`);

      gpuCombo.setOptions(buildGpuOptions(), true);
      gpuCombo.setPlaceholder(t('home.gpuPlaceholder'));
      gpuCombo.setEmptyText(t('home.gpuEmpty'));
      gpuCombo.setCascaderLabels({
        searchPlaceholder: t('cb.searchGpuPh'),
        brandHeader: t('cb.brandCol'),
        seriesHeader: t('cb.seriesCol'),
        modelHeader: t('cb.modelCol'),
        allBrandsLabel: (n) => t('cb.allBrands', { count: n }),
        allSeriesLabel: (n) => t('cb.allSeries', { count: n }),
        itemsCountFormatter: (n) => t('cb.countItems', { count: n }),
      });
      if (getActiveUnifiedSoc()) {
        gpuCombo.setDisplayOverride(t('home.noneUnifiedAuto'), true, false);
      } else if (selectedGpuVal) {
        gpuCombo.setValue(selectedGpuVal);
      }

      modelCombo.setOptions(buildModelOptions(), true);
      modelCombo.setPlaceholder(t('home.allModels', { count: catData.models.length }));
      modelCombo.setEmptyText(t('home.modelEmpty'));
      modelCombo.setValue(selectedModel);

      syncGpuQtyControl();
      updateContextBar();
      applyFilters(false);
    });

    syncGpuQtyControl();
    updateReserveUi();
    hydrateFromUrl();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMatrixPage);
  } else {
    initMatrixPage();
  }
</script>
