    <section class="surface-card mt-10 p-6 sm:p-7" aria-labelledby="bottleneck-heading">
      <h2 id="bottleneck-heading" class="text-xl font-bold tracking-tight text-[var(--ink-primary)]" data-i18n="detail.bottleneckTitle">
        Context Window &amp; Memory Bottleneck Analysis
      </h2>

      <dl class="mt-4 grid gap-3 sm:grid-cols-3">
        <div class="surface-inset px-4 py-3">
          <dt class="text-xs font-medium text-[var(--ink-tertiary)]" data-i18n="detail.kvPer4k">KV Cache per 4K Tokens (FP16)</dt>
          <dd class="mt-1 font-mono text-lg font-bold text-[var(--ink-primary)] tabular-nums">
            +{context_analysis.kv_gb_per_4k.toFixed(2)} GB / 4K
          </dd>
        </div>
        <div class="surface-inset px-4 py-3">
          <dt class="text-xs font-medium text-[var(--ink-tertiary)]" data-i18n="detail.maxSmoothCtx">Max Fit Context (Q4_K_M)</dt>
          <dd class="mt-1 font-mono text-lg font-bold text-[var(--ink-primary)] tabular-nums">
            {maxFitCtxLabel}
          </dd>
          {hasMaxFitSpeed && (
            <div class="mt-1 font-mono text-[11px] font-semibold text-[var(--ink-secondary)] tabular-nums">
              {maxFitSpeedSubline}
            </div>
          )}
        </div>
        <div class="surface-inset px-4 py-3">
          <dt class="text-xs font-medium text-[var(--ink-tertiary)]" data-i18n="detail.hwMemBus">Hardware Memory Bus</dt>
          <dd class="mt-1 font-mono text-lg font-bold text-[var(--ink-primary)] tabular-nums">
            {hardware.bandwidth_gbps} GB/s
          </dd>
        </div>
      </dl>

      <p class="mt-5 text-sm leading-relaxed text-[var(--ink-secondary)]">
        {context_analysis.bottleneck_summary}
      </p>

      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="surface-inset p-4">
          <h3 class="text-sm font-bold text-[var(--ink-primary)]" data-i18n="detail.keySignals">Key Bottleneck Signals</h3>
          <ul class="mt-2.5 space-y-2 text-sm text-[var(--ink-secondary)]">
            {context_analysis.key_points.map((pt) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
                <span>{pt}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="surface-inset p-4">
          <h3 class="text-sm font-bold text-[var(--ink-primary)]" data-i18n="detail.recOpts">Recommended Optimizations</h3>
          <ul class="mt-2.5 space-y-2 text-sm text-[var(--ink-secondary)]">
            {context_analysis.optimization_tips.map((tip) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-xl font-bold tracking-tight text-[var(--ink-primary)]" data-i18n="detail.faqTitle">
        Frequently Asked Questions
      </h2>
      <div class="mt-4 space-y-3">
        {faq.map((item, idx) => (
          <details
            open={idx < 2}
            class="surface-card group px-5 py-4 open:border-[var(--accent-border)]"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-[var(--ink-primary)]">
              <span>{item.question}</span>
              <span class="shrink-0 font-mono text-[var(--ink-tertiary)] group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-[var(--ink-secondary)]">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

    {recommendedLinks.length > 0 && (
      <section class="mt-12 border-t border-[var(--border-subtle)] pt-8" aria-labelledby="related-heading">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 id="related-heading" class="text-xl font-bold tracking-tight text-[var(--ink-primary)]" data-i18n="detail.relatedTitle">
              Compare Related Hardware &amp; Models
            </h2>
            <p class="mt-1 text-sm text-[var(--ink-secondary)]">
              {model.short_name} · {hardware.short_name}
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-2 shrink-0">
            <a
              href={gpuHubHref}
              class="btn-secondary rounded-full px-3 py-1 text-xs font-semibold"
              data-i18n="detail.retAllHw"
              data-i18n-args={retAllHwArgs}
            >
              All {hardware.short_name} -&gt;
            </a>
            <a
              href={modelHubHref}
              class="btn-secondary rounded-full px-3 py-1 text-xs font-semibold"
              data-i18n="detail.retAllModel"
              data-i18n-args={retAllModelArgs}
            >
              All {model.short_name} -&gt;
            </a>
            <a href="/" class="text-xs font-semibold text-[var(--accent-ink)] hover:underline ml-1" data-i18n="detail.viewFullMatrix">
              View Full Matrix -&gt;
            </a>
          </div>
        </div>

        <div class="mt-4 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
          {recommendedLinks.map((rel) => {
            const relHref = `/can-i-run/${rel.slug}/`;
            const rRes = rel.default_result;
            const relTps = formatTpsRange(rRes.est_tps_low, rRes.est_tps_high, rRes.est_tps, rRes.status);
            const relTier = rRes.speed_tier ?? classifySpeedTier(rRes.est_tps, rRes.status);
            const relHwArgs = JSON.stringify({ hw: rel.hardware.short_name });
            return (
              <a
                href={relHref}
                class="surface-card-interactive flex flex-col justify-between p-4"
              >
                <div>
                  <div class="flex flex-wrap items-center justify-between gap-1.5">
                    <div class="flex items-center gap-1">
                      <StatusBadge status={rRes.status} />
                      <SpeedBadge tier={relTier} />
                    </div>
                    <span class="font-mono text-xs text-[var(--ink-tertiary)] tabular-nums">
                      {rRes.total_vram_gb.toFixed(1)} GB
                    </span>
                  </div>
                  <p class="mt-2.5 text-sm font-bold text-[var(--ink-primary)]">
                    {rel.model.short_name}{' '}
                    <span data-i18n="common.onPrefix" data-i18n-args={relHwArgs}>on {rel.hardware.short_name}</span>
                  </p>
                </div>
                <div class="mt-3 flex items-center justify-between text-xs text-[var(--ink-secondary)]">
                  <span class="font-mono tabular-nums">{relTps}</span>
                  <span class="font-semibold text-[var(--accent-ink)]" data-i18n="common.compare">Compare -&gt;</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
