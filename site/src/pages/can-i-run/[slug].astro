---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import VramCalculator from '../../components/VramCalculator.astro';
import rawPagesData from '../../data/pages_data.json';
import type { PageEntry } from '../../types/vram';
import { formatContextLabel } from '../../utils/physics';

export function getStaticPaths() {
  const allEntries = rawPagesData as PageEntry[];
  return allEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, allEntries },
  }));
}

interface Props {
  entry: PageEntry;
  allEntries: PageEntry[];
}

const { entry, allEntries } = Astro.props;
const { model, hardware, default_result: res, quant_table, commands, context_analysis, faq } = entry;

const entryBySlug = new Map(allEntries.map((e) => [e.slug, e]));

const sameModelEntries = allEntries.filter(
  (e) => e.model.id === model.id && e.slug !== entry.slug
);
const sameHwEntries = allEntries.filter(
  (e) => e.hardware.id === hardware.id && e.slug !== entry.slug
);

const relatedPool: PageEntry[] = [];
const seen = new Set<string>([entry.slug]);

for (const candidate of [...sameModelEntries, ...sameHwEntries]) {
  if (!seen.has(candidate.slug)) {
    seen.add(candidate.slug);
    relatedPool.push(candidate);
  }
}

for (const slug of entry.related_slugs) {
  const target = entryBySlug.get(slug);
  if (target && !seen.has(target.slug)) {
    seen.add(target.slug);
    relatedPool.push(target);
  }
}

for (const fallback of allEntries) {
  if (relatedPool.length >= 6) break;
  if (!seen.has(fallback.slug)) {
    seen.add(fallback.slug);
    relatedPool.push(fallback);
  }
}

const recommendedLinks = relatedPool.slice(0, 6);

const maxSmoothCtxLabel =
  context_analysis.max_smooth_context_q4 > 0
    ? formatContextLabel(context_analysis.max_smooth_context_q4)
    : 'N/A (Exceeds Usable VRAM)';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `${model.name} on ${hardware.name} VRAM Calculator`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: hardware.is_unified ? 'macOS' : 'Linux, Windows',
  url: `https://vramcalc.me/can-i-run/${entry.slug}/`,
  description: entry.meta_description,
};
---

<BaseLayout
  title={entry.title}
  description={entry.meta_description}
  canonicalPath={`/can-i-run/${entry.slug}/`}
  totalPages={allEntries.length}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  </Fragment>

  <article class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs font-medium text-slate-500">
      <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/" class="hover:text-slate-900 transition-colors">{model.family}</a>
      <span aria-hidden="true">/</span>
      <span class="text-slate-900 truncate">{model.short_name} on {hardware.short_name}</span>
    </nav>

    <!-- Page Header -->
    <header class="mt-4">
      <div class="flex flex-wrap items-center gap-2.5">
        <StatusBadge status={res.status} size="md" />
        <span class="rounded-full border border-slate-200 bg-white px-2.5 py-0.5 font-mono text-xs font-medium text-slate-600">
          {hardware.backend} · {hardware.memory_type}
        </span>
        <span class="rounded-full border border-slate-200 bg-white px-2.5 py-0.5 font-mono text-xs font-medium text-slate-600">
          {model.params_b}B Params · {model.num_layers} Layers
        </span>
      </div>

      <h1 class="mt-3.5 text-2xl font-extrabold tracking-tight text-slate-950 sm:text-4xl">
        Can I Run {model.name} on {hardware.name}?
      </h1>

      <p class="mt-3 max-w-3xl text-base leading-relaxed text-slate-700">
        {entry.verdict_summary}
      </p>

      <div class="mt-4 flex flex-wrap gap-2 text-xs text-slate-600">
        <span class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 font-mono">
          Hardware Budget: <strong class="text-slate-950">{hardware.usable_vram_gb} GB</strong> / {hardware.vram_gb} GB
        </span>
        <span class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 font-mono">
          Bandwidth: <strong class="text-slate-950">{hardware.bandwidth_gbps} GB/s</strong>
        </span>
        <span class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 font-mono">
          GQA KV Geometry: <strong class="text-slate-950">{model.num_kv_heads} heads × {model.head_dim} dim</strong>
        </span>
      </div>
    </header>

    <!-- Top Interactive Pure-JS Estimator -->
    <div class="mt-7">
      <VramCalculator entry={entry} />
    </div>

    <!-- Quantization Comparison Table -->
    <section class="mt-10" aria-labelledby="quant-table-heading">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 id="quant-table-heading" class="text-xl font-bold tracking-tight text-slate-950">
            Quantization Comparison Table (8K Context)
          </h2>
          <p class="mt-1 text-sm text-slate-600">
            Static GGUF footprint breakdown across Q4_K_M through FP16 on {hardware.short_name}.
          </p>
        </div>
        <span class="text-xs font-mono text-slate-500">KV Cache @ 8K FP16</span>
      </div>

      <div class="mt-4 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-xs">
        <table class="w-full min-w-[760px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50 text-xs font-semibold uppercase tracking-wider text-slate-500">
              <th class="px-4 py-3">Quant</th>
              <th class="px-4 py-3">Weights</th>
              <th class="px-4 py-3">Total VRAM (8K)</th>
              <th class="px-4 py-3">GPU Layers</th>
              <th class="px-4 py-3">Est. Speed</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Practical Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {quant_table.map((row) => {
              const rowClass = row.recommended ? 'bg-blue-50/40' : 'hover:bg-slate-50/70';
              const rowTps = row.status === 'OOM' ? 'OOM' : `${row.est_tps.toFixed(1)} tok/s`;
              return (
              <tr class={rowClass}>
                <td class="px-4 py-3.5 align-top">
                  <div class="flex items-center gap-2">
                    <span class="font-mono font-bold text-slate-950">{row.quant}</span>
                    {row.recommended && (
                      <span class="rounded-full bg-blue-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">
                        Recommended
                      </span>
                    )}
                  </div>
                  <div class="mt-0.5 text-xs text-slate-500">{row.bits_per_weight} bpw</div>
                </td>
                <td class="px-4 py-3.5 align-top font-mono text-slate-800 tabular-nums">
                  {row.weights_gb.toFixed(2)} GB
                </td>
                <td class="px-4 py-3.5 align-top font-mono font-semibold text-slate-950 tabular-nums">
                  {row.total_vram_8k_gb.toFixed(2)} GB
                </td>
                <td class="px-4 py-3.5 align-top font-mono text-slate-700 tabular-nums">
                  {row.gpu_layers_fit}/{row.total_layers}
                </td>
                <td class="px-4 py-3.5 align-top font-mono font-semibold text-slate-900 tabular-nums">
                  {rowTps}
                </td>
                <td class="px-4 py-3.5 align-top">
                  <StatusBadge status={row.status} />
                </td>
                <td class="px-4 py-3.5 align-top text-xs leading-relaxed text-slate-600 max-w-xs">
                  {row.notes}
                </td>
              </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- One-Click Copy Launch Commands -->
    <section class="mt-10" aria-labelledby="commands-heading">
      <h2 id="commands-heading" class="text-xl font-bold tracking-tight text-slate-950">
        One-Click Launch Commands (Ollama &amp; llama.cpp)
      </h2>
      <p class="mt-1 text-sm text-slate-600">
        Pre-tuned flags for {hardware.name} using optimal <span class="font-mono text-slate-900">-ngl {commands.recommended_ngl}</span> and
        <span class="font-mono text-slate-900">{formatContextLabel(commands.recommended_ctx)}</span> context.
      </p>

      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        <!-- Ollama Card -->
        <div class="flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-950 p-5 text-slate-100">
          <div>
            <div class="flex items-center justify-between gap-2 border-b border-slate-800 pb-3">
              <div>
                <span class="font-mono text-sm font-bold text-white">Ollama</span>
                <span class="ml-2 text-xs text-slate-400">Quick Run &amp; Tuned Env</span>
              </div>
              <button
                type="button"
                data-copy-target="cmd-ollama-env"
                class="rounded-lg border border-slate-700 bg-slate-800 px-3 py-1 text-xs font-semibold text-slate-200 hover:bg-slate-700 transition-colors cursor-pointer"
              >
                Copy Env Command
              </button>
            </div>

            <div class="mt-3.5 space-y-3">
              <div>
                <div class="flex items-center justify-between text-[11px] uppercase tracking-wider text-slate-400">
                  <span>Standard Run</span>
                  <button
                    type="button"
                    data-copy-target="cmd-ollama-basic"
                    class="font-semibold text-blue-400 hover:text-blue-300 cursor-pointer"
                  >
                    Copy
                  </button>
                </div>
                <pre id="cmd-ollama-basic" class="mt-1 overflow-x-auto rounded-lg bg-slate-900 p-3 font-mono text-xs text-emerald-300">{commands.ollama_run}</pre>
              </div>

              <div>
                <div class="text-[11px] uppercase tracking-wider text-slate-400">
                  Flash Attention + Q8_0 KV Cache ({formatContextLabel(commands.recommended_ctx)})
                </div>
                <pre id="cmd-ollama-env" class="mt-1 overflow-x-auto rounded-lg bg-slate-900 p-3 font-mono text-xs text-sky-300 whitespace-pre-wrap break-all">{commands.ollama_env_cmd}</pre>
              </div>
            </div>
          </div>
        </div>

        <!-- llama.cpp Card -->
        <div class="flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-950 p-5 text-slate-100">
          <div>
            <div class="flex items-center justify-between gap-2 border-b border-slate-800 pb-3">
              <div>
                <span class="font-mono text-sm font-bold text-white">llama.cpp</span>
                <span class="ml-2 text-xs text-slate-400">CLI &amp; OpenAI Server</span>
              </div>
              <button
                type="button"
                data-copy-target="cmd-llama-cli"
                class="rounded-lg border border-slate-700 bg-slate-800 px-3 py-1 text-xs font-semibold text-slate-200 hover:bg-slate-700 transition-colors cursor-pointer"
              >
                Copy llama-cli
              </button>
            </div>

            <div class="mt-3.5 space-y-3">
              <div>
                <div class="text-[11px] uppercase tracking-wider text-slate-400">
                  Interactive Terminal (`llama-cli`)
                </div>
                <pre id="cmd-llama-cli" class="mt-1 overflow-x-auto rounded-lg bg-slate-900 p-3 font-mono text-xs text-emerald-300">{commands.llama_cli}</pre>
              </div>

              <div>
                <div class="flex items-center justify-between text-[11px] uppercase tracking-wider text-slate-400">
                  <span>Local API Server (`llama-server`)</span>
                  <button
                    type="button"
                    data-copy-target="cmd-llama-server"
                    class="font-semibold text-blue-400 hover:text-blue-300 cursor-pointer"
                  >
                    Copy
                  </button>
                </div>
                <pre id="cmd-llama-server" class="mt-1 overflow-x-auto rounded-lg bg-slate-900 p-3 font-mono text-xs text-sky-300">{commands.llama_server}</pre>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Context Bottleneck & Optimization Analysis -->
    <section class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 sm:p-7" aria-labelledby="bottleneck-heading">
      <h2 id="bottleneck-heading" class="text-xl font-bold tracking-tight text-slate-950">
        Context Window &amp; Memory Bottleneck Analysis
      </h2>

      <dl class="mt-4 grid gap-3 sm:grid-cols-3">
        <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
          <dt class="text-xs font-medium text-slate-500">KV Cache per 4K Tokens (FP16)</dt>
          <dd class="mt-1 font-mono text-lg font-bold text-slate-950 tabular-nums">
            +{context_analysis.kv_gb_per_4k.toFixed(2)} GB / 4K
          </dd>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
          <dt class="text-xs font-medium text-slate-500">Max Smooth Context (Q4_K_M)</dt>
          <dd class="mt-1 font-mono text-lg font-bold text-slate-950 tabular-nums">
            {maxSmoothCtxLabel}
          </dd>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
          <dt class="text-xs font-medium text-slate-500">Hardware Memory Bus</dt>
          <dd class="mt-1 font-mono text-lg font-bold text-slate-950 tabular-nums">
            {hardware.bandwidth_gbps} GB/s
          </dd>
        </div>
      </dl>

      <p class="mt-5 text-sm leading-relaxed text-slate-700">
        {context_analysis.bottleneck_summary}
      </p>

      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
          <h3 class="text-sm font-bold text-slate-950">Key Bottleneck Signals</h3>
          <ul class="mt-2.5 space-y-2 text-sm text-slate-700">
            {context_analysis.key_points.map((pt) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-600" aria-hidden="true"></span>
                <span>{pt}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
          <h3 class="text-sm font-bold text-slate-950">Recommended Optimizations</h3>
          <ul class="mt-2.5 space-y-2 text-sm text-slate-700">
            {context_analysis.optimization_tips.map((tip) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-600" aria-hidden="true"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Dedicated FAQ -->
    <section class="mt-10" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-xl font-bold tracking-tight text-slate-950">
        Frequently Asked Questions
      </h2>
      <div class="mt-4 space-y-3">
        {faq.map((item, idx) => (
          <details
            open={idx < 2}
            class="group rounded-xl border border-slate-200 bg-white px-5 py-4 open:border-blue-200"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-950">
              <span>{item.question}</span>
              <span class="shrink-0 font-mono text-slate-400 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- Internal Linking Recommendations -->
    {recommendedLinks.length > 0 && (
      <section class="mt-12 border-t border-slate-200 pt-8" aria-labelledby="related-heading">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 id="related-heading" class="text-xl font-bold tracking-tight text-slate-950">
              Compare Related Hardware &amp; Models
            </h2>
            <p class="mt-1 text-sm text-slate-600">
              Explore alternative GPUs for {model.short_name} or other open-weight models benchmarked on {hardware.short_name}.
            </p>
          </div>
          <a href="/" class="text-xs font-semibold text-blue-600 hover:text-blue-800 shrink-0">
            View Full Matrix -&gt;
          </a>
        </div>

        <div class="mt-4 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
          {recommendedLinks.map((rel) => {
            const relHref = `/can-i-run/${rel.slug}/`;
            const relTps =
              rel.default_result.status === 'OOM'
                ? 'OOM'
                : `${rel.default_result.est_tps.toFixed(1)} tok/s`;
            return (
            <a
              href={relHref}
              class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-4 hover:border-blue-300 hover:shadow-sm transition-all"
            >
              <div>
                <div class="flex items-center justify-between gap-2">
                  <StatusBadge status={rel.default_result.status} />
                  <span class="font-mono text-xs text-slate-500 tabular-nums">
                    {rel.default_result.total_vram_gb.toFixed(1)} GB
                  </span>
                </div>
                <p class="mt-2.5 text-sm font-bold text-slate-950">
                  {rel.model.short_name} on {rel.hardware.short_name}
                </p>
              </div>
              <div class="mt-3 flex items-center justify-between text-xs text-slate-600">
                <span class="font-mono tabular-nums">
                  {relTps}
                </span>
                <span class="font-semibold text-blue-600">Compare -&gt;</span>
              </div>
            </a>
            );
          })}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script is:inline>
  (function () {
    function copyText(text) {
      if (navigator.clipboard && window.isSecureContext) {
        return navigator.clipboard.writeText(text);
      }
      return new Promise((resolve, reject) => {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        try {
          document.execCommand('copy');
          document.body.removeChild(ta);
          resolve();
        } catch (err) {
          document.body.removeChild(ta);
          reject(err);
        }
      });
    }

    document.querySelectorAll('[data-copy-target]').forEach((btn) => {
      const originalLabel = btn.textContent || 'Copy';
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-copy-target');
        const el = targetId ? document.getElementById(targetId) : null;
        if (!el) return;
        const text = (el.textContent || '').trim();
        copyText(text).then(() => {
          btn.textContent = 'Copied ✓';
          btn.classList.add('text-emerald-300');
          setTimeout(() => {
            btn.textContent = originalLabel;
            btn.classList.remove('text-emerald-300');
          }, 1600);
        });
      });
    });
  })();
</script>
