---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import VramCalculator from '../../components/VramCalculator.astro';
import rawPagesData from '../../data/pages_data.json';
import type { PageEntry } from '../../types/vram';
import { formatContextLabel } from '../../utils/physics';

export function getStaticPaths() {
  const allEntries = rawPagesData as PageEntry[];
  return allEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, allEntries },
  }));
}

interface Props {
  entry: PageEntry;
  allEntries: PageEntry[];
}

const { entry, allEntries } = Astro.props;
const { model, hardware, default_result: res, quant_table, commands, context_analysis, faq } = entry;

const entryBySlug = new Map(allEntries.map((e) => [e.slug, e]));

const sameModelEntries = allEntries.filter(
  (e) => e.model.id === model.id && e.slug !== entry.slug
);
const sameHwEntries = allEntries.filter(
  (e) => e.hardware.id === hardware.id && e.slug !== entry.slug
);

const relatedPool: PageEntry[] = [];
const seen = new Set<string>([entry.slug]);

for (const candidate of [...sameModelEntries, ...sameHwEntries]) {
  if (!seen.has(candidate.slug)) {
    seen.add(candidate.slug);
    relatedPool.push(candidate);
  }
}

for (const slug of entry.related_slugs) {
  const target = entryBySlug.get(slug);
  if (target && !seen.has(target.slug)) {
    seen.add(target.slug);
    relatedPool.push(target);
  }
}

for (const fallback of allEntries) {
  if (relatedPool.length >= 6) break;
  if (!seen.has(fallback.slug)) {
    seen.add(fallback.slug);
    relatedPool.push(fallback);
  }
}

const recommendedLinks = relatedPool.slice(0, 6);

const maxSmoothCtxLabel =
  context_analysis.max_smooth_context_q4 > 0
    ? formatContextLabel(context_analysis.max_smooth_context_q4)
    : 'N/A (Exceeds Usable VRAM)';

const showRetentionPanel = res.status === 'OOM' || res.status === 'Partial Offload';
const isOom = res.status === 'OOM';

const smoothSameHw = sameHwEntries
  .filter((e) => e.default_result.status === 'Smooth')
  .sort((a, b) => {
    if (b.model.params_b !== a.model.params_b) return b.model.params_b - a.model.params_b;
    return b.default_result.est_tps - a.default_result.est_tps;
  })
  .slice(0, 3);

const smoothSameModel = sameModelEntries.filter((e) => e.default_result.status === 'Smooth');

interface UpgradeHwPick {
  role: string;
  entry: PageEntry;
}

const upgradeHwPicks: UpgradeHwPick[] = [];
const pickedUpgradeSlugs = new Set<string>();

if (smoothSameModel.length > 0) {
  const affordablePick = [...smoothSameModel].sort((a, b) => {
    if (a.hardware.msrp_usd !== b.hardware.msrp_usd) {
      return a.hardware.msrp_usd - b.hardware.msrp_usd;
    }
    return b.default_result.est_tps - a.default_result.est_tps;
  })[0];
  if (affordablePick) {
    pickedUpgradeSlugs.add(affordablePick.slug);
    upgradeHwPicks.push({ role: 'Most Affordable Smooth', entry: affordablePick });
  }

  const fastestPick = [...smoothSameModel].sort(
    (a, b) => b.default_result.est_tps - a.default_result.est_tps
  )[0];
  if (fastestPick && !pickedUpgradeSlugs.has(fastestPick.slug)) {
    pickedUpgradeSlugs.add(fastestPick.slug);
    upgradeHwPicks.push({ role: 'Fastest Smooth', entry: fastestPick });
  }

  const unifiedPick = [...smoothSameModel]
    .filter((e) => e.hardware.is_unified)
    .sort((a, b) => b.default_result.est_tps - a.default_result.est_tps)[0];
  if (unifiedPick && !pickedUpgradeSlugs.has(unifiedPick.slug)) {
    pickedUpgradeSlugs.add(unifiedPick.slug);
    upgradeHwPicks.push({ role: 'Unified Memory Smooth', entry: unifiedPick });
  }

  for (const extra of [...smoothSameModel].sort(
    (a, b) => b.default_result.est_tps - a.default_result.est_tps
  )) {
    if (upgradeHwPicks.length >= 3) break;
    if (!pickedUpgradeSlugs.has(extra.slug)) {
      pickedUpgradeSlugs.add(extra.slug);
      upgradeHwPicks.push({ role: 'Runner-Up Smooth', entry: extra });
    }
  }
}

const retentionWrapClass = isOom
  ? 'mt-8 rounded-2xl border border-rose-200 bg-rose-50/60 p-5 sm:p-6'
  : 'mt-8 rounded-2xl border border-amber-200 bg-amber-50/50 p-5 sm:p-6';
const retentionBadgeClass = isOom
  ? 'inline-flex items-center rounded-full border border-rose-200 bg-white px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-rose-700'
  : 'inline-flex items-center rounded-full border border-amber-200 bg-white px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-amber-800';
const retentionHeadline = isOom
  ? `Out of Memory on ${hardware.short_name}: Smooth Alternatives & Upgrades`
  : `PCIe Offload Bottleneck (${res.gpu_layers_fit}/${res.total_layers} GPU Layers): Smooth Alternatives`;
const retentionLead = isOom
  ? `${model.short_name} needs ${res.total_vram_gb.toFixed(2)} GB at 8K Q4_K_M vs ${hardware.usable_vram_gb} GB usable on ${hardware.short_name}. Pick a smaller Smooth model on this GPU or upgrade hardware below:`
  : `Running ${model.short_name} on ${hardware.short_name} spills weights to system RAM (~${res.est_tps.toFixed(1)} tok/s). For 100% full-speed GPU residency without offloading, consider these verified Smooth options:`;

const themeColor =
  res.status === 'Smooth' ? '#10b981' : res.status === 'Partial Offload' ? '#f59e0b' : '#f43f5e';
const ogSpeedSnippet = res.status === 'OOM' ? 'OOM' : `${res.est_tps.toFixed(1)} tok/s`;
const ogTitle = `${model.short_name} on ${hardware.short_name}: ${res.status} (${ogSpeedSnippet})`;
const ogDescription = `${res.status} @ Q4_K_M 8K: ${res.total_vram_gb.toFixed(2)}/${hardware.usable_vram_gb} GB usable (${res.gpu_layers_fit}/${res.total_layers} layers). Max Smooth Q4 context: ${maxSmoothCtxLabel}. Ollama & llama.cpp flags inside.`;
const ogImage = `/og/run-${entry.slug}.png`;
const shareUrl = `https://vramcalc.me/can-i-run/${entry.slug}/`;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const gpuHubHref = `/gpu/${hardware.id}/`;
const modelHubHref = `/model/${model.id}/`;

const detailTitleArgs = JSON.stringify({ model: model.name, hw: hardware.name });
const detailModelHubArgs = JSON.stringify({ model: model.short_name });
const detailOnHwArgs = JSON.stringify({ hw: hardware.short_name });
const retBadgeI18nKey = isOom ? 'detail.retFixes' : 'detail.retAlts';
const retSmoothModelsArgs = JSON.stringify({ hw: hardware.short_name });
const retAllHwArgs = JSON.stringify({ hw: hardware.short_name });
const retGpusSmoothArgs = JSON.stringify({ model: model.short_name });
const retAllModelArgs = JSON.stringify({ model: model.short_name });
const retExploreHwArgs = JSON.stringify({ hw: hardware.short_name });
const retCompareSmoothArgs = JSON.stringify({ count: smoothSameModel.length });
const quantTableSubArgs = JSON.stringify({ hw: hardware.short_name });

const gpuBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://vramcalc.me/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'All GPUs',
      item: 'https://vramcalc.me/gpu/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: hardware.short_name,
      item: `https://vramcalc.me${gpuHubHref}`,
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: `${model.short_name} on ${hardware.short_name}`,
      item: `https://vramcalc.me/can-i-run/${entry.slug}/`,
    },
  ],
};

const modelBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://vramcalc.me/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'All Models',
      item: 'https://vramcalc.me/model/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: model.short_name,
      item: `https://vramcalc.me${modelHubHref}`,
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: `${model.short_name} on ${hardware.short_name}`,
      item: `https://vramcalc.me/can-i-run/${entry.slug}/`,
    },
  ],
};

const appOs =
  hardware.vendor === 'Apple'
    ? 'macOS'
    : hardware.id.includes('dgx-spark')
      ? 'Linux (DGX OS)'
      : 'Linux, Windows';

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `${model.name} on ${hardware.name} VRAM Calculator`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: appOs,
  url: `https://vramcalc.me/can-i-run/${entry.slug}/`,
  description: entry.meta_description,
};
---

<BaseLayout
  title={entry.title}
  description={entry.meta_description}
  canonicalPath={`/can-i-run/${entry.slug}/`}
  totalPages={allEntries.length}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  ogImageAlt={ogTitle}
  themeColor={themeColor}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(gpuBreadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(modelBreadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  </Fragment>

  <article class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <!-- Dual-Taxonomy Breadcrumb Bar -->
    <div class="flex flex-wrap items-center justify-between gap-2">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1.5 text-xs font-medium text-slate-500">
          <li>
            <a href="/" class="hover:text-slate-900 transition-colors" data-i18n="common.home">Home</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/gpu/" class="hover:text-slate-900 transition-colors" data-i18n="nav.gpus">All GPUs</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href={gpuHubHref} class="hover:text-slate-900 transition-colors">{hardware.short_name}</a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-slate-900 font-semibold truncate">
            {model.short_name} <span data-i18n="common.onPrefix" data-i18n-args={detailOnHwArgs}>on {hardware.short_name}</span>
          </li>
        </ol>
      </nav>

      <a
        href={modelHubHref}
        data-i18n="detail.modelHubPill"
        data-i18n-args={detailModelHubArgs}
        class="inline-flex items-center gap-1 rounded-full border border-slate-200 bg-white px-2.5 py-0.5 text-[11px] font-semibold text-slate-700 hover:border-blue-300 hover:text-blue-700 transition-colors"
      >
        Model Hub: {model.short_name} -&gt;
      </a>
    </div>

    <!-- Page Header -->
    <header class="mt-4">
      <div class="flex flex-wrap items-center justify-between gap-2.5">
        <div class="flex flex-wrap items-center gap-2.5">
          <StatusBadge status={res.status} size="md" />
          <span class="rounded-full border border-slate-200 bg-white px-2.5 py-0.5 font-mono text-xs font-medium text-slate-600">
            {hardware.backend} · {hardware.memory_type}
          </span>
          <span class="rounded-full border border-slate-200 bg-white px-2.5 py-0.5 font-mono text-xs font-medium text-slate-600">
            {model.params_b}B Params · {model.num_layers} Layers
          </span>
        </div>

        <button
          type="button"
          data-copy-url={shareUrl}
          data-copy-label="Benchmark share link"
          class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-700 hover:border-blue-300 hover:text-blue-700 transition-colors cursor-pointer"
        >
          <span data-copy-icon="copy" aria-hidden="true">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
          </span>
          <span data-copy-icon="check" class="hidden" aria-hidden="true">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span data-copy-text data-i18n="common.shareBenchmark">Share Benchmark</span>
        </button>
      </div>

      <h1 class="mt-3.5 text-2xl font-extrabold tracking-tight text-slate-950 sm:text-4xl" data-i18n="detail.canIRunTitle" data-i18n-args={detailTitleArgs}>
        Can I Run {model.name} on {hardware.name}?
      </h1>

      <p class="mt-3 max-w-3xl text-base leading-relaxed text-slate-700">
        {entry.verdict_summary}
      </p>

      <div class="mt-4 flex flex-wrap gap-2 text-xs text-slate-600">
        <span class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 font-mono">
          <span data-i18n="detail.hwBudget">Hardware Budget:</span> <strong class="text-slate-950">{hardware.usable_vram_gb} GB</strong> / {hardware.vram_gb} GB
        </span>
        <span class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 font-mono">
          <span data-i18n="detail.bandwidth">Bandwidth:</span> <strong class="text-slate-950">{hardware.bandwidth_gbps} GB/s</strong>
        </span>
        <span class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 font-mono">
          <span data-i18n="detail.kvGeometry">GQA KV Geometry:</span> <strong class="text-slate-950">{model.num_kv_heads} × {model.head_dim}</strong>
        </span>
      </div>
    </header>

    <!-- Top Interactive Pure-JS Estimator -->
    <div class="mt-7">
      <VramCalculator entry={entry} />
    </div>

    <!-- SSR OOM & Partial Offload Retention Panel -->
    {showRetentionPanel && (
      <section
        id="oom-retention-panel"
        aria-labelledby="retention-heading"
        class={retentionWrapClass}
      >
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class={retentionBadgeClass} data-i18n={retBadgeI18nKey}>
            {isOom ? 'Recommended Smooth Fixes' : 'Full-GPU Smooth Alternatives'}
          </span>
          <span class="font-mono text-xs text-slate-600" data-i18n="detail.retVerified">
            Verified Smooth Fits Only
          </span>
        </div>

        <h2 id="retention-heading" class="mt-2.5 text-lg font-bold tracking-tight text-slate-950 sm:text-xl">
          {retentionHeadline}
        </h2>
        <p class="mt-1 text-sm text-slate-700">
          {retentionLead}
        </p>

        <div class="mt-5 grid gap-5 lg:grid-cols-2">
          <!-- Column 1: Smooth Alternative Models on Same Hardware -->
          <div class="rounded-xl border border-slate-200/80 bg-white/95 p-4 shadow-xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-2.5">
                <h3 class="text-sm font-bold text-slate-950" data-i18n="detail.retSmoothModelsOn" data-i18n-args={retSmoothModelsArgs}>
                  Smooth Models on {hardware.short_name}
                </h3>
                <a href={gpuHubHref} class="text-xs font-semibold text-blue-600 hover:text-blue-800 shrink-0" data-i18n="detail.retAllHw" data-i18n-args={retAllHwArgs}>
                  All {hardware.short_name} -&gt;
                </a>
              </div>

              {smoothSameHw.length > 0 ? (
                <div class="mt-3 space-y-2.5">
                  {smoothSameHw.map((alt) => {
                    const altHref = `/can-i-run/${alt.slug}/`;
                    return (
                      <a
                        href={altHref}
                        class="flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2.5 hover:border-emerald-300 hover:bg-emerald-50/40 transition-colors"
                      >
                        <div class="min-w-0">
                          <div class="flex items-center gap-2">
                            <span class="font-bold text-sm text-slate-950 truncate">{alt.model.short_name}</span>
                            <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-800" data-i18n="status.smooth">
                              Smooth
                            </span>
                          </div>
                          <div class="mt-0.5 font-mono text-xs text-slate-500">
                            {alt.default_result.total_vram_gb.toFixed(1)} / {alt.hardware.usable_vram_gb} GB · {alt.default_result.gpu_layers_fit}/{alt.default_result.total_layers}L
                          </div>
                        </div>
                        <div class="text-right shrink-0">
                          <div class="font-mono text-sm font-bold text-emerald-700 tabular-nums">
                            {alt.default_result.est_tps.toFixed(1)} tok/s
                          </div>
                          <span class="text-[11px] font-semibold text-blue-600" data-i18n="common.switch">Switch -&gt;</span>
                        </div>
                      </a>
                    );
                  })}
                </div>
              ) : (
                <p class="mt-3 text-xs text-slate-600">
                  Inspect smaller 1.5B–7B GGUF models tested for {hardware.short_name} on the GPU hub.
                </p>
              )}
            </div>

            <div class="mt-3.5 border-t border-slate-100 pt-2.5 text-right">
              <a href={gpuHubHref} class="text-xs font-semibold text-blue-600 hover:text-blue-800" data-i18n="detail.retExploreHw" data-i18n-args={retExploreHwArgs}>
                Explore All {hardware.short_name} Models -&gt;
              </a>
            </div>
          </div>

          <!-- Column 2: Smooth Upgrade Hardware for Same Model -->
          <div class="rounded-xl border border-slate-200/80 bg-white/95 p-4 shadow-xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-2.5">
                <h3 class="text-sm font-bold text-slate-950" data-i18n="detail.retGpusSmooth" data-i18n-args={retGpusSmoothArgs}>
                  GPUs That Run {model.short_name} Smoothly
                </h3>
                <a href={modelHubHref} class="text-xs font-semibold text-blue-600 hover:text-blue-800 shrink-0" data-i18n="detail.retAllModel" data-i18n-args={retAllModelArgs}>
                  All {model.short_name} -&gt;
                </a>
              </div>

              {upgradeHwPicks.length > 0 ? (
                <div class="mt-3 space-y-2.5">
                  {upgradeHwPicks.map((up) => {
                    const upEntry = up.entry;
                    const upHref = `/can-i-run/${upEntry.slug}/`;
                    return (
                      <a
                        href={upHref}
                        class="flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2.5 hover:border-blue-300 hover:bg-blue-50/40 transition-colors"
                      >
                        <div class="min-w-0">
                          <div class="flex items-center gap-2">
                            <span class="font-bold text-sm text-slate-950 truncate">{upEntry.hardware.short_name}</span>
                            <span class="rounded-full bg-blue-100 px-2 py-0.5 text-[10px] font-bold text-blue-800">
                              {up.role}
                            </span>
                          </div>
                          <div class="mt-0.5 font-mono text-xs text-slate-500">
                            {upEntry.hardware.usable_vram_gb} GB usable · ${upEntry.hardware.msrp_usd.toLocaleString()} MSRP
                          </div>
                        </div>
                        <div class="text-right shrink-0">
                          <div class="font-mono text-sm font-bold text-emerald-700 tabular-nums">
                            {upEntry.default_result.est_tps.toFixed(1)} tok/s
                          </div>
                          <span class="text-[11px] font-semibold text-blue-600" data-i18n="common.inspect">Inspect -&gt;</span>
                        </div>
                      </a>
                    );
                  })}
                </div>
              ) : (
                <p class="mt-3 text-xs text-slate-600">
                  Compare all tested hardware specs and offload speeds on the {model.short_name} leaderboard.
                </p>
              )}
            </div>

            <div class="mt-3.5 border-t border-slate-100 pt-2.5 text-right">
              <a href={modelHubHref} class="text-xs font-semibold text-blue-600 hover:text-blue-800" data-i18n="detail.retCompareSmooth" data-i18n-args={retCompareSmoothArgs}>
                Compare All {smoothSameModel.length} Smooth GPUs -&gt;
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Quantization Comparison Table -->
    <section class="mt-10" aria-labelledby="quant-table-heading">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 id="quant-table-heading" class="text-xl font-bold tracking-tight text-slate-950" data-i18n="detail.quantTableTitle">
            Quantization Comparison Table (8K Context)
          </h2>
          <p class="mt-1 text-sm text-slate-600" data-i18n="detail.quantTableSub" data-i18n-args={quantTableSubArgs}>
            Static GGUF footprint breakdown across Q4_K_M through FP16 on {hardware.short_name}.
          </p>
        </div>
        <span class="text-xs font-mono text-slate-500" data-i18n="detail.kvNoteHeader">KV Cache @ 8K FP16</span>
      </div>

      <div class="mt-4 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-xs">
        <table class="w-full min-w-[760px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50 text-xs font-semibold uppercase tracking-wider text-slate-500">
              <th class="px-4 py-3" data-i18n="detail.colQuant">Quant</th>
              <th class="px-4 py-3" data-i18n="detail.colWeights">Weights</th>
              <th class="px-4 py-3" data-i18n="detail.colTotalVram">Total VRAM (8K)</th>
              <th class="px-4 py-3" data-i18n="detail.colGpuLayers">GPU Layers</th>
              <th class="px-4 py-3" data-i18n="detail.colEstSpeed">Est. Speed</th>
              <th class="px-4 py-3" data-i18n="detail.colStatus">Status</th>
              <th class="px-4 py-3" data-i18n="detail.colNotes">Practical Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {quant_table.map((row) => {
              const rowClass = row.recommended ? 'bg-blue-50/40' : 'hover:bg-slate-50/70';
              const rowTps = row.status === 'OOM' ? 'OOM' : `${row.est_tps.toFixed(1)} tok/s`;
              return (
              <tr class={rowClass}>
                <td class="px-4 py-3.5 align-top">
                  <div class="flex items-center gap-2">
                    <span class="font-mono font-bold text-slate-950">{row.quant}</span>
                    {row.recommended && (
                      <span class="rounded-full bg-blue-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white" data-i18n="common.recommended">
                        Recommended
                      </span>
                    )}
                  </div>
                  <div class="mt-0.5 text-xs text-slate-500">{row.bits_per_weight} bpw</div>
                </td>
                <td class="px-4 py-3.5 align-top font-mono text-slate-800 tabular-nums">
                  {row.weights_gb.toFixed(2)} GB
                </td>
                <td class="px-4 py-3.5 align-top font-mono font-semibold text-slate-950 tabular-nums">
                  {row.total_vram_8k_gb.toFixed(2)} GB
                </td>
                <td class="px-4 py-3.5 align-top font-mono text-slate-700 tabular-nums">
                  {row.gpu_layers_fit}/{row.total_layers}
                </td>
                <td class="px-4 py-3.5 align-top font-mono font-semibold text-slate-900 tabular-nums">
                  <span data-i18n={row.status === 'OOM' ? 'status.oom' : undefined}>{rowTps}</span>
                </td>
                <td class="px-4 py-3.5 align-top">
                  <StatusBadge status={row.status} />
                </td>
                <td class="px-4 py-3.5 align-top text-xs leading-relaxed text-slate-600 max-w-xs">
                  {row.notes}
                </td>
              </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- One-Click Copy Launch Commands -->
    <section class="mt-10" aria-labelledby="commands-heading">
      <h2 id="commands-heading" class="text-xl font-bold tracking-tight text-slate-950" data-i18n="detail.cmdTitle">
        One-Click Launch Commands (Ollama &amp; llama.cpp)
      </h2>
      <p class="mt-1 text-sm text-slate-600">
        {hardware.name} · <span class="font-mono text-slate-900">-ngl {commands.recommended_ngl}</span> ·{' '}
        <span class="font-mono text-slate-900">{formatContextLabel(commands.recommended_ctx)}</span>
      </p>

      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        <!-- Ollama Card -->
        <div class="flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-950 p-5 text-slate-100">
          <div>
            <div class="flex items-center justify-between gap-2 border-b border-slate-800 pb-3">
              <div>
                <span class="font-mono text-sm font-bold text-white">Ollama</span>
                <span class="ml-2 text-xs text-slate-400">Quick Run &amp; Tuned Env</span>
              </div>
              <button
                type="button"
                data-copy-target="cmd-ollama-env"
                data-copy-label="Ollama Env command"
                class="inline-flex items-center gap-1.5 rounded-lg border border-slate-700 bg-slate-800 px-3 py-1 text-xs font-semibold text-slate-200 hover:bg-slate-700 transition-colors cursor-pointer"
              >
                <span data-copy-icon="copy" aria-hidden="true">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                </span>
                <span data-copy-icon="check" class="hidden" aria-hidden="true">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span data-copy-text data-i18n="detail.copyEnvCmd">Copy Env Command</span>
              </button>
            </div>

            <div class="mt-3.5 space-y-3">
              <div>
                <div class="flex items-center justify-between text-[11px] uppercase tracking-wider text-slate-400">
                  <span data-i18n="detail.stdRun">Standard Run</span>
                  <button
                    type="button"
                    data-copy-target="cmd-ollama-basic"
                    data-copy-label="Ollama Run command"
                    class="inline-flex items-center gap-1 rounded-md border border-slate-700 bg-slate-800 px-2.5 py-0.5 text-[11px] font-semibold normal-case tracking-normal text-slate-200 hover:bg-slate-700 transition-colors cursor-pointer"
                  >
                    <span data-copy-icon="copy" aria-hidden="true">
                      <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                      </svg>
                    </span>
                    <span data-copy-icon="check" class="hidden" aria-hidden="true">
                      <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </span>
                    <span data-copy-text data-i18n="detail.copyRun">Copy Run</span>
                  </button>
                </div>
                <pre id="cmd-ollama-basic" class="mt-1.5 overflow-x-auto rounded-lg bg-slate-900 p-3 font-mono text-xs text-emerald-300 transition-shadow">{commands.ollama_run}</pre>
              </div>

              <div>
                <div class="text-[11px] uppercase tracking-wider text-slate-400">
                  Flash Attention + Q8_0 KV Cache ({formatContextLabel(commands.recommended_ctx)})
                </div>
                <pre id="cmd-ollama-env" class="mt-1.5 overflow-x-auto rounded-lg bg-slate-900 p-3 font-mono text-xs text-sky-300 whitespace-pre-wrap break-all transition-shadow">{commands.ollama_env_cmd}</pre>
              </div>
            </div>
          </div>
        </div>

        <!-- llama.cpp Card -->
        <div class="flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-950 p-5 text-slate-100">
          <div>
            <div class="flex items-center justify-between gap-2 border-b border-slate-800 pb-3">
              <div>
                <span class="font-mono text-sm font-bold text-white">llama.cpp</span>
                <span class="ml-2 text-xs text-slate-400">CLI &amp; OpenAI Server</span>
              </div>
              <button
                type="button"
                data-copy-target="cmd-llama-cli"
                data-copy-label="llama-cli command"
                class="inline-flex items-center gap-1.5 rounded-lg border border-slate-700 bg-slate-800 px-3 py-1 text-xs font-semibold text-slate-200 hover:bg-slate-700 transition-colors cursor-pointer"
              >
                <span data-copy-icon="copy" aria-hidden="true">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                </span>
                <span data-copy-icon="check" class="hidden" aria-hidden="true">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span data-copy-text data-i18n="detail.copyLlamaCli">Copy llama-cli</span>
              </button>
            </div>

            <div class="mt-3.5 space-y-3">
              <div>
                <div class="text-[11px] uppercase tracking-wider text-slate-400" data-i18n="detail.interactiveCli">
                  Interactive Terminal (`llama-cli`)
                </div>
                <pre id="cmd-llama-cli" class="mt-1.5 overflow-x-auto rounded-lg bg-slate-900 p-3 font-mono text-xs text-emerald-300 transition-shadow">{commands.llama_cli}</pre>
              </div>

              <div>
                <div class="flex items-center justify-between text-[11px] uppercase tracking-wider text-slate-400">
                  <span data-i18n="detail.localApiServer">Local API Server (`llama-server`)</span>
                  <button
                    type="button"
                    data-copy-target="cmd-llama-server"
                    data-copy-label="llama-server command"
                    class="inline-flex items-center gap-1 rounded-md border border-slate-700 bg-slate-800 px-2.5 py-0.5 text-[11px] font-semibold normal-case tracking-normal text-slate-200 hover:bg-slate-700 transition-colors cursor-pointer"
                  >
                    <span data-copy-icon="copy" aria-hidden="true">
                      <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                      </svg>
                    </span>
                    <span data-copy-icon="check" class="hidden" aria-hidden="true">
                      <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </span>
                    <span data-copy-text data-i18n="detail.copyServer">Copy Server</span>
                  </button>
                </div>
                <pre id="cmd-llama-server" class="mt-1.5 overflow-x-auto rounded-lg bg-slate-900 p-3 font-mono text-xs text-sky-300 transition-shadow">{commands.llama_server}</pre>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Context Bottleneck & Optimization Analysis -->
    <section class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 sm:p-7" aria-labelledby="bottleneck-heading">
      <h2 id="bottleneck-heading" class="text-xl font-bold tracking-tight text-slate-950" data-i18n="detail.bottleneckTitle">
        Context Window &amp; Memory Bottleneck Analysis
      </h2>

      <dl class="mt-4 grid gap-3 sm:grid-cols-3">
        <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
          <dt class="text-xs font-medium text-slate-500" data-i18n="detail.kvPer4k">KV Cache per 4K Tokens (FP16)</dt>
          <dd class="mt-1 font-mono text-lg font-bold text-slate-950 tabular-nums">
            +{context_analysis.kv_gb_per_4k.toFixed(2)} GB / 4K
          </dd>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
          <dt class="text-xs font-medium text-slate-500" data-i18n="detail.maxSmoothCtx">Max Smooth Context (Q4_K_M)</dt>
          <dd class="mt-1 font-mono text-lg font-bold text-slate-950 tabular-nums">
            {maxSmoothCtxLabel}
          </dd>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
          <dt class="text-xs font-medium text-slate-500" data-i18n="detail.hwMemBus">Hardware Memory Bus</dt>
          <dd class="mt-1 font-mono text-lg font-bold text-slate-950 tabular-nums">
            {hardware.bandwidth_gbps} GB/s
          </dd>
        </div>
      </dl>

      <p class="mt-5 text-sm leading-relaxed text-slate-700">
        {context_analysis.bottleneck_summary}
      </p>

      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
          <h3 class="text-sm font-bold text-slate-950" data-i18n="detail.keySignals">Key Bottleneck Signals</h3>
          <ul class="mt-2.5 space-y-2 text-sm text-slate-700">
            {context_analysis.key_points.map((pt) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-600" aria-hidden="true"></span>
                <span>{pt}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
          <h3 class="text-sm font-bold text-slate-950" data-i18n="detail.recOpts">Recommended Optimizations</h3>
          <ul class="mt-2.5 space-y-2 text-sm text-slate-700">
            {context_analysis.optimization_tips.map((tip) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-600" aria-hidden="true"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Dedicated FAQ -->
    <section class="mt-10" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-xl font-bold tracking-tight text-slate-950" data-i18n="detail.faqTitle">
        Frequently Asked Questions
      </h2>
      <div class="mt-4 space-y-3">
        {faq.map((item, idx) => (
          <details
            open={idx < 2}
            class="group rounded-xl border border-slate-200 bg-white px-5 py-4 open:border-blue-200"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-950">
              <span>{item.question}</span>
              <span class="shrink-0 font-mono text-slate-400 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- Internal Linking Recommendations -->
    {recommendedLinks.length > 0 && (
      <section class="mt-12 border-t border-slate-200 pt-8" aria-labelledby="related-heading">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 id="related-heading" class="text-xl font-bold tracking-tight text-slate-950" data-i18n="detail.relatedTitle">
              Compare Related Hardware &amp; Models
            </h2>
            <p class="mt-1 text-sm text-slate-600">
              {model.short_name} · {hardware.short_name}
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-2 shrink-0">
            <a
              href={gpuHubHref}
              class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-700 hover:border-blue-300 hover:text-blue-700 transition-colors"
              data-i18n="detail.retAllHw"
              data-i18n-args={retAllHwArgs}
            >
              All {hardware.short_name} -&gt;
            </a>
            <a
              href={modelHubHref}
              class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-700 hover:border-blue-300 hover:text-blue-700 transition-colors"
              data-i18n="detail.retAllModel"
              data-i18n-args={retAllModelArgs}
            >
              All {model.short_name} -&gt;
            </a>
            <a href="/" class="text-xs font-semibold text-blue-600 hover:text-blue-800 ml-1" data-i18n="detail.viewFullMatrix">
              View Full Matrix -&gt;
            </a>
          </div>
        </div>

        <div class="mt-4 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
          {recommendedLinks.map((rel) => {
            const relHref = `/can-i-run/${rel.slug}/`;
            const relTps =
              rel.default_result.status === 'OOM'
                ? 'OOM'
                : `${rel.default_result.est_tps.toFixed(1)} tok/s`;
            const relHwArgs = JSON.stringify({ hw: rel.hardware.short_name });
            return (
            <a
              href={relHref}
              class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-4 hover:border-blue-300 hover:shadow-sm transition-all"
            >
              <div>
                <div class="flex items-center justify-between gap-2">
                  <StatusBadge status={rel.default_result.status} />
                  <span class="font-mono text-xs text-slate-500 tabular-nums">
                    {rel.default_result.total_vram_gb.toFixed(1)} GB
                  </span>
                </div>
                <p class="mt-2.5 text-sm font-bold text-slate-950">
                  {rel.model.short_name}{' '}
                  <span data-i18n="common.onPrefix" data-i18n-args={relHwArgs}>on {rel.hardware.short_name}</span>
                </p>
              </div>
              <div class="mt-3 flex items-center justify-between text-xs text-slate-600">
                <span class="font-mono tabular-nums" data-i18n={rel.default_result.status === 'OOM' ? 'status.oom' : undefined}>
                  {relTps}
                </span>
                <span class="font-semibold text-blue-600" data-i18n="common.compare">Compare -&gt;</span>
              </div>
            </a>
            );
          })}
        </div>
      </section>
    )}
  </article>

  <!-- Accessible Floating Copy Toast -->
  <div
    id="copy-toast"
    role="status"
    aria-live="polite"
    class="fixed bottom-5 right-5 z-50 flex items-center gap-2 rounded-xl border border-emerald-500/40 bg-slate-950 px-4 py-2.5 text-xs font-semibold text-white shadow-lg transition-all duration-200 opacity-0 pointer-events-none translate-y-2"
  >
    <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
    <span id="copy-toast-text" data-i18n="common.copiedToast">Copied to clipboard</span>
  </div>
</BaseLayout>
