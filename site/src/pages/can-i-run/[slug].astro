---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import SpeedBadge from '../../components/SpeedBadge.astro';
import VramCalculator from '../../components/VramCalculator.astro';
import rawCatalog from '../../data/catalog_data.json';
import rawPagesData from '../../data/pages_data.json';
import type { CatalogData, VramPageEntry } from '../../types/vram';
import { officialPriceI18n, officialPriceSortValue } from '../../utils/pricing';
import {
  classifySpeedTier,
  formatContextLabel,
  formatTpsRange,
} from '../../utils/physics';
import {
  getBenchmarksMethodologyNote,
  getFreshnessMeta,
  getNearestReferenceAnchors,
  getReferenceBenchmarks,
  statusRank,
} from '../../utils/hubs';

export function getStaticPaths() {
  const allEntries = rawPagesData as VramPageEntry[];
  return allEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, allEntries },
  }));
}

interface Props {
  entry: VramPageEntry;
  allEntries: VramPageEntry[];
}

const { entry, allEntries } = Astro.props;
const { model, hardware, default_result: res, quant_table, commands, context_analysis, faq } = entry;

const updatedAt = entry.updated_at || '2026-11-24';
const totalCatalogHardware = (rawCatalog as CatalogData).hardware.length;
const effectiveUsable = res.effective_usable_vram_gb ?? hardware.usable_vram_gb;
const speedTier = res.speed_tier ?? classifySpeedTier(res.est_tps, res.status);
const tpsRangeText = formatTpsRange(res.est_tps_low, res.est_tps_high, res.est_tps, res.status);

const refBenchmarks = getReferenceBenchmarks({ modelId: model.id, hardwareId: hardware.id });
const refNote = getBenchmarksMethodologyNote();
const slugLookup = new Map(allEntries.map((e) => [`${e.model.id}::${e.hardware.id}`, e.slug]));
const nearestAnchors =
  refBenchmarks.length === 0 ? getNearestReferenceAnchors(model.id, hardware, slugLookup) : [];

const benchRepo =
  hardware.is_unified && hardware.vendor === 'Apple' && model.mlx_repo
    ? `mlx_lm.generate --model ${model.mlx_repo} --max-tokens 128`
    : hardware.backend === 'CUDA' && model.awq_repo
      ? `vllm bench latency --model ${model.awq_repo} --quantization awq --input-len 512 --output-len 128 --batch-size 1`
      : `llama-bench -m ${model.id}-Q4_K_M.gguf -p 512 -n 128 -ngl ${commands.recommended_ngl} -fa 1`;
const submitBenchIssueUrl = `https://github.com/Kiwi392251/vramcalc/issues/new?title=${encodeURIComponent(
  `Benchmark: ${model.short_name} on ${hardware.short_name}`,
)}&labels=benchmark&body=${encodeURIComponent(
  `Hardware: ${hardware.name}\nCPU:\nSystem RAM (GB & speed, e.g. 32GB DDR4-3200):\nPCIe Link (e.g. Gen4 x16):\nModel: ${model.name}\nQuant / Format:\n-ngl (GPU layers):\nContext / KV Type (e.g. 8192 / fp16):\nPrompt Spec (e.g. pp512 / tg128):\nCommand: ${benchRepo}\nMeasured tok/s:\nDate:`,
)}`;

const entryBySlug = new Map(allEntries.map((e) => [e.slug, e]));
const sameModelEntries = allEntries.filter(
  (e) => e.model.id === model.id && e.slug !== entry.slug,
);
const sameHwEntries = allEntries.filter(
  (e) => e.hardware.id === hardware.id && e.slug !== entry.slug,
);

const relatedPool: VramPageEntry[] = [];
const seen = new Set<string>([entry.slug]);

for (const candidate of [...sameModelEntries, ...sameHwEntries]) {
  if (!seen.has(candidate.slug)) {
    seen.add(candidate.slug);
    relatedPool.push(candidate);
  }
}

for (const slug of entry.related_slugs) {
  const target = entryBySlug.get(slug);
  if (target && !seen.has(target.slug)) {
    seen.add(target.slug);
    relatedPool.push(target);
  }
}

for (const fallback of allEntries) {
  if (relatedPool.length >= 6) break;
  if (!seen.has(fallback.slug)) {
    seen.add(fallback.slug);
    relatedPool.push(fallback);
  }
}

const recommendedLinks = relatedPool.slice(0, 6);

const maxFitCtx = entry.max_fit_context ?? context_analysis.max_smooth_context_q4;
const maxFitVram = entry.max_fit_total_vram_gb ?? res.total_vram_gb;
const maxFitCtxLabel =
  maxFitCtx > 0
    ? `${formatContextLabel(maxFitCtx)} (${maxFitVram.toFixed(2)} GB)`
    : 'N/A (Offload req.)';
const hasMaxFitSpeed = Boolean(maxFitCtx > 0 && entry.max_fit_tps_high && entry.max_fit_tps_high > 0);
const maxFitSpeedSubline = hasMaxFitSpeed
  ? `~${entry.max_fit_tps_low}–${entry.max_fit_tps_high} tok/s @ ${formatContextLabel(maxFitCtx)} (${entry.max_fit_speed_tier ?? ''})`
  : '';
const showFormulaOnlyPill = refBenchmarks.length === 0 && res.status !== 'OOM';
const showMeasuredPill = refBenchmarks.length > 0;

const showRetentionPanel = res.status === 'OOM' || res.status === 'Partial Offload';
const isOom = res.status === 'OOM';

const fittingSameHw = sameHwEntries
  .filter((e) => e.default_result.status === 'Fits' || e.default_result.status === 'Tight Fit')
  .sort((a, b) => {
    const rankDiff = statusRank(a.default_result.status) - statusRank(b.default_result.status);
    if (rankDiff !== 0) return rankDiff;
    if (b.model.params_b !== a.model.params_b) return b.model.params_b - a.model.params_b;
    return b.default_result.est_tps - a.default_result.est_tps;
  })
  .slice(0, 3);

const fittingSameModel = sameModelEntries.filter(
  (e) => e.default_result.status === 'Fits' || e.default_result.status === 'Tight Fit',
);

interface UpgradeHwPick {
  role: string;
  entry: VramPageEntry;
}

const upgradeHwPicks: UpgradeHwPick[] = [];
const pickedUpgradeSlugs = new Set<string>();

if (fittingSameModel.length > 0) {
  const affordablePick = [...fittingSameModel].sort((a, b) => {
    const priceDiff = officialPriceSortValue(a.hardware) - officialPriceSortValue(b.hardware);
    if (priceDiff !== 0) {
      return priceDiff;
    }
    return b.default_result.est_tps - a.default_result.est_tps;
  })[0];
  if (affordablePick) {
    pickedUpgradeSlugs.add(affordablePick.slug);
    upgradeHwPicks.push({ role: 'Lowest Cost Resident', entry: affordablePick });
  }

  const fastestPick = [...fittingSameModel].sort(
    (a, b) => b.default_result.est_tps - a.default_result.est_tps,
  )[0];
  if (fastestPick && !pickedUpgradeSlugs.has(fastestPick.slug)) {
    pickedUpgradeSlugs.add(fastestPick.slug);
    upgradeHwPicks.push({ role: 'Fastest Resident', entry: fastestPick });
  }

  const unifiedPick = [...fittingSameModel]
    .filter((e) => e.hardware.is_unified)
    .sort((a, b) => b.default_result.est_tps - a.default_result.est_tps)[0];
  if (unifiedPick && !pickedUpgradeSlugs.has(unifiedPick.slug)) {
    pickedUpgradeSlugs.add(unifiedPick.slug);
    upgradeHwPicks.push({ role: 'Unified Memory Mac', entry: unifiedPick });
  }

  for (const extra of [...fittingSameModel].sort(
    (a, b) => b.default_result.est_tps - a.default_result.est_tps,
  )) {
    if (upgradeHwPicks.length >= 3) break;
    if (!pickedUpgradeSlugs.has(extra.slug)) {
      pickedUpgradeSlugs.add(extra.slug);
      upgradeHwPicks.push({ role: 'Resident Alternative', entry: extra });
    }
  }
}

const retentionWrapClass = isOom
  ? 'mt-8 rounded-2xl border border-rose-500/30 bg-rose-500/10 p-5 sm:p-6'
  : 'mt-8 rounded-2xl border border-amber-500/30 bg-amber-500/10 p-5 sm:p-6';
const retentionBadgeClass = isOom
  ? 'badge-oom uppercase tracking-wider text-[11px] font-bold'
  : 'badge-partial uppercase tracking-wider text-[11px] font-bold';
const retentionHeadline = isOom
  ? `Out of Memory on ${hardware.short_name}: Resident Alternatives & Upgrades`
  : `PCIe Offload Bottleneck (${res.gpu_layers_fit}/${res.total_layers} GPU Layers): Resident Alternatives`;
const retentionLead = isOom
  ? `${model.short_name} needs ${res.total_vram_gb.toFixed(2)} GB at 8K Q4_K_M vs ${effectiveUsable.toFixed(1)} GB usable on ${hardware.short_name}. Pick a smaller model that fits cleanly or upgrade hardware below:`
  : `Running ${model.short_name} on ${hardware.short_name} spills weights to system RAM (${tpsRangeText} formula est.). For 100% GPU residency without PCIe offload, consider these alternatives:`;

const themeColor =
  res.status === 'Fits'
    ? '#10b981'
    : res.status === 'Tight Fit'
      ? '#f97316'
      : res.status === 'Partial Offload'
        ? '#f59e0b'
        : '#f43f5e';
const ogTitle = `${model.short_name} on ${hardware.short_name}: ${res.status} (${tpsRangeText})`;
const ogDescription = `${res.status} (${speedTier}) @ Q4_K_M 8K: ${res.total_vram_gb.toFixed(2)}/${effectiveUsable.toFixed(1)} GB usable (${res.gpu_layers_fit}/${res.total_layers} layers). Max Fit: ${maxFitCtxLabel}.`;
const ogImage = `/og/run-${entry.slug}.png`;
const shareUrl = `https://vramcalc.me/can-i-run/${entry.slug}/`;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const gpuHubHref = `/gpu/${hardware.id}/`;
const modelHubHref = `/model/${model.id}/`;

const updatedArgs = JSON.stringify({ date: updatedAt });
const detailTitleArgs = JSON.stringify({ model: model.name, hw: hardware.name });
const detailModelHubArgs = JSON.stringify({ model: model.short_name });
const detailOnHwArgs = JSON.stringify({ hw: hardware.short_name });
const retBadgeI18nKey = isOom ? 'detail.retFixes' : 'detail.retAlts';
const retSmoothModelsArgs = JSON.stringify({ hw: hardware.short_name });
const retAllHwArgs = JSON.stringify({ hw: hardware.short_name });
const retGpusSmoothArgs = JSON.stringify({ model: model.short_name });
const retAllModelArgs = JSON.stringify({ model: model.short_name });
const retExploreHwArgs = JSON.stringify({ hw: hardware.short_name });
const retCompareSmoothArgs = JSON.stringify({ count: fittingSameModel.length });
const quantTableSubArgs = JSON.stringify({ hw: hardware.short_name });

const gpuBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vramcalc.me/' },
    { '@type': 'ListItem', position: 2, name: 'All GPUs', item: 'https://vramcalc.me/gpu/' },
    { '@type': 'ListItem', position: 3, name: hardware.short_name, item: `https://vramcalc.me${gpuHubHref}` },
    { '@type': 'ListItem', position: 4, name: model.short_name, item: `https://vramcalc.me/can-i-run/${entry.slug}/` },
  ],
};

const modelBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vramcalc.me/' },
    { '@type': 'ListItem', position: 2, name: 'All Models', item: 'https://vramcalc.me/model/' },
    { '@type': 'ListItem', position: 3, name: model.short_name, item: `https://vramcalc.me${modelHubHref}` },
    { '@type': 'ListItem', position: 4, name: hardware.short_name, item: `https://vramcalc.me/can-i-run/${entry.slug}/` },
  ],
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `${model.name} on ${hardware.name} VRAM Calculator`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  url: `https://vramcalc.me/can-i-run/${entry.slug}/`,
  description: entry.meta_description,
};
---

<BaseLayout
  title={entry.title}
  description={entry.meta_description}
  canonicalPath={`/can-i-run/${entry.slug}/`}
  totalPages={allEntries.length}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  ogImageAlt={ogTitle}
  themeColor={themeColor}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(gpuBreadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(modelBreadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  </Fragment>

  <article class="mx-auto min-w-0 w-full max-w-6xl px-4 py-8 sm:px-6">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1.5 text-xs font-medium text-[var(--ink-tertiary)]">
          <li>
            <a href="/" class="hover:text-[var(--ink-primary)] transition-colors" data-i18n="common.home">Home</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/gpu/" class="hover:text-[var(--ink-primary)] transition-colors" data-i18n="nav.gpus">GPUs</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href={gpuHubHref} class="hover:text-[var(--ink-primary)] transition-colors">{hardware.short_name}</a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-semibold text-[var(--ink-primary)] truncate">
            {model.short_name} <span data-i18n="common.onPrefix" data-i18n-args={detailOnHwArgs}>on {hardware.short_name}</span>
          </li>
        </ol>
      </nav>

      <a
        href={modelHubHref}
        data-i18n="detail.modelHubPill"
        data-i18n-args={detailModelHubArgs}
        class="btn-secondary rounded-full px-3 py-1 text-[11px] font-semibold"
      >
        Model Hub: {model.short_name} -&gt;
      </a>
    </div>

    <header class="mt-4">
      <div class="flex flex-wrap items-center justify-between gap-2.5">
        <div class="flex flex-wrap items-center gap-2">
          <StatusBadge status={res.status} size="md" />
          <SpeedBadge tier={speedTier} short={false} />
          {showMeasuredPill && (
            <span class="badge-fits font-mono text-xs" data-i18n="speed.measuredBadge">
              Measured
            </span>
          )}
          {showFormulaOnlyPill && (
            <span class="badge-neutral font-mono text-xs" data-i18n="speed.formulaOnly">
              Formula only (unverified)
            </span>
          )}
          <span class="font-mono text-xs text-[var(--ink-tertiary)]">
            {hardware.backend} · {hardware.memory_type} · {model.params_b}B · {model.num_layers}L · {model.releaseDate}
          </span>
          {model.aa_index && (
            <span
              class="badge-accent font-mono text-xs font-semibold"
              title={model.aa_label ?? 'Artificial Analysis Intelligence Index v5.0.2'}
            >
              AA Score · {model.aa_index}
            </span>
          )}
          {model.arena_elo && (
            <span
              class="badge-neutral font-mono text-xs"
              title={model.arena_rank ? `LMArena Text Arena #${model.arena_rank} (2026-11-22)` : 'LMArena Text Arena Elo (2026-11-22)'}
            >
              Arena · {model.arena_elo}
            </span>
          )}
          <span class="badge-neutral font-mono text-xs" data-i18n="common.updated" data-i18n-args={updatedArgs}>
            Updated {updatedAt}
          </span>
        </div>

        <button
          type="button"
          data-copy-url={shareUrl}
          data-copy-label="Benchmark share link"
          class="btn-secondary rounded-full px-3 py-1 text-xs font-semibold"
        >
          <span data-copy-icon="copy" aria-hidden="true">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
          </span>
          <span data-copy-icon="check" class="hidden" aria-hidden="true">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span data-copy-text data-i18n="common.shareBenchmark">Share Benchmark</span>
        </button>
      </div>

      <h1 class="mt-3.5 text-2xl font-extrabold tracking-tight text-[var(--ink-primary)] sm:text-4xl" data-i18n="detail.canIRunTitle" data-i18n-args={detailTitleArgs}>
        Can I Run {model.name} on {hardware.name}?
      </h1>

      <p class="mt-3 max-w-3xl text-base leading-relaxed text-[var(--ink-secondary)]">
        {entry.verdict_summary}
      </p>

      <dl class="mt-5 grid grid-cols-1 sm:grid-cols-3 gap-px rounded-2xl border border-[var(--border-subtle)] bg-[var(--border-subtle)] shadow-[var(--shadow-card)] overflow-hidden text-xs">
        <div class="bg-[var(--bg-surface)] px-4 py-3 font-mono text-[var(--ink-secondary)]">
          <span data-i18n="detail.hwBudget">Hardware Budget:</span>{' '}
          <strong class="text-[var(--ink-primary)]">{effectiveUsable.toFixed(1)} GB</strong> / {hardware.vram_gb} GB
        </div>
        <div class="bg-[var(--bg-surface)] px-4 py-3 font-mono text-[var(--ink-secondary)]">
          <span data-i18n="detail.bandwidth">Bandwidth:</span>{' '}
          <strong class="text-[var(--ink-primary)]">{hardware.bandwidth_gbps} GB/s</strong>
        </div>
        <div class="bg-[var(--bg-surface)] px-4 py-3 font-mono text-[var(--ink-secondary)]">
          <span data-i18n="detail.kvGeometry">GQA KV Geometry:</span>{' '}
          <strong class="text-[var(--ink-primary)]">{model.num_kv_heads} × {model.head_dim}</strong>
        </div>
      </dl>
    </header>

    <div class="mt-7">
      <VramCalculator entry={entry} />
    </div>

    {refBenchmarks.length > 0 && (
      <section class="surface-card mt-7 border-[var(--accent-border)] p-5" aria-labelledby="detail-ref-benchmarks">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 id="detail-ref-benchmarks" class="text-base font-bold text-[var(--ink-primary)]" data-i18n="speed.refBenchmark">
            Measured Community Benchmarks
          </h2>
          <span class="badge-fits font-mono text-[11px]" data-i18n="speed.measuredBadge">
            Measured
          </span>
        </div>
        <p class="mt-1 text-xs text-[var(--ink-secondary)]">{refNote}</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {refBenchmarks.map((anc) => {
            const fresh = getFreshnessMeta(anc.date);
            return (
              <div class="surface-inset min-w-0 max-w-full p-3.5 text-xs">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="font-mono font-bold text-[var(--ink-primary)]">
                    {anc.format} · {anc.quant} @ {formatContextLabel(anc.context_tokens)} ({anc.backend})
                  </span>
                  <span class="font-mono font-bold text-emerald-600 dark:text-emerald-400">
                    {anc.gen_tps_low}–{anc.gen_tps_high} tok/s measured
                  </span>
                </div>
                <p class="mt-1 text-[var(--ink-secondary)]">{anc.notes}</p>
                <div class="mt-1.5 flex flex-wrap items-center gap-1.5 font-mono text-[10px] text-[var(--ink-tertiary)]">
                  <span>{anc.date}</span>
                  <span class={fresh.badgeClass} data-i18n={fresh.key}>{fresh.label}</span>
                  <span>· {anc.prompt_spec} · {anc.runtime_version}</span>
                </div>
                <code class="mt-2 block w-full max-w-full overflow-x-auto rounded-lg bg-[var(--bg-code)] px-2.5 py-1.5 font-mono text-[10px] text-slate-200">
                  {anc.repro_cmd}
                </code>
                <div class="mt-1.5 text-[11px] text-[var(--ink-tertiary)]">
                  <span data-i18n="speed.refSource">Source</span>:{' '}
                  <a href={anc.source_url} target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--ink-primary)]">
                    {anc.source_label}
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    {refBenchmarks.length === 0 && (
      <section class="surface-card mt-7 min-w-0 max-w-full p-5" aria-labelledby="detail-nearest-anchors">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 id="detail-nearest-anchors" class="text-base font-bold text-[var(--ink-primary)]" data-i18n="detail.nearestTitle">
            Formula Only — Closest Verified Reference Anchors
          </h2>
          <span class="badge-neutral font-mono text-[11px]" data-i18n="speed.formulaOnly">
            Formula only (unverified)
          </span>
        </div>
        <p class="mt-1 text-xs leading-relaxed text-[var(--ink-secondary)]" data-i18n="detail.nearestSub">
          Zero measured single-stream run exists yet for this exact pairing. Use the neighboring verified hardware &amp; model runs below (with bandwidth ratio) or submit a real run:
        </p>

        {nearestAnchors.length > 0 && (
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            {nearestAnchors.map((item) => (
              <div class="surface-inset min-w-0 max-w-full p-3.5 text-xs">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="badge-neutral rounded px-1.5 py-0.5 font-mono text-[10px]">
                    {item.relation} · {item.bwRatioLabel}
                  </span>
                  <span class="font-mono font-bold text-emerald-600 dark:text-emerald-400">
                    {item.anchor.gen_tps_low}–{item.anchor.gen_tps_high} tok/s measured
                  </span>
                </div>
                <div class="mt-2 font-bold text-[var(--ink-primary)]">
                  <a href={item.pairHref} class="hover:text-[var(--accent-ink)] transition-colors">
                    {item.modelName} on {item.hardwareName}
                  </a>
                </div>
                <div class="mt-0.5 flex flex-wrap items-center gap-1.5 font-mono text-[10px] text-[var(--ink-secondary)]">
                  <span>{item.anchor.format} · {item.anchor.quant} @ {formatContextLabel(item.anchor.context_tokens)}</span>
                  <span class={item.freshness.badgeClass} data-i18n={item.freshness.key}>{item.freshness.label}</span>
                  <span>({item.anchor.date})</span>
                </div>
                <div class="mt-1.5 text-[11px] text-[var(--ink-tertiary)]">
                  <span data-i18n="speed.refSource">Source</span>:{' '}
                  <a href={item.anchor.source_url} target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--ink-primary)]">
                    {item.anchor.source_label}
                  </a>
                </div>
              </div>
            ))}
          </div>
        )}

        <div class="code-card mt-4 min-w-0 max-w-full p-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
