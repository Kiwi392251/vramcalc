---
import BaseLayout from '../layouts/BaseLayout.astro';
import RigSimulator from '../components/RigSimulator.astro';
import catalogRaw from '../data/catalog_data.json';
import pagesRaw from '../data/pages_data.json';
import type { CatalogData, VramPageEntry } from '../types/vram';

const catalog = catalogRaw as CatalogData;
const curatedEntries = pagesRaw as VramPageEntry[];
const totalIndexed = curatedEntries.length;
const updatedAt = catalog.updated_at ?? '2026-11-24';

const pageTitle = `Multi-GPU (1x–8x), AWQ / MLX & OS Reserve Rig Simulator — VRAMCalc.me`;
const pageDescription = `Simulate local and cloud LLMs across ${catalog.hardware.length} GPUs (1x–8x, T4/L4/A10/RTX/Mac), ${catalog.models.length} models (Qwen3, Gemma 3, DeepSeek-R1), GGUF / AWQ / MLX formats, Desktop vs Clean OS reserves, and PCIe All-Reduce latency.`;
const canonicalPath = '/calculator/';
const ogTitle = `Multi-GPU, AWQ / MLX & CPU/RAM LLM Simulator (${catalog.hardware.length} GPUs × ${catalog.models.length} LLMs)`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vramcalc.me/' },
    { '@type': 'ListItem', position: 2, name: 'Rig Simulator', item: 'https://vramcalc.me/calculator/' },
  ],
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'VRAMCalc.me Universal LLM Rig Simulator',
  url: 'https://vramcalc.me/calculator/',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, Windows, macOS',
  description: pageDescription,
};

const simHeroDescArgs = JSON.stringify({
  models: catalog.models.length,
  hw: catalog.hardware.length,
});
const updatedArgs = JSON.stringify({ date: updatedAt });
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  totalPages={totalIndexed}
  ogTitle={ogTitle}
  ogDescription={pageDescription}
  ogImage="/og/calculator.png"
  ogImageAlt={ogTitle}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  </Fragment>

  <article class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
    <nav aria-label="Breadcrumb" class="mb-4">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs font-medium text-[var(--ink-tertiary)]">
        <li>
          <a href="/" class="hover:text-[var(--ink-primary)] transition-colors" data-i18n="common.home">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-[var(--ink-primary)] font-semibold" data-i18n="sim.breadcrumb">Rig Simulator</li>
      </ol>
    </nav>

    <header class="mb-8 border-b border-[var(--border-hairline)] pb-7">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 font-mono text-xs text-[var(--ink-tertiary)]">
        <span class="text-[var(--accent-ink)] font-semibold" data-i18n="sim.heroBadge1">
          Multi-GPU · AWQ · MLX · CPU/RAM
        </span>
        <span aria-hidden="true">·</span>
        <span data-i18n="sim.heroBadge2">Fits vs Speed Tier · PCIe All-Reduce</span>
        <span aria-hidden="true">·</span>
        <span class="text-emerald-600 dark:text-emerald-400 font-medium" data-i18n="common.updated" data-i18n-args={updatedArgs}>
          Updated {updatedAt}
        </span>
      </div>

      <h1 class="mt-3 text-2xl sm:text-4xl font-bold tracking-[-0.025em] text-[var(--ink-primary)]" data-i18n="sim.heroTitle">
        Universal Local AI Rig Simulator
      </h1>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-[var(--ink-secondary)] sm:text-base" data-i18n="sim.heroDesc" data-i18n-args={simHeroDescArgs}>
        Test GGUF, vLLM AWQ/FP8, and Apple MLX across 1x–8x GPUs (T4, L4, A10, RTX 4090/5090, Dual 3090), Desktop vs Clean OS reserves, PCIe All-Reduce latency vs Layer Split, and CPU-only inference.
      </p>
    </header>

    <RigSimulator />
  </article>
</BaseLayout>
