---
import BaseLayout from '../layouts/BaseLayout.astro';
import RigSimulator from '../components/RigSimulator.astro';
import catalogRaw from '../data/catalog_data.json';
import pagesRaw from '../data/pages_data.json';
import type { CatalogData, PageEntry } from '../types/vram';

const catalog = catalogRaw as CatalogData;
const curatedEntries = pagesRaw as PageEntry[];
const totalIndexed = curatedEntries.length;

const pageTitle = `Multi-GPU (1x–8x), 7-Quant & CPU/RAM LLM Simulator — VRAMCalc.me`;
const pageDescription = `Simulate local LLMs across ${catalog.hardware.length} GPUs (1x to 8x multi-GPU), 16 CPU/RAM memory profiles, 7 GGUF quants (Q2_K–FP16), and FP16/Q8_0/Q4_0 KV cache.`;
const canonicalPath = '/calculator/';
const ogTitle = `Multi-GPU & CPU/RAM LLM VRAM Simulator (${catalog.hardware.length} GPUs × ${catalog.models.length} LLMs)`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://vramcalc.me/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Rig Simulator',
      item: 'https://vramcalc.me/calculator/',
    },
  ],
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'VRAMCalc.me Multi-GPU & CPU/RAM Rig Simulator',
  url: 'https://vramcalc.me/calculator/',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, Windows, macOS',
  description: pageDescription,
};

const simHeroDescArgs = JSON.stringify({
  models: catalog.models.length,
  hw: catalog.hardware.length,
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  totalPages={totalIndexed}
  ogTitle={ogTitle}
  ogDescription={pageDescription}
  ogImage="/og/calculator.png"
  ogImageAlt={ogTitle}
  themeColor="#2563eb"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  </Fragment>

  <article class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-4">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs font-medium text-slate-500">
        <li>
          <a href="/" class="hover:text-slate-900 transition-colors" data-i18n="common.home">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-slate-900 font-semibold" data-i18n="sim.breadcrumb">Rig Simulator</li>
      </ol>
    </nav>

    <header class="mb-8 rounded-2xl border border-slate-800 bg-slate-950 p-6 text-slate-100 shadow-xs sm:p-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full border border-blue-500/40 bg-blue-500/15 px-2.5 py-0.5 font-mono text-xs font-semibold text-blue-300" data-i18n="sim.heroBadge1">
          Multi-GPU · CPU · Custom Rig
        </span>
        <span class="rounded-full border border-slate-700 bg-slate-900 px-2.5 py-0.5 font-mono text-xs text-slate-300" data-i18n="sim.heroBadge2">
          7 GGUF Quants · FP16 / Q8_0 / Q4_0 KV
        </span>
      </div>

      <h1 class="mt-4 text-2xl font-extrabold tracking-tight text-white sm:text-4xl" data-i18n="sim.heroTitle">
        Universal Local AI Rig Simulator
      </h1>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-300 sm:text-base" data-i18n="sim.heroDesc" data-i18n-args={simHeroDescArgs}>
        Test <strong class="text-white">1x to 8x multi-GPU</strong> rigs (e.g. 3x GTX 1080, 4x Tesla P40, Dual RTX 3090),{' '}
        <strong class="text-white">CPU-only DDR4/DDR5/EPYC inference</strong>, or mixed custom VRAM setups across all{' '}
        <strong class="text-white">{catalog.models.length} dense &amp; MoE LLMs</strong> and{' '}
        <strong class="text-white">{catalog.hardware.length} accelerators</strong>.
      </p>
    </header>

    <RigSimulator />
  </article>

  <!-- Accessible Copy Toast -->
  <div
    id="copy-toast"
    role="status"
    aria-live="polite"
    class="fixed bottom-5 right-5 z-50 flex items-center gap-2 rounded-xl border border-emerald-500/40 bg-slate-950 px-4 py-2.5 text-xs font-semibold text-white shadow-lg transition-all duration-200 opacity-0 pointer-events-none translate-y-2"
  >
    <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
    <span id="copy-toast-text" data-i18n="common.copiedToast">Copied to clipboard</span>
  </div>
</BaseLayout>
