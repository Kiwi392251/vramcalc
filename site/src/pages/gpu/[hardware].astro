---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import SpeedBadge from '../../components/SpeedBadge.astro';
import rawPagesData from '../../data/pages_data.json';
import type { HardwareSpec, VramPageEntry } from '../../types/vram';
import { formatContextLabel, formatTpsRange } from '../../utils/physics';
import { officialPriceI18n } from '../../utils/pricing';
import {
  buildHardwareFaq,
  buildHardwareHubs,
  getBenchmarksMethodologyNote,
  getCatalogUpdatedAt,
  getFreshnessMeta,
  getReferenceBenchmarks,
  type HardwareHub,
} from '../../utils/hubs';

export function getStaticPaths() {
  const allEntries = rawPagesData as VramPageEntry[];
  const hubs = buildHardwareHubs(allEntries);
  const allHardware = hubs.map((h) => h.hardware);

  return hubs.map((hub) => ({
    params: { hardware: hub.hardware.id },
    props: {
      hub,
      allHardware,
      totalSiteEntries: allEntries.length,
    },
  }));
}

interface Props {
  hub: HardwareHub;
  allHardware: HardwareSpec[];
  totalSiteEntries: number;
}

const { hub, allHardware, totalSiteEntries } = Astro.props;
const {
  hardware,
  effectiveUsableGb,
  rows,
  fitsCount,
  tightCount,
  partialCount,
  oomCount,
  picks,
} = hub;

const updatedAt = getCatalogUpdatedAt();
const faq = buildHardwareFaq(hub);
const allModelsCount = rows.length;
const hwPrice = officialPriceI18n(hardware, false);
const refBenchmarks = getReferenceBenchmarks({ hardwareId: hardware.id });
const refNote = getBenchmarksMethodologyNote();

const relatedHardware = allHardware
  .filter((h) => h.id !== hardware.id)
  .sort((a, b) => {
    const aSameVendor = a.vendor === hardware.vendor ? 0 : 1;
    const bSameVendor = b.vendor === hardware.vendor ? 0 : 1;
    if (aSameVendor !== bSameVendor) return aSameVendor - bSameVendor;
    const vDiff =
      Math.abs(a.usable_vram_gb - hardware.usable_vram_gb) -
      Math.abs(b.usable_vram_gb - hardware.usable_vram_gb);
    if (vDiff !== 0) return vDiff;
    return b.bandwidth_gbps - a.bandwidth_gbps;
  })
  .slice(0, 6);

const gpuCount = hardware.gpu_count ?? 1;
const topologyLabel =
  gpuCount > 1
    ? `${gpuCount}x GPU Split (${hardware.backend})`
    : hardware.is_unified
      ? `Unified Memory (${hardware.backend})`
      : `Discrete Single GPU (${hardware.backend})`;

const topPickRow = picks[0]?.row;
const topPickSummary = topPickRow
  ? `${topPickRow.model.short_name} (${formatTpsRange(
      topPickRow.result.est_tps_low,
      topPickRow.result.est_tps_high,
      topPickRow.result.est_tps,
      topPickRow.result.status,
    )})`
  : `${allModelsCount} models evaluated`;

const isMultiCapable = !hardware.is_unified && hardware.category !== 'Laptop GPU';
const simActionHref = isMultiCapable
  ? `/calculator/?hw=${encodeURIComponent(hardware.id)}&gpus=2`
  : `/calculator/?hw=${encodeURIComponent(hardware.id)}`;
const simActionLabel = isMultiCapable
  ? 'Simulate 1x–8x Multi-GPU & AWQ/MLX ->'
  : 'Open Format & Reserve Simulator ->';

const canonicalPath = `/gpu/${hardware.id}/`;
const pageTitle = `Best Local AI Models for ${hardware.name} — VRAMCalc.me`;
const pageDescription = `${hardware.name} exposes ${effectiveUsableGb.toFixed(1)} GB usable ${hardware.memory_type} (${hardware.bandwidth_gbps} GB/s). Inspect all ${allModelsCount} LLMs (${fitsCount} Fits, ${tightCount} Tight Fit at Q4_K_M @ 8K) plus AWQ/MLX & Max Context.`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vramcalc.me/' },
    { '@type': 'ListItem', position: 2, name: 'All GPUs', item: 'https://vramcalc.me/gpu/' },
    { '@type': 'ListItem', position: 3, name: hardware.name, item: `https://vramcalc.me/gpu/${hardware.id}/` },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Local LLM Compatibility Matrix for ${hardware.name}`,
  numberOfItems: rows.length,
  itemListElement: rows.map((r, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: `${r.model.name} on ${hardware.short_name}`,
    url: r.isCurated
      ? `https://vramcalc.me${r.href}`
      : `https://vramcalc.me/model/${r.model.id}/`,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const statusFilters = [
  { key: 'all', label: `All (${allModelsCount})`, i18nKey: 'status.allWithCount', i18nArgs: JSON.stringify({ count: allModelsCount }) },
  { key: 'Fits', label: `Fits (${fitsCount})`, i18nKey: 'status.fitsWithCount', i18nArgs: JSON.stringify({ count: fitsCount }) },
  { key: 'Tight Fit', label: `Tight Fit (${tightCount})`, i18nKey: 'status.tightWithCount', i18nArgs: JSON.stringify({ count: tightCount }) },
  { key: 'Partial Offload', label: `Partial Offload (${partialCount})`, i18nKey: 'status.partialWithCount', i18nArgs: JSON.stringify({ count: partialCount }) },
  { key: 'OOM', label: `OOM (${oomCount})`, i18nKey: 'status.oomWithCount', i18nArgs: JSON.stringify({ count: oomCount }) },
] as const;

const simBtnI18nKey = isMultiCapable ? 'hub.simMultiGpuBtn' : 'hub.open7QuantBtn';
const bestModelsForArgs = JSON.stringify({ hw: hardware.name });
const recBestModelsArgs = JSON.stringify({ hw: hardware.short_name });
const allCatalogModelsArgs = JSON.stringify({ count: allModelsCount, hw: hardware.short_name });
const faqTargetArgs = JSON.stringify({ target: hardware.short_name });
const showAllArgs = JSON.stringify({ count: allModelsCount });
const browseAllHwArgs = JSON.stringify({ count: allHardware.length });
const updatedArgs = JSON.stringify({ date: updatedAt });
const ogTitle = `${hardware.name}: ${fitsCount + tightCount}/${allModelsCount} Local LLMs Fit`;
const ogDescription = `${effectiveUsableGb.toFixed(1)} GB usable ${hardware.memory_type} (${hardware.bandwidth_gbps} GB/s). Top fit: ${topPickSummary}.`;
const ogImage = `/og/gpu-${hardware.id}.png`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  totalPages={totalSiteEntries}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  ogImageAlt={ogTitle}
  themeColor="#2563eb"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <article class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-4">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs font-medium text-slate-500">
        <li>
          <a href="/" class="hover:text-slate-900 transition-colors" data-i18n="common.home">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/gpu/" class="hover:text-[var(--ink-primary)] transition-colors" data-i18n="nav.gpus">GPUs</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-semibold text-[var(--ink-primary)] truncate">
          {hardware.name}
        </li>
      </ol>
    </nav>

    <header class="pb-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="badge-accent font-mono text-xs">
            {hardware.vendor} · {hardware.backend}
          </span>
          <span class="font-mono text-xs text-[var(--ink-tertiary)]">
            {hardware.series} · {hardware.category} · {hardware.memory_type} ·{' '}
            <span
              class="font-semibold text-[var(--ink-secondary)]"
              title={hardware.price_note ?? ''}
              data-i18n={hwPrice.key}
              data-i18n-args={hwPrice.args}
            >
              {hwPrice.text}
            </span>
          </span>
          {hardware.price_note && (
            <span class="rounded border border-[var(--border-hairline)] bg-[var(--bg-subtle)] px-2 py-0.5 text-[11px] text-[var(--ink-tertiary)]">
              {hardware.price_note}
            </span>
          )}
          <span class="badge-fits font-mono text-xs" data-i18n="common.updated" data-i18n-args={updatedArgs}>
            Updated {updatedAt}
          </span>
        </div>

        <a
          href={simActionHref}
          data-i18n={simBtnI18nKey}
          class="btn-primary text-xs shrink-0"
        >
          {simActionLabel}
        </a>
      </div>

      <h1 class="mt-4 text-2xl font-extrabold tracking-tight text-[var(--ink-primary)] sm:text-4xl" data-i18n="hub.bestModelsFor" data-i18n-args={bestModelsForArgs}>
        Best Local AI Models for {hardware.name}
      </h1>

      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-[var(--ink-secondary)] sm:text-base">
        Under Daily Desktop reserve, <strong class="font-mono text-[var(--ink-primary)]">{effectiveUsableGb.toFixed(1)} GB</strong> of{' '}
        {hardware.vram_gb} GB physical {hardware.backend} memory is usable ({hardware.bandwidth_gbps} GB/s). Across all{' '}
        <strong class="text-[var(--ink-primary)]">{allModelsCount}</strong> LLMs at Q4_K_M @ 8K:{' '}
        <span class="font-semibold text-emerald-600 dark:text-emerald-400">{fitsCount} Fits</span>,{' '}
        <span class="font-semibold text-orange-600 dark:text-orange-400">{tightCount} Tight Fit</span>,{' '}
        <span class="font-semibold text-amber-600 dark:text-amber-400">{partialCount} Partial Offload</span>, and{' '}
        <span class="font-semibold text-rose-600 dark:text-rose-400">{oomCount} OOM</span>.
      </p>

      <dl class="mt-6 grid grid-cols-2 lg:grid-cols-4 gap-px rounded-2xl border border-[var(--border-subtle)] bg-[var(--border-subtle)] shadow-[var(--shadow-card)] overflow-hidden">
        <div class="bg-[var(--bg-surface)] px-4 py-3.5">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-[var(--ink-tertiary)]">Usable / Total VRAM</dt>
          <dd class="mt-1 whitespace-nowrap font-mono text-lg font-bold text-[var(--ink-primary)] tabular-nums">
            {effectiveUsableGb.toFixed(1)} / {hardware.vram_gb} GB
          </dd>
        </div>
        <div class="bg-[var(--bg-surface)] px-4 py-3.5">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-[var(--ink-tertiary)]">Memory Bandwidth</dt>
          <dd class="mt-1 whitespace-nowrap font-mono text-lg font-bold text-[var(--accent-ink)] tabular-nums">
            {hardware.bandwidth_gbps} GB/s
          </dd>
        </div>
        <div class="bg-[var(--bg-surface)] px-4 py-3.5">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-[var(--ink-tertiary)]">Topology &amp; Backend</dt>
          <dd class="mt-1 font-mono text-sm font-bold text-[var(--ink-primary)]">
            {topologyLabel}
          </dd>
        </div>
        <div class="bg-[var(--bg-surface)] px-4 py-3.5">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-[var(--ink-tertiary)]">Full {allModelsCount}-LLM Fit</dt>
          <dd class="mt-1 font-mono text-sm font-bold text-emerald-600 dark:text-emerald-400 tabular-nums">
            {fitsCount} Fits · {tightCount} Tight · {partialCount} Offload
          </dd>
        </div>
      </dl>
    </header>

    {refBenchmarks.length > 0 && (
      <section class="surface-card mt-2 p-5 border-[var(--accent-border)]" aria-labelledby="gpu-ref-benchmarks">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 id="gpu-ref-benchmarks" class="text-base font-bold text-[var(--ink-primary)]" data-i18n="speed.refBenchmark">
            Measured Community Benchmarks
          </h2>
          <span class="badge-fits font-mono text-[11px]" data-i18n="speed.measuredBadge">
            Measured
          </span>
        </div>
        <p class="mt-1 text-xs text-[var(--ink-secondary)]">{refNote}</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {refBenchmarks.map((anc) => {
            const fresh = getFreshnessMeta(anc.date);
            return (
              <div class="surface-inset min-w-0 max-w-full p-3.5 text-xs">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="font-mono font-bold text-[var(--ink-primary)]">
                    {anc.model_id} · {anc.quant} @ {formatContextLabel(anc.context_tokens)}
                  </span>
                  <span class="font-mono font-bold text-emerald-600 dark:text-emerald-400">
                    {anc.gen_tps_low}–{anc.gen_tps_high} tok/s measured
                  </span>
                </div>
                <p class="mt-1 text-[var(--ink-secondary)]">{anc.notes}</p>
                <div class="mt-1.5 flex flex-wrap items-center gap-1.5 font-mono text-[10px] text-[var(--ink-tertiary)]">
                  <span>{anc.date}</span>
                  <span class={fresh.badgeClass} data-i18n={fresh.key}>{fresh.label}</span>
                  <span>· {anc.prompt_spec} · {anc.runtime_version}</span>
                </div>
                <code class="mt-2 block w-full max-w-full overflow-x-auto rounded-lg bg-[var(--bg-code)] px-2.5 py-1.5 font-mono text-[10px] text-slate-200">
                  {anc.repro_cmd}
                </code>
                <div class="mt-1.5 text-[11px] text-[var(--ink-tertiary)]">
                  <span data-i18n="speed.refSource">Source</span>:{' '}
                  <a href={anc.source_url} target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--ink-primary)]">
                    {anc.source_label}
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    {picks.length > 0 && (
      <section class="mt-10" aria-labelledby="recommended-models-heading">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 id="recommended-models-heading" class="text-xl font-bold tracking-tight text-[var(--ink-primary)]" data-i18n="hub.recBestModels" data-i18n-args={recBestModelsArgs}>
              Top Recommended Models for {hardware.short_name}
            </h2>
            <p class="mt-1 text-sm text-[var(--ink-secondary)]">
              {effectiveUsableGb.toFixed(1)} GB usable VRAM · {hardware.bandwidth_gbps} GB/s
            </p>
          </div>
          <a href="/" class="text-xs font-semibold text-[var(--accent-ink)] hover:underline shrink-0" data-i18n="detail.viewFullMatrix">
            View Full Matrix -&gt;
          </a>
        </div>

        <div class="mt-4 grid gap-4 md:grid-cols-3">
          {picks.map((pick) => {
            const row = pick.row;
            const res = row.result;
            const tier = res.speed_tier ?? 'Readable';
            const speedText = formatTpsRange(res.est_tps_low, res.est_tps_high, res.est_tps, res.status);
            const maxCtx =
              row.maxFitCtx > 0
                ? `${formatContextLabel(row.maxFitCtx)} (${row.maxFitVramGb.toFixed(1)} GB)`
                : 'Offload/Q8';
            const roleClass = `inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-semibold ${pick.accent}`;
            const modelHref = `/model/${row.model.id}/`;
            const summaryText = row.curatedEntry
              ? row.curatedEntry.verdict_summary
              : `${hardware.short_name} runs ${row.model.name} (${res.weights_gb.toFixed(2)} GB weights @ Q4_K_M) in status ${res.status} with ${maxCtx} resident context headroom.`;
            const ctaI18n = row.isCurated ? 'common.openGuide' : 'common.simulate';
            const ctaText = row.isCurated ? 'Open Guide ->' : 'Simulate ->';

            return (
              <div class="surface-card-interactive flex flex-col justify-between p-5">
                <div>
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class={roleClass}>{pick.role}</span>
                    <div class="flex items-center gap-1.5">
                      <StatusBadge status={res.status} />
                      <SpeedBadge tier={tier} />
                    </div>
                  </div>

                  <h3 class="mt-3 text-lg font-bold tracking-tight text-[var(--ink-primary)]">
                    <a href={row.href} class="hover:text-[var(--accent-ink)] transition-colors">
                      {row.model.name}
                    </a>
                  </h3>
                  <p class="mt-0.5 font-mono text-xs text-[var(--ink-tertiary)]">
                    {row.model.params_b}B · {row.model.architecture} · {row.recQuant}
                  </p>

                  <p class="mt-2.5 text-xs leading-relaxed text-[var(--ink-secondary)] line-clamp-3">
                    {summaryText}
                  </p>
                </div>

                <div class="mt-4 border-t border-[var(--border-hairline)] pt-3.5">
                  <div class="grid grid-cols-3 gap-2 text-xs">
                    <div>
                      <span class="block text-[11px] text-[var(--ink-tertiary)]" data-i18n="speed.formulaEst">Formula est.</span>
                      <span class="font-mono font-bold text-[var(--ink-primary)] tabular-nums">{speedText}</span>
                    </div>
                    <div>
                      <span class="block text-[11px] text-[var(--ink-tertiary)]">
                        <span data-i18n="common.vram8kLabel">VRAM @ 8K</span>{' '}
                        <span class="font-mono text-[10px]">({res.quant})</span>
                      </span>
                      <span class="font-mono font-semibold text-[var(--ink-primary)] tabular-nums">
                        {res.total_vram_gb.toFixed(1)} GB
                      </span>
                    </div>
                    <div>
                      <span class="block text-[11px] text-[var(--ink-tertiary)]" data-i18n="detail.maxSmoothCtx">Max Fit</span>
                      <span class="font-mono font-semibold text-[var(--ink-primary)] tabular-nums">{maxCtx}</span>
                    </div>
                  </div>

                  <div class="mt-3.5 flex items-center justify-between gap-2 text-xs font-semibold">
                    <a href={modelHref} class="text-[var(--ink-secondary)] hover:text-[var(--ink-primary)] transition-colors" data-i18n="hub.compareGpusLink">
                      Compare GPUs -&gt;
                    </a>
                    <a href={row.href} class="text-[var(--accent-ink)] hover:underline" data-i18n={ctaI18n}>
                      {ctaText}
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <section class="mt-10" aria-labelledby="gpu-models-table-heading">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 id="gpu-models-table-heading" class="text-xl font-bold tracking-tight text-[var(--ink-primary)]" data-i18n="hub.allCatalogModelsHeading" data-i18n-args={allCatalogModelsArgs}>
            All {allModelsCount} Catalog Models on {hardware.short_name}
          </h2>
          <p class="mt-1 text-sm text-[var(--ink-secondary)]">
            <span class="font-mono text-[var(--ink-primary)]">Q4_K_M @ 8K FP16 KV</span> · {effectiveUsableGb.toFixed(1)} GB usable (Daily Desktop)
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter models by status">
          {statusFilters.map((st) => (
            <button
              type="button"
              data-gpu-status-btn={st.key}
              data-active={st.key === 'all' ? 'true' : 'false'}
              data-i18n={st.i18nKey}
              data-i18n-args={st.i18nArgs}
              class="pill-filter"
            >
              {st.label}
            </button>
          ))}
        </div>
      </div>

      <div id="gpu-table-wrap" class="table-shell mt-4">
        <table class="w-full min-w-[880px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-[var(--border-subtle)] bg-[var(--bg-subtle)] text-xs font-semibold uppercase tracking-wider text-[var(--ink-secondary)]">
              <th class="px-3 py-3" data-i18n="sim.colModel">Model</th>
              <th class="px-2.5 py-3" data-i18n="score.aiCol">AI Score (AA / Arena)</th>
              <th class="px-2.5 py-3" data-i18n="detail.colStatus">Fit / Speed</th>
              <th class="px-2.5 py-3" data-i18n="home.modelTableQ4">Q4_K_M @ 8K</th>
              <th class="px-2.5 py-3" data-i18n="detail.colGpuLayers">GPU Layers</th>
              <th class="px-2.5 py-3" data-i18n="hub.colSpeed8k">Formula Speed (Q4 @ 8K)</th>
              <th class="px-2.5 py-3">AWQ / MLX @ 8K</th>
              <th class="px-2.5 py-3" data-i18n="hub.bestQuantMaxCtx">Max Fit &amp; @Max VRAM</th>
              <th class="px-3 py-3 text-right" data-i18n="hub.colCalculator">Calculator</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border-hairline)]">
            {rows.map((row) => {
              const res = row.result;
              const tier = res.speed_tier ?? 'Readable';
              const tpsText = formatTpsRange(res.est_tps_low, res.est_tps_high, res.est_tps, res.status);
              const fillPct = Math.min(100, Math.round((res.total_vram_gb / effectiveUsableGb) * 100));
              const fillColor =
                res.status === 'Fits'
                  ? 'bg-emerald-500'
                  : res.status === 'Tight Fit'
                    ? 'bg-orange-500'
                    : res.status === 'Partial Offload'
                      ? 'bg-amber-500'
                      : 'bg-rose-500';
              const barClass = `h-full rounded-full ${fillColor}`;
              const barStyle = `width: ${fillPct}%`;
              const speedBadgeClass =
                res.status === 'OOM'
                  ? 'font-mono font-semibold text-rose-600 dark:text-rose-400 tabular-nums whitespace-nowrap'
                  : 'font-mono font-bold text-[var(--ink-primary)] tabular-nums whitespace-nowrap';
              const actionClass = row.isCurated
                ? 'badge-accent px-2.5 py-1 text-xs font-semibold hover:opacity-85 transition-opacity whitespace-nowrap'
                : 'btn-secondary px-2.5 py-1 text-xs whitespace-nowrap';
              const actionText = row.isCurated ? 'Open Guide ->' : 'Simulate ->';
              const actionI18n = row.isCurated ? 'common.openGuide' : 'common.simulate';
              const moeLabel = row.model.active_params_b ? ` · MoE ${row.model.active_params_b}B` : '';
              const modelHubHref = `/model/${row.model.id}/`;
              const maxFitSpeedPart =
                row.maxFitTpsHigh > 0 ? ` (~${row.maxFitTpsLow}–${row.maxFitTpsHigh} tok/s)` : '';
              const maxCtxLabel =
                row.maxFitCtx > 0
                  ? `${formatContextLabel(row.maxFitCtx)} · ${row.maxFitVramGb.toFixed(1)} GB${maxFitSpeedPart}`
                  : 'Offload / Q8 KV';
              const altSpeedStr =
                row.altRow.status === 'OOM'
                  ? 'OOM'
                  : `~${row.altRow.est_tps_low}–${row.altRow.est_tps_high} tok/s`;
              const altSummaryLine = `${row.altRow.total_vram_gb.toFixed(1)} GB · ${altSpeedStr}`;
              const altCellClass =
                row.altRow.status === 'OOM'
                  ? 'font-mono text-xs text-rose-600 dark:text-rose-400 tabular-nums'
                  : 'font-mono text-xs text-[var(--ink-secondary)] tabular-nums';

              return (
                <tr data-gpu-row data-status={res.status} class="hover:bg-[var(--bg-hover)] transition-colors">
                  <td class="px-3 py-3.5 align-top">
                    <div class="flex flex-wrap items-center gap-1.5">
                      <a href={row.href} class="font-bold text-[var(--ink-primary)] hover:text-[var(--accent-ink)] transition-colors">
                        {row.model.name}
                      </a>
                      {row.isCurated ? (
                        <span class="badge-accent rounded px-1.5 py-0.5 text-[10px]" data-i18n="common.fullGuide">
                          Full Guide
                        </span>
                      ) : (
                        <span class="badge-neutral rounded px-1.5 py-0.5 text-[10px]" data-i18n="common.liveCalc">
                          Live Calc
                        </span>
                      )}
                    </div>
                    <div class="mt-0.5 flex flex-wrap items-center gap-2 text-xs text-[var(--ink-tertiary)]">
                      <span class="font-mono">{row.model.params_b}B{moeLabel}</span>
                      <span>·</span>
                      <a href={modelHubHref} class="hover:text-[var(--ink-primary)] underline decoration-[var(--border-strong)] underline-offset-2">
                        {row.model.family}
                      </a>
                    </div>
                  </td>
                  <td class="px-2.5 py-3.5 align-top font-mono text-[11px] whitespace-nowrap">
                    {row.model.aa_index || row.model.arena_elo ? (
                      <div class="flex flex-col gap-1">
                        {row.model.aa_index && (
                          <span
                            class="badge-accent inline-flex w-fit rounded px-1.5 py-0.5 font-semibold"
                            title={row.model.aa_label ?? 'Artificial Analysis Intelligence Index v5.0.2'}
                          >
                            AA v5 · {row.model.aa_index}
                          </span>
                        )}
                        {row.model.arena_elo && (
                          <span
                            class="inline-flex w-fit rounded border border-[var(--border-hairline)] bg-[var(--bg-subtle)] px-1.5 py-0.5 text-[var(--ink-secondary)]"
                            title={row.model.arena_rank ? `LMArena Text Arena #${row.model.arena_rank} (2026-11-22)` : 'LMArena Text Arena Elo (2026-11-22)'}
                          >
                            Arena · {row.model.arena_elo}
                          </span>
                        )}
                      </div>
                    ) : (
                      <span class="text-[var(--ink-tertiary)]">—</span>
                    )}
                  </td>
                  <td class="px-2.5 py-3.5 align-top">
                    <div class="flex flex-wrap items-center gap-1">
                      <StatusBadge status={res.status} />
                      <SpeedBadge tier={tier} />
                    </div>
                  </td>
                  <td class="px-2.5 py-3.5 align-top">
                    <div class="font-mono text-xs font-semibold text-[var(--ink-primary)] tabular-nums whitespace-nowrap">
                      {res.total_vram_gb.toFixed(2)} / {effectiveUsableGb.toFixed(1)} GB
                    </div>
                    <div class="mt-1.5 h-1.5 w-24 overflow-hidden rounded-full bg-[var(--border-subtle)]">
                      <div class={barClass} style={barStyle}></div>
                    </div>
                  </td>
                  <td class="px-2.5 py-3.5 align-top font-mono text-xs text-[var(--ink-secondary)] tabular-nums whitespace-nowrap">
                    {res.gpu_layers_fit}/{res.total_layers}
                  </td>
                  <td class="px-2.5 py-3.5 align-top">
                    <span class={speedBadgeClass}>{tpsText}</span>
                    {res.status !== 'OOM' && (
                      <span class="block text-[10px] text-[var(--ink-tertiary)]" data-i18n="speed.formulaEst">Formula est.</span>
                    )}
                  </td>
                  <td class="px-2.5 py-3.5 align-top">
                    <div class="font-mono text-[11px] font-semibold text-[var(--ink-primary)]">{row.altRow.format}</div>
                    <div class={altCellClass}>{altSummaryLine}</div>
                  </td>
                  <td class="px-2.5 py-3.5 align-top text-xs">
                    <div class="font-mono font-semibold text-[var(--ink-primary)]">{row.recQuant}</div>
                    <div class="mt-0.5 text-[var(--ink-tertiary)]">{maxCtxLabel}</div>
                  </td>
                  <td class="px-3 py-3.5 align-top text-right">
                    <a href={row.href} class={actionClass} data-i18n={actionI18n}>
                      {actionText}
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div
        id="gpu-empty-state"
        class="surface-card mt-4 hidden border-dashed p-8 text-center"
      >
        <p class="text-sm font-semibold text-[var(--ink-primary)]" data-i18n="hub.noMatchingConfigs">
          No models on {hardware.short_name} match this compatibility filter.
        </p>
        <button
          id="gpu-filter-reset"
          type="button"
          data-i18n="status.allWithCount"
          data-i18n-args={showAllArgs}
          class="btn-mono mt-3 text-xs"
        >
          Show All ({allModelsCount})
        </button>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="gpu-faq-heading">
      <h2 id="gpu-faq-heading" class="text-xl font-bold tracking-tight text-[var(--ink-primary)]" data-i18n="hub.faqForTarget" data-i18n-args={faqTargetArgs}>
        Frequently Asked Questions ({hardware.short_name})
      </h2>
      <div class="mt-4 space-y-3">
        {faq.map((item, idx) => (
          <details
            open={idx < 2}
            class="surface-card group px-5 py-4 open:border-[var(--accent-border)]"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-[var(--ink-primary)]">
              <span>{item.question}</span>
              <span class="shrink-0 font-mono text-[var(--ink-tertiary)] group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-[var(--ink-secondary)]">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

    {relatedHardware.length > 0 && (
      <section class="mt-12 border-t border-[var(--border-subtle)] pt-8" aria-labelledby="other-gpus-heading">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 id="other-gpus-heading" class="text-xl font-bold tracking-tight text-[var(--ink-primary)]" data-i18n="hub.compareSimilarHw">
              Compare Similar Hardware Hubs
            </h2>
            <p class="mt-1 text-sm text-[var(--ink-secondary)]">
              {hardware.vendor} · {hardware.backend}
            </p>
          </div>
          <a href="/gpu/" class="text-xs font-semibold text-[var(--accent-ink)] hover:underline shrink-0" data-i18n="hub.browseAllHw" data-i18n-args={browseAllHwArgs}>
            Browse All {allHardware.length} Hardware Hubs -&gt;
          </a>
        </div>

        <div class="mt-4 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
          {relatedHardware.map((other) => {
            const otherHref = `/gpu/${other.id}/`;
            return (
              <a
                href={otherHref}
                class="surface-card-interactive flex flex-col justify-between p-4"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 text-xs">
                    <span class="font-mono font-semibold text-[var(--ink-tertiary)]">{other.vendor} · {other.backend}</span>
                    <span class="font-mono font-bold text-[var(--ink-primary)] tabular-nums">{other.vram_gb} GB</span>
                  </div>
                  <p class="mt-2 text-sm font-bold text-[var(--ink-primary)]">{other.name}</p>
                </div>
                <div class="mt-3 flex items-center justify-between text-xs text-[var(--ink-secondary)]">
                  <span class="font-mono tabular-nums">{other.bandwidth_gbps} GB/s</span>
                  <span class="font-semibold text-[var(--accent-ink)]" data-i18n="hub.gpuHubLabel">GPU Hub -&gt;</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script is:inline>
  (function () {
    const buttons = Array.from(document.querySelectorAll('[data-gpu-status-btn]'));
    const rows = Array.from(document.querySelectorAll('[data-gpu-row]'));
    const tableWrap = document.getElementById('gpu-table-wrap');
    const emptyState = document.getElementById('gpu-empty-state');
    const resetBtn = document.getElementById('gpu-filter-reset');

    function applyFilter(selected) {
      let norm = selected;
      if (norm === 'Smooth') norm = 'Fits';
      let visible = 0;
      rows.forEach((row) => {
        const match = norm === 'all' || row.getAttribute('data-status') === norm;
        row.classList.toggle('hidden', !match);
        if (match) visible += 1;
      });

      buttons.forEach((b) => {
        const active = (b.getAttribute('data-gpu-status-btn') || 'all') === norm;
        b.setAttribute('data-active', active ? 'true' : 'false');
      });

      if (tableWrap) tableWrap.classList.toggle('hidden', visible === 0);
      if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        applyFilter(btn.getAttribute('data-gpu-status-btn') || 'all');
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => applyFilter('all'));
    }
  })();
</script>
