---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import SpeedBadge from '../../components/SpeedBadge.astro';
import rawPagesData from '../../data/pages_data.json';
import type { HardwareSpec, VramPageEntry } from '../../types/vram';
import { formatContextLabel, formatTpsRange } from '../../utils/physics';
import {
  buildHardwareFaq,
  buildHardwareHubs,
  getBenchmarksMethodologyNote,
  getCatalogUpdatedAt,
  getReferenceBenchmarks,
  type HardwareHub,
} from '../../utils/hubs';

export function getStaticPaths() {
  const allEntries = rawPagesData as VramPageEntry[];
  const hubs = buildHardwareHubs(allEntries);
  const allHardware = hubs.map((h) => h.hardware);

  return hubs.map((hub) => ({
    params: { hardware: hub.hardware.id },
    props: {
      hub,
      allHardware,
      totalSiteEntries: allEntries.length,
    },
  }));
}

interface Props {
  hub: HardwareHub;
  allHardware: HardwareSpec[];
  totalSiteEntries: number;
}

const { hub, allHardware, totalSiteEntries } = Astro.props;
const {
  hardware,
  effectiveUsableGb,
  rows,
  fitsCount,
  tightCount,
  partialCount,
  oomCount,
  picks,
} = hub;

const updatedAt = getCatalogUpdatedAt();
const faq = buildHardwareFaq(hub);
const allModelsCount = rows.length;
const refBenchmarks = getReferenceBenchmarks({ hardwareId: hardware.id });
const refNote = getBenchmarksMethodologyNote();

const relatedHardware = allHardware
  .filter((h) => h.id !== hardware.id)
  .sort((a, b) => {
    const aSameVendor = a.vendor === hardware.vendor ? 0 : 1;
    const bSameVendor = b.vendor === hardware.vendor ? 0 : 1;
    if (aSameVendor !== bSameVendor) return aSameVendor - bSameVendor;
    const vDiff =
      Math.abs(a.usable_vram_gb - hardware.usable_vram_gb) -
      Math.abs(b.usable_vram_gb - hardware.usable_vram_gb);
    if (vDiff !== 0) return vDiff;
    return b.bandwidth_gbps - a.bandwidth_gbps;
  })
  .slice(0, 6);

const gpuCount = hardware.gpu_count ?? 1;
const topologyLabel =
  gpuCount > 1
    ? `${gpuCount}x GPU Split (${hardware.backend})`
    : hardware.is_unified
      ? `Unified Memory (${hardware.backend})`
      : `Discrete Single GPU (${hardware.backend})`;

const topPickRow = picks[0]?.row;
const topPickSummary = topPickRow
  ? `${topPickRow.model.short_name} (${formatTpsRange(
      topPickRow.result.est_tps_low,
      topPickRow.result.est_tps_high,
      topPickRow.result.est_tps,
      topPickRow.result.status,
    )})`
  : `${allModelsCount} models evaluated`;

const isMultiCapable = !hardware.is_unified && hardware.category !== 'Laptop GPU';
const simActionHref = isMultiCapable
  ? `/calculator/?hw=${encodeURIComponent(hardware.id)}&gpus=2`
  : `/calculator/?hw=${encodeURIComponent(hardware.id)}`;
const simActionLabel = isMultiCapable
  ? 'Simulate 1x–8x Multi-GPU & AWQ/MLX ->'
  : 'Open Format & Reserve Simulator ->';

const canonicalPath = `/gpu/${hardware.id}/`;
const pageTitle = `Best Local AI Models for ${hardware.name} — VRAMCalc.me`;
const pageDescription = `${hardware.name} exposes ${effectiveUsableGb.toFixed(1)} GB usable ${hardware.memory_type} (${hardware.bandwidth_gbps} GB/s). Inspect all ${allModelsCount} LLMs (${fitsCount} Fits, ${tightCount} Tight Fit at Q4_K_M @ 8K) plus AWQ/MLX & Max Context.`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vramcalc.me/' },
    { '@type': 'ListItem', position: 2, name: 'All GPUs', item: 'https://vramcalc.me/gpu/' },
    { '@type': 'ListItem', position: 3, name: hardware.name, item: `https://vramcalc.me/gpu/${hardware.id}/` },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Local LLM Compatibility Matrix for ${hardware.name}`,
  numberOfItems: rows.length,
  itemListElement: rows.map((r, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: `${r.model.name} on ${hardware.short_name}`,
    url: r.isCurated
      ? `https://vramcalc.me${r.href}`
      : `https://vramcalc.me/model/${r.model.id}/`,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const statusFilters = [
  { key: 'all', label: `All (${allModelsCount})`, i18nKey: 'status.allWithCount', i18nArgs: JSON.stringify({ count: allModelsCount }) },
  { key: 'Fits', label: `Fits (${fitsCount})`, i18nKey: 'status.fitsWithCount', i18nArgs: JSON.stringify({ count: fitsCount }) },
  { key: 'Tight Fit', label: `Tight Fit (${tightCount})`, i18nKey: 'status.tightWithCount', i18nArgs: JSON.stringify({ count: tightCount }) },
  { key: 'Partial Offload', label: `Partial Offload (${partialCount})`, i18nKey: 'status.partialWithCount', i18nArgs: JSON.stringify({ count: partialCount }) },
  { key: 'OOM', label: `OOM (${oomCount})`, i18nKey: 'status.oomWithCount', i18nArgs: JSON.stringify({ count: oomCount }) },
] as const;

const simBtnI18nKey = isMultiCapable ? 'hub.simMultiGpuBtn' : 'hub.open7QuantBtn';
const bestModelsForArgs = JSON.stringify({ hw: hardware.name });
const recBestModelsArgs = JSON.stringify({ hw: hardware.short_name });
const allCatalogModelsArgs = JSON.stringify({ count: allModelsCount, hw: hardware.short_name });
const faqTargetArgs = JSON.stringify({ target: hardware.short_name });
const showAllArgs = JSON.stringify({ count: allModelsCount });
const browseAllHwArgs = JSON.stringify({ count: allHardware.length });
const updatedArgs = JSON.stringify({ date: updatedAt });
const ogTitle = `${hardware.name}: ${fitsCount + tightCount}/${allModelsCount} Local LLMs Fit`;
const ogDescription = `${effectiveUsableGb.toFixed(1)} GB usable ${hardware.memory_type} (${hardware.bandwidth_gbps} GB/s). Top fit: ${topPickSummary}.`;
const ogImage = `/og/gpu-${hardware.id}.png`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  totalPages={totalSiteEntries}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  ogImageAlt={ogTitle}
  themeColor="#2563eb"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <article class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-4">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs font-medium text-slate-500">
        <li>
          <a href="/" class="hover:text-slate-900 transition-colors" data-i18n="common.home">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/gpu/" class="hover:text-slate-900 transition-colors" data-i18n="nav.gpus">GPUs</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-slate-900 font-semibold truncate">
          {hardware.name}
        </li>
      </ol>
    </nav>

    <header class="rounded-2xl border border-slate-800 bg-slate-950 p-6 text-slate-100 shadow-xs sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full border border-blue-500/40 bg-blue-500/15 px-2.5 py-0.5 font-mono text-xs font-semibold text-blue-300">
            {hardware.vendor} · {hardware.backend}
          </span>
          <span class="rounded-full border border-slate-700 bg-slate-900 px-2.5 py-0.5 font-mono text-xs text-slate-300">
            {hardware.series}
          </span>
          <span class="rounded-full border border-slate-700 bg-slate-900 px-2.5 py-0.5 font-mono text-xs text-slate-300">
            {hardware.category}
          </span>
          <span class="rounded-full border border-slate-700 bg-slate-900 px-2.5 py-0.5 font-mono text-xs text-emerald-300">
            {hardware.memory_type}
          </span>
          <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 font-mono text-xs text-emerald-300" data-i18n="common.updated" data-i18n-args={updatedArgs}>
            Updated {updatedAt}
          </span>
        </div>

        <a
          href={simActionHref}
          data-i18n={simBtnI18nKey}
          class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-2 text-xs font-semibold text-white hover:bg-blue-500 transition-colors"
        >
          {simActionLabel}
        </a>
      </div>

      <h1 class="mt-4 text-2xl font-extrabold tracking-tight text-white sm:text-4xl" data-i18n="hub.bestModelsFor" data-i18n-args={bestModelsForArgs}>
        Best Local AI Models for {hardware.name}
      </h1>

      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-300 sm:text-base">
        Under Daily Desktop reserve, <strong class="text-white font-mono">{effectiveUsableGb.toFixed(1)} GB</strong> of{' '}
        {hardware.vram_gb} GB physical {hardware.backend} memory is usable ({hardware.bandwidth_gbps} GB/s). Across all{' '}
        <strong class="text-white">{allModelsCount}</strong> LLMs at Q4_K_M @ 8K:{' '}
        <span class="text-emerald-300 font-semibold">{fitsCount} Fits</span>,{' '}
        <span class="text-orange-300 font-semibold">{tightCount} Tight Fit</span>,{' '}
        <span class="text-amber-300 font-semibold">{partialCount} Partial Offload</span>, and{' '}
        <span class="text-rose-300 font-semibold">{oomCount} OOM</span>.
      </p>

      <dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400">Usable / Total VRAM</dt>
          <dd class="mt-1 font-mono text-lg font-bold text-white tabular-nums">
            {effectiveUsableGb.toFixed(1)} / {hardware.vram_gb} GB
          </dd>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400">Memory Bandwidth</dt>
          <dd class="mt-1 font-mono text-lg font-bold text-sky-300 tabular-nums">
            {hardware.bandwidth_gbps} GB/s
          </dd>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400">Topology &amp; Backend</dt>
          <dd class="mt-1 font-mono text-sm font-bold text-slate-100">
            {topologyLabel}
          </dd>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400">Full {allModelsCount}-LLM Fit</dt>
          <dd class="mt-1 font-mono text-sm font-bold text-emerald-300 tabular-nums">
            {fitsCount} Fits · {tightCount} Tight · {partialCount} Offload
          </dd>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400">Reference MSRP</dt>
          <dd class="mt-1 font-mono text-lg font-bold text-white tabular-nums">
            ${hardware.msrp_usd.toLocaleString()}
          </dd>
        </div>
      </dl>
    </header>

    {refBenchmarks.length > 0 && (
      <section class="mt-7 rounded-2xl border border-sky-200 bg-sky-50/70 p-5" aria-labelledby="gpu-ref-benchmarks">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 id="gpu-ref-benchmarks" class="text-base font-bold text-slate-950" data-i18n="speed.refBenchmark">
            Measured Community Benchmarks
          </h2>
          <span class="rounded-md bg-white/90 px-2 py-0.5 font-mono text-[11px] font-semibold text-emerald-800 border border-emerald-200" data-i18n="speed.measuredBadge">
            Measured
          </span>
        </div>
        <p class="mt-1 text-xs text-slate-600">{refNote}</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {refBenchmarks.map((anc) => (
            <div class="rounded-xl border border-sky-200 bg-white p-3.5 text-xs">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="font-mono font-bold text-slate-950">
                  {anc.model_id} · {anc.quant} @ {formatContextLabel(anc.context_tokens)}
                </span>
                <span class="font-mono font-bold text-emerald-700">
                  {anc.gen_tps_low}–{anc.gen_tps_high} tok/s measured
                </span>
              </div>
              <p class="mt-1 text-slate-600">{anc.notes}</p>
              <div class="mt-1.5 text-[11px] text-slate-500">
                <span data-i18n="speed.refSource">Source</span>:{' '}
                <a href={anc.source_url} target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-900">
                  {anc.source_label}
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {picks.length > 0 && (
      <section class="mt-10" aria-labelledby="recommended-models-heading">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 id="recommended-models-heading" class="text-xl font-bold tracking-tight text-slate-950" data-i18n="hub.recBestModels" data-i18n-args={recBestModelsArgs}>
              Top Recommended Models for {hardware.short_name}
            </h2>
            <p class="mt-1 text-sm text-slate-600">
              {effectiveUsableGb.toFixed(1)} GB usable VRAM · {hardware.bandwidth_gbps} GB/s
            </p>
          </div>
          <a href="/" class="text-xs font-semibold text-blue-600 hover:text-blue-800 shrink-0" data-i18n="detail.viewFullMatrix">
            View Full Matrix -&gt;
          </a>
        </div>

        <div class="mt-4 grid gap-4 md:grid-cols-3">
          {picks.map((pick) => {
            const row = pick.row;
            const res = row.result;
            const tier = res.speed_tier ?? 'Readable';
            const speedText = formatTpsRange(res.est_tps_low, res.est_tps_high, res.est_tps, res.status);
            const maxCtx =
              row.maxFitCtx > 0
                ? `${formatContextLabel(row.maxFitCtx)} (${row.maxFitVramGb.toFixed(1)} GB)`
                : 'Offload/Q8';
            const roleClass = `inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-semibold ${pick.accent}`;
            const modelHref = `/model/${row.model.id}/`;
            const summaryText = row.curatedEntry
              ? row.curatedEntry.verdict_summary
              : `${hardware.short_name} runs ${row.model.name} (${res.weights_gb.toFixed(2)} GB weights @ Q4_K_M) in status ${res.status} with ${maxCtx} resident context headroom.`;
            const ctaI18n = row.isCurated ? 'common.openGuide' : 'common.simulate';
            const ctaText = row.isCurated ? 'Open Guide ->' : 'Simulate ->';

            return (
              <div class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-xs hover:border-blue-300 transition-colors">
                <div>
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class={roleClass}>{pick.role}</span>
                    <div class="flex items-center gap-1.5">
                      <StatusBadge status={res.status} />
                      <SpeedBadge tier={tier} />
                    </div>
                  </div>

                  <h3 class="mt-3 text-lg font-bold tracking-tight text-slate-950">
                    <a href={row.href} class="hover:text-blue-600 transition-colors">
                      {row.model.name}
                    </a>
                  </h3>
                  <p class="mt-0.5 font-mono text-xs text-slate-500">
                    {row.model.params_b}B · {row.model.architecture} · {row.recQuant}
                  </p>

                  <p class="mt-2.5 text-xs leading-relaxed text-slate-600 line-clamp-3">
                    {summaryText}
                  </p>
                </div>

                <div class="mt-4 border-t border-slate-100 pt-3.5">
                  <div class="grid grid-cols-3 gap-2 text-xs">
                    <div>
                      <span class="block text-[11px] text-slate-500" data-i18n="speed.formulaEst">Formula est.</span>
                      <span class="font-mono font-bold text-slate-950 tabular-nums">{speedText}</span>
                    </div>
                    <div>
                      <span class="block text-[11px] text-slate-500" data-i18n="common.vram8kLabel">VRAM @ 8K</span>
                      <span class="font-mono font-semibold text-slate-900 tabular-nums">
                        {res.total_vram_gb.toFixed(1)} GB
                      </span>
                    </div>
                    <div>
                      <span class="block text-[11px] text-slate-500" data-i18n="detail.maxSmoothCtx">Max Fit</span>
                      <span class="font-mono font-semibold text-slate-900 tabular-nums">{maxCtx}</span>
                    </div>
                  </div>

                  <div class="mt-3.5 flex items-center justify-between gap-2 text-xs font-semibold">
                    <a href={modelHref} class="text-slate-600 hover:text-slate-950 transition-colors" data-i18n="hub.compareGpusLink">
                      Compare GPUs -&gt;
                    </a>
                    <a href={row.href} class="text-blue-600 hover:text-blue-800 transition-colors" data-i18n={ctaI18n}>
                      {ctaText}
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <section class="mt-10" aria-labelledby="gpu-models-table-heading">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 id="gpu-models-table-heading" class="text-xl font-bold tracking-tight text-slate-950" data-i18n="hub.allCatalogModelsHeading" data-i18n-args={allCatalogModelsArgs}>
            All {allModelsCount} Catalog Models on {hardware.short_name}
          </h2>
          <p class="mt-1 text-sm text-slate-600">
            <span class="font-mono text-slate-900">Q4_K_M @ 8K FP16 KV</span> · {effectiveUsableGb.toFixed(1)} GB usable (Daily Desktop)
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter models by status">
          {statusFilters.map((st) => {
            const btnClass =
              st.key === 'all'
                ? 'rounded-full border px-3 py-1 text-xs font-semibold transition-colors cursor-pointer border-slate-900 bg-slate-900 text-white'
                : 'rounded-full border px-3 py-1 text-xs font-semibold transition-colors cursor-pointer border-slate-200 bg-white text-slate-700 hover:bg-slate-100';
            return (
              <button
                type="button"
                data-gpu-status-btn={st.key}
                data-i18n={st.i18nKey}
                data-i18n-args={st.i18nArgs}
                class={btnClass}
              >
                {st.label}
              </button>
            );
          })}
        </div>
      </div>

      <div id="gpu-table-wrap" class="mt-4 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-xs">
        <table class="w-full min-w-[880px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50 text-xs font-semibold uppercase tracking-wider text-slate-500">
              <th class="px-4 py-3" data-i18n="sim.colModel">Model</th>
              <th class="px-4 py-3" data-i18n="detail.colStatus">Fit / Speed</th>
              <th class="px-4 py-3" data-i18n="detail.colTotalVram">VRAM @ 8K</th>
              <th class="px-4 py-3" data-i18n="detail.colGpuLayers">GPU Layers</th>
              <th class="px-4 py-3" data-i18n="hub.colSpeed8k">Formula Speed (Q4 @ 8K)</th>
              <th class="px-4 py-3" data-i18n="hub.bestQuantMaxCtx">Max Fit &amp; @Max VRAM</th>
              <th class="px-4 py-3 text-right" data-i18n="hub.colCalculator">Calculator</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {rows.map((row) => {
              const res = row.result;
              const tier = res.speed_tier ?? 'Readable';
              const tpsText = formatTpsRange(res.est_tps_low, res.est_tps_high, res.est_tps, res.status);
              const fillPct = Math.min(100, Math.round((res.total_vram_gb / effectiveUsableGb) * 100));
              const fillColor =
                res.status === 'Fits'
                  ? 'bg-emerald-500'
                  : res.status === 'Tight Fit'
                    ? 'bg-orange-500'
                    : res.status === 'Partial Offload'
                      ? 'bg-amber-500'
                      : 'bg-rose-500';
              const barClass = `h-full rounded-full ${fillColor}`;
              const barStyle = `width: ${fillPct}%`;
              const speedBadgeClass =
                res.status === 'OOM'
                  ? 'font-mono font-semibold text-rose-700 tabular-nums'
                  : 'font-mono font-bold text-slate-950 tabular-nums';
              const actionClass = row.isCurated
                ? 'inline-flex items-center rounded-lg border border-blue-200 bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700 hover:bg-blue-100 transition-colors'
                : 'inline-flex items-center rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 hover:border-blue-300 hover:text-blue-700 transition-colors';
              const actionText = row.isCurated ? 'Open Guide ->' : 'Simulate ->';
              const actionI18n = row.isCurated ? 'common.openGuide' : 'common.simulate';
              const moeLabel = row.model.active_params_b ? ` · MoE ${row.model.active_params_b}B` : '';
              const modelHubHref = `/model/${row.model.id}/`;
              const maxCtxLabel =
                row.maxFitCtx > 0
                  ? `${formatContextLabel(row.maxFitCtx)} · ${row.maxFitVramGb.toFixed(1)} GB`
                  : 'Offload / Q8 KV';

              return (
                <tr data-gpu-row data-status={res.status} class="hover:bg-slate-50/70 transition-colors">
                  <td class="px-4 py-3.5 align-top">
                    <div class="flex flex-wrap items-center gap-1.5">
                      <a href={row.href} class="font-bold text-slate-950 hover:text-blue-600 transition-colors">
                        {row.model.name}
                      </a>
                      {row.isCurated ? (
                        <span class="rounded bg-blue-50 px-1.5 py-0.5 text-[10px] font-semibold text-blue-700" data-i18n="common.fullGuide">
                          Full Guide
                        </span>
                      ) : (
                        <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-semibold text-slate-500" data-i18n="common.liveCalc">
                          Live Calc
                        </span>
                      )}
                    </div>
                    <div class="mt-0.5 flex flex-wrap items-center gap-2 text-xs text-slate-500">
                      <span class="font-mono">{row.model.params_b}B{moeLabel}</span>
                      <span>·</span>
                      <a href={modelHubHref} class="hover:text-slate-900 underline decoration-slate-300 underline-offset-2">
                        {row.model.family}
                      </a>
                    </div>
                  </td>
                  <td class="px-4 py-3.5 align-top">
                    <div class="flex flex-wrap items-center gap-1">
                      <StatusBadge status={res.status} />
                      <SpeedBadge tier={tier} />
                    </div>
                  </td>
                  <td class="px-4 py-3.5 align-top">
                    <div class="font-mono text-xs font-semibold text-slate-900 tabular-nums">
                      {res.total_vram_gb.toFixed(2)} / {effectiveUsableGb.toFixed(1)} GB
                    </div>
                    <div class="mt-1.5 h-1.5 w-28 overflow-hidden rounded-full bg-slate-100">
                      <div class={barClass} style={barStyle}></div>
                    </div>
                  </td>
                  <td class="px-4 py-3.5 align-top font-mono text-slate-700 tabular-nums">
                    {res.gpu_layers_fit}/{res.total_layers}
                  </td>
                  <td class="px-4 py-3.5 align-top">
                    <span class={speedBadgeClass}>{tpsText}</span>
                    {res.status !== 'OOM' && (
                      <span class="block text-[10px] text-slate-400" data-i18n="speed.formulaEst">Formula est.</span>
                    )}
                  </td>
                  <td class="px-4 py-3.5 align-top text-xs">
                    <div class="font-mono font-semibold text-slate-900">{row.recQuant}</div>
                    <div class="mt-0.5 text-slate-500">{maxCtxLabel}</div>
                  </td>
                  <td class="px-4 py-3.5 align-top text-right">
                    <a href={row.href} class={actionClass} data-i18n={actionI18n}>
                      {actionText}
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div
        id="gpu-empty-state"
        class="mt-4 hidden rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center"
      >
        <p class="text-sm font-semibold text-slate-900" data-i18n="hub.noMatchingConfigs">
          No models on {hardware.short_name} match this compatibility filter.
        </p>
        <button
          id="gpu-filter-reset"
          type="button"
          data-i18n="status.allWithCount"
          data-i18n-args={showAllArgs}
          class="mt-3 rounded-lg bg-slate-900 px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-slate-800 cursor-pointer"
        >
          Show All ({allModelsCount})
        </button>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="gpu-faq-heading">
      <h2 id="gpu-faq-heading" class="text-xl font-bold tracking-tight text-slate-950" data-i18n="hub.faqForTarget" data-i18n-args={faqTargetArgs}>
        Frequently Asked Questions ({hardware.short_name})
      </h2>
      <div class="mt-4 space-y-3">
        {faq.map((item, idx) => (
          <details
            open={idx < 2}
            class="group rounded-xl border border-slate-200 bg-white px-5 py-4 open:border-blue-200"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-950">
              <span>{item.question}</span>
              <span class="shrink-0 font-mono text-slate-400 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

    {relatedHardware.length > 0 && (
      <section class="mt-12 border-t border-slate-200 pt-8" aria-labelledby="other-gpus-heading">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 id="other-gpus-heading" class="text-xl font-bold tracking-tight text-slate-950" data-i18n="hub.compareSimilarHw">
              Compare Similar Hardware Hubs
            </h2>
            <p class="mt-1 text-sm text-slate-600">
              {hardware.vendor} · {hardware.backend}
            </p>
          </div>
          <a href="/gpu/" class="text-xs font-semibold text-blue-600 hover:text-blue-800 shrink-0" data-i18n="hub.browseAllHw" data-i18n-args={browseAllHwArgs}>
            Browse All {allHardware.length} Hardware Hubs -&gt;
          </a>
        </div>

        <div class="mt-4 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
          {relatedHardware.map((other) => {
            const otherHref = `/gpu/${other.id}/`;
            return (
              <a
                href={otherHref}
                class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-4 hover:border-blue-300 hover:shadow-sm transition-all"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 text-xs">
                    <span class="font-mono font-semibold text-slate-500">{other.vendor} · {other.backend}</span>
                    <span class="font-mono font-bold text-slate-900 tabular-nums">{other.vram_gb} GB</span>
                  </div>
                  <p class="mt-2 text-sm font-bold text-slate-950">{other.name}</p>
                </div>
                <div class="mt-3 flex items-center justify-between text-xs text-slate-600">
                  <span class="font-mono tabular-nums">{other.bandwidth_gbps} GB/s</span>
                  <span class="font-semibold text-blue-600" data-i18n="hub.gpuHubLabel">GPU Hub -&gt;</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script is:inline>
  (function () {
    const buttons = Array.from(document.querySelectorAll('[data-gpu-status-btn]'));
    const rows = Array.from(document.querySelectorAll('[data-gpu-row]'));
    const tableWrap = document.getElementById('gpu-table-wrap');
    const emptyState = document.getElementById('gpu-empty-state');
    const resetBtn = document.getElementById('gpu-filter-reset');

    function applyFilter(selected) {
      let norm = selected;
      if (norm === 'Smooth') norm = 'Fits';
      let visible = 0;
      rows.forEach((row) => {
        const match = norm === 'all' || row.getAttribute('data-status') === norm;
        row.classList.toggle('hidden', !match);
        if (match) visible += 1;
      });

      buttons.forEach((b) => {
        const active = (b.getAttribute('data-gpu-status-btn') || 'all') === norm;
        b.classList.toggle('border-slate-900', active);
        b.classList.toggle('bg-slate-900', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('border-slate-200', !active);
        b.classList.toggle('bg-white', !active);
        b.classList.toggle('text-slate-700', !active);
      });

      if (tableWrap) tableWrap.classList.toggle('hidden', visible === 0);
      if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        applyFilter(btn.getAttribute('data-gpu-status-btn') || 'all');
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => applyFilter('all'));
    }
  })();
</script>
