---
import BaseLayout from '../../layouts/BaseLayout.astro';
import rawPagesData from '../../data/pages_data.json';
import type { PageEntry } from '../../types/vram';
import { buildHardwareHubs } from '../../utils/hubs';

const allEntries = rawPagesData as PageEntry[];
const hubs = buildHardwareHubs(allEntries);

const totalHubs = hubs.length;
const totalConfigs = allEntries.length;
const nvidiaCount = hubs.filter((h) => h.hardware.vendor === 'NVIDIA').length;
const appleCount = hubs.filter((h) => h.hardware.vendor === 'Apple').length;
const amdCount = hubs.filter((h) => h.hardware.vendor === 'AMD').length;
const maxUsableVram = hubs.reduce((acc, h) => Math.max(acc, h.hardware.usable_vram_gb), 0);

const canonicalPath = '/gpu/';
const pageTitle = `All Local AI GPUs & Macs (${totalHubs} Hardware Hubs) — VRAMCalc.me`;
const pageDescription = `Compare ${totalHubs} local AI GPUs and unified-memory systems across NVIDIA (${nvidiaCount}), Apple Silicon (${appleCount}), and AMD (${amdCount}). Inspect usable VRAM up to ${maxUsableVram} GB, memory bandwidth, and Smooth LLM support.`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://vramcalc.me/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'All GPUs',
      item: 'https://vramcalc.me/gpu/',
    },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: 'https://vramcalc.me/gpu/',
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Local AI Hardware Hubs on VRAMCalc.me',
  numberOfItems: totalHubs,
  itemListElement: hubs.map((h, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: h.hardware.name,
    url: `https://vramcalc.me/gpu/${h.hardware.id}/`,
  })),
};

const vendorFilters = [
  { key: 'all', label: `All Vendors (${totalHubs})` },
  { key: 'NVIDIA', label: `NVIDIA (${nvidiaCount})` },
  { key: 'Apple', label: `Apple (${appleCount})` },
  { key: 'AMD', label: `AMD (${amdCount})` },
] as const;

const groupFilters = [
  'all',
  'Desktop GPU',
  'Multi-GPU & Workstation',
  'Unified Memory',
  'Laptop GPU',
] as const;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  totalPages={totalConfigs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>

  <article class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-4">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs font-medium text-slate-500">
        <li>
          <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-slate-900 font-semibold">All GPUs</li>
      </ol>
    </nav>

    <!-- Dark Tech Directory Hero -->
    <header class="rounded-2xl border border-slate-800 bg-slate-950 p-6 text-slate-100 shadow-xs sm:p-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full border border-blue-500/40 bg-blue-500/15 px-2.5 py-0.5 font-mono text-xs font-semibold text-blue-300">
          Hardware Directory
        </span>
        <span class="rounded-full border border-slate-700 bg-slate-900 px-2.5 py-0.5 font-mono text-xs text-slate-300">
          CUDA · Metal · ROCm
        </span>
      </div>

      <h1 class="mt-4 text-2xl font-extrabold tracking-tight text-white sm:text-4xl">
        All Local AI GPUs &amp; Unified Memory Systems
      </h1>

      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-300 sm:text-base">
        Browse <strong class="text-white">{totalHubs}</strong> dedicated hardware hubs covering NVIDIA RTX 30/40/50 &amp; Dual-GPU rigs,
        Apple Silicon M1–M5 unified memory Macs, DGX Spark GB10, and AMD Radeon / Strix Halo. Open any card to see which open-weight
        LLMs fit cleanly in VRAM and which trigger offload.
      </p>

      <dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400">Indexed GPUs &amp; Macs</dt>
          <dd class="mt-1 font-mono text-xl font-bold text-white tabular-nums">{totalHubs}</dd>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400">Vendor Coverage</dt>
          <dd class="mt-1 font-mono text-sm font-bold text-sky-300 tabular-nums">
            {nvidiaCount} NV · {appleCount} Apple · {amdCount} AMD
          </dd>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400">Usable Ceiling</dt>
          <dd class="mt-1 font-mono text-xl font-bold text-emerald-300 tabular-nums">Up to {maxUsableVram} GB</dd>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400">Total Benchmarks</dt>
          <dd class="mt-1 font-mono text-xl font-bold text-white tabular-nums">{totalConfigs} Pairings</dd>
        </div>
      </dl>
    </header>

    <!-- Filter Controls -->
    <section class="mt-7" aria-label="Filter hardware hubs">
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs sm:p-5">
        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
          <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter by vendor">
            {vendorFilters.map((vf) => {
              const vBtnClass =
                vf.key === 'all'
                  ? 'rounded-full border px-3 py-1 text-xs font-semibold transition-colors cursor-pointer border-slate-900 bg-slate-900 text-white'
                  : 'rounded-full border px-3 py-1 text-xs font-semibold transition-colors cursor-pointer border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100';
              return (
                <button type="button" data-dir-vendor-btn={vf.key} class={vBtnClass}>
                  {vf.label}
                </button>
              );
            })}
          </div>

          <div class="w-full md:w-72">
            <label for="dir-gpu-search" class="sr-only">Search hardware</label>
            <input
              id="dir-gpu-search"
              type="search"
              placeholder="Search e.g. 5090, M5 Max, 3090, Halo..."
              class="w-full rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-none"
            />
          </div>
        </div>

        <div class="mt-3 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-3">
          <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter by hardware class">
            {groupFilters.map((grp) => {
              const gBtnClass =
                grp === 'all'
                  ? 'rounded-full border px-3 py-1 text-xs font-semibold transition-colors cursor-pointer border-blue-600 bg-blue-600 text-white'
                  : 'rounded-full border px-3 py-1 text-xs font-semibold transition-colors cursor-pointer border-slate-200 bg-white text-slate-700 hover:bg-slate-100';
              const gLabel = grp === 'all' ? 'All Form Factors' : grp;
              return (
                <button type="button" data-dir-group-btn={grp} class={gBtnClass}>
                  {gLabel}
                </button>
              );
            })}
          </div>

          <div class="flex items-center gap-3 text-xs text-slate-600">
            <span id="dir-gpu-count" class="font-mono tabular-nums">
              Showing {totalHubs} of {totalHubs} hardware hubs
            </span>
            <button
              id="dir-gpu-reset"
              type="button"
              class="hidden font-semibold text-blue-600 hover:text-blue-800 cursor-pointer"
            >
              Reset
            </button>
          </div>
        </div>
      </div>

      <!-- Cards Grid -->
      <div id="dir-gpu-grid" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {hubs.map((hub) => {
          const hw = hub.hardware;
          const hubHref = `/gpu/${hw.id}/`;
          const topPick = hub.picks[0]?.entry;
          const topPickLabel = topPick
            ? `${topPick.model.short_name} (${topPick.default_result.est_tps.toFixed(1)} tok/s)`
            : 'See compatibility table';
          const searchBlob = [
            hw.name,
            hw.short_name,
            hw.vendor,
            hw.series,
            hub.group,
            hw.memory_type,
            hw.backend,
          ]
            .join(' ')
            .toLowerCase();

          return (
            <article
              data-dir-hw-card
              data-vendor={hw.vendor}
              data-group={hub.group}
              data-search={searchBlob}
              class="group flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 transition-all hover:border-blue-300 hover:shadow-md"
            >
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-slate-700">
                    {hw.vendor} · {hw.backend}
                  </span>
                  <span class="rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[11px] font-medium text-slate-600">
                    {hub.group}
                  </span>
                </div>

                <h2 class="mt-3 text-lg font-bold tracking-tight text-slate-950 group-hover:text-blue-600 transition-colors">
                  <a href={hubHref} class="focus:outline-none">
                    {hw.name}
                  </a>
                </h2>

                <div class="mt-2.5 grid grid-cols-2 gap-2 rounded-xl border border-slate-100 bg-slate-50/80 p-3 text-xs">
                  <div>
                    <span class="block text-[11px] text-slate-500">Usable / Total</span>
                    <span class="font-mono font-bold text-slate-950 tabular-nums">
                      {hw.usable_vram_gb} / {hw.vram_gb} GB
                    </span>
                  </div>
                  <div>
                    <span class="block text-[11px] text-slate-500">Bandwidth</span>
                    <span class="font-mono font-bold text-slate-950 tabular-nums">
                      {hw.bandwidth_gbps} GB/s
                    </span>
                  </div>
                </div>

                <div class="mt-3 flex flex-wrap items-center gap-1.5 text-[11px] font-mono">
                  <span class="rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 font-semibold text-emerald-800 tabular-nums">
                    {hub.smoothCount} Smooth
                  </span>
                  {hub.partialCount > 0 && (
                    <span class="rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 font-semibold text-amber-800 tabular-nums">
                      {hub.partialCount} Partial
                    </span>
                  )}
                  {hub.oomCount > 0 && (
                    <span class="rounded-full border border-rose-200 bg-rose-50 px-2 py-0.5 font-semibold text-rose-800 tabular-nums">
                      {hub.oomCount} OOM
                    </span>
                  )}
                </div>
              </div>

              <div class="mt-4 border-t border-slate-100 pt-3.5">
                <div class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">
                  Top Highlighted Fit
                </div>
                <div class="mt-0.5 font-mono text-xs font-semibold text-slate-800 truncate">
                  {topPickLabel}
                </div>

                <div class="mt-3 flex items-center justify-between text-xs">
                  <span class="font-mono text-slate-500">${hw.msrp_usd.toLocaleString()} MSRP</span>
                  <a href={hubHref} class="font-semibold text-blue-600 hover:text-blue-800">
                    View Hardware Hub -&gt;
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <div
        id="dir-gpu-empty"
        class="mt-8 hidden rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center"
      >
        <p class="text-base font-semibold text-slate-900">No matching hardware hubs</p>
        <button
          id="dir-gpu-empty-reset"
          type="button"
          class="mt-4 rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800 cursor-pointer"
        >
          Reset Filters
        </button>
      </div>
    </section>

    <!-- Cross-link Banner -->
    <section class="mt-12 rounded-2xl border border-slate-200 bg-white p-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-slate-950">
          Prefer Browsing by Open-Weight Model?
        </h2>
        <p class="mt-1 text-sm text-slate-600">
          Compare GPUs ranked side-by-side for DeepSeek-R1, Qwen2.5-Coder, Llama-3.3, and Mistral Small.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a
          href="/model/"
          class="rounded-lg bg-slate-950 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800 transition-colors"
        >
          Browse All Model Hubs -&gt;
        </a>
        <a
          href="/"
          class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors"
        >
          Full Compatibility Matrix -&gt;
        </a>
      </div>
    </section>
  </article>
</BaseLayout>

<script is:inline>
  (function () {
    const vendorBtns = Array.from(document.querySelectorAll('[data-dir-vendor-btn]'));
    const groupBtns = Array.from(document.querySelectorAll('[data-dir-group-btn]'));
    const searchInput = document.getElementById('dir-gpu-search');
    const cards = Array.from(document.querySelectorAll('[data-dir-hw-card]'));
    const countEl = document.getElementById('dir-gpu-count');
    const resetBtn = document.getElementById('dir-gpu-reset');
    const emptyState = document.getElementById('dir-gpu-empty');
    const emptyReset = document.getElementById('dir-gpu-empty-reset');
    const grid = document.getElementById('dir-gpu-grid');

    let selectedVendor = 'all';
    let selectedGroup = 'all';
    const total = cards.length;

    function updateButtons() {
      vendorBtns.forEach((b) => {
        const active = (b.getAttribute('data-dir-vendor-btn') || 'all') === selectedVendor;
        b.classList.toggle('border-slate-900', active);
        b.classList.toggle('bg-slate-900', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('border-slate-200', !active);
        b.classList.toggle('bg-slate-50', !active);
        b.classList.toggle('text-slate-700', !active);
      });
      groupBtns.forEach((b) => {
        const active = (b.getAttribute('data-dir-group-btn') || 'all') === selectedGroup;
        b.classList.toggle('border-blue-600', active);
        b.classList.toggle('bg-blue-600', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('border-slate-200', !active);
        b.classList.toggle('bg-white', !active);
        b.classList.toggle('text-slate-700', !active);
      });
    }

    function applyFilter() {
      const q = searchInput ? searchInput.value.trim().toLowerCase() : '';
      let visible = 0;

      cards.forEach((card) => {
        const mv = selectedVendor === 'all' || card.getAttribute('data-vendor') === selectedVendor;
        const mg = selectedGroup === 'all' || card.getAttribute('data-group') === selectedGroup;
        const blob = card.getAttribute('data-search') || '';
        const mq = !q || blob.includes(q);
        const show = mv && mg && mq;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });

      if (countEl) countEl.textContent = `Showing ${visible} of ${total} hardware hubs`;
      const isFiltered = selectedVendor !== 'all' || selectedGroup !== 'all' || q.length > 0;
      if (resetBtn) resetBtn.classList.toggle('hidden', !isFiltered);
      if (grid) grid.classList.toggle('hidden', visible === 0);
      if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
    }

    function resetAll() {
      selectedVendor = 'all';
      selectedGroup = 'all';
      if (searchInput) searchInput.value = '';
      updateButtons();
      applyFilter();
    }

    vendorBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedVendor = btn.getAttribute('data-dir-vendor-btn') || 'all';
        updateButtons();
        applyFilter();
      });
    });

    groupBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedGroup = btn.getAttribute('data-dir-group-btn') || 'all';
        updateButtons();
        applyFilter();
      });
    });

    if (searchInput) searchInput.addEventListener('input', applyFilter);
    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (emptyReset) emptyReset.addEventListener('click', resetAll);
  })();
</script>
