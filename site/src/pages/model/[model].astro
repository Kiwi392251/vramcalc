---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import SpeedBadge from '../../components/SpeedBadge.astro';
import rawPagesData from '../../data/pages_data.json';
import type { ModelSpec, VramPageEntry } from '../../types/vram';
import { formatContextLabel, formatTpsRange } from '../../utils/physics';
import {
  buildModelFaq,
  buildModelHubs,
  getBenchmarksMethodologyNote,
  getCatalogUpdatedAt,
  getReferenceBenchmarks,
  type ModelHub,
} from '../../utils/hubs';

export function getStaticPaths() {
  const allEntries = rawPagesData as VramPageEntry[];
  const hubs = buildModelHubs(allEntries);
  const allModels = hubs.map((h) => h.model);

  return hubs.map((hub) => ({
    params: { model: hub.model.id },
    props: {
      hub,
      allModels,
      totalSiteEntries: allEntries.length,
    },
  }));
}

interface Props {
  hub: ModelHub;
  allModels: ModelSpec[];
  totalSiteEntries: number;
}

const { hub, allModels, totalSiteEntries } = Astro.props;
const {
  model,
  rows,
  fitsCount,
  tightCount,
  partialCount,
  oomCount,
  fastestTps,
  fastestTpsText,
  q4Row,
  q8Row,
  fp16Row,
  awqRow,
  kvPer4k,
  topPicks,
} = hub;

const updatedAt = getCatalogUpdatedAt();
const faq = buildModelFaq(hub);
const refBenchmarks = getReferenceBenchmarks({ modelId: model.id });
const refNote = getBenchmarksMethodologyNote();

const otherModels = allModels
  .filter((m) => m.id !== model.id)
  .sort((a, b) => a.params_b - b.params_b || a.name.localeCompare(b.name));

const q4VramLabel = `${q4Row.total_vram_gb.toFixed(2)} GB`;
const q4WeightsLabel = `${q4Row.weights_gb.toFixed(2)} GB weights`;
const awqVramLabel = `${awqRow.total_vram_gb.toFixed(2)} GB`;
const q8VramLabel = `${q8Row.total_vram_gb.toFixed(2)} GB`;
const fp16VramLabel = `${fp16Row.total_vram_gb.toFixed(1)} GB FP16`;
const maxContextLabel = formatContextLabel(model.max_context);

const topHwRow = topPicks[0]?.row;
const topHwSummary = topHwRow
  ? `${topHwRow.hardware.short_name} (${fastestTpsText})`
  : `${rows.length} GPUs evaluated`;

const canonicalPath = `/model/${model.id}/`;
const pageTitle = `Best GPUs & Macs for ${model.name} (${model.params_b}B) — VRAMCalc.me`;
const pageDescription = `${model.name} requires ${q4VramLabel} (Q4_K_M @ 8K) or ${awqVramLabel} (4-bit AWQ) and +${kvPer4k.toFixed(2)} GB KV cache per 4K tokens. Compare all ${rows.length} GPUs and Macs (${fitsCount} Fits, ${tightCount} Tight Fit), led by ${topHwSummary}.`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vramcalc.me/' },
    { '@type': 'ListItem', position: 2, name: 'All Models', item: 'https://vramcalc.me/model/' },
    { '@type': 'ListItem', position: 3, name: model.name, item: `https://vramcalc.me/model/${model.id}/` },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Hardware Compatibility Leaderboard for ${model.name}`,
  numberOfItems: rows.length,
  itemListElement: rows.map((r, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: `${model.short_name} on ${r.hardware.name}`,
    url: r.isCurated
      ? `https://vramcalc.me${r.href}`
      : `https://vramcalc.me/gpu/${r.hardware.id}/`,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const statusFilters = [
  { key: 'all', label: `All (${rows.length})`, i18nKey: 'status.allWithCount', i18nArgs: JSON.stringify({ count: rows.length }) },
  { key: 'Fits', label: `Fits (${fitsCount})`, i18nKey: 'status.fitsWithCount', i18nArgs: JSON.stringify({ count: fitsCount }) },
  { key: 'Tight Fit', label: `Tight Fit (${tightCount})`, i18nKey: 'status.tightWithCount', i18nArgs: JSON.stringify({ count: tightCount }) },
  { key: 'Partial Offload', label: `Partial Offload (${partialCount})`, i18nKey: 'status.partialWithCount', i18nArgs: JSON.stringify({ count: partialCount }) },
  { key: 'OOM', label: `OOM (${oomCount})`, i18nKey: 'status.oomWithCount', i18nArgs: JSON.stringify({ count: oomCount }) },
] as const;

const vendorFilters = [
  { key: 'all', label: 'All Vendors' },
  { key: 'NVIDIA', label: 'NVIDIA' },
  { key: 'Apple', label: 'Apple' },
  { key: 'AMD', label: 'AMD' },
  { key: 'Intel', label: 'Intel' },
] as const;

const bestGpusForArgs = JSON.stringify({ model: model.name, params: model.params_b });
const topHwPicksArgs = JSON.stringify({ model: model.short_name });
const hwLeaderboardArgs = JSON.stringify({ count: rows.length, model: model.short_name });
const modelFaqArgs = JSON.stringify({ target: model.short_name });
const modelCountArgs = JSON.stringify({ shown: rows.length, total: rows.length });
const browseAllModelsArgs = JSON.stringify({ count: allModels.length });
const updatedArgs = JSON.stringify({ date: updatedAt });
const simModelHref = `/calculator/?model=${encodeURIComponent(model.id)}`;
const ogTitle = `${model.short_name} VRAM & ${rows.length}-GPU Rankings (${fitsCount + tightCount} Fit)`;
const ogDescription = `Q4_K_M @ 8K uses ${q4VramLabel}, AWQ uses ${awqVramLabel}. Fastest tested: ${topHwSummary}.`;
const ogImage = `/og/model-${model.id}.png`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  totalPages={totalSiteEntries}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  ogImageAlt={ogTitle}
  themeColor="#2563eb"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <article class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-4">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs font-medium text-slate-500">
        <li>
          <a href="/" class="hover:text-slate-900 transition-colors" data-i18n="common.home">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/model/" class="hover:text-slate-900 transition-colors" data-i18n="nav.models">Models</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-slate-900 font-semibold truncate">
          {model.name}
        </li>
      </ol>
    </nav>

    <header class="rounded-2xl border border-slate-800 bg-slate-950 p-6 text-slate-100 shadow-xs sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full border border-blue-500/40 bg-blue-500/15 px-2.5 py-0.5 font-mono text-xs font-semibold text-blue-300">
            {model.family}
          </span>
          <span class="rounded-full border border-slate-700 bg-slate-900 px-2.5 py-0.5 font-mono text-xs text-slate-300">
            {model.params_b}B Params · {model.num_layers} Layers
          </span>
          <span class="rounded-full border border-slate-700 bg-slate-900 px-2.5 py-0.5 font-mono text-xs text-slate-300">
            {model.architecture}
          </span>
          <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 font-mono text-xs text-emerald-300" data-i18n="common.updated" data-i18n-args={updatedArgs}>
            Updated {updatedAt}
          </span>
        </div>

        <a
          href={simModelHref}
          data-i18n="hub.open7QuantBtn"
          class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-2 text-xs font-semibold text-white hover:bg-blue-500 transition-colors"
        >
          Open Format &amp; Reserve Simulator -&gt;
        </a>
      </div>

      <h1 class="mt-4 text-2xl font-extrabold tracking-tight text-white sm:text-4xl" data-i18n="hub.bestGpusFor" data-i18n-args={bestGpusForArgs}>
        Best GPUs &amp; Macs for {model.name} ({model.params_b}B)
      </h1>

      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-300 sm:text-base">
        Ranked across all <strong class="text-white">{rows.length}</strong> catalog GPUs, cloud instances (T4/L4/A10/H200),
        dual-GPU stations, and Apple Silicon Macs (<span class="text-emerald-300 font-semibold">{fitsCount} Fits</span>,{' '}
        <span class="text-orange-300 font-semibold">{tightCount} Tight Fit</span>,{' '}
        <span class="text-amber-300 font-semibold">{partialCount} Partial Offload</span>,{' '}
        <span class="text-rose-300 font-semibold">{oomCount} OOM</span>). Baseline Q4_K_M @ 8K uses{' '}
        <strong class="text-white font-mono">{q4VramLabel}</strong> (AWQ 4-bit: <strong class="text-white font-mono">{awqVramLabel}</strong>).
      </p>

      {model.use_cases.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {model.use_cases.map((uc) => (
            <span class="rounded-lg border border-slate-800 bg-slate-900 px-2.5 py-1 text-xs text-slate-300">
              {uc}
            </span>
          ))}
        </div>
      )}

      <dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400">Q4_K_M @ 8K</dt>
          <dd class="mt-1 font-mono text-lg font-bold text-white tabular-nums">{q4VramLabel}</dd>
          <dd class="mt-0.5 font-mono text-[11px] text-slate-400">{q4WeightsLabel}</dd>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400">AWQ 4-bit / Q8</dt>
          <dd class="mt-1 font-mono text-lg font-bold text-sky-300 tabular-nums">{awqVramLabel}</dd>
          <dd class="mt-0.5 font-mono text-[11px] text-slate-400">Q8: {q8VramLabel} · {fp16VramLabel}</dd>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400">KV Cache Scaling</dt>
          <dd class="mt-1 font-mono text-lg font-bold text-white tabular-nums">+{kvPer4k.toFixed(2)} GB/4K</dd>
          <dd class="mt-0.5 font-mono text-[11px] text-slate-400">
            {model.num_kv_heads} KV heads × {model.head_dim}
          </dd>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400">Max Context Spec</dt>
          <dd class="mt-1 font-mono text-lg font-bold text-emerald-300 tabular-nums">{maxContextLabel}</dd>
          <dd class="mt-0.5 font-mono text-[11px] text-slate-400">Released {model.release_year}</dd>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400">Hardware Matrix</dt>
          <dd class="mt-1 font-mono text-lg font-bold text-white tabular-nums">{rows.length} GPUs</dd>
          <dd class="mt-0.5 font-mono text-[11px] text-emerald-300">{fitsCount} Fits · {tightCount} Tight</dd>
        </div>
      </dl>
    </header>

    {refBenchmarks.length > 0 && (
      <section class="mt-7 rounded-2xl border border-sky-200 bg-sky-50/70 p-5" aria-labelledby="model-ref-benchmarks">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 id="model-ref-benchmarks" class="text-base font-bold text-slate-950" data-i18n="speed.refBenchmark">
            Measured Community Benchmarks
          </h2>
          <span class="rounded-md bg-white/90 px-2 py-0.5 font-mono text-[11px] font-semibold text-emerald-800 border border-emerald-200" data-i18n="speed.measuredBadge">
            Measured
          </span>
        </div>
        <p class="mt-1 text-xs text-slate-600">{refNote}</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {refBenchmarks.map((anc) => (
            <div class="min-w-0 max-w-full rounded-xl border border-sky-200 bg-white p-3.5 text-xs">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="font-mono font-bold text-slate-950">
                  {anc.hardware_id} · {anc.quant} @ {formatContextLabel(anc.context_tokens)}
                </span>
                <span class="font-mono font-bold text-emerald-700">
                  {anc.gen_tps_low}–{anc.gen_tps_high} tok/s measured
                </span>
              </div>
              <p class="mt-1 text-slate-600">{anc.notes}</p>
              <div class="mt-1.5 font-mono text-[10px] text-slate-500">
                {anc.date} · {anc.prompt_spec} · {anc.runtime_version}
              </div>
              <code class="mt-1.5 block w-full max-w-full overflow-x-auto rounded bg-slate-100 px-2 py-1 font-mono text-[10px] text-slate-700">
                {anc.repro_cmd}
              </code>
              <div class="mt-1.5 text-[11px] text-slate-500">
                <span data-i18n="speed.refSource">Source</span>:{' '}
                <a href={anc.source_url} target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-900">
                  {anc.source_label}
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {topPicks.length > 0 && (
      <section class="mt-10" aria-labelledby="top-hardware-heading">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 id="top-hardware-heading" class="text-xl font-bold tracking-tight text-slate-950" data-i18n="hub.topHwPicks" data-i18n-args={topHwPicksArgs}>
              Top Resident Hardware Picks for {model.short_name}
            </h2>
            <p class="mt-1 text-sm text-slate-600">
              {model.short_name} · Q4_K_M @ 8K ({q4VramLabel}) · AWQ ({awqVramLabel})
            </p>
          </div>
          <a href="/" class="text-xs font-semibold text-blue-600 hover:text-blue-800 shrink-0" data-i18n="detail.viewFullMatrix">
            View Full Matrix -&gt;
          </a>
        </div>

        <div class="mt-4 grid gap-4 md:grid-cols-3">
          {topPicks.map((pick) => {
            const row = pick.row;
            const res = row.result;
            const tier = res.speed_tier ?? 'Readable';
            const speedText = formatTpsRange(res.est_tps_low, res.est_tps_high, res.est_tps, res.status);
            const gpuHref = `/gpu/${row.hardware.id}/`;
            const maxCtx =
              row.maxFitCtx > 0
                ? `${formatContextLabel(row.maxFitCtx)} (${row.maxFitVramGb.toFixed(1)} GB)`
                : 'Offload/OOM';
            const roleClass = `inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-semibold ${pick.accent}`;
            const allHwBtnArgs = JSON.stringify({ hw: row.hardware.short_name });
            const summaryText = row.curatedEntry
              ? row.curatedEntry.verdict_summary
              : `${row.hardware.name} (${res.effective_usable_vram_gb?.toFixed(1)} GB usable) holds ${model.short_name} in status ${res.status} with ${speedText} formula decode speed.`;
            const ctaI18n = row.isCurated ? 'common.openGuide' : 'common.simulate';
            const ctaText = row.isCurated ? 'Open Guide ->' : 'Simulate ->';

            return (
              <div class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-xs hover:border-blue-300 transition-colors">
                <div>
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class={roleClass}>{pick.role}</span>
                    <div class="flex items-center gap-1.5">
                      <StatusBadge status={res.status} />
                      <SpeedBadge tier={tier} />
                    </div>
                  </div>

                  <h3 class="mt-3 text-lg font-bold tracking-tight text-slate-950">
                    <a href={row.href} class="hover:text-blue-600 transition-colors">
                      {row.hardware.name}
                    </a>
                  </h3>
                  <p class="mt-0.5 font-mono text-xs text-slate-500">
                    {(res.effective_usable_vram_gb ?? row.hardware.usable_vram_gb).toFixed(1)} GB usable · {row.hardware.bandwidth_gbps} GB/s · ${row.hardware.msrp_usd.toLocaleString()} MSRP
                  </p>

                  <p class="mt-2.5 text-xs leading-relaxed text-slate-600 line-clamp-3">
                    {summaryText}
                  </p>
                </div>

                <div class="mt-4 border-t border-slate-100 pt-3.5">
                  <div class="grid grid-cols-3 gap-2 text-xs">
                    <div>
                      <span class="block text-[11px] text-slate-500" data-i18n="speed.formulaEst">Formula est.</span>
                      <span class="font-mono font-bold text-slate-950 tabular-nums">{speedText}</span>
                    </div>
                    <div>
                      <span class="block text-[11px] text-slate-500" data-i18n="common.recommended">Rec. Quant</span>
                      <span class="font-mono font-semibold text-slate-900">{row.recQuant}</span>
                    </div>
                    <div>
                      <span class="block text-[11px] text-slate-500" data-i18n="detail.maxSmoothCtx">Max Fit</span>
                      <span class="font-mono font-semibold text-slate-900 tabular-nums">{maxCtx}</span>
                    </div>
                  </div>

                  <div class="mt-3.5 flex items-center justify-between gap-2 text-xs font-semibold">
                    <a href={gpuHref} class="text-slate-600 hover:text-slate-950 transition-colors" data-i18n="detail.retAllHw" data-i18n-args={allHwBtnArgs}>
                      All {row.hardware.short_name} -&gt;
                    </a>
                    <a href={row.href} class="text-blue-600 hover:text-blue-800 transition-colors" data-i18n={ctaI18n}>
                      {ctaText}
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <section class="mt-10" aria-labelledby="model-leaderboard-heading">
      <div class="flex flex-col gap-3">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 id="model-leaderboard-heading" class="text-xl font-bold tracking-tight text-slate-950" data-i18n="hub.hwLeaderboardHeading" data-i18n-args={hwLeaderboardArgs}>
              Full {rows.length}-Hardware Leaderboard for {model.short_name}
            </h2>
            <p class="mt-1 text-sm text-slate-600">
              <span class="font-mono text-slate-900">Q4_K_M @ 8K · Formula Estimate Range (±15–25%)</span>
            </p>
          </div>
          <span id="model-filter-count" class="font-mono text-xs text-slate-500 tabular-nums" data-i18n="hub.showingHwConfigs" data-i18n-args={modelCountArgs}>
            Showing {rows.length} of {rows.length} hardware configs
          </span>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3">
          <div class="flex flex-wrap items-center gap-3">
            <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter hardware by status">
              {statusFilters.map((st) => {
                const btnClass =
                  st.key === 'all'
                    ? 'rounded-full border px-3 py-1 text-xs font-semibold transition-colors cursor-pointer border-slate-900 bg-slate-900 text-white'
                    : 'rounded-full border px-3 py-1 text-xs font-semibold transition-colors cursor-pointer border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100';
                return (
                  <button
                    type="button"
                    data-model-status-btn={st.key}
                    data-i18n={st.i18nKey}
                    data-i18n-args={st.i18nArgs}
                    class={btnClass}
                  >
                    {st.label}
                  </button>
                );
              })}
            </div>

            <span class="hidden h-4 w-px bg-slate-200 sm:inline-block" aria-hidden="true"></span>

            <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter hardware by vendor">
              {vendorFilters.map((vnd) => {
                const vClass =
                  vnd.key === 'all'
                    ? 'rounded-full border px-3 py-1 text-xs font-semibold transition-colors cursor-pointer border-blue-600 bg-blue-600 text-white'
                    : 'rounded-full border px-3 py-1 text-xs font-semibold transition-colors cursor-pointer border-slate-200 bg-white text-slate-700 hover:bg-slate-100';
                return (
                  <button
                    type="button"
                    data-model-vendor-btn={vnd.key}
                    data-i18n={vnd.key === 'all' ? 'status.all' : undefined}
                    class={vClass}
                  >
                    {vnd.label}
                  </button>
                );
              })}
            </div>
          </div>

          <button
            id="model-filter-reset"
            type="button"
            data-i18n="common.reset"
            class="hidden text-xs font-semibold text-blue-600 hover:text-blue-800 cursor-pointer"
          >
            Reset
          </button>
        </div>
      </div>

      <div id="model-table-wrap" class="mt-4 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-xs">
        <table class="w-full min-w-[900px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50 text-xs font-semibold uppercase tracking-wider text-slate-500">
              <th class="px-4 py-3" data-i18n="hub.colRank">Rank</th>
              <th class="px-4 py-3" data-i18n="hub.colHardware">Hardware</th>
              <th class="px-4 py-3" data-i18n="detail.colStatus">Fit / Speed</th>
              <th class="px-4 py-3" data-i18n="hub.colSpeed8k">Formula Speed (Q4 @ 8K)</th>
              <th class="px-4 py-3" data-i18n="detail.colGpuLayers">GPU Layers</th>
              <th class="px-4 py-3" data-i18n="hub.bestQuantMaxCtx">Max Fit &amp; @Max VRAM</th>
              <th class="px-4 py-3 text-right" data-i18n="hub.colCalculator">Calculator</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {rows.map((row, idx) => {
              const res = row.result;
              const tier = res.speed_tier ?? 'Readable';
              const gpuHubHref = `/gpu/${row.hardware.id}/`;
              const tpsText = formatTpsRange(res.est_tps_low, res.est_tps_high, res.est_tps, res.status);
              const speedPct =
                res.status === 'OOM' || fastestTps === 0
                  ? 0
                  : Math.max(4, Math.min(100, Math.round((res.est_tps / fastestTps) * 100)));
              const barColor =
                res.status === 'Fits'
                  ? 'bg-emerald-500'
                  : res.status === 'Tight Fit'
                    ? 'bg-orange-500'
                    : res.status === 'Partial Offload'
                      ? 'bg-amber-500'
                      : 'bg-rose-500';
              const barClass = `h-full rounded-full ${barColor}`;
              const barStyle = `width: ${speedPct}%`;
              const maxFitSpeedSuffix =
                row.maxFitTpsHigh > 0 ? ` (~${row.maxFitTpsLow}–${row.maxFitTpsHigh} tok/s)` : '';
              const maxCtxText = row.maxFitCtx
                ? `${formatContextLabel(row.maxFitCtx)} · ${row.maxFitVramGb.toFixed(1)} GB${maxFitSpeedSuffix}`
                : 'Offload / Q8 KV';
              const altSpeedStr =
                row.altRow.status === 'OOM'
                  ? 'OOM'
                  : `~${row.altRow.est_tps_low}–${row.altRow.est_tps_high} tok/s`;
              const altSummarySub = `${row.altRow.format}: ${row.altRow.total_vram_gb.toFixed(1)} GB · ${altSpeedStr}`;
              const speedClass =
                res.status === 'OOM'
                  ? 'font-mono font-semibold text-rose-700 tabular-nums'
                  : 'font-mono font-bold text-slate-950 tabular-nums';
              const ctaI18n = row.isCurated ? 'common.openGuide' : 'common.simulate';
              const ctaLabel = row.isCurated ? 'Open Guide ->' : 'Simulate ->';
              const usableLabel = (res.effective_usable_vram_gb ?? row.hardware.usable_vram_gb).toFixed(1);

              return (
                <tr
                  data-model-row
                  data-status={res.status}
                  data-vendor={row.hardware.vendor}
                  class="hover:bg-slate-50/70 transition-colors"
                >
                  <td class="px-4 py-3.5 align-top font-mono text-xs font-bold text-slate-500 tabular-nums">
                    #{idx + 1}
                  </td>
                  <td class="px-4 py-3.5 align-top">
                    <div class="flex flex-wrap items-center gap-1.5">
                      <a href={row.href} class="font-bold text-slate-950 hover:text-blue-600 transition-colors">
                        {row.hardware.name}
                      </a>
                      {row.isCurated ? (
                        <span class="rounded bg-blue-50 px-1.5 py-0.5 text-[10px] font-semibold text-blue-700" data-i18n="common.fullGuide">
                          Full Guide
                        </span>
                      ) : (
                        <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-semibold text-slate-500" data-i18n="common.liveCalc">
                          Live Calc
                        </span>
                      )}
                    </div>
                    <div class="mt-0.5 flex flex-wrap items-center gap-2 text-xs text-slate-500">
                      <span class="font-mono">
                        {row.hardware.backend} · {usableLabel} GB usable · {row.hardware.bandwidth_gbps} GB/s
                      </span>
                      <span>·</span>
                      <a href={gpuHubHref} class="hover:text-slate-900 underline decoration-slate-300 underline-offset-2" data-i18n="hub.gpuHubLabel">
                        GPU Hub -&gt;
                      </a>
                    </div>
                  </td>
                  <td class="px-4 py-3.5 align-top">
                    <div class="flex flex-wrap items-center gap-1">
                      <StatusBadge status={res.status} />
                      <SpeedBadge tier={tier} />
                    </div>
                  </td>
                  <td class="px-4 py-3.5 align-top">
                    <div class={speedClass}>{tpsText}</div>
                    <div class="mt-1.5 h-1.5 w-28 overflow-hidden rounded-full bg-slate-100">
                      <div class={barClass} style={barStyle}></div>
                    </div>
                    <div class="mt-1 font-mono text-[11px] text-slate-500 tabular-nums">{altSummarySub}</div>
                  </td>
                  <td class="px-4 py-3.5 align-top font-mono text-slate-700 tabular-nums">
                    {res.gpu_layers_fit}/{res.total_layers}
                  </td>
                  <td class="px-4 py-3.5 align-top text-xs">
                    <div class="font-mono font-semibold text-slate-900">{row.recQuant}</div>
                    <div class="mt-0.5 text-slate-500">{maxCtxText}</div>
                  </td>
                  <td class="px-4 py-3.5 align-top text-right">
                    <a
                      href={row.href}
                      data-i18n={ctaI18n}
                      class="inline-flex items-center rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-semibold text-blue-600 hover:border-blue-300 hover:bg-blue-50 transition-colors"
                    >
                      {ctaLabel}
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div
        id="model-empty-state"
        class="mt-4 hidden rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center"
      >
        <p class="text-sm font-semibold text-slate-900" data-i18n="hub.noMatchingConfigs">
          No hardware entries match the selected status and vendor filters.
        </p>
        <button
          id="model-empty-reset"
          type="button"
          data-i18n="common.resetFilters"
          class="mt-3 rounded-lg bg-slate-900 px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-slate-800 cursor-pointer"
        >
          Reset Filters
        </button>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="model-faq-heading">
      <h2 id="model-faq-heading" class="text-xl font-bold tracking-tight text-slate-950" data-i18n="hub.faqForTarget" data-i18n-args={modelFaqArgs}>
        Frequently Asked Questions ({model.short_name})
      </h2>
      <div class="mt-4 space-y-3">
        {faq.map((item, idx) => (
          <details
            open={idx < 2}
            class="group rounded-xl border border-slate-200 bg-white px-5 py-4 open:border-blue-200"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-950">
              <span>{item.question}</span>
              <span class="shrink-0 font-mono text-slate-400 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

    {otherModels.length > 0 && (
      <section class="mt-12 border-t border-slate-200 pt-8" aria-labelledby="other-models-heading">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 id="other-models-heading" class="text-xl font-bold tracking-tight text-slate-950" data-i18n="hub.exploreOtherModels">
              Explore Other Open-Weight Model Hubs
            </h2>
            <p class="mt-1 text-sm text-slate-600">
              {otherModels.length + 1} LLMs
            </p>
          </div>
          <a href="/model/" class="text-xs font-semibold text-blue-600 hover:text-blue-800 shrink-0" data-i18n="hub.browseAllModels" data-i18n-args={browseAllModelsArgs}>
            Browse All {allModels.length} Model Hubs -&gt;
          </a>
        </div>

        <div class="mt-4 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
          {otherModels.map((other) => {
            const otherHref = `/model/${other.id}/`;
            return (
              <a
                href={otherHref}
                class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-4 hover:border-blue-300 hover:shadow-sm transition-all"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 text-xs">
                    <span class="font-mono font-semibold text-slate-500">{other.family}</span>
                    <span class="font-mono font-bold text-slate-900 tabular-nums">{other.params_b}B</span>
                  </div>
                  <p class="mt-2 text-sm font-bold text-slate-950">{other.name}</p>
                </div>
                <div class="mt-3 flex items-center justify-between text-xs text-slate-600">
                  <span class="font-mono">{other.architecture}</span>
                  <span class="font-semibold text-blue-600" data-i18n="hub.modelHubLabel">Model Hub -&gt;</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  import { onLocaleChange, t } from '../../utils/i18n';

  function initModelHub() {
    const statusButtons = Array.from(document.querySelectorAll('[data-model-status-btn]'));
    const vendorButtons = Array.from(document.querySelectorAll('[data-model-vendor-btn]'));
    const rows = Array.from(document.querySelectorAll('[data-model-row]'));
    const countEl = document.getElementById('model-filter-count');
    const resetBtn = document.getElementById('model-filter-reset');
    const emptyResetBtn = document.getElementById('model-empty-reset');
    const tableWrap = document.getElementById('model-table-wrap');
    const emptyState = document.getElementById('model-empty-state');

    let selectedStatus = 'all';
    let selectedVendor = 'all';
    const total = rows.length;

    function updatePills() {
      statusButtons.forEach((b) => {
        const active = (b.getAttribute('data-model-status-btn') || 'all') === selectedStatus;
        b.classList.toggle('border-slate-900', active);
        b.classList.toggle('bg-slate-900', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('border-slate-200', !active);
        b.classList.toggle('bg-slate-50', !active);
        b.classList.toggle('text-slate-700', !active);
      });
      vendorButtons.forEach((b) => {
        const active = (b.getAttribute('data-model-vendor-btn') || 'all') === selectedVendor;
        b.classList.toggle('border-blue-600', active);
        b.classList.toggle('bg-blue-600', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('border-slate-200', !active);
        b.classList.toggle('bg-white', !active);
        b.classList.toggle('text-slate-700', !active);
      });
    }

    function applyFilter() {
      let visible = 0;
      rows.forEach((row) => {
        const mStatus = selectedStatus === 'all' || row.getAttribute('data-status') === selectedStatus;
        const mVendor = selectedVendor === 'all' || row.getAttribute('data-vendor') === selectedVendor;
        const show = mStatus && mVendor;
        row.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });

      if (countEl) {
        countEl.textContent = t('hub.showingHwConfigs', { shown: visible, total });
      }
      const isFiltered = selectedStatus !== 'all' || selectedVendor !== 'all';
      if (resetBtn) resetBtn.classList.toggle('hidden', !isFiltered);
      if (tableWrap) tableWrap.classList.toggle('hidden', visible === 0);
      if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
    }

    function resetAll() {
      selectedStatus = 'all';
      selectedVendor = 'all';
      updatePills();
      applyFilter();
    }

    statusButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-model-status-btn') || 'all';
        selectedStatus = raw === 'Smooth' ? 'Fits' : raw;
        updatePills();
        applyFilter();
      });
    });

    vendorButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedVendor = btn.getAttribute('data-model-vendor-btn') || 'all';
        updatePills();
        applyFilter();
      });
    });

    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);

    onLocaleChange(() => applyFilter());
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initModelHub);
  } else {
    initModelHub();
  }
</script>
