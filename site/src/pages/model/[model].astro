---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import SpeedBadge from '../../components/SpeedBadge.astro';
import rawPagesData from '../../data/pages_data.json';
import type { ModelSpec, VramPageEntry } from '../../types/vram';
import { formatContextLabel, formatTpsRange } from '../../utils/physics';
import {
  buildModelFaq,
  buildModelHubs,
  getBenchmarksMethodologyNote,
  getCatalogUpdatedAt,
  getFreshnessMeta,
  getReferenceBenchmarks,
  type ModelHub,
} from '../../utils/hubs';

export function getStaticPaths() {
  const allEntries = rawPagesData as VramPageEntry[];
  const hubs = buildModelHubs(allEntries);
  const allModels = hubs.map((h) => h.model);

  return hubs.map((hub) => ({
    params: { model: hub.model.id },
    props: {
      hub,
      allModels,
      totalSiteEntries: allEntries.length,
    },
  }));
}

interface Props {
  hub: ModelHub;
  allModels: ModelSpec[];
  totalSiteEntries: number;
}

const { hub, allModels, totalSiteEntries } = Astro.props;
const {
  model,
  rows,
  fitsCount,
  tightCount,
  partialCount,
  oomCount,
  fastestTps,
  fastestTpsText,
  q4Row,
  q8Row,
  fp16Row,
  awqRow,
  kvPer4k,
  topPicks,
} = hub;

const updatedAt = getCatalogUpdatedAt();
const faq = buildModelFaq(hub);
const refBenchmarks = getReferenceBenchmarks({ modelId: model.id });
const refNote = getBenchmarksMethodologyNote();

const otherModels = allModels
  .filter((m) => m.id !== model.id)
  .sort((a, b) => a.params_b - b.params_b || a.name.localeCompare(b.name));

const q4VramLabel = `${q4Row.total_vram_gb.toFixed(2)} GB`;
const q4WeightsLabel = `${q4Row.weights_gb.toFixed(2)} GB weights`;
const awqVramLabel = `${awqRow.total_vram_gb.toFixed(2)} GB`;
const q8VramLabel = `${q8Row.total_vram_gb.toFixed(2)} GB`;
const fp16VramLabel = `${fp16Row.total_vram_gb.toFixed(1)} GB FP16`;
const maxContextLabel = formatContextLabel(model.max_context);

const topHwRow = topPicks[0]?.row;
const topHwSummary = topHwRow
  ? `${topHwRow.hardware.short_name} (${fastestTpsText})`
  : `${rows.length} GPUs evaluated`;

const canonicalPath = `/model/${model.id}/`;
const pageTitle = `Best GPUs & Macs for ${model.name} (${model.params_b}B) — VRAMCalc.me`;
const pageDescription = `${model.name} requires ${q4VramLabel} (Q4_K_M @ 8K) or ${awqVramLabel} (4-bit AWQ) and +${kvPer4k.toFixed(2)} GB KV cache per 4K tokens. Compare all ${rows.length} GPUs and Macs (${fitsCount} Fits, ${tightCount} Tight Fit), led by ${topHwSummary}.`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vramcalc.me/' },
    { '@type': 'ListItem', position: 2, name: 'All Models', item: 'https://vramcalc.me/model/' },
    { '@type': 'ListItem', position: 3, name: model.name, item: `https://vramcalc.me/model/${model.id}/` },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Hardware Compatibility Leaderboard for ${model.name}`,
  numberOfItems: rows.length,
  itemListElement: rows.map((r, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: `${model.short_name} on ${r.hardware.name}`,
    url: r.isCurated
      ? `https://vramcalc.me${r.href}`
      : `https://vramcalc.me/gpu/${r.hardware.id}/`,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const statusFilters = [
  { key: 'all', label: `All (${rows.length})`, i18nKey: 'status.allWithCount', i18nArgs: JSON.stringify({ count: rows.length }) },
  { key: 'Fits', label: `Fits (${fitsCount})`, i18nKey: 'status.fitsWithCount', i18nArgs: JSON.stringify({ count: fitsCount }) },
  { key: 'Tight Fit', label: `Tight Fit (${tightCount})`, i18nKey: 'status.tightWithCount', i18nArgs: JSON.stringify({ count: tightCount }) },
  { key: 'Partial Offload', label: `Partial Offload (${partialCount})`, i18nKey: 'status.partialWithCount', i18nArgs: JSON.stringify({ count: partialCount }) },
  { key: 'OOM', label: `OOM (${oomCount})`, i18nKey: 'status.oomWithCount', i18nArgs: JSON.stringify({ count: oomCount }) },
] as const;

const vendorFilters = [
  { key: 'all', label: 'All Vendors' },
  { key: 'NVIDIA', label: 'NVIDIA' },
  { key: 'Apple', label: 'Apple' },
  { key: 'AMD', label: 'AMD' },
  { key: 'Intel', label: 'Intel' },
] as const;

const bestGpusForArgs = JSON.stringify({ model: model.name, params: model.params_b });
const topHwPicksArgs = JSON.stringify({ model: model.short_name });
const hwLeaderboardArgs = JSON.stringify({ count: rows.length, model: model.short_name });
const modelFaqArgs = JSON.stringify({ target: model.short_name });
const modelCountArgs = JSON.stringify({ shown: rows.length, total: rows.length });
const browseAllModelsArgs = JSON.stringify({ count: allModels.length });
const updatedArgs = JSON.stringify({ date: updatedAt });
const simModelHref = `/calculator/?model=${encodeURIComponent(model.id)}`;
const ogTitle = `${model.short_name} VRAM & ${rows.length}-GPU Rankings (${fitsCount + tightCount} Fit)`;
const ogDescription = `Q4_K_M @ 8K uses ${q4VramLabel}, AWQ uses ${awqVramLabel}. Fastest tested: ${topHwSummary}.`;
const ogImage = `/og/model-${model.id}.png`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  totalPages={totalSiteEntries}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  ogImageAlt={ogTitle}
  themeColor="#2563eb"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <article class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-4">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs font-medium text-slate-500">
        <li>
          <a href="/" class="hover:text-slate-900 transition-colors" data-i18n="common.home">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/model/" class="hover:text-[var(--ink-primary)] transition-colors" data-i18n="nav.models">Models</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-semibold text-[var(--ink-primary)] truncate">
          {model.name}
        </li>
      </ol>
    </nav>

    <header class="pb-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="badge-accent font-mono text-xs">
            {model.family}
          </span>
          <span class="font-mono text-xs text-[var(--ink-tertiary)]">
            {model.params_b}B · {model.num_layers}L · {model.architecture} · {maxContextLabel} max ({model.release_year})
          </span>
          <span class="badge-fits font-mono text-xs" data-i18n="common.updated" data-i18n-args={updatedArgs}>
            Updated {updatedAt}
          </span>
        </div>

        <a
          href={simModelHref}
          data-i18n="hub.open7QuantBtn"
          class="btn-primary text-xs shrink-0"
        >
          Open Format &amp; Reserve Simulator -&gt;
        </a>
      </div>

      <h1 class="mt-4 text-2xl font-extrabold tracking-tight text-[var(--ink-primary)] sm:text-4xl" data-i18n="hub.bestGpusFor" data-i18n-args={bestGpusForArgs}>
        Best GPUs &amp; Macs for {model.name} ({model.params_b}B)
      </h1>

      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-[var(--ink-secondary)] sm:text-base">
        Ranked across all <strong class="text-[var(--ink-primary)]">{rows.length}</strong> catalog GPUs, cloud instances (T4/L4/A10/H200),
        dual-GPU stations, and Apple Silicon Macs (<span class="font-semibold text-emerald-600 dark:text-emerald-400">{fitsCount} Fits</span>,{' '}
        <span class="font-semibold text-orange-600 dark:text-orange-400">{tightCount} Tight Fit</span>,{' '}
        <span class="font-semibold text-amber-600 dark:text-amber-400">{partialCount} Partial Offload</span>,{' '}
        <span class="font-semibold text-rose-600 dark:text-rose-400">{oomCount} OOM</span>). Baseline Q4_K_M @ 8K uses{' '}
        <strong class="font-mono text-[var(--ink-primary)]">{q4VramLabel}</strong> (AWQ 4-bit: <strong class="font-mono text-[var(--ink-primary)]">{awqVramLabel}</strong>).
      </p>

      {model.use_cases.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {model.use_cases.map((uc) => (
            <span class="badge-neutral text-xs">
              {uc}
            </span>
          ))}
        </div>
      )}

      <dl class="mt-6 grid grid-cols-2 lg:grid-cols-4 gap-px rounded-2xl border border-[var(--border-subtle)] bg-[var(--border-subtle)] shadow-[var(--shadow-card)] overflow-hidden">
        <div class="bg-[var(--bg-surface)] px-4 py-3.5">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-[var(--ink-tertiary)]">Q4_K_M @ 8K</dt>
          <dd class="mt-1 whitespace-nowrap font-mono text-lg font-bold text-[var(--ink-primary)] tabular-nums">{q4VramLabel}</dd>
          <dd class="mt-0.5 font-mono text-[11px] text-[var(--ink-tertiary)]">{q4WeightsLabel}</dd>
        </div>
        <div class="bg-[var(--bg-surface)] px-4 py-3.5">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-[var(--ink-tertiary)]">AWQ 4-bit / Q8</dt>
          <dd class="mt-1 whitespace-nowrap font-mono text-lg font-bold text-[var(--accent-ink)] tabular-nums">{awqVramLabel}</dd>
          <dd class="mt-0.5 font-mono text-[11px] text-[var(--ink-tertiary)]">Q8: {q8VramLabel} · {fp16VramLabel}</dd>
        </div>
        <div class="bg-[var(--bg-surface)] px-4 py-3.5">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-[var(--ink-tertiary)]">KV Cache Scaling</dt>
          <dd class="mt-1 whitespace-nowrap font-mono text-lg font-bold text-[var(--ink-primary)] tabular-nums">+{kvPer4k.toFixed(2)} GB/4K</dd>
          <dd class="mt-0.5 font-mono text-[11px] text-[var(--ink-tertiary)]">
            {model.num_kv_heads} KV heads × {model.head_dim}
          </dd>
        </div>
        <div class="bg-[var(--bg-surface)] px-4 py-3.5">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-[var(--ink-tertiary)]">Hardware Matrix</dt>
          <dd class="mt-1 whitespace-nowrap font-mono text-lg font-bold text-[var(--ink-primary)] tabular-nums">{rows.length} GPUs</dd>
          <dd class="mt-0.5 font-mono text-[11px] text-emerald-600 dark:text-emerald-400">{fitsCount} Fits · {tightCount} Tight</dd>
        </div>
      </dl>
    </header>

    {refBenchmarks.length > 0 && (
      <section class="surface-card mt-2 p-5 border-[var(--accent-border)]" aria-labelledby="model-ref-benchmarks">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 id="model-ref-benchmarks" class="text-base font-bold text-[var(--ink-primary)]" data-i18n="speed.refBenchmark">
            Measured Community Benchmarks
          </h2>
          <span class="badge-fits font-mono text-[11px]" data-i18n="speed.measuredBadge">
            Measured
          </span>
        </div>
        <p class="mt-1 text-xs text-[var(--ink-secondary)]">{refNote}</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {refBenchmarks.map((anc) => {
            const fresh = getFreshnessMeta(anc.date);
            return (
              <div class="surface-inset min-w-0 max-w-full p-3.5 text-xs">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="font-mono font-bold text-[var(--ink-primary)]">
                    {anc.hardware_id} · {anc.quant} @ {formatContextLabel(anc.context_tokens)}
                  </span>
                  <span class="font-mono font-bold text-emerald-600 dark:text-emerald-400">
                    {anc.gen_tps_low}–{anc.gen_tps_high} tok/s measured
                  </span>
                </div>
                <p class="mt-1 text-[var(--ink-secondary)]">{anc.notes}</p>
                <div class="mt-1.5 flex flex-wrap items-center gap-1.5 font-mono text-[10px] text-[var(--ink-tertiary)]">
                  <span>{anc.date}</span>
                  <span class={fresh.badgeClass} data-i18n={fresh.key}>{fresh.label}</span>
                  <span>· {anc.prompt_spec} · {anc.runtime_version}</span>
                </div>
                <code class="mt-2 block w-full max-w-full overflow-x-auto rounded-lg bg-[var(--bg-code)] px-2.5 py-1.5 font-mono text-[10px] text-slate-200">
                  {anc.repro_cmd}
                </code>
                <div class="mt-1.5 text-[11px] text-[var(--ink-tertiary)]">
                  <span data-i18n="speed.refSource">Source</span>:{' '}
                  <a href={anc.source_url} target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--ink-primary)]">
                    {anc.source_label}
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    {topPicks.length > 0 && (
      <section class="mt-10" aria-labelledby="top-hardware-heading">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 id="top-hardware-heading" class="text-xl font-bold tracking-tight text-[var(--ink-primary)]" data-i18n="hub.topHwPicks" data-i18n-args={topHwPicksArgs}>
              Top Resident Hardware Picks for {model.short_name}
            </h2>
            <p class="mt-1 text-sm text-[var(--ink-secondary)]">
              {model.short_name} · Q4_K_M @ 8K ({q4VramLabel}) · AWQ ({awqVramLabel})
            </p>
          </div>
          <a href="/" class="text-xs font-semibold text-[var(--accent-ink)] hover:underline shrink-0" data-i18n="detail.viewFullMatrix">
            View Full Matrix -&gt;
          </a>
        </div>

        <div class="mt-4 grid gap-4 md:grid-cols-3">
          {topPicks.map((pick) => {
            const row = pick.row;
            const res = row.result;
            const tier = res.speed_tier ?? 'Readable';
            const speedText = formatTpsRange(res.est_tps_low, res.est_tps_high, res.est_tps, res.status);
            const gpuHref = `/gpu/${row.hardware.id}/`;
            const maxCtx =
              row.maxFitCtx > 0
                ? `${formatContextLabel(row.maxFitCtx)} (${row.maxFitVramGb.toFixed(1)} GB)`
                : 'Offload/OOM';
            const roleClass = `inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-semibold ${pick.accent}`;
            const allHwBtnArgs = JSON.stringify({ hw: row.hardware.short_name });
            const summaryText = row.curatedEntry
              ? row.curatedEntry.verdict_summary
              : `${row.hardware.name} (${res.effective_usable_vram_gb?.toFixed(1)} GB usable) holds ${model.short_name} in status ${res.status} with ${speedText} formula decode speed.`;
            const ctaI18n = row.isCurated ? 'common.openGuide' : 'common.simulate';
            const ctaText = row.isCurated ? 'Open Guide ->' : 'Simulate ->';

            return (
              <div class="surface-card-interactive flex flex-col justify-between p-5">
                <div>
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class={roleClass}>{pick.role}</span>
                    <div class="flex items-center gap-1.5">
                      <StatusBadge status={res.status} />
                      <SpeedBadge tier={tier} />
                    </div>
                  </div>

                  <h3 class="mt-3 text-lg font-bold tracking-tight text-[var(--ink-primary)]">
                    <a href={row.href} class="hover:text-[var(--accent-ink)] transition-colors">
                      {row.hardware.name}
                    </a>
                  </h3>
                  <p class="mt-0.5 font-mono text-xs text-[var(--ink-tertiary)]">
                    {(res.effective_usable_vram_gb ?? row.hardware.usable_vram_gb).toFixed(1)} GB usable · {row.hardware.bandwidth_gbps} GB/s · ${row.hardware.msrp_usd.toLocaleString()} MSRP
                  </p>

                  <p class="mt-2.5 text-xs leading-relaxed text-[var(--ink-secondary)] line-clamp-3">
                    {summaryText}
                  </p>
                </div>

                <div class="mt-4 border-t border-[var(--border-hairline)] pt-3.5">
                  <div class="grid grid-cols-3 gap-2 text-xs">
                    <div>
                      <span class="block text-[11px] text-[var(--ink-tertiary)]" data-i18n="speed.formulaEst">Formula est.</span>
                      <span class="font-mono font-bold text-[var(--ink-primary)] tabular-nums">{speedText}</span>
                    </div>
                    <div>
                      <span class="block text-[11px] text-[var(--ink-tertiary)]" data-i18n="common.recommended">Rec. Quant</span>
                      <span class="font-mono font-semibold text-[var(--ink-primary)]">{row.recQuant}</span>
                    </div>
                    <div>
                      <span class="block text-[11px] text-[var(--ink-tertiary)]" data-i18n="detail.maxSmoothCtx">Max Fit</span>
                      <span class="font-mono font-semibold text-[var(--ink-primary)] tabular-nums">{maxCtx}</span>
                    </div>
                  </div>

                  <div class="mt-3.5 flex items-center justify-between gap-2 text-xs font-semibold">
                    <a href={gpuHref} class="text-[var(--ink-secondary)] hover:text-[var(--ink-primary)] transition-colors" data-i18n="detail.retAllHw" data-i18n-args={allHwBtnArgs}>
                      All {row.hardware.short_name} -&gt;
                    </a>
                    <a href={row.href} class="text-[var(--accent-ink)] hover:underline" data-i18n={ctaI18n}>
                      {ctaText}
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <section class="mt-10" aria-labelledby="model-leaderboard-heading">
      <div class="flex flex-col gap-3">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 id="model-leaderboard-heading" class="text-xl font-bold tracking-tight text-[var(--ink-primary)]" data-i18n="hub.hwLeaderboardHeading" data-i18n-args={hwLeaderboardArgs}>
              Full {rows.length}-Hardware Leaderboard for {model.short_name}
            </h2>
            <p class="mt-1 text-sm text-[var(--ink-secondary)]">
              <span class="font-mono text-[var(--ink-primary)]">Q4_K_M @ 8K · Formula Estimate Range (±15–25%)</span>
            </p>
          </div>
          <span id="model-filter-count" class="font-mono text-xs text-[var(--ink-tertiary)] tabular-nums" data-i18n="hub.showingHwConfigs" data-i18n-args={modelCountArgs}>
            Showing {rows.length} of {rows.length} hardware configs
          </span>
        </div>

        <div class="surface-card flex flex-wrap items-center justify-between gap-3 px-4 py-3">
          <div class="flex flex-wrap items-center gap-3">
            <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter hardware by status">
              {statusFilters.map((st) => (
                <button
                  type="button"
                  data-model-status-btn={st.key}
                  data-active={st.key === 'all' ? 'true' : 'false'}
                  data-i18n={st.i18nKey}
                  data-i18n-args={st.i18nArgs}
                  class="pill-filter"
                >
                  {st.label}
                </button>
              ))}
            </div>

            <span class="hidden h-4 w-px bg-[var(--border-subtle)] sm:inline-block" aria-hidden="true"></span>

            <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter hardware by vendor">
              {vendorFilters.map((vnd) => (
                <button
                  type="button"
                  data-model-vendor-btn={vnd.key}
                  data-active={vnd.key === 'all' ? 'true' : 'false'}
                  data-i18n={vnd.key === 'all' ? 'status.all' : undefined}
                  class="pill-filter"
                >
                  {vnd.label}
                </button>
              ))}
            </div>
          </div>

          <button
            id="model-filter-reset"
            type="button"
            data-i18n="common.reset"
            class="hidden text-xs font-semibold text-[var(--accent-ink)] hover:underline cursor-pointer"
          >
            Reset
          </button>
        </div>
      </div>

      <div id="model-table-wrap" class="table-shell mt-4">
        <table class="w-full min-w-[840px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-[var(--border-subtle)] bg-[var(--bg-subtle)] text-xs font-semibold uppercase tracking-wider text-[var(--ink-secondary)]">
              <th class="px-3 py-3" data-i18n="hub.colRank">Rank</th>
              <th class="px-3 py-3" data-i18n="hub.colHardware">Hardware</th>
              <th class="px-2.5 py-3" data-i18n="detail.colStatus">Fit / Speed</th>
              <th class="px-2.5 py-3" data-i18n="hub.colSpeed8k">Formula Speed (Q4 @ 8K)</th>
              <th class="px-2.5 py-3" data-i18n="detail.colGpuLayers">GPU Layers</th>
              <th class="px-2.5 py-3" data-i18n="hub.bestQuantMaxCtx">Max Fit &amp; @Max VRAM</th>
              <th class="px-3 py-3 text-right" data-i18n="hub.colCalculator">Calculator</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border-hairline)]">
            {rows.map((row, idx) => {
              const res = row.result;
              const tier = res.speed_tier ?? 'Readable';
              const gpuHubHref = `/gpu/${row.hardware.id}/`;
              const tpsText = formatTpsRange(res.est_tps_low, res.est_tps_high, res.est_tps, res.status);
              const speedPct =
                res.status === 'OOM' || fastestTps === 0
                  ? 0
                  : Math.max(4, Math.min(100, Math.round((res.est_tps / fastestTps) * 100)));
              const barColor =
                res.status === 'Fits'
                  ? 'bg-emerald-500'
                  : res.status === 'Tight Fit'
                    ? 'bg-orange-500'
                    : res.status === 'Partial Offload'
                      ? 'bg-amber-500'
                      : 'bg-rose-500';
              const barClass = `h-full rounded-full ${barColor}`;
              const barStyle = `width: ${speedPct}%`;
              const maxFitSpeedSuffix =
                row.maxFitTpsHigh > 0 ? ` (~${row.maxFitTpsLow}–${row.maxFitTpsHigh} tok/s)` : '';
              const maxCtxText = row.maxFitCtx
                ? `${formatContextLabel(row.maxFitCtx)} · ${row.maxFitVramGb.toFixed(1)} GB${maxFitSpeedSuffix}`
                : 'Offload / Q8 KV';
              const altSpeedStr =
                row.altRow.status === 'OOM'
                  ? 'OOM'
                  : `~${row.altRow.est_tps_low}–${row.altRow.est_tps_high} tok/s`;
              const altSummarySub = `${row.altRow.format}: ${row.altRow.total_vram_gb.toFixed(1)} GB · ${altSpeedStr}`;
              const speedClass =
                res.status === 'OOM'
                  ? 'font-mono font-semibold text-rose-600 dark:text-rose-400 tabular-nums whitespace-nowrap'
                  : 'font-mono font-bold text-[var(--ink-primary)] tabular-nums whitespace-nowrap';
              const ctaI18n = row.isCurated ? 'common.openGuide' : 'common.simulate';
              const ctaLabel = row.isCurated ? 'Open Guide ->' : 'Simulate ->';
              const usableLabel = (res.effective_usable_vram_gb ?? row.hardware.usable_vram_gb).toFixed(1);

              return (
                <tr
                  data-model-row
                  data-status={res.status}
                  data-vendor={row.hardware.vendor}
                  class="hover:bg-[var(--bg-hover)] transition-colors"
                >
                  <td class="px-3 py-3.5 align-top font-mono text-xs font-bold text-[var(--ink-tertiary)] tabular-nums">
                    #{idx + 1}
                  </td>
                  <td class="px-3 py-3.5 align-top">
                    <div class="flex flex-wrap items-center gap-1.5">
                      <a href={row.href} class="font-bold text-[var(--ink-primary)] hover:text-[var(--accent-ink)] transition-colors">
                        {row.hardware.name}
                      </a>
                      {row.isCurated ? (
                        <span class="badge-accent rounded px-1.5 py-0.5 text-[10px]" data-i18n="common.fullGuide">
                          Full Guide
                        </span>
                      ) : (
                        <span class="badge-neutral rounded px-1.5 py-0.5 text-[10px]" data-i18n="common.liveCalc">
                          Live Calc
                        </span>
                      )}
                    </div>
                    <div class="mt-0.5 flex flex-wrap items-center gap-2 text-xs text-[var(--ink-tertiary)]">
                      <span class="font-mono">
                        {row.hardware.backend} · {usableLabel} GB usable · {row.hardware.bandwidth_gbps} GB/s
                      </span>
                      <span>·</span>
                      <a href={gpuHubHref} class="hover:text-[var(--ink-primary)] underline decoration-[var(--border-strong)] underline-offset-2" data-i18n="hub.gpuHubLabel">
                        GPU Hub -&gt;
                      </a>
                    </div>
                  </td>
                  <td class="px-2.5 py-3.5 align-top">
                    <div class="flex flex-wrap items-center gap-1">
                      <StatusBadge status={res.status} />
                      <SpeedBadge tier={tier} />
                    </div>
                  </td>
                  <td class="px-2.5 py-3.5 align-top">
                    <div class={speedClass}>{tpsText}</div>
                    <div class="mt-1.5 h-1.5 w-24 overflow-hidden rounded-full bg-[var(--border-subtle)]">
                      <div class={barClass} style={barStyle}></div>
                    </div>
                    <div class="mt-1 font-mono text-[11px] text-[var(--ink-tertiary)] tabular-nums">{altSummarySub}</div>
                  </td>
                  <td class="px-2.5 py-3.5 align-top font-mono text-xs text-[var(--ink-secondary)] tabular-nums whitespace-nowrap">
                    {res.gpu_layers_fit}/{res.total_layers}
                  </td>
                  <td class="px-2.5 py-3.5 align-top text-xs">
                    <div class="font-mono font-semibold text-[var(--ink-primary)]">{row.recQuant}</div>
                    <div class="mt-0.5 text-[var(--ink-tertiary)]">{maxCtxText}</div>
                  </td>
                  <td class="px-3 py-3.5 align-top text-right">
                    <a
                      href={row.href}
                      data-i18n={ctaI18n}
                      class={row.isCurated ? 'badge-accent px-2.5 py-1 text-xs font-semibold hover:opacity-85 transition-opacity whitespace-nowrap' : 'btn-secondary px-2.5 py-1 text-xs whitespace-nowrap'}
                    >
                      {ctaLabel}
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div
        id="model-empty-state"
        class="surface-card mt-4 hidden border-dashed p-8 text-center"
      >
        <p class="text-sm font-semibold text-[var(--ink-primary)]" data-i18n="hub.noMatchingConfigs">
          No hardware entries match the selected status and vendor filters.
        </p>
        <button
          id="model-empty-reset"
          type="button"
          data-i18n="common.resetFilters"
          class="btn-mono mt-3 text-xs"
        >
          Reset Filters
        </button>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="model-faq-heading">
      <h2 id="model-faq-heading" class="text-xl font-bold tracking-tight text-[var(--ink-primary)]" data-i18n="hub.faqForTarget" data-i18n-args={modelFaqArgs}>
        Frequently Asked Questions ({model.short_name})
      </h2>
      <div class="mt-4 space-y-3">
        {faq.map((item, idx) => (
          <details
            open={idx < 2}
            class="surface-card group px-5 py-4 open:border-[var(--accent-border)]"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-[var(--ink-primary)]">
              <span>{item.question}</span>
              <span class="shrink-0 font-mono text-[var(--ink-tertiary)] group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-[var(--ink-secondary)]">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

    {otherModels.length > 0 && (
      <section class="mt-12 border-t border-[var(--border-subtle)] pt-8" aria-labelledby="other-models-heading">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 id="other-models-heading" class="text-xl font-bold tracking-tight text-[var(--ink-primary)]" data-i18n="hub.exploreOtherModels">
              Explore Other Open-Weight Model Hubs
            </h2>
            <p class="mt-1 text-sm text-[var(--ink-secondary)]">
              {otherModels.length + 1} LLMs
            </p>
          </div>
          <a href="/model/" class="text-xs font-semibold text-[var(--accent-ink)] hover:underline shrink-0" data-i18n="hub.browseAllModels" data-i18n-args={browseAllModelsArgs}>
            Browse All {allModels.length} Model Hubs -&gt;
          </a>
        </div>

        <div class="mt-4 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
          {otherModels.map((other) => {
            const otherHref = `/model/${other.id}/`;
            return (
              <a
                href={otherHref}
                class="surface-card-interactive flex flex-col justify-between p-4"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 text-xs">
                    <span class="font-mono font-semibold text-[var(--ink-tertiary)]">{other.family}</span>
                    <span class="font-mono font-bold text-[var(--ink-primary)] tabular-nums">{other.params_b}B</span>
                  </div>
                  <p class="mt-2 text-sm font-bold text-[var(--ink-primary)]">{other.name}</p>
                </div>
                <div class="mt-3 flex items-center justify-between text-xs text-[var(--ink-secondary)]">
                  <span class="font-mono">{other.architecture}</span>
                  <span class="font-semibold text-[var(--accent-ink)]" data-i18n="hub.modelHubLabel">Model Hub -&gt;</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  import { onLocaleChange, t } from '../../utils/i18n';

  function initModelHub() {
    const statusButtons = Array.from(document.querySelectorAll('[data-model-status-btn]'));
    const vendorButtons = Array.from(document.querySelectorAll('[data-model-vendor-btn]'));
    const rows = Array.from(document.querySelectorAll('[data-model-row]'));
    const countEl = document.getElementById('model-filter-count');
    const resetBtn = document.getElementById('model-filter-reset');
    const emptyResetBtn = document.getElementById('model-empty-reset');
    const tableWrap = document.getElementById('model-table-wrap');
    const emptyState = document.getElementById('model-empty-state');

    let selectedStatus = 'all';
    let selectedVendor = 'all';
    const total = rows.length;

    function updatePills() {
      statusButtons.forEach((b) => {
        const active = (b.getAttribute('data-model-status-btn') || 'all') === selectedStatus;
        b.setAttribute('data-active', active ? 'true' : 'false');
      });
      vendorButtons.forEach((b) => {
        const active = (b.getAttribute('data-model-vendor-btn') || 'all') === selectedVendor;
        b.setAttribute('data-active', active ? 'true' : 'false');
      });
    }

    function applyFilter() {
      let visible = 0;
      rows.forEach((row) => {
        const mStatus = selectedStatus === 'all' || row.getAttribute('data-status') === selectedStatus;
        const mVendor = selectedVendor === 'all' || row.getAttribute('data-vendor') === selectedVendor;
        const show = mStatus && mVendor;
        row.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });

      if (countEl) {
        countEl.textContent = t('hub.showingHwConfigs', { shown: visible, total });
      }
      const isFiltered = selectedStatus !== 'all' || selectedVendor !== 'all';
      if (resetBtn) resetBtn.classList.toggle('hidden', !isFiltered);
      if (tableWrap) tableWrap.classList.toggle('hidden', visible === 0);
      if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
    }

    function resetAll() {
      selectedStatus = 'all';
      selectedVendor = 'all';
      updatePills();
      applyFilter();
    }

    statusButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-model-status-btn') || 'all';
        selectedStatus = raw === 'Smooth' ? 'Fits' : raw;
        updatePills();
        applyFilter();
      });
    });

    vendorButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedVendor = btn.getAttribute('data-model-vendor-btn') || 'all';
        updatePills();
        applyFilter();
      });
    });

    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);

    onLocaleChange(() => applyFilter());
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initModelHub);
  } else {
    initModelHub();
  }
</script>
