---
import BaseLayout from '../../layouts/BaseLayout.astro';
import rawPagesData from '../../data/pages_data.json';
import rawCatalog from '../../data/catalog_data.json';
import type { CatalogData, VramPageEntry } from '../../types/vram';
import { buildModelHubs, getCatalogUpdatedAt } from '../../utils/hubs';
import { formatContextLabel } from '../../utils/physics';
import { aiCapabilitySortScore } from '../../utils/pricing';

const allEntries = rawPagesData as VramPageEntry[];
const catalog = rawCatalog as CatalogData;
const updatedAt = getCatalogUpdatedAt();
const hubs = buildModelHubs(allEntries);

const totalHubs = hubs.length;
const totalHwCount = catalog.hardware.length;
const totalConfigs = allEntries.length;
const families = Array.from(new Set(hubs.map((h) => h.model.family)));
const minParams = hubs.reduce((acc, h) => Math.min(acc, h.model.params_b), hubs[0]?.model.params_b ?? 0);
const maxParams = hubs.reduce((acc, h) => Math.max(acc, h.model.params_b), 0);

const canonicalPath = '/model/';
const pageTitle = `All ${totalHubs} Open-Weight LLM VRAM & GPU Hubs — VRAMCalc.me`;
const pageDescription = `Compare AA Score intelligence, Arena Elo, @8K & Max Fit VRAM, AWQ/MLX sizes, and ${totalHwCount}-GPU leaderboards across ${totalHubs} open-weight LLMs (${minParams}B–${maxParams}B): Qwen3.5/3.6/3.8, DeepSeek-V4.1/R1, Gemma 4, GPT-OSS, Llama 4 & GLM.`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vramcalc.me/' },
    { '@type': 'ListItem', position: 2, name: 'All Models', item: 'https://vramcalc.me/model/' },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: 'https://vramcalc.me/model/',
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Open-Weight LLM Model Hubs on VRAMCalc.me',
  numberOfItems: totalHubs,
  itemListElement: hubs.map((h, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: h.model.name,
    url: `https://vramcalc.me/model/${h.model.id}/`,
  })),
};

const ogTitle = `All ${totalHubs} Open-Weight LLM VRAM Hubs (AA Score + Arena Elo) | VRAMCalc.me`;
const ogDescription = `Exact Q4_K_M / AWQ 4-bit / Q8_0 / FP16 requirements and ${totalHwCount}-GPU speed rankings across ${totalHubs} open models.`;

const hubHeadingArgs = JSON.stringify({ count: totalHubs });
const hubAllModelsSubArgs = JSON.stringify({ hwCount: totalHwCount });
const hubAllFamiliesArgs = JSON.stringify({ count: totalHubs });
const hubShowingModelsArgs = JSON.stringify({ shown: totalHubs, total: totalHubs });
const browseAllHwArgs = JSON.stringify({ count: totalHwCount });
const updatedArgs = JSON.stringify({ date: updatedAt });
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  totalPages={totalConfigs}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage="/og/model-index.png"
  ogImageAlt={ogTitle}
  themeColor="#2563eb"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>

  <article class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-4">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs font-medium text-[var(--ink-tertiary)]">
        <li>
          <a href="/" class="hover:text-[var(--ink-primary)] transition-colors" data-i18n="common.home">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-semibold text-[var(--ink-primary)]" data-i18n="nav.models">Models</li>
      </ol>
    </nav>

    <header class="pb-6">
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge-accent font-mono text-xs" data-i18n="hub.modelDirBadge">
          Model Directory
        </span>
        <span class="badge-neutral font-mono text-xs">
          GGUF · AWQ · MLX
        </span>
        <span class="badge-fits font-mono text-xs" data-i18n="common.updated" data-i18n-args={updatedArgs}>
          Updated {updatedAt}
        </span>
      </div>

      <h1 class="mt-4 text-2xl font-extrabold tracking-tight text-[var(--ink-primary)] sm:text-4xl" data-i18n="hub.allModelsHeading" data-i18n-args={hubHeadingArgs}>
        All {totalHubs} Open-Weight LLM VRAM &amp; Hardware Hubs
      </h1>

      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-[var(--ink-secondary)] sm:text-base" data-i18n="hub.allModelsSub" data-i18n-args={hubAllModelsSubArgs}>
        Inspect exact @8K + Max Fit VRAM requirements, KV-cache scaling, AWQ/MLX comparisons, and ranked{' '}
        <strong class="text-[var(--ink-primary)]">{totalHwCount}-GPU</strong> leaderboards across Qwen3, Gemma 3, DeepSeek-R1,
        Llama-3.3, and Mistral.
      </p>

      <dl class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-px rounded-2xl border border-[var(--border-subtle)] bg-[var(--border-subtle)] shadow-[var(--shadow-card)] overflow-hidden">
        <div class="bg-[var(--bg-surface)] px-4 py-3.5">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-[var(--ink-tertiary)]" data-i18n="hub.indexedModels">Static Model Hubs</dt>
          <dd class="mt-1 font-mono text-xl font-bold text-[var(--ink-primary)] tabular-nums">{totalHubs}</dd>
        </div>
        <div class="bg-[var(--bg-surface)] px-4 py-3.5">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-[var(--ink-tertiary)]" data-i18n="hub.modelFamilies">Model Families</dt>
          <dd class="mt-1 font-mono text-xl font-bold text-[var(--accent-ink)] tabular-nums">{families.length}</dd>
        </div>
        <div class="bg-[var(--bg-surface)] px-4 py-3.5">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-[var(--ink-tertiary)]" data-i18n="hub.paramRange">Parameter Range</dt>
          <dd class="mt-1 font-mono text-xl font-bold text-emerald-600 dark:text-emerald-400 tabular-nums">
            {minParams}B – {maxParams}B
          </dd>
        </div>
        <div class="bg-[var(--bg-surface)] px-4 py-3.5">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-[var(--ink-tertiary)]" data-i18n="hub.hwBenchmarks">GPUs Evaluated Each</dt>
          <dd class="mt-1 font-mono text-xl font-bold text-[var(--ink-primary)] tabular-nums">{totalHwCount} GPUs</dd>
        </div>
      </dl>
    </header>

    <section class="mt-2" aria-label="Filter model hubs">
      <div class="surface-card p-4 sm:p-5">
        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
          <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter by model family">
            <button
              type="button"
              data-dir-family-btn="all"
              data-active="true"
              data-i18n="hub.allFamilies"
              data-i18n-args={hubAllFamiliesArgs}
              class="pill-filter"
            >
              All Families ({totalHubs})
            </button>
            {families.map((fam) => (
              <button
                type="button"
                data-dir-family-btn={fam}
                data-active="false"
                class="pill-filter"
              >
                {fam}
              </button>
            ))}
          </div>

          <div class="w-full md:w-72">
            <label for="dir-model-search" class="sr-only">Search model</label>
            <input
              id="dir-model-search"
              type="search"
              placeholder="Search e.g. Qwen3, Gemma 3, DeepSeek, 27B..."
              data-i18n-placeholder="hub.searchModelPh"
              class="field-input h-9 px-3 text-sm"
            />
          </div>
        </div>

        <div class="mt-3 flex flex-wrap items-center justify-between gap-3 border-t border-[var(--border-hairline)] pt-3 text-xs text-[var(--ink-secondary)]">
          <div class="flex flex-wrap items-center gap-3">
            <span id="dir-model-count" class="font-mono tabular-nums" data-i18n="hub.showingModelHubs" data-i18n-args={hubShowingModelsArgs}>
              Showing {totalHubs} of {totalHubs} model hubs
            </span>
            <button
              id="dir-model-reset"
              type="button"
              data-i18n="common.reset"
              class="hidden font-semibold text-[var(--accent-ink)] hover:underline cursor-pointer"
            >
              Reset
            </button>
          </div>
          <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Sort models">
            <button
              type="button"
              data-dir-model-sort="default"
              data-active="true"
              class="pill-filter text-[11px]"
              data-i18n="home.sortRecommended"
            >
              Recommended
            </button>
            <button
              type="button"
              data-dir-model-sort="ai-score"
              data-active="false"
              class="pill-filter text-[11px]"
              data-i18n="model.sortAiScore"
            >
              AI Score ↓
            </button>
            <button
              type="button"
              data-dir-model-sort="params-asc"
              data-active="false"
              class="pill-filter text-[11px]"
              data-i18n="model.sortParamsAsc"
            >
              Params ↑
            </button>
          </div>
        </div>
      </div>

      <p class="mt-3 text-xs leading-relaxed text-[var(--ink-tertiary)]">
        <span data-i18n="score.methodologyNote">
          Open-weight capability scores cross-reference Artificial Analysis Intelligence Index v5.0.2 (AA Score) and LMArena Text Arena Elo (2026-11-22). Models showing “—” have no published entry in that benchmark version.
        </span>{' '}
        <a href="https://artificialanalysis.ai/models" target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--ink-primary)]">Artificial Analysis</a>
        {' · '}
        <a href="https://lmarena.ai/leaderboard" target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--ink-primary)]">LMArena</a>
      </p>

      <div id="dir-model-grid" class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {hubs.map((hub, idx) => {
          const m = hub.model;
          const aiScore = aiCapabilitySortScore(m);
          const hubHref = `/model/${m.id}/`;
          const q4Gb = `${hub.q4Row.total_vram_gb.toFixed(1)} GB`;
          const awqGb = `${hub.awqRow.total_vram_gb.toFixed(1)} GB`;
          const q8Gb = `${hub.q8Row.total_vram_gb.toFixed(1)} GB`;
          const topHwRow = hub.topPicks[0]?.row;
          const topHwText = topHwRow
            ? `${topHwRow.hardware.short_name} (${hub.fastestTpsText})`
            : 'See leaderboard';
          const searchBlob = [m.id, m.name, m.short_name, m.family, m.architecture, m.ollama_tag]
            .join(' ')
            .toLowerCase();
          const gpusEvalArgs = JSON.stringify({ count: hub.rows.length });

          return (
            <article
              data-dir-model-card
              data-index={idx}
              data-ai-score={aiScore}
              data-params={m.params_b}
              data-family={m.family}
              data-search={searchBlob}
              class="surface-card-interactive group flex flex-col justify-between p-5"
            >
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="badge-accent font-mono text-[11px]">
                    {m.family}
                  </span>
                  <span class="font-mono text-[11px] font-semibold text-[var(--ink-tertiary)] tabular-nums">
                    {m.params_b}B · {formatContextLabel(m.max_context)} max
                  </span>
                </div>

                <h2 class="mt-3 text-lg font-bold tracking-tight text-[var(--ink-primary)] group-hover:text-[var(--accent-ink)] transition-colors">
                  <a href={hubHref} class="focus:outline-none">
                    {m.name}
                  </a>
                </h2>
                <p class="mt-0.5 font-mono text-xs text-[var(--ink-tertiary)]">
                  {m.architecture} · +{hub.kvPer4k.toFixed(2)} GB KV / 4K
                </p>

                <div class="mt-2 flex flex-wrap items-center gap-1.5 font-mono text-[10.5px]">
                  {m.aa_index ? (
                    <span
                      class="badge-accent rounded px-1.5 py-0.5 font-semibold"
                      title={m.aa_label ?? 'Artificial Analysis Intelligence Index v5.0.2'}
                    >
                      AA Score · {m.aa_index}
                    </span>
                  ) : null}
                  {m.arena_elo ? (
                    <span
                      class="rounded border border-[var(--border-hairline)] bg-[var(--bg-subtle)] px-1.5 py-0.5 font-medium text-[var(--ink-secondary)]"
                      title={m.arena_rank ? `LMArena Text Arena #${m.arena_rank} (2026-11-22)` : 'LMArena Text Arena Elo (2026-11-22)'}
                    >
                      Arena · {m.arena_elo}
                    </span>
                  ) : null}
                  {!m.aa_index && !m.arena_elo && (
                    <span class="rounded border border-[var(--border-hairline)] bg-[var(--bg-subtle)] px-1.5 py-0.5 text-[var(--ink-tertiary)]" data-i18n="score.unscored">
                      Unscored in AA Score
                    </span>
                  )}
                </div>

                <dl class="surface-inset mt-3 grid grid-cols-3 gap-2 p-3 text-xs">
                  <div>
                    <dt class="text-[11px] text-[var(--ink-tertiary)]">Q4_K_M @ 8K</dt>
                    <dd class="font-mono font-bold text-[var(--ink-primary)] tabular-nums">{q4Gb}</dd>
                  </div>
                  <div>
                    <dt class="text-[11px] text-[var(--ink-tertiary)]">AWQ 4-bit</dt>
                    <dd class="font-mono font-semibold text-[var(--ink-secondary)] tabular-nums">{awqGb}</dd>
                  </div>
                  <div>
                    <dt class="text-[11px] text-[var(--ink-tertiary)]">Q8_0 @ 8K</dt>
                    <dd class="font-mono font-semibold text-[var(--ink-secondary)] tabular-nums">{q8Gb}</dd>
                  </div>
                </dl>

                <div class="mt-3 flex flex-wrap items-center gap-1.5 text-[11px] font-mono">
                  <span class="badge-fits tabular-nums">
                    {hub.fitsCount} Fits
                  </span>
                  {hub.tightCount > 0 && (
                    <span class="badge-tight tabular-nums">
                      {hub.tightCount} Tight
                    </span>
                  )}
                  {hub.partialCount > 0 && (
                    <span class="badge-partial tabular-nums">
                      {hub.partialCount} Partial
                    </span>
                  )}
                </div>
              </div>

              <div class="mt-4 border-t border-[var(--border-hairline)] pt-3.5">
                <div class="text-[11px] uppercase tracking-wider text-[var(--ink-tertiary)] font-semibold" data-i18n="hub.fastestHw">
                  Fastest Resident Hardware
                </div>
                <div class="mt-0.5 font-mono text-xs font-semibold text-[var(--ink-primary)] truncate">
                  {topHwText}
                </div>

                <div class="mt-3 flex items-center justify-between text-xs">
                  <span class="font-mono text-[var(--ink-tertiary)]" data-i18n="hub.gpusTested" data-i18n-args={gpusEvalArgs}>
                    {hub.rows.length} GPUs evaluated
                  </span>
                  <a href={hubHref} class="font-semibold text-[var(--accent-ink)] hover:underline" data-i18n="hub.compareAllGpus">
                    Compare All GPUs -&gt;
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <div
        id="dir-model-empty"
        class="surface-card mt-8 hidden border-dashed p-10 text-center"
      >
        <p class="text-base font-semibold text-[var(--ink-primary)]" data-i18n="hub.noModelHubs">No matching model hubs</p>
        <button
          id="dir-model-empty-reset"
          type="button"
          data-i18n="common.resetFilters"
          class="btn-mono mt-4"
        >
          Reset Filters
        </button>
      </div>
    </section>

    <section class="surface-card mt-12 p-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-[var(--ink-primary)]" data-i18n="hub.shopSpecificGpu">
          Shopping or Inspecting a Specific GPU or Cloud Instance?
        </h2>
        <p class="mt-1 text-sm text-[var(--ink-secondary)]" data-i18n="hub.shopSpecificGpuSub">
          Open a hardware hub to filter every model tested on T4, L4, A10, RTX 50/40/30, Apple M1–M5, or Strix Halo.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a
          href="/gpu/"
          data-i18n="hub.browseAllHw"
          data-i18n-args={browseAllHwArgs}
          class="btn-mono"
        >
          Browse All {totalHwCount} Hardware Hubs -&gt;
        </a>
        <a
          href="/"
          data-i18n="hub.fullMatrixBtn"
          class="btn-secondary"
        >
          Full Compatibility Matrix -&gt;
        </a>
      </div>
    </section>
  </article>
</BaseLayout>

<script>
  import { onLocaleChange, t } from '../../utils/i18n';

  function initModelDirectory() {
    const famBtns = Array.from(document.querySelectorAll('[data-dir-family-btn]'));
    const sortBtns = Array.from(document.querySelectorAll('[data-dir-model-sort]'));
    const searchInput = document.getElementById('dir-model-search') as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll('[data-dir-model-card]'));
    const countEl = document.getElementById('dir-model-count');
    const resetBtn = document.getElementById('dir-model-reset');
    const emptyState = document.getElementById('dir-model-empty');
    const emptyReset = document.getElementById('dir-model-empty-reset');
    const grid = document.getElementById('dir-model-grid');

    let selectedFamily = 'all';
    let selectedSort = 'default';
    const total = cards.length;

    function updateButtons() {
      famBtns.forEach((b) => {
        const active = (b.getAttribute('data-dir-family-btn') || 'all') === selectedFamily;
        b.setAttribute('data-active', active ? 'true' : 'false');
      });
      sortBtns.forEach((b) => {
        const active = (b.getAttribute('data-dir-model-sort') || 'default') === selectedSort;
        b.setAttribute('data-active', active ? 'true' : 'false');
      });
    }

    function applySort() {
      if (!grid) return;
      const sorted = [...cards].sort((a, b) => {
        if (selectedSort === 'ai-score') {
          const sd = Number(b.getAttribute('data-ai-score') || 0) - Number(a.getAttribute('data-ai-score') || 0);
          if (sd !== 0) return sd;
          return Number(a.getAttribute('data-index') || 0) - Number(b.getAttribute('data-index') || 0);
        }
        if (selectedSort === 'params-asc') {
          const pd = Number(a.getAttribute('data-params') || 0) - Number(b.getAttribute('data-params') || 0);
          if (pd !== 0) return pd;
          return Number(b.getAttribute('data-ai-score') || 0) - Number(a.getAttribute('data-ai-score') || 0);
        }
        return Number(a.getAttribute('data-index') || 0) - Number(b.getAttribute('data-index') || 0);
      });
      const frag = document.createDocumentFragment();
      sorted.forEach((c) => frag.appendChild(c));
      grid.appendChild(frag);
    }

    function applyFilter() {
      const q = searchInput ? searchInput.value.trim().toLowerCase() : '';
      let visible = 0;

      cards.forEach((card) => {
        const mf = selectedFamily === 'all' || card.getAttribute('data-family') === selectedFamily;
        const blob = card.getAttribute('data-search') || '';
        const mq = !q || blob.includes(q);
        const show = mf && mq;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });

      if (countEl) countEl.textContent = t('hub.showingModelHubs', { shown: visible, total });
      const isFiltered = selectedFamily !== 'all' || q.length > 0;
      if (resetBtn) resetBtn.classList.toggle('hidden', !isFiltered);
      if (grid) grid.classList.toggle('hidden', visible === 0);
      if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
    }

    function resetAll() {
      selectedFamily = 'all';
      selectedSort = 'default';
      if (searchInput) searchInput.value = '';
      updateButtons();
      applySort();
      applyFilter();
    }

    famBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedFamily = btn.getAttribute('data-dir-family-btn') || 'all';
        updateButtons();
        applyFilter();
      });
    });

    sortBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedSort = btn.getAttribute('data-dir-model-sort') || 'default';
        updateButtons();
        applySort();
      });
    });

    if (searchInput) searchInput.addEventListener('input', applyFilter);
    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (emptyReset) emptyReset.addEventListener('click', resetAll);

    onLocaleChange(() => applyFilter());
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initModelDirectory);
  } else {
    initModelDirectory();
  }
</script>
