---
import BaseLayout from '../../layouts/BaseLayout.astro';
import rawPagesData from '../../data/pages_data.json';
import rawCatalog from '../../data/catalog_data.json';
import type { CatalogData, VramPageEntry } from '../../types/vram';
import { buildModelHubs, getCatalogUpdatedAt } from '../../utils/hubs';
import { formatContextLabel } from '../../utils/physics';

const allEntries = rawPagesData as VramPageEntry[];
const catalog = rawCatalog as CatalogData;
const updatedAt = getCatalogUpdatedAt();
const hubs = buildModelHubs(allEntries);

const totalHubs = hubs.length;
const totalHwCount = catalog.hardware.length;
const totalConfigs = allEntries.length;
const families = Array.from(new Set(hubs.map((h) => h.model.family)));
const minParams = hubs.reduce((acc, h) => Math.min(acc, h.model.params_b), hubs[0]?.model.params_b ?? 0);
const maxParams = hubs.reduce((acc, h) => Math.max(acc, h.model.params_b), 0);

const canonicalPath = '/model/';
const pageTitle = `All ${totalHubs} Open-Weight LLM VRAM & GPU Hubs — VRAMCalc.me`;
const pageDescription = `Compare @8K & Max Fit VRAM, AWQ/MLX sizes, and ${totalHwCount}-GPU leaderboards for all ${totalHubs} open-weight LLMs (${minParams}B–${maxParams}B): Qwen3, Gemma 3, DeepSeek-R1, Llama-3.3 & Mistral.`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vramcalc.me/' },
    { '@type': 'ListItem', position: 2, name: 'All Models', item: 'https://vramcalc.me/model/' },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: 'https://vramcalc.me/model/',
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Open-Weight LLM Model Hubs on VRAMCalc.me',
  numberOfItems: totalHubs,
  itemListElement: hubs.map((h, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: h.model.name,
    url: `https://vramcalc.me/model/${h.model.id}/`,
  })),
};

const ogTitle = `All ${totalHubs} Open-Weight LLM VRAM Hubs (Qwen3, Gemma 3, DeepSeek) | VRAMCalc.me`;
const ogDescription = `Exact Q4_K_M / AWQ 4-bit / Q8_0 / FP16 requirements and ${totalHwCount}-GPU speed rankings across ${totalHubs} open models.`;

const hubHeadingArgs = JSON.stringify({ count: totalHubs });
const hubAllModelsSubArgs = JSON.stringify({ hwCount: totalHwCount });
const hubAllFamiliesArgs = JSON.stringify({ count: totalHubs });
const hubShowingModelsArgs = JSON.stringify({ shown: totalHubs, total: totalHubs });
const browseAllHwArgs = JSON.stringify({ count: totalHwCount });
const updatedArgs = JSON.stringify({ date: updatedAt });
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  totalPages={totalConfigs}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage="/og/model-index.png"
  ogImageAlt={ogTitle}
  themeColor="#2563eb"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>

  <article class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-4">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs font-medium text-slate-500">
        <li>
          <a href="/" class="hover:text-slate-900 transition-colors" data-i18n="common.home">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-slate-900 font-semibold" data-i18n="nav.models">Models</li>
      </ol>
    </nav>

    <header class="rounded-2xl border border-slate-800 bg-slate-950 p-6 text-slate-100 shadow-xs sm:p-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full border border-blue-500/40 bg-blue-500/15 px-2.5 py-0.5 font-mono text-xs font-semibold text-blue-300" data-i18n="hub.modelDirBadge">
          Model Directory
        </span>
        <span class="rounded-full border border-slate-700 bg-slate-900 px-2.5 py-0.5 font-mono text-xs text-slate-300">
          GGUF · AWQ · MLX
        </span>
        <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 font-mono text-xs text-emerald-300" data-i18n="common.updated" data-i18n-args={updatedArgs}>
          Updated {updatedAt}
        </span>
      </div>

      <h1 class="mt-4 text-2xl font-extrabold tracking-tight text-white sm:text-4xl" data-i18n="hub.allModelsHeading" data-i18n-args={hubHeadingArgs}>
        All {totalHubs} Open-Weight LLM VRAM &amp; Hardware Hubs
      </h1>

      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-300 sm:text-base" data-i18n="hub.allModelsSub" data-i18n-args={hubAllModelsSubArgs}>
        Inspect exact @8K + Max Fit VRAM requirements, KV-cache scaling, AWQ/MLX comparisons, and ranked{' '}
        <strong class="text-white">{totalHwCount}-GPU</strong> leaderboards across Qwen3, Gemma 3, DeepSeek-R1,
        Llama-3.3, and Mistral.
      </p>

      <dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400" data-i18n="hub.indexedModels">Static Model Hubs</dt>
          <dd class="mt-1 font-mono text-xl font-bold text-white tabular-nums">{totalHubs}</dd>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400" data-i18n="hub.modelFamilies">Model Families</dt>
          <dd class="mt-1 font-mono text-xl font-bold text-sky-300 tabular-nums">{families.length}</dd>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400" data-i18n="hub.paramRange">Parameter Range</dt>
          <dd class="mt-1 font-mono text-xl font-bold text-emerald-300 tabular-nums">
            {minParams}B – {maxParams}B
          </dd>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 px-4 py-3">
          <dt class="text-[11px] font-medium uppercase tracking-wider text-slate-400" data-i18n="hub.hwBenchmarks">GPUs Evaluated Each</dt>
          <dd class="mt-1 font-mono text-xl font-bold text-white tabular-nums">{totalHwCount} GPUs</dd>
        </div>
      </dl>
    </header>

    <section class="mt-7" aria-label="Filter model hubs">
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs sm:p-5">
        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
          <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter by model family">
            <button
              type="button"
              data-dir-family-btn="all"
              data-i18n="hub.allFamilies"
              data-i18n-args={hubAllFamiliesArgs}
              class="rounded-full border px-3 py-1 text-xs font-semibold transition-colors cursor-pointer border-slate-900 bg-slate-900 text-white"
            >
              All Families ({totalHubs})
            </button>
            {families.map((fam) => (
              <button
                type="button"
                data-dir-family-btn={fam}
                class="rounded-full border px-3 py-1 text-xs font-semibold transition-colors cursor-pointer border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100"
              >
                {fam}
              </button>
            ))}
          </div>

          <div class="w-full md:w-72">
            <label for="dir-model-search" class="sr-only">Search model</label>
            <input
              id="dir-model-search"
              type="search"
              placeholder="Search e.g. Qwen3, Gemma 3, DeepSeek, 27B..."
              data-i18n-placeholder="hub.searchModelPh"
              class="w-full rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-none"
            />
          </div>
        </div>

        <div class="mt-3 flex items-center justify-between gap-3 border-t border-slate-100 pt-3 text-xs text-slate-600">
          <span id="dir-model-count" class="font-mono tabular-nums" data-i18n="hub.showingModelHubs" data-i18n-args={hubShowingModelsArgs}>
            Showing {totalHubs} of {totalHubs} model hubs
          </span>
          <button
            id="dir-model-reset"
            type="button"
            data-i18n="common.reset"
            class="hidden font-semibold text-blue-600 hover:text-blue-800 cursor-pointer"
          >
            Reset
          </button>
        </div>
      </div>

      <div id="dir-model-grid" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {hubs.map((hub) => {
          const m = hub.model;
          const hubHref = `/model/${m.id}/`;
          const q4Gb = `${hub.q4Row.total_vram_gb.toFixed(1)} GB`;
          const awqGb = `${hub.awqRow.total_vram_gb.toFixed(1)} GB`;
          const q8Gb = `${hub.q8Row.total_vram_gb.toFixed(1)} GB`;
          const topHwRow = hub.topPicks[0]?.row;
          const topHwText = topHwRow
            ? `${topHwRow.hardware.short_name} (${hub.fastestTpsText})`
            : 'See leaderboard';
          const searchBlob = [m.id, m.name, m.short_name, m.family, m.architecture, m.ollama_tag]
            .join(' ')
            .toLowerCase();
          const gpusEvalArgs = JSON.stringify({ count: hub.rows.length });

          return (
            <article
              data-dir-model-card
              data-family={m.family}
              data-search={searchBlob}
              class="group flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 transition-all hover:border-blue-300 hover:shadow-md"
            >
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="rounded-full border border-blue-200 bg-blue-50 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-blue-800">
                    {m.family}
                  </span>
                  <span class="rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[11px] font-bold text-slate-700 tabular-nums">
                    {m.params_b}B · {formatContextLabel(m.max_context)} max
                  </span>
                </div>

                <h2 class="mt-3 text-lg font-bold tracking-tight text-slate-950 group-hover:text-blue-600 transition-colors">
                  <a href={hubHref} class="focus:outline-none">
                    {m.name}
                  </a>
                </h2>
                <p class="mt-0.5 font-mono text-xs text-slate-500">
                  {m.architecture} · +{hub.kvPer4k.toFixed(2)} GB KV / 4K
                </p>

                <dl class="mt-3 grid grid-cols-3 gap-2 rounded-xl border border-slate-100 bg-slate-50/80 p-3 text-xs">
                  <div>
                    <dt class="text-[11px] text-slate-500">Q4_K_M @ 8K</dt>
                    <dd class="font-mono font-bold text-slate-950 tabular-nums">{q4Gb}</dd>
                  </div>
                  <div>
                    <dt class="text-[11px] text-slate-500">AWQ 4-bit</dt>
                    <dd class="font-mono font-semibold text-slate-800 tabular-nums">{awqGb}</dd>
                  </div>
                  <div>
                    <dt class="text-[11px] text-slate-500">Q8_0 @ 8K</dt>
                    <dd class="font-mono font-semibold text-slate-800 tabular-nums">{q8Gb}</dd>
                  </div>
                </dl>

                <div class="mt-3 flex flex-wrap items-center gap-1.5 text-[11px] font-mono">
                  <span class="rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 font-semibold text-emerald-800 tabular-nums">
                    {hub.fitsCount} Fits
                  </span>
                  {hub.tightCount > 0 && (
                    <span class="rounded-full border border-orange-200 bg-orange-50 px-2 py-0.5 font-semibold text-orange-800 tabular-nums">
                      {hub.tightCount} Tight
                    </span>
                  )}
                  {hub.partialCount > 0 && (
                    <span class="rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 font-semibold text-amber-800 tabular-nums">
                      {hub.partialCount} Partial
                    </span>
                  )}
                </div>
              </div>

              <div class="mt-4 border-t border-slate-100 pt-3.5">
                <div class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold" data-i18n="hub.fastestHw">
                  Fastest Resident Hardware
                </div>
                <div class="mt-0.5 font-mono text-xs font-semibold text-slate-800 truncate">
                  {topHwText}
                </div>

                <div class="mt-3 flex items-center justify-between text-xs">
                  <span class="font-mono text-slate-500" data-i18n="hub.gpusTested" data-i18n-args={gpusEvalArgs}>
                    {hub.rows.length} GPUs evaluated
                  </span>
                  <a href={hubHref} class="font-semibold text-blue-600 hover:text-blue-800" data-i18n="hub.compareAllGpus">
                    Compare All GPUs -&gt;
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <div
        id="dir-model-empty"
        class="mt-8 hidden rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center"
      >
        <p class="text-base font-semibold text-slate-900" data-i18n="hub.noModelHubs">No matching model hubs</p>
        <button
          id="dir-model-empty-reset"
          type="button"
          data-i18n="common.resetFilters"
          class="mt-4 rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800 cursor-pointer"
        >
          Reset Filters
        </button>
      </div>
    </section>

    <section class="mt-12 rounded-2xl border border-slate-200 bg-white p-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-slate-950" data-i18n="hub.shopSpecificGpu">
          Shopping or Inspecting a Specific GPU or Cloud Instance?
        </h2>
        <p class="mt-1 text-sm text-slate-600" data-i18n="hub.shopSpecificGpuSub">
          Open a hardware hub to filter every model tested on T4, L4, A10, RTX 50/40/30, Apple M1–M5, or Strix Halo.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a
          href="/gpu/"
          data-i18n="hub.browseAllHw"
          data-i18n-args={browseAllHwArgs}
          class="rounded-lg bg-slate-950 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800 transition-colors"
        >
          Browse All {totalHwCount} Hardware Hubs -&gt;
        </a>
        <a
          href="/"
          data-i18n="hub.fullMatrixBtn"
          class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors"
        >
          Full Compatibility Matrix -&gt;
        </a>
      </div>
    </section>
  </article>
</BaseLayout>

<script>
  import { onLocaleChange, t } from '../../utils/i18n';

  function initModelDirectory() {
    const famBtns = Array.from(document.querySelectorAll('[data-dir-family-btn]'));
    const searchInput = document.getElementById('dir-model-search') as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll('[data-dir-model-card]'));
    const countEl = document.getElementById('dir-model-count');
    const resetBtn = document.getElementById('dir-model-reset');
    const emptyState = document.getElementById('dir-model-empty');
    const emptyReset = document.getElementById('dir-model-empty-reset');
    const grid = document.getElementById('dir-model-grid');

    let selectedFamily = 'all';
    const total = cards.length;

    function updateButtons() {
      famBtns.forEach((b) => {
        const active = (b.getAttribute('data-dir-family-btn') || 'all') === selectedFamily;
        b.classList.toggle('border-slate-900', active);
        b.classList.toggle('bg-slate-900', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('border-slate-200', !active);
        b.classList.toggle('bg-slate-50', !active);
        b.classList.toggle('text-slate-700', !active);
      });
    }

    function applyFilter() {
      const q = searchInput ? searchInput.value.trim().toLowerCase() : '';
      let visible = 0;

      cards.forEach((card) => {
        const mf = selectedFamily === 'all' || card.getAttribute('data-family') === selectedFamily;
        const blob = card.getAttribute('data-search') || '';
        const mq = !q || blob.includes(q);
        const show = mf && mq;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });

      if (countEl) countEl.textContent = t('hub.showingModelHubs', { shown: visible, total });
      const isFiltered = selectedFamily !== 'all' || q.length > 0;
      if (resetBtn) resetBtn.classList.toggle('hidden', !isFiltered);
      if (grid) grid.classList.toggle('hidden', visible === 0);
      if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
    }

    function resetAll() {
      selectedFamily = 'all';
      if (searchInput) searchInput.value = '';
      updateButtons();
      applyFilter();
    }

    famBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedFamily = btn.getAttribute('data-dir-family-btn') || 'all';
        updateButtons();
        applyFilter();
      });
    });

    if (searchInput) searchInput.addEventListener('input', applyFilter);
    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (emptyReset) emptyReset.addEventListener('click', resetAll);

    onLocaleChange(() => applyFilter());
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initModelDirectory);
  } else {
    initModelDirectory();
  }
</script>
