---
import '../styles/global.css';
import rawCatalog from '../data/catalog_data.json';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  totalPages?: number;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  themeColor?: string;
}

const {
  title,
  description,
  canonicalPath = '/',
  totalPages: _totalPages = 0,
  ogTitle,
  ogDescription,
  ogImage = '/og/home.png',
  ogImageAlt,
  themeColor = '#f5f5f7',
} = Astro.props;

const updatedAt = (rawCatalog as { updated_at?: string }).updated_at ?? '2026-11-24';
const engineVersion = (rawCatalog as { engine_version?: string }).engine_version ?? 'v3.3';

const canonicalUrl = new URL(canonicalPath, Astro.site ?? 'https://vramcalc.me').toString();
const socialTitle = ogTitle ?? title;
const socialDesc = ogDescription ?? description;
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://vramcalc.me').toString();
const socialImageAlt = ogImageAlt ?? socialTitle;
const isHome = canonicalPath === '/';
const isCalc = canonicalPath.startsWith('/calculator');
const isGpu = canonicalPath.startsWith('/gpu/');
const isModel = canonicalPath.startsWith('/model/');
const isChangelog = canonicalPath.startsWith('/changelog');

const navBase = 'whitespace-nowrap rounded-lg px-2.5 py-1.5 transition-colors';
const navActive = `${navBase} bg-[var(--bg-subtle)] text-[var(--ink-primary)] font-semibold`;
const navIdle = `${navBase} text-[var(--ink-secondary)] hover:bg-[var(--bg-subtle)] hover:text-[var(--ink-primary)]`;

const navMatrixClass = isHome ? navActive : navIdle;
const navCalcClass = isCalc ? navActive : navIdle;
const navGpuClass = isGpu ? navActive : navIdle;
const navModelClass = isModel ? navActive : navIdle;
const navChangelogClass = isChangelog ? navActive : navIdle;
const navDesktopChangelogClass = `hidden md:inline ${navChangelogClass}`;
const footerMetaArgs = JSON.stringify({ date: updatedAt, ver: engineVersion });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="theme-color" content={themeColor} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="VRAMCalc.me" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDesc} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <script is:inline>
      (function () {
        var valid = { en: 'en', 'zh-CN': 'zh-CN', 'zh-TW': 'zh-TW', ja: 'ja', es: 'es', fr: 'fr', ko: 'ko' };
        var loc = '';
        var st = '';
        try {
          var qp = new URLSearchParams(window.location.search).get('lang');
          if (qp && valid[qp]) loc = qp;
        } catch (e) {}
        if (!loc) {
          try {
            st = window.localStorage.getItem('vramcalc_lang') || '';
            if (st && valid[st]) loc = st;
          } catch (e) {}
        }
        if (!loc && st === 'auto') {
          var list = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'en'];
          for (var i = 0; i < list.length; i++) {
            var tag = String(list[i] || '').trim().toLowerCase().replace(/_/g, '-');
            if (!tag) continue;
            if (tag === 'zh-tw' || tag === 'zh-hk' || tag === 'zh-mo' || tag.indexOf('zh-hant') === 0) {
              loc = 'zh-TW';
              break;
            }
            if (tag === 'zh' || tag.indexOf('zh-') === 0) {
              loc = 'zh-CN';
              break;
            }
            if (tag === 'ja' || tag.indexOf('ja-') === 0) {
              loc = 'ja';
              break;
            }
            if (tag === 'es' || tag.indexOf('es-') === 0) {
              loc = 'es';
              break;
            }
            if (tag === 'fr' || tag.indexOf('fr-') === 0) {
              loc = 'fr';
              break;
            }
            if (tag === 'ko' || tag.indexOf('ko-') === 0) {
              loc = 'ko';
              break;
            }
            if (tag === 'en' || tag.indexOf('en-') === 0) {
              loc = 'en';
              break;
            }
          }
        }
        loc = loc || 'en';
        document.documentElement.lang = loc;
        document.documentElement.dataset.locale = loc;

        var isDark = false;
        try {
          isDark = window.localStorage.getItem('vramcalc_theme') === 'dark';
        } catch (e) {}
        document.documentElement.classList.toggle('dark', isDark);
        document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
        var tcMeta = document.querySelector('meta[name="theme-color"]');
        if (tcMeta) tcMeta.setAttribute('content', isDark ? '#0a0a0c' : '#f5f5f7');
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-[var(--bg-canvas)] text-[var(--ink-primary)] antialiased flex flex-col">
    <header class="sticky top-0 z-40 border-b border-[var(--border-subtle)] bg-[var(--bg-header)] backdrop-blur-xl">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-3 gap-y-2 px-4 py-2.5 sm:flex-nowrap sm:gap-4 sm:px-6 sm:py-3">
        <a
          href="/"
          class="flex shrink-0 items-center gap-2.5 font-semibold tracking-tight text-[var(--ink-primary)] hover:opacity-85 transition-opacity"
        >
          <span class="flex h-7 w-7 sm:h-8 sm:w-8 items-center justify-center rounded-lg bg-[var(--pill-active-bg)] text-[var(--pill-active-ink)]">
            <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <rect x="3" y="4" width="18" height="4" rx="1" />
              <rect x="3" y="10" width="13" height="4" rx="1" />
              <rect x="3" y="16" width="8" height="4" rx="1" />
              <path d="M19 11v9m0 0l2.5-2.5M19 20l-2.5-2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="text-sm sm:text-base whitespace-nowrap">
            VRAMCalc<span class="text-[var(--accent)]">.me</span>
          </span>
        </a>

        <div class="flex items-center gap-2 shrink-0 sm:order-3">
          <button
            id="theme-toggle-btn"
            type="button"
            aria-pressed="false"
            aria-label="Toggle color theme"
            data-i18n-aria="theme.toggleAria"
            class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--ink-secondary)] hover:border-[var(--border-strong)] hover:bg-[var(--bg-subtle)] hover:text-[var(--ink-primary)] transition-colors cursor-pointer"
          >
            <svg class="h-4 w-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            </svg>
            <svg class="h-4 w-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
          </button>

          <div id="lang-switcher" class="relative shrink-0">
            <button
              id="lang-switcher-btn"
              type="button"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-label="Select language"
              class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-2.5 text-xs font-medium text-[var(--ink-secondary)] hover:border-[var(--border-strong)] hover:bg-[var(--bg-subtle)] hover:text-[var(--ink-primary)] transition-colors cursor-pointer"
            >
              <svg class="h-3.5 w-3.5 text-[var(--ink-tertiary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <path d="M2 12h20" />
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
              <span id="lang-switcher-label">EN</span>
              <svg class="h-3 w-3 text-[var(--ink-tertiary)]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                  clip-rule="evenodd"
                />
              </svg>
            </button>
            <div
              id="lang-switcher-menu"
              role="menu"
              aria-label="Language options"
              class="popover-panel hidden absolute right-0 top-full z-50 mt-1.5 w-52 overflow-hidden py-1"
            ></div>
          </div>
        </div>

        <nav aria-label="Primary" class="order-3 flex w-full items-center justify-between gap-1 border-t border-[var(--border-hairline)] pt-2 text-xs font-medium sm:order-2 sm:ml-auto sm:w-auto sm:border-0 sm:pt-0 sm:gap-1 sm:text-[13px]">
          <a href="/" class={navMatrixClass} data-i18n="nav.matrix">Matrix</a>
          <a href="/calculator/" class={navCalcClass} data-i18n="nav.simulator">Simulator</a>
          <a href="/gpu/" class={navGpuClass} data-i18n="nav.gpus">GPUs</a>
          <a href="/model/" class={navModelClass} data-i18n="nav.models">Models</a>
          <a href="/#methodology" class={`hidden md:inline ${navIdle}`} data-i18n="nav.formula">
            VRAM Formula
          </a>
          <a href="/changelog/" class={navDesktopChangelogClass} data-i18n="nav.changelog">
            Changelog
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 border-t border-[var(--border-subtle)] bg-[var(--bg-surface)]">
      <div class="mx-auto flex max-w-6xl flex-col gap-5 px-4 py-10 text-sm text-[var(--ink-secondary)] sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <div class="space-y-2">
          <div class="flex flex-wrap items-center gap-2.5">
            <p class="font-semibold text-[var(--ink-primary)]" data-i18n="footer.tagline">
              VRAMCalc.me — Local LLM Memory &amp; Throughput Estimator
            </p>
            <a
              href="/changelog/"
              class="inline-flex items-center rounded-md border border-[var(--border-subtle)] bg-[var(--bg-subtle)] px-2 py-0.5 text-[11px] font-mono text-[var(--ink-secondary)] hover:border-[var(--accent-border)] hover:text-[var(--accent-ink)] transition-colors"
              data-i18n="footer.updatedMeta"
              data-i18n-args={footerMetaArgs}
            >
              Updated {updatedAt} · Physics {engineVersion} · Formula Estimates
            </a>
          </div>
          <p class="max-w-2xl text-xs leading-relaxed text-[var(--ink-tertiary)]" data-i18n="footer.disclaimer">
            VRAM budgets come from weight bit-width (GGUF / AWQ / MLX), GQA KV-cache geometry, per-GPU CUDA/PCIe overhead,
            and selectable OS reserves. Speed numbers are bandwidth formula estimate ranges (±17–25%), paired with public reference benchmarks where verified.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-xs font-medium text-[var(--ink-secondary)] shrink-0">
          <a href="/" class="hover:text-[var(--ink-primary)] transition-colors" data-i18n="footer.matrix">Matrix</a>
          <a href="/calculator/" class="hover:text-[var(--ink-primary)] transition-colors" data-i18n="footer.rigSimulator">Rig Simulator</a>
          <a href="/gpu/" class="hover:text-[var(--ink-primary)] transition-colors" data-i18n="footer.allGpus">All GPUs</a>
          <a href="/model/" class="hover:text-[var(--ink-primary)] transition-colors" data-i18n="footer.allModels">All Models</a>
          <a href="/changelog/" class="hover:text-[var(--ink-primary)] transition-colors" data-i18n="nav.changelog">Changelog</a>
          <a href="/sitemap-index.xml" class="hover:text-[var(--ink-primary)] transition-colors" data-i18n="footer.sitemap">Sitemap</a>
        </div>
      </div>
    </footer>

    <div
      id="copy-toast"
      role="status"
      aria-live="polite"
      class="fixed bottom-5 right-5 z-50 flex items-center gap-2 rounded-xl border border-[var(--border-strong)] bg-[var(--bg-code)] px-4 py-2.5 text-xs font-semibold text-white shadow-xl transition-all duration-200 opacity-0 pointer-events-none translate-y-2"
    >
      <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
      <span id="copy-toast-text" data-i18n="common.copiedToast">Copied to clipboard</span>
    </div>

    <script>
      import { initGlobalI18n, onLocaleChange, t } from '../utils/i18n';

      function initThemeSwitcher() {
        const btn = document.getElementById('theme-toggle-btn');
        if (!btn) return;
        const syncState = () => {
          const isDark = document.documentElement.classList.contains('dark');
          btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
          const label = t(isDark ? 'theme.toLight' : 'theme.toDark');
          btn.setAttribute('title', label);
          btn.setAttribute('aria-label', label);
        };

        btn.addEventListener('click', () => {
          const nextDark = !document.documentElement.classList.contains('dark');
          document.documentElement.classList.toggle('dark', nextDark);
          document.documentElement.dataset.theme = nextDark ? 'dark' : 'light';
          try {
            window.localStorage.setItem('vramcalc_theme', nextDark ? 'dark' : 'light');
          } catch {
            // ignore storage block
          }
          const tcMeta = document.querySelector('meta[name="theme-color"]');
          if (tcMeta) tcMeta.setAttribute('content', nextDark ? '#0a0a0c' : '#f5f5f7');
          syncState();
        });

        onLocaleChange(syncState);
        syncState();
      }

      function bootGlobalShell() {
        initGlobalI18n();
        initThemeSwitcher();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootGlobalShell);
      } else {
        bootGlobalShell();
      }
    </script>
  </body>
</html>
