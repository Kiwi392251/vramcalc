---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  totalPages?: number;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  themeColor?: string;
}

const {
  title,
  description,
  canonicalPath = '/',
  totalPages = 0,
  ogTitle,
  ogDescription,
  ogImage = '/og/home.png',
  ogImageAlt,
  themeColor = '#2563eb',
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, Astro.site ?? 'https://vramcalc.me').toString();
const socialTitle = ogTitle ?? title;
const socialDesc = ogDescription ?? description;
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://vramcalc.me').toString();
const socialImageAlt = ogImageAlt ?? socialTitle;
const isHome = canonicalPath === '/';
const isGpu = canonicalPath.startsWith('/gpu/');
const isModel = canonicalPath.startsWith('/model/');

const navMatrixClass = isHome ? 'text-blue-600 font-semibold' : 'hover:text-slate-950 transition-colors';
const navGpuClass = isGpu ? 'text-blue-600 font-semibold' : 'hover:text-slate-950 transition-colors';
const navModelClass = isModel ? 'text-blue-600 font-semibold' : 'hover:text-slate-950 transition-colors';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="theme-color" content={themeColor} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="VRAMCalc.me" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDesc} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-[#f8fafc] text-slate-900 antialiased flex flex-col">
    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur-sm">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <a
          href="/"
          class="flex items-center gap-2.5 font-semibold tracking-tight text-slate-950 hover:text-blue-600 transition-colors"
        >
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-950 text-white">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <rect x="3" y="4" width="18" height="4" rx="1" />
              <rect x="3" y="10" width="13" height="4" rx="1" />
              <rect x="3" y="16" width="8" height="4" rx="1" />
              <path d="M19 11v9m0 0l2.5-2.5M19 20l-2.5-2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="text-base">
            VRAMCalc<span class="text-blue-600">.me</span>
          </span>
        </a>

        <nav aria-label="Primary" class="flex items-center gap-4 sm:gap-5 text-sm font-medium text-slate-600">
          <a href="/" class={navMatrixClass}>Matrix</a>
          <a href="/gpu/" class={navGpuClass}>GPUs</a>
          <a href="/model/" class={navModelClass}>Models</a>
          <a href="/#methodology" class="hidden md:inline hover:text-slate-950 transition-colors">
            VRAM Formula
          </a>
          {totalPages > 0 && (
            <span class="hidden lg:inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-mono text-slate-600 tabular-nums">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              {totalPages} configs indexed
            </span>
          )}
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 border-t border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <div class="space-y-1">
          <p class="font-medium text-slate-900">VRAMCalc.me — Local LLM Memory & Throughput Estimator</p>
          <p class="max-w-2xl text-xs text-slate-500">
            Estimates derive from GGUF bits-per-weight, GQA KV-cache geometry (FP16 K/V), runtime buffer overhead,
            and memory-bandwidth-bound decode math. Actual throughput varies by driver version, Flash Attention, and PCIe topology.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-xs font-medium text-slate-500 shrink-0">
          <a href="/" class="hover:text-slate-900 transition-colors">Matrix</a>
          <a href="/gpu/" class="hover:text-slate-900 transition-colors">All GPUs</a>
          <a href="/model/" class="hover:text-slate-900 transition-colors">All Models</a>
          <a href="/sitemap-index.xml" class="hover:text-slate-900 transition-colors">Sitemap</a>
        </div>
      </div>
    </footer>
  </body>
</html>
