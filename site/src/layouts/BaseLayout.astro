---
import '../styles/global.css';
import rawCatalog from '../data/catalog_data.json';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  totalPages?: number;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  themeColor?: string;
}

const {
  title,
  description,
  canonicalPath = '/',
  totalPages = 0,
  ogTitle,
  ogDescription,
  ogImage = '/og/home.png',
  ogImageAlt,
  themeColor = '#2563eb',
} = Astro.props;

const updatedAt = (rawCatalog as { updated_at?: string }).updated_at ?? '2026-11-24';
const engineVersion = (rawCatalog as { engine_version?: string }).engine_version ?? 'v3.1';
const modelCount = rawCatalog.models.length;
const hwCount = rawCatalog.hardware.length;

const canonicalUrl = new URL(canonicalPath, Astro.site ?? 'https://vramcalc.me').toString();
const socialTitle = ogTitle ?? title;
const socialDesc = ogDescription ?? description;
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://vramcalc.me').toString();
const socialImageAlt = ogImageAlt ?? socialTitle;
const isHome = canonicalPath === '/';
const isCalc = canonicalPath.startsWith('/calculator');
const isGpu = canonicalPath.startsWith('/gpu/');
const isModel = canonicalPath.startsWith('/model/');

const navMatrixClass = isHome ? 'whitespace-nowrap text-blue-600 font-semibold' : 'whitespace-nowrap hover:text-slate-950 transition-colors';
const navCalcClass = isCalc ? 'whitespace-nowrap text-blue-600 font-semibold' : 'whitespace-nowrap hover:text-slate-950 transition-colors';
const navGpuClass = isGpu ? 'whitespace-nowrap text-blue-600 font-semibold' : 'whitespace-nowrap hover:text-slate-950 transition-colors';
const navModelClass = isModel ? 'whitespace-nowrap text-blue-600 font-semibold' : 'whitespace-nowrap hover:text-slate-950 transition-colors';
const indexedArgs = JSON.stringify({ count: totalPages, models: modelCount, hw: hwCount });
const footerMetaArgs = JSON.stringify({ date: updatedAt, ver: engineVersion });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="theme-color" content={themeColor} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="VRAMCalc.me" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDesc} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <script is:inline>
      (function () {
        var valid = { en: 'en', 'zh-CN': 'zh-CN', 'zh-TW': 'zh-TW', ja: 'ja', es: 'es', fr: 'fr', ko: 'ko' };
        var loc = '';
        try {
          var qp = new URLSearchParams(window.location.search).get('lang');
          if (qp && valid[qp]) loc = qp;
        } catch (e) {}
        if (!loc) {
          try {
            var st = window.localStorage.getItem('vramcalc_lang');
            if (st && valid[st]) loc = st;
          } catch (e) {}
        }
        if (!loc) {
          var list = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'en'];
          for (var i = 0; i < list.length; i++) {
            var tag = String(list[i] || '').trim().toLowerCase().replace(/_/g, '-');
            if (!tag) continue;
            if (tag === 'zh-tw' || tag === 'zh-hk' || tag === 'zh-mo' || tag.indexOf('zh-hant') === 0) {
              loc = 'zh-TW';
              break;
            }
            if (tag === 'zh' || tag.indexOf('zh-') === 0) {
              loc = 'zh-CN';
              break;
            }
            if (tag === 'ja' || tag.indexOf('ja-') === 0) {
              loc = 'ja';
              break;
            }
            if (tag === 'es' || tag.indexOf('es-') === 0) {
              loc = 'es';
              break;
            }
            if (tag === 'fr' || tag.indexOf('fr-') === 0) {
              loc = 'fr';
              break;
            }
            if (tag === 'ko' || tag.indexOf('ko-') === 0) {
              loc = 'ko';
              break;
            }
            if (tag === 'en' || tag.indexOf('en-') === 0) {
              loc = 'en';
              break;
            }
          }
        }
        loc = loc || 'en';
        document.documentElement.lang = loc;
        document.documentElement.dataset.locale = loc;
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-[#f8fafc] text-slate-900 antialiased flex flex-col">
    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur-sm">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-3 gap-y-2 px-3 py-2.5 sm:flex-nowrap sm:gap-4 sm:px-6 sm:py-3">
        <a
          href="/"
          class="flex shrink-0 items-center gap-2 sm:gap-2.5 font-semibold tracking-tight text-slate-950 hover:text-blue-600 transition-colors"
        >
          <span class="flex h-7 w-7 sm:h-8 sm:w-8 items-center justify-center rounded-lg bg-slate-950 text-white">
            <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <rect x="3" y="4" width="18" height="4" rx="1" />
              <rect x="3" y="10" width="13" height="4" rx="1" />
              <rect x="3" y="16" width="8" height="4" rx="1" />
              <path d="M19 11v9m0 0l2.5-2.5M19 20l-2.5-2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="text-sm sm:text-base whitespace-nowrap">
            VRAMCalc<span class="text-blue-600">.me</span>
          </span>
        </a>

        <div id="lang-switcher" class="relative shrink-0 sm:order-3">
          <button
            id="lang-switcher-btn"
            type="button"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label="Select language"
            class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-2.5 text-xs font-semibold text-slate-700 hover:border-blue-300 hover:bg-blue-50 hover:text-blue-700 transition-colors cursor-pointer"
          >
            <svg class="h-3.5 w-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <path d="M2 12h20" />
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            </svg>
            <span id="lang-switcher-label">EN</span>
            <svg class="h-3 w-3 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
          <div
            id="lang-switcher-menu"
            role="menu"
            aria-label="Language options"
            class="hidden absolute right-0 top-full z-50 mt-1.5 w-52 overflow-hidden rounded-xl border border-slate-200 bg-white py-1 shadow-xl"
          ></div>
        </div>

        <nav aria-label="Primary" class="order-3 flex w-full items-center justify-between gap-2 border-t border-slate-100 pt-2 text-xs font-medium text-slate-600 sm:order-2 sm:ml-auto sm:w-auto sm:border-0 sm:pt-0 sm:gap-5 sm:text-sm">
          <a href="/" class={navMatrixClass} data-i18n="nav.matrix">Matrix</a>
          <a href="/calculator/" class={navCalcClass} data-i18n="nav.simulator">Simulator</a>
          <a href="/gpu/" class={navGpuClass} data-i18n="nav.gpus">GPUs</a>
          <a href="/model/" class={navModelClass} data-i18n="nav.models">Models</a>
          <a href="/#methodology" class="hidden md:inline whitespace-nowrap hover:text-slate-950 transition-colors" data-i18n="nav.formula">
            VRAM Formula
          </a>
          {totalPages > 0 && (
            <span class="hidden xl:inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-mono text-slate-600 tabular-nums whitespace-nowrap">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              <span data-i18n="nav.configsIndexed" data-i18n-args={indexedArgs}>{totalPages} guides · {modelCount}×{hwCount}</span>
            </span>
          )}
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 border-t border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <div class="space-y-1.5">
          <div class="flex flex-wrap items-center gap-2.5">
            <p class="font-medium text-slate-900" data-i18n="footer.tagline">
              VRAMCalc.me — Local LLM Memory &amp; Throughput Estimator
            </p>
            <span
              class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 text-[11px] font-mono text-slate-500"
              data-i18n="footer.updatedMeta"
              data-i18n-args={footerMetaArgs}
            >
              Updated {updatedAt} · Physics {engineVersion} · Formula Estimates
            </span>
          </div>
          <p class="max-w-2xl text-xs text-slate-500" data-i18n="footer.disclaimer">
            VRAM budgets come from weight bit-width (GGUF / AWQ / MLX), GQA KV-cache geometry, per-GPU CUDA/PCIe overhead,
            and selectable OS reserves. Speed numbers are bandwidth formula estimate ranges (±15–25%), paired with public reference benchmarks where verified.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-xs font-medium text-slate-500 shrink-0">
          <a href="/" class="hover:text-slate-900 transition-colors" data-i18n="footer.matrix">Matrix</a>
          <a href="/calculator/" class="hover:text-slate-900 transition-colors" data-i18n="footer.rigSimulator">Rig Simulator</a>
          <a href="/gpu/" class="hover:text-slate-900 transition-colors" data-i18n="footer.allGpus">All GPUs</a>
          <a href="/model/" class="hover:text-slate-900 transition-colors" data-i18n="footer.allModels">All Models</a>
          <a href="/sitemap-index.xml" class="hover:text-slate-900 transition-colors" data-i18n="footer.sitemap">Sitemap</a>
        </div>
      </div>
    </footer>

    <script>
      import { initGlobalI18n } from '../utils/i18n';

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGlobalI18n);
      } else {
        initGlobalI18n();
      }
    </script>
  </body>
</html>
